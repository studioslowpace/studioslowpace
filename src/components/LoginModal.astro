---
// LoginModal 元件（含身分角色選擇、分身造型與防呆寫入）
---
<div style="max-width: 100%; padding: 24px; background: #262422; color: #e7e2d8; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; border-radius: 8px;">

  <!-- 頂部文青 Logo 與返回首頁 -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid #3c3835;">
    <a href="/" style="display: flex; align-items: center; gap: 8px; text-decoration: none; color: #f5f2eb;">
      <span style="font-size: 1.25rem;">☕</span>
      <div style="display: flex; flex-direction: column;">
        <span style="font-size: 0.95rem; font-weight: 500; letter-spacing: 0.05em;">空間客舍</span>
        <span style="font-size: 0.7rem; color: #a39b90; letter-spacing: 0.1em;">Slow Pace Skill</span>
      </div>
    </a>
    <a href="/" style="font-size: 0.75rem; color: #a39b90; text-decoration: none; padding: 4px 8px; border: 1px solid #3c3835; border-radius: 4px; transition: all 0.2s;">
      ← 回到首頁
    </a>
  </div>

  <!-- 切換登入、註冊與訪客模式分頁 -->
  <div style="display: flex; gap: 8px; margin-bottom: 20px;">
    <button id="tab-login-mode" class="auth-tab-btn" style="flex:1; padding:10px; background:#4a443f; color:#f5f2eb; border:none; border-radius:6px; cursor:pointer; font-weight:500; font-size:0.9rem;">會員登入</button>
    <button id="tab-register-mode" class="auth-tab-btn" style="flex:1; padding:10px; background:#262422; color:#a39b90; border:1px solid #3c3835; border-radius:6px; cursor:pointer; font-size:0.9rem;">會員註冊</button>
    <button id="tab-guest-mode" class="auth-tab-btn" style="flex:1; padding:10px; background:#262422; color:#a39b90; border:1px solid #3c3835; border-radius:6px; cursor:pointer; font-size:0.9rem;">👤 訪客模式</button>
  </div>

  <!-- 會員登入表單區塊 -->
  <div id="login-form-container">
    <input type="email" id="login-email" placeholder="電子信箱 (Email)" style="width:100%; padding:12px; margin-bottom:12px; background:#1e1c1a; color:#f5f2eb; border:1px solid #3c3835; border-radius:6px; box-sizing:border-box; outline:none;" />
    <input type="password" id="login-password" placeholder="密碼" style="width:100%; padding:12px; margin-bottom:12px; background:#1e1c1a; color:#f5f2eb; border:1px solid #3c3835; border-radius:6px; box-sizing:border-box; outline:none;" />
    
    <button id="login-submit-btn" style="width:100%; padding:12px; background:#4a443f; color:#f5f2eb; border:none; border-radius:6px; font-weight:500; cursor:pointer; margin-bottom: 14px;">登入空間</button>
    
    <div style="text-align: right;">
      <button id="forgot-password-btn" style="background: none; border: none; color: #b8aea3; cursor: pointer; font-size: 0.85rem; text-decoration: underline; padding: 0;">忘記密碼？</button>
    </div>
  </div>

  <!-- 會員註冊表單區塊 -->
  <div id="register-form-container" style="display: none;">
    <input type="text" id="register-name" placeholder="鄰里人稱呼 / 暱稱 (Name)" style="width:100%; padding:12px; margin-bottom:12px; background:#1e1c1a; color:#f5f2eb; border:1px solid #3c3835; border-radius:6px; box-sizing:border-box; outline:none;" />
    <input type="email" id="register-email" placeholder="電子信箱 (Email)" style="width:100%; padding:12px; margin-bottom:12px; background:#1e1c1a; color:#f5f2eb; border:1px solid #3c3835; border-radius:6px; box-sizing:border-box; outline:none;" />
    <input type="password" id="register-password" placeholder="設定密碼 (至少 6 碼)" style="width:100%; padding:12px; margin-bottom:12px; background:#1e1c1a; color:#f5f2eb; border:1px solid #3c3835; border-radius:6px; box-sizing:border-box; outline:none;" />
    <input type="password" id="register-password-confirm" placeholder="確認密碼" style="width:100%; padding:12px; margin-bottom:12px; background:#1e1c1a; color:#f5f2eb; border:1px solid #3c3835; border-radius:6px; box-sizing:border-box; outline:none;" />
    
    <!-- 角色選擇 (role) -->
    <div style="font-size: 0.8rem; color: #a39b90; margin-bottom: 6px;">選擇你的身分角色 (Role)：</div>
    <select id="register-role" style="width:100%; padding:12px; margin-bottom:12px; background:#1e1c1a; color:#f5f2eb; border:1px solid #3c3835; border-radius:6px; box-sizing:border-box; outline:none; cursor:pointer;">
      <option value="漫步者">漫步者</option>
      <option value="探索者">探索者</option>
      <option value="實踐者">實踐者</option>
      <option value="觀察者">觀察者</option>
    </select>

    <!-- 分身造型選擇 -->
    <div style="font-size: 0.8rem; color: #a39b90; margin-bottom: 6px;">選擇分身造型：</div>
    <div style="display: flex; gap: 12px; margin-bottom: 16px;">
      <label style="flex:1; background:#1e1c1a; border:1px solid #3c3835; padding:8px; text-align:center; border-radius:8px; cursor:pointer;">
        <input type="radio" name="register-avatar" value="/assets/player1.png" checked style="display:none;" />
        <img src="/assets/player1.png" alt="P1" style="width:28px; height:28px; margin-bottom: 2px;" />
        <div style="font-size:0.7rem; color:#f5f2eb;">分身一號</div>
      </label>
      <label style="flex:1; background:#1e1c1a; border:1px solid #3c3835; padding:8px; text-align:center; border-radius:8px; cursor:pointer;">
        <input type="radio" name="register-avatar" value="/assets/player2.png" style="display:none;" />
        <img src="/assets/player2.png" alt="P2" style="width:28px; height:28px; margin-bottom: 2px;" />
        <div style="font-size:0.7rem; color:#f5f2eb;">分身二號</div>
      </label>
    </div>
    
    <button id="register-submit-btn" style="width:100%; padding:12px; background:#4a443f; color:#f5f2eb; border:none; border-radius:6px; font-weight:500; cursor:pointer;">註冊新帳號</button>
  </div>

  <!-- 訪客快速進入表單區塊 -->
  <div id="guest-form-container" style="display: none;">
    <p style="font-size: 0.8rem; color: #a39b90; margin-bottom: 16px; line-height: 1.5;">訪客將依序自動指派編號（如 訪客 #1），離開空間後資料將自動清除，享受一段寧靜的短暫停留。</p>
    
    <div style="font-size: 0.8rem; color: #a39b90; margin-bottom: 8px;">選擇分身造型：</div>
    <div style="display: flex; gap: 12px; margin-bottom: 20px;">
      <label style="flex:1; background:#1e1c1a; border:1px solid #3c3835; padding:10px; text-align:center; border-radius:8px; cursor:pointer;">
        <input type="radio" name="guest-avatar" value="/assets/player1.png" checked style="display:none;" />
        <img src="/assets/player1.png" alt="P1" style="width:32px; height:32px; margin-bottom: 4px;" />
        <div style="font-size:0.75rem; color:#f5f2eb;">分身一號</div>
      </label>
      <label style="flex:1; background:#1e1c1a; border:1px solid #3c3835; padding:10px; text-align:center; border-radius:8px; cursor:pointer;">
        <input type="radio" name="guest-avatar" value="/assets/player2.png" style="display:none;" />
        <img src="/assets/player2.png" alt="P2" style="width:32px; height:32px; margin-bottom: 4px;" />
        <div style="font-size:0.75rem; color:#f5f2eb;">分身二號</div>
      </label>
    </div>

    <button id="guest-submit-btn" style="width:100%; padding:12px; background:#5c534d; color:#f5f2eb; border:none; border-radius:6px; font-weight:500; cursor:pointer;">🍵 快速進入客舍空間</button>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase';
  const TABLE_NAME = 'slowpace_members';

  const tabLoginMode = document.getElementById('tab-login-mode');
  const tabRegisterMode = document.getElementById('tab-register-mode');
  const tabGuestMode = document.getElementById('tab-guest-mode');

  const loginFormContainer = document.getElementById('login-form-container');
  const registerFormContainer = document.getElementById('register-form-container');
  const guestFormContainer = document.getElementById('guest-form-container');

  tabLoginMode?.addEventListener('click', () => {
    tabLoginMode.style.background = '#4a443f'; tabLoginMode.style.color = '#f5f2eb'; tabLoginMode.style.border = 'none';
    if (tabRegisterMode) { tabRegisterMode.style.background = '#262422'; tabRegisterMode.style.color = '#a39b90'; tabRegisterMode.style.border = '1px solid #3c3835'; }
    if (tabGuestMode) { tabGuestMode.style.background = '#262422'; tabGuestMode.style.color = '#a39b90'; tabGuestMode.style.border = '1px solid #3c3835'; }
    if (loginFormContainer) loginFormContainer.style.display = 'block';
    if (registerFormContainer) registerFormContainer.style.display = 'none';
    if (guestFormContainer) guestFormContainer.style.display = 'none';
  });

  tabRegisterMode?.addEventListener('click', () => {
    tabRegisterMode.style.background = '#4a443f'; tabRegisterMode.style.color = '#f5f2eb'; tabRegisterMode.style.border = 'none';
    if (tabLoginMode) { tabLoginMode.style.background = '#262422'; tabLoginMode.style.color = '#a39b90'; tabLoginMode.style.border = '1px solid #3c3835'; }
    if (tabGuestMode) { tabGuestMode.style.background = '#262422'; tabGuestMode.style.color = '#a39b90'; tabGuestMode.style.border = '1px solid #3c3835'; }
    if (registerFormContainer) registerFormContainer.style.display = 'block';
    if (loginFormContainer) loginFormContainer.style.display = 'none';
    if (guestFormContainer) guestFormContainer.style.display = 'none';
  });

  tabGuestMode?.addEventListener('click', () => {
    tabGuestMode.style.background = '#4a443f'; tabGuestMode.style.color = '#f5f2eb'; tabGuestMode.style.border = 'none';
    if (tabLoginMode) { tabLoginMode.style.background = '#262422'; tabLoginMode.style.color = '#a39b90'; tabLoginMode.style.border = '1px solid #3c3835'; }
    if (tabRegisterMode) { tabRegisterMode.style.background = '#262422'; tabRegisterMode.style.color = '#a39b90'; tabRegisterMode.style.border = '1px solid #3c3835'; }
    if (guestFormContainer) guestFormContainer.style.display = 'block';
    if (loginFormContainer) loginFormContainer.style.display = 'none';
    if (registerFormContainer) registerFormContainer.style.display = 'none';
  });

  // 會員登入
  document.getElementById('login-submit-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value.trim();
    if (!email || !password) { alert('請完整填寫 Email 與密碼'); return; }

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) { alert('登入失敗：' + error.message); } 
    else { window.parent.postMessage({ type: 'LOGIN_SUCCESS' }, '*'); }
  });

  // 會員註冊
  document.getElementById('register-submit-btn')?.addEventListener('click', async () => {
    const name = document.getElementById('register-name').value.trim();
    const email = document.getElementById('register-email').value.trim();
    const password = document.getElementById('register-password').value.trim();
    const passwordConfirm = document.getElementById('register-password-confirm').value.trim();
    const role = document.getElementById('register-role').value;
    const selectedAvatar = document.querySelector('input[name="register-avatar"]:checked');
    const avatarVal = selectedAvatar ? selectedAvatar.value : '/assets/player1.png';

    if (!name || !email || !password || !passwordConfirm) { alert('請完整填寫所有註冊欄位'); return; }
    if (password !== passwordConfirm) { alert('兩次輸入的密碼不相符'); return; }
    if (password.length < 6) { alert('密碼長度至少需要 6 個字元'); return; }

    const { data: authData, error: authError } = await supabase.auth.signUp({ email, password });
    if (authError) { 
      alert('註冊失敗：' + authError.message); 
      return; 
    }

    const userId = authData?.user?.id;
    if (userId) {
      const memberPayload = {
        user_id: userId,
        name: name,
        role: role,
        tier: '鄰里人',
        avatar: avatarVal,
        updated_at: new Date()
      };

      const { error: dbError } = await supabase.from(TABLE_NAME).upsert([memberPayload], { onConflict: 'user_id' });
      if (dbError) {
        console.error("❌ 寫入 slowpace_members 失敗：", dbError.message);
      }
    }

    alert('註冊成功！歡迎加入空間客舍。');
    window.parent.postMessage({ type: 'REGISTER_SUCCESS' }, '*');
  });

  // 訪客快速進入
  document.getElementById('guest-submit-btn')?.addEventListener('click', async () => {
    const selectedAvatar = document.querySelector('input[name="guest-avatar"]:checked');
    const avatarVal = selectedAvatar ? selectedAvatar.value : '/assets/player1.png';

    let guestName = '';
    let guestId = '';
    let insertSuccess = false;
    let attempts = 0;

    while (!insertSuccess && attempts < 5) {
      attempts++;
      const { data: existingGuests, error: fetchError } = await supabase
        .from(TABLE_NAME)
        .select('name')
        .like('name', '訪客 #%');

      let nextIndex = 1;
      if (!fetchError && existingGuests && existingGuests.length > 0) {
        const numbers = existingGuests.map(g => {
          const match = g.name.match(/訪客 #(\d+)/);
          return match ? parseInt(match[1], 10) : 0;
        });
        const maxIndex = Math.max(...numbers, 0);
        nextIndex = maxIndex + 1;
      }

      guestName = `訪客 #${nextIndex}`;
      guestId = 'guest_' + Math.random().toString(36).substring(2, 11);

      const guestData = {
        user_id: guestId,
        name: guestName,
        role: '☁️ 訪客',
        tier: '鄰里人',
        avatar: avatarVal,
        room: 'study',
        gx: 2,
        gy: 2,
        reading_log: [],
        updated_at: new Date()
      };

      const { error: insertError } = await supabase.from(TABLE_NAME).insert([guestData]);
      if (!insertError) {
        insertSuccess = true;
      }
    }

    if (!insertSuccess) {
      alert('進入空間失敗：無法分配訪客編號，請稍後再試。');
      return;
    }

    sessionStorage.setItem('space_guest_id', guestId);
    sessionStorage.setItem('space_guest_name', guestName);
    window.__TEMP_GUEST_ID = guestId;
    window.__TEMP_GUEST_NAME = guestName;

    window.parent.postMessage({
      type: 'GUEST_LOGIN_SUCCESS',
      guestId: guestId,
      name: guestName,
      avatar: avatarVal
    }, '*');
  });

  window.addEventListener('beforeunload', () => {
    const guestId = sessionStorage.getItem('space_guest_id');
    if (!guestId) return;
    supabase.from(TABLE_NAME).delete().eq('user_id', guestId).then();
    sessionStorage.removeItem('space_guest_id');
  });

  document.getElementById('forgot-password-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('login-email').value.trim();
    if (!email) { alert('請先在上方欄位輸入您的電子信箱 (Email)'); return; }
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/profile`,
    });
    if (error) { alert('發送重設密碼信失敗：' + error.message); } 
    else { alert('重設密碼信已發送！'); }
  });
</script>