<!-- LoginModal 元件（含雙表寫入、聯絡資料、密碼顯示切換、造型高亮與忘記密碼介面） -->
<div style="max-width: 440px; margin: 0 auto; padding: 32px; background: #fdfbf7; color: #3c3835; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border: 1px solid #efece6;">

  <!-- 頂部文青 Logo 與返回首頁 -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid #efece6;">
    <a href="/" style="display: flex; align-items: center; gap: 8px; text-decoration: none; color: #3c3835;">
      <span style="font-size: 1.25rem;">☕</span>
      <div style="display: flex; flex-direction: column;">
        <span style="font-size: 0.95rem; font-weight: 500; letter-spacing: 0.05em;">空間客舍</span>
        <span style="font-size: 0.7rem; color: #8c8275; letter-spacing: 0.1em;">Slow Pace Skill</span>
      </div>
    </a>
    <a href="/" style="font-size: 0.75rem; color: #8c8275; text-decoration: none; padding: 4px 10px; border: 1px solid #e5dfd5; border-radius: 6px; transition: all 0.2s; background: #f7f4ee;">
      ← 回到首頁
    </a>
  </div>

  <!-- 切換登入、註冊與訪客模式分頁 (忘記密碼時隱藏) -->
  <div id="mode-tabs-container" style="display: flex; gap: 8px; margin-bottom: 24px; background: #f4efe6; padding: 4px; border-radius: 10px;">
    <button id="tab-login-mode" class="auth-tab-btn" style="flex:1; padding:10px; background:#3c3835; color:#fdfbf7; border:none; border-radius:8px; cursor:pointer; font-weight:500; font-size:0.9rem; transition: all 0.2s;">會員登入</button>
    <button id="tab-register-mode" class="auth-tab-btn" style="flex:1; padding:10px; background:transparent; color:#8c8275; border:none; border-radius:8px; cursor:pointer; font-size:0.9rem; transition: all 0.2s;">註冊帳號</button>
    <button id="tab-guest-mode" class="auth-tab-btn" style="flex:1; padding:10px; background:transparent; color:#8c8275; border:none; border-radius:8px; cursor:pointer; font-size:0.9rem; transition: all 0.2s;">訪客快速進入</button>
  </div>

  <!-- 會員登入表單區塊 -->
  <div id="login-form-container">
    <div style="margin-bottom: 20px;">
      <h2 style="font-size: 1.25rem; font-weight: 600; color: #3c3835; margin: 0 0 4px 0;">歡迎回來，旅人</h2>
    </div>

    <div style="margin-bottom: 14px;">
      <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">電子信箱 (Email)</label>
      <input type="email" id="login-email" placeholder="your@email.com" style="width:100%; padding:12px 14px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.9rem;" />
    </div>

    <div style="margin-bottom: 18px;">
      <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">密碼</label>
      <div style="position: relative;">
        <input type="password" id="login-password" placeholder="••••••••" style="width:100%; padding:12px 40px 12px 14px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.9rem;" />
        <button type="button" id="toggle-login-pwd" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #8c8275; font-size: 0.9rem;">👁️</button>
      </div>
    </div>
    
    <button id="login-submit-btn" style="width:100%; padding:13px; background:#3c3835; color:#fdfbf7; border:none; border-radius:8px; font-weight:500; cursor:pointer; margin-bottom: 16px; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(60,56,53,0.15);">登入空間</button>
    
    <div style="text-align: center;">
      <button id="forgot-password-link" style="background: none; border: none; color: #8c8275; cursor: pointer; font-size: 0.85rem; text-decoration: underline; padding: 0;">忘記密碼？</button>
    </div>
  </div>

  <!-- 忘記密碼獨立介面 -->
  <div id="forgot-form-container" style="display: none;">
    <div style="margin-bottom: 20px;">
      <h2 style="font-size: 1.25rem; font-weight: 600; color: #3c3835; margin: 0 0 4px 0;">重設您的密碼</h2>
      <p style="font-size: 0.8rem; color: #8c8275; margin: 0; line-height: 1.5;">請輸入您註冊時使用的電子信箱，我們將發送重設密碼連結給您。</p>
    </div>

    <div style="margin-bottom: 18px;">
      <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">電子信箱 (Email)</label>
      <input type="email" id="forgot-email" placeholder="your@email.com" style="width:100%; padding:12px 14px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.9rem;" />
    </div>

    <button id="forgot-submit-btn" style="width:100%; padding:13px; background:#3c3835; color:#fdfbf7; border:none; border-radius:8px; font-weight:500; cursor:pointer; margin-bottom: 12px; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(60,56,53,0.15);">發送重設密碼信</button>
    
    <div style="text-align: center;">
      <button id="back-to-login-btn" style="background: none; border: none; color: #8c8275; cursor: pointer; font-size: 0.85rem; text-decoration: underline; padding: 0;">← 返回登入</button>
    </div>
  </div>

  <!-- 會員註冊表單區塊 -->
  <div id="register-form-container" style="display: none;">
    <div style="margin-bottom: 20px;">
      <h2 style="font-size: 1.25rem; font-weight: 600; color: #3c3835; margin: 0 0 4px 0;">加入空間客舍</h2>
    </div>

    <div style="margin-bottom: 12px;">
      <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">您的稱呼</label>
      <input type="text" id="register-name" placeholder="例如：阿明" style="width:100%; padding:11px 14px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.9rem;" />
    </div>

    <div style="margin-bottom: 12px;">
      <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">電子信箱 (Email)</label>
      <input type="email" id="register-email" placeholder="your@email.com" style="width:100%; padding:11px 14px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.9rem;" />
    </div>

    <!-- 聯絡資料區塊：電話與 IG -->
    <div style="display: flex; gap: 10px; margin-bottom: 4px;">
      <div style="flex: 1;">
        <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">聯絡電話</label>
        <input type="text" id="register-phone" placeholder="0912-345-678" style="width:100%; padding:11px 12px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.85rem;" />
      </div>
      <div style="flex: 1;">
        <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">IG 帳號</label>
        <input type="text" id="register-ig" placeholder="@instagram_id" style="width:100%; padding:11px 12px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.85rem;" />
      </div>
    </div>
    <div style="font-size: 0.75rem; color: #8c8275; margin-bottom: 12px;">💡 兩者擇一填寫即可，若填寫一個，另一個將自動帶入相同內容。</div>

    <div style="margin-bottom: 12px;">
      <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">設定密碼 (至少 6 碼)</label>
      <div style="position: relative;">
        <input type="password" id="register-password" placeholder="••••••••" style="width:100%; padding:11px 40px 11px 14px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.9rem;" />
        <button type="button" id="toggle-reg-pwd" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #8c8275; font-size: 0.9rem;">👁️</button>
      </div>
    </div>

    <div style="margin-bottom: 12px;">
      <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">確認密碼</label>
      <div style="position: relative;">
        <input type="password" id="register-password-confirm" placeholder="••••••••" style="width:100%; padding:11px 40px 11px 14px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; font-size: 0.9rem;" />
        <button type="button" id="toggle-reg-confirm-pwd" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #8c8275; font-size: 0.9rem;">👁️</button>
      </div>
    </div>
    
    <!-- 角色選擇 (role) -->
    <div style="margin-bottom: 12px;">
      <label style="display: block; font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">身分角色</label>
      <select id="register-role" style="width:100%; padding:11px 14px; background:#ffffff; color:#3c3835; border:1px solid #e5dfd5; border-radius:8px; box-sizing:border-box; outline:none; cursor:pointer; font-size: 0.9rem;">
        <option value="鄰里人">🌱 鄰里人</option>
        <option value="漫步者">漫步者</option>
        <option value="探索者">探索者</option>
        <option value="實踐者">實踐者</option>
        <option value="觀察者">觀察者</option>
      </select>
    </div>

    <!-- 分身造型選擇 -->
    <div style="font-size: 0.8rem; color: #6e655b; margin-bottom: 6px;">選擇分身造型：</div>
    <div style="display: flex; gap: 12px; margin-bottom: 18px;" id="register-avatar-group">
      <label class="avatar-label reg-avatar-label" style="flex:1; background:#f4efe6; border:2px solid #3c3835; padding:10px; text-align:center; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; transition: all 0.2s;">
        <input type="radio" name="register-avatar" value="/assets/player1.png" checked style="display:none;" />
        <img src="/assets/player1.png" alt="P1" style="width:24px; height:24px;" />
        <span style="font-size:0.8rem; color:#3c3835; font-weight: 500;">分身一號</span>
      </label>
      <label class="avatar-label reg-avatar-label" style="flex:1; background:#ffffff; border:1px solid #e5dfd5; padding:10px; text-align:center; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; transition: all 0.2s;">
        <input type="radio" name="register-avatar" value="/assets/player2.png" style="display:none;" />
        <img src="/assets/player2.png" alt="P2" style="width:24px; height:24px;" />
        <span style="font-size:0.8rem; color:#8c8275;">分身二號</span>
      </label>
    </div>
    
    <button id="register-submit-btn" style="width:100%; padding:13px; background:#3c3835; color:#fdfbf7; border:none; border-radius:8px; font-weight:500; cursor:pointer; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(60,56,53,0.15);">註冊並建立身分</button>
  </div>

  <!-- 訪客快速進入表單區塊 -->
  <div id="guest-form-container" style="display: none;">
    <div style="margin-bottom: 16px;">
      <h2 style="font-size: 1.25rem; font-weight: 600; color: #3c3835; margin: 0 0 6px 0;">以訪客身分探索</h2>
      <p style="font-size: 0.8rem; color: #8c8275; margin: 0; line-height: 1.5;">無需註冊，直接選擇造型進入客舍互動。</p>
    </div>
    
    <div style="font-size: 0.8rem; color: #6e655b; margin-bottom: 8px;">選擇分身造型：</div>
    <div style="display: flex; gap: 12px; margin-bottom: 24px;" id="guest-avatar-group">
      <label class="avatar-label guest-avatar-label" style="flex:1; background:#f0f5f2; border:2px solid #557263; padding:12px; text-align:center; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; transition: all 0.2s;">
        <input type="radio" name="guest-avatar" value="/assets/player1.png" checked style="display:none;" />
        <img src="/assets/player1.png" alt="P1" style="width:28px; height:28px;" />
        <span style="font-size:0.85rem; color:#3c3835; font-weight: 500;">預設旅人</span>
      </label>
      <label class="avatar-label guest-avatar-label" style="flex:1; background:#ffffff; border:1px solid #e5dfd5; padding:12px; text-align:center; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; transition: all 0.2s;">
        <input type="radio" name="guest-avatar" value="/assets/player2.png" style="display:none;" />
        <img src="/assets/player2.png" alt="P2" style="width:28px; height:28px;" />
        <span style="font-size:0.85rem; color:#8c8275;">探索者</span>
      </label>
    </div>

    <button id="guest-submit-btn" style="width:100%; padding:13px; background:#557263; color:#fdfbf7; border:none; border-radius:8px; font-weight:500; cursor:pointer; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(85,114,99,0.2);">快速進入客舍空間</button>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase';
  const TABLE_NAME = 'slowpace_members';

  const tabLoginMode = document.getElementById('tab-login-mode');
  const tabRegisterMode = document.getElementById('tab-register-mode');
  const tabGuestMode = document.getElementById('tab-guest-mode');

  const modeTabsContainer = document.getElementById('mode-tabs-container');
  const loginFormContainer = document.getElementById('login-form-container');
  const registerFormContainer = document.getElementById('register-form-container');
  const guestFormContainer = document.getElementById('guest-form-container');
  const forgotFormContainer = document.getElementById('forgot-form-container');

  // 切換樣式 Helper
  function updateTabs(activeTab) {
    [tabLoginMode, tabRegisterMode, tabGuestMode].forEach(tab => {
      if (!tab) return;
      if (tab === activeTab) {
        tab.style.background = '#3c3835';
        tab.style.color = '#fdfbf7';
      } else {
        tab.style.background = 'transparent';
        tab.style.color = '#8c8275';
      }
    });
  }

  tabLoginMode?.addEventListener('click', () => {
    updateTabs(tabLoginMode);
    modeTabsContainer.style.display = 'flex';
    if (loginFormContainer) loginFormContainer.style.display = 'block';
    if (registerFormContainer) registerFormContainer.style.display = 'none';
    if (guestFormContainer) guestFormContainer.style.display = 'none';
    if (forgotFormContainer) forgotFormContainer.style.display = 'none';
  });

  tabRegisterMode?.addEventListener('click', () => {
    updateTabs(tabRegisterMode);
    modeTabsContainer.style.display = 'flex';
    if (registerFormContainer) registerFormContainer.style.display = 'block';
    if (loginFormContainer) loginFormContainer.style.display = 'none';
    if (guestFormContainer) guestFormContainer.style.display = 'none';
    if (forgotFormContainer) forgotFormContainer.style.display = 'none';
  });

  tabGuestMode?.addEventListener('click', () => {
    updateTabs(tabGuestMode);
    modeTabsContainer.style.display = 'flex';
    if (guestFormContainer) guestFormContainer.style.display = 'block';
    if (loginFormContainer) loginFormContainer.style.display = 'none';
    if (registerFormContainer) registerFormContainer.style.display = 'none';
    if (forgotFormContainer) forgotFormContainer.style.display = 'none';
  });

  // 忘記密碼介面切換
  document.getElementById('forgot-password-link')?.addEventListener('click', () => {
    modeTabsContainer.style.display = 'none';
    if (loginFormContainer) loginFormContainer.style.display = 'none';
    if (registerFormContainer) registerFormContainer.style.display = 'none';
    if (guestFormContainer) guestFormContainer.style.display = 'none';
    if (forgotFormContainer) forgotFormContainer.style.display = 'block';
  });

  document.getElementById('back-to-login-btn')?.addEventListener('click', () => {
    modeTabsContainer.style.display = 'flex';
    updateTabs(tabLoginMode);
    if (loginFormContainer) loginFormContainer.style.display = 'block';
    if (forgotFormContainer) forgotFormContainer.style.display = 'none';
  });

  // 密碼顯示/隱藏切換功能
  function setupPasswordToggle(inputId, toggleBtnId) {
    const input = document.getElementById(inputId);
    const btn = document.getElementById(toggleBtnId);
    btn?.addEventListener('click', () => {
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = '🔒';
      } else {
        input.type = 'password';
        btn.textContent = '👁️';
      }
    });
  }
  setupPasswordToggle('login-password', 'toggle-login-pwd');
  setupPasswordToggle('register-password', 'toggle-reg-pwd');
  setupPasswordToggle('register-password-confirm', 'toggle-reg-confirm-pwd');

  // 分身造型點擊高亮選取效果
  function setupAvatarSelection(groupId, labelClass, activeBg, activeBorder, activeText) {
    const group = document.getElementById(groupId);
    const labels = group?.querySelectorAll('.' + labelClass);
    labels?.forEach(label => {
      label.addEventListener('click', () => {
        labels.forEach(l => {
          l.style.background = '#ffffff';
          l.style.border = '1px solid #e5dfd5';
          const span = l.querySelector('span');
          if(span) { span.style.color = '#8c8275'; span.style.fontWeight = '400'; }
        });
        label.style.background = activeBg;
        label.style.border = activeBorder;
        const activeSpan = label.querySelector('span');
        if(activeSpan) { activeSpan.style.color = activeText; activeSpan.style.fontWeight = '500'; }
        const radio = label.querySelector('input[type="radio"]');
        if(radio) radio.checked = true;
      });
    });
  }
  setupAvatarSelection('register-avatar-group', 'reg-avatar-label', '#f4efe6', '2px solid #3c3835', '#3c3835');
  setupAvatarSelection('guest-avatar-group', 'guest-avatar-label', '#f0f5f2', '2px solid #557263', '#3c3835');

  // 會員登入
  document.getElementById('login-submit-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value.trim();
    if (!email || !password) { alert('請完整填寫 Email 與密碼'); return; }

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) { alert('登入失敗：' + error.message); } 
    else { window.parent.postMessage({ type: 'LOGIN_SUCCESS' }, '*'); }
  });

// 會員註冊（強化錯誤偵測與雙表寫入）
  document.getElementById('register-submit-btn')?.addEventListener('click', async () => {
    const name = document.getElementById('register-name').value.trim();
    const email = document.getElementById('register-email').value.trim();
    let phone = document.getElementById('register-phone').value.trim();
    let ig = document.getElementById('register-ig').value.trim();
    const password = document.getElementById('register-password').value.trim();
    const passwordConfirm = document.getElementById('register-password-confirm').value.trim();
    const role = document.getElementById('register-role').value;
    const selectedAvatar = document.querySelector('input[name="register-avatar"]:checked');
    const avatarVal = selectedAvatar ? selectedAvatar.value : '/assets/player1.png';

    if (!name || !email || (!phone && !ig) || !password || !passwordConfirm) { 
      alert('請完整填寫必填欄位（聯絡電話與 IG 帳號至少需填寫其中一項）'); 
      return; 
    }

    if (phone && !ig) { ig = phone; }
    else if (!phone && ig) { phone = ig; }

    if (password !== passwordConfirm) { alert('兩次輸入的密碼不相符'); return; }
    if (password.length < 6) { alert('密碼長度至少需要 6 個字元'); return; }

    console.log("正在送出註冊請求...", { email, name });

    // 呼叫 Supabase 註冊
    const { data: authData, error: authError } = await supabase.auth.signUp({ 
      email, 
      password,
      options: {
        data: {
          name: name // 同步帶入 metadata 確保萬無一失
        }
      }
    });

    if (authError) { 
      console.error("❌ Supabase Auth 註冊失敗細節：", authError);
      alert('註冊失敗：' + authError.message); 
      return; 
    }

    console.log("✅ Supabase Auth 註冊成功，回傳資料：", authData);

    const userId = authData?.user?.id;
    if (userId) {
      // 1. 寫入 slowpace_members
      const memberPayload = {
        user_id: userId,
        name: name,
        role: role,
        tier: '鄰里人',
        avatar: avatarVal,
        updated_at: new Date()
      };
      const { error: dbError1 } = await supabase.from(TABLE_NAME).upsert([memberPayload], { onConflict: 'user_id' });
      if (dbError1) { console.error("❌ 寫入 slowpace_members 失敗：", dbError1.message); }

      // 2. 寫入 member_contacts
      const contactPayload = {
        user_id: userId,
        name: name,
        email: email,
        phone: phone,
        ig: ig
      };
      const { error: dbError2 } = await supabase.from('member_contacts').upsert([contactPayload], { onConflict: 'user_id' });
      if (dbError2) { console.error("❌ 寫入 member_contacts 失敗：", dbError2.message); }
    }

    alert('註冊成功！若有啟用 Email 驗證，請至您的信箱收取驗證信。');
    window.parent.postMessage({ type: 'REGISTER_SUCCESS' }, '*');
  });

  // 訪客快速進入
  document.getElementById('guest-submit-btn')?.addEventListener('click', async () => {
    const selectedAvatar = document.querySelector('input[name="guest-avatar"]:checked');
    const avatarVal = selectedAvatar ? selectedAvatar.value : '/assets/player1.png';

    let guestName = '';
    let guestId = '';
    let insertSuccess = false;
    let attempts = 0;

    while (!insertSuccess && attempts < 5) {
      attempts++;
      const { data: existingGuests, error: fetchError } = await supabase
        .from(TABLE_NAME)
        .select('name')
        .like('name', '訪客 #%');

      let nextIndex = 1;
      if (!fetchError && existingGuests && existingGuests.length > 0) {
        const numbers = existingGuests.map(g => {
          const match = g.name.match(/訪客 #(\d+)/);
          return match ? parseInt(match[1], 10) : 0;
        });
        const maxIndex = Math.max(...numbers, 0);
        nextIndex = maxIndex + 1;
      }

      guestName = `訪客 #${nextIndex}`;
      guestId = 'guest_' + Math.random().toString(36).substring(2, 11);

      const guestData = {
        user_id: guestId,
        name: guestName,
        role: '☁️ 訪客',
        tier: '鄰里人',
        avatar: avatarVal,
        room: 'study',
        gx: 2,
        gy: 2,
        reading_log: [],
        updated_at: new Date()
      };

      const { error: insertError } = await supabase.from(TABLE_NAME).insert([guestData]);
      if (!insertError) {
        insertSuccess = true;
      }
    }

    if (!insertSuccess) {
      alert('進入空間失敗：無法分配訪客編號，請稍後再試。');
      return;
    }

    const now = new Date().getTime();
    localStorage.setItem('space_guest_id', guestId);
    localStorage.setItem('space_guest_name', guestName);
    localStorage.setItem('space_guest_created_at', now.toString());

    window.__TEMP_GUEST_ID = guestId;
    window.__TEMP_GUEST_NAME = guestName;

    window.parent.postMessage({
      type: 'GUEST_LOGIN_SUCCESS',
      guestId: guestId,
      name: guestName,
      avatar: avatarVal
    }, '*');
  });

  // 發送重設密碼信
  document.getElementById('forgot-submit-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('forgot-email').value.trim();
    if (!email) { alert('請輸入您的電子信箱 (Email)'); return; }
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/profile`,
    });
    if (error) { alert('發送重設密碼信失敗：' + error.message); } 
    else { 
      alert('重設密碼信已發送！請檢查您的信箱。'); 
      document.getElementById('back-to-login-btn').click();
    }
  });
</script>