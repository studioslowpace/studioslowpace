<!-- LoginModal 元件（不含頁面 Header） -->
<div style="max-width: 100%; padding: 10px; background: #1e293b; color: #fff; box-sizing: border-box;">
  <!-- 切換登入、註冊與訪客模式分頁 -->
  <div style="display: flex; gap: 6px; margin-bottom: 16px;">
    <button id="tab-login-mode" class="auth-tab-btn" style="flex:1; padding:8px; background:#0284c7; color:#fff; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">會員登入</button>
    <button id="tab-register-mode" class="auth-tab-btn" style="flex:1; padding:8px; background:#0f172a; color:#94a3b8; border:1px solid #334155; border-radius:4px; cursor:pointer;">會員註冊</button>
    <button id="tab-guest-mode" class="auth-tab-btn" style="flex:1; padding:8px; background:#0f172a; color:#94a3b8; border:1px solid #334155; border-radius:4px; cursor:pointer;">👤 訪客模式</button>
  </div>

  <!-- 會員登入表單區塊 -->
  <div id="login-form-container">
    <input type="email" id="login-email" placeholder="電子信箱 (Email)" style="width:100%; padding:10px; margin-bottom:10px; background:#0f172a; color:#fff; border:1px solid #334155; border-radius:4px; box-sizing:border-box;" />
    <input type="password" id="login-password" placeholder="密碼" style="width:100%; padding:10px; margin-bottom:10px; background:#0f172a; color:#fff; border:1px solid #334155; border-radius:4px; box-sizing:border-box;" />
    
    <button id="login-submit-btn" style="width:100%; padding:10px; background:#0284c7; color:#fff; border:none; border-radius:4px; font-weight:bold; cursor:pointer; margin-bottom: 12px;">登入</button>
    
    <div style="text-align: right;">
      <button id="forgot-password-btn" style="background: none; border: none; color: #38bdf8; cursor: pointer; font-size: 0.85rem; text-decoration: underline; padding: 0;">忘記密碼？</button>
    </div>
  </div>

  <!-- 會員註冊表單區塊 -->
  <div id="register-form-container" style="display: none;">
    <input type="email" id="register-email" placeholder="電子信箱 (Email)" style="width:100%; padding:10px; margin-bottom:10px; background:#0f172a; color:#fff; border:1px solid #334155; border-radius:4px; box-sizing:border-box;" />
    <input type="password" id="register-password" placeholder="設定密碼 (至少 6 碼)" style="width:100%; padding:10px; margin-bottom:10px; background:#0f172a; color:#fff; border:1px solid #334155; border-radius:4px; box-sizing:border-box;" />
    <input type="password" id="register-password-confirm" placeholder="確認密碼" style="width:100%; padding:10px; margin-bottom:12px; background:#0f172a; color:#fff; border:1px solid #334155; border-radius:4px; box-sizing:border-box;" />
    
    <button id="register-submit-btn" style="width:100%; padding:10px; background:#059669; color:#fff; border:none; border-radius:4px; font-weight:bold; cursor:pointer;">註冊新帳號</button>
  </div>

  <!-- 訪客快速進入表單區塊 -->
  <div id="guest-form-container" style="display: none;">
    <p style="font-size: 12px; color: #94a3b8; margin-bottom: 12px;">訪客將依序自動指派編號（如 訪客 #1），離開空間後資料將自動清除。</p>
    
    <div style="font-size: 12px; color: #94a3b8; margin-bottom: 6px;">選擇分身造型：</div>
    <div style="display: flex; gap: 10px; margin-bottom: 16px;">
      <label style="flex:1; background:#0f172a; border:1px solid #334155; padding:8px; text-align:center; border-radius:6px; cursor:pointer;">
        <input type="radio" name="guest-avatar" value="/assets/player1.png" checked style="display:none;" />
        <img src="/assets/player1.png" alt="P1" style="width:32px; height:32px;" />
        <div style="font-size:11px; color:#fff;">分身一號</div>
      </label>
      <label style="flex:1; background:#0f172a; border:1px solid #334155; padding:8px; text-align:center; border-radius:6px; cursor:pointer;">
        <input type="radio" name="guest-avatar" value="/assets/player2.png" style="display:none;" />
        <img src="/assets/player2.png" alt="P2" style="width:32px; height:32px;" />
        <div style="font-size:11px; color:#fff;">分身二號</div>
      </label>
    </div>

    <button id="guest-submit-btn" style="width:100%; padding:10px; background:#10b981; color:#fff; border:none; border-radius:4px; font-weight:bold; cursor:pointer;">🚀 快速進入客舍空間</button>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase';
  const TABLE_NAME = 'slowpace_members';

  // 分頁切換按鈕邏輯
  const tabLoginMode = document.getElementById('tab-login-mode');
  const tabRegisterMode = document.getElementById('tab-register-mode');
  const tabGuestMode = document.getElementById('tab-guest-mode');

  const loginFormContainer = document.getElementById('login-form-container');
  const registerFormContainer = document.getElementById('register-form-container');
  const guestFormContainer = document.getElementById('guest-form-container');

  tabLoginMode?.addEventListener('click', () => {
    tabLoginMode.style.background = '#0284c7'; tabLoginMode.style.color = '#fff'; tabLoginMode.style.border = 'none';
    if (tabRegisterMode) { tabRegisterMode.style.background = '#0f172a'; tabRegisterMode.style.color = '#94a3b8'; tabRegisterMode.style.border = '1px solid #334155'; }
    if (tabGuestMode) { tabGuestMode.style.background = '#0f172a'; tabGuestMode.style.color = '#94a3b8'; tabGuestMode.style.border = '1px solid #334155'; }
    if (loginFormContainer) loginFormContainer.style.display = 'block';
    if (registerFormContainer) registerFormContainer.style.display = 'none';
    if (guestFormContainer) guestFormContainer.style.display = 'none';
  });

  tabRegisterMode?.addEventListener('click', () => {
    tabRegisterMode.style.background = '#059669'; tabRegisterMode.style.color = '#fff'; tabRegisterMode.style.border = 'none';
    if (tabLoginMode) { tabLoginMode.style.background = '#0f172a'; tabLoginMode.style.color = '#94a3b8'; tabLoginMode.style.border = '1px solid #334155'; }
    if (tabGuestMode) { tabGuestMode.style.background = '#0f172a'; tabGuestMode.style.color = '#94a3b8'; tabGuestMode.style.border = '1px solid #334155'; }
    if (registerFormContainer) registerFormContainer.style.display = 'block';
    if (loginFormContainer) loginFormContainer.style.display = 'none';
    if (guestFormContainer) guestFormContainer.style.display = 'none';
  });

  tabGuestMode?.addEventListener('click', () => {
    tabGuestMode.style.background = '#10b981'; tabGuestMode.style.color = '#fff'; tabGuestMode.style.border = 'none';
    if (tabLoginMode) { tabLoginMode.style.background = '#0f172a'; tabLoginMode.style.color = '#94a3b8'; tabLoginMode.style.border = '1px solid #334155'; }
    if (tabRegisterMode) { tabRegisterMode.style.background = '#0f172a'; tabRegisterMode.style.color = '#94a3b8'; tabRegisterMode.style.border = '1px solid #334155'; }
    if (guestFormContainer) guestFormContainer.style.display = 'block';
    if (loginFormContainer) loginFormContainer.style.display = 'none';
    if (registerFormContainer) registerFormContainer.style.display = 'none';
  });

  // 會員登入
  document.getElementById('login-submit-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value.trim();
    if (!email || !password) { alert('請完整填寫 Email 與密碼'); return; }

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) { alert('登入失敗：' + error.message); } 
    else { window.parent.postMessage({ type: 'LOGIN_SUCCESS' }, '*'); }
  });

  // 會員註冊
  document.getElementById('register-submit-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('register-email').value.trim();
    const password = document.getElementById('register-password').value.trim();
    const passwordConfirm = document.getElementById('register-password-confirm').value.trim();
    if (!email || !password || !passwordConfirm) { alert('請完整填寫所有欄位'); return; }
    if (password !== passwordConfirm) { alert('兩次輸入的密碼不相符'); return; }
    if (password.length < 6) { alert('密碼長度至少需要 6 個字元'); return; }

    const { error } = await supabase.auth.signUp({ email, password });
    if (error) { alert('註冊失敗：' + error.message); } 
    else { window.parent.postMessage({ type: 'REGISTER_SUCCESS' }, '*'); }
  });

  // 訪客模式：遞增編號與離開自動刪除
  document.getElementById('guest-submit-btn')?.addEventListener('click', async () => {
    const selectedAvatar = document.querySelector('input[name="guest-avatar"]:checked');
    const avatarVal = selectedAvatar ? selectedAvatar.value : '/assets/player1.png';

    // 1. 計算目前的訪客數量來決定流水號（抓取 role 為 '☁️ 訪客' 的數量）
    const { count, error: countError } = await supabase
      .from(TABLE_NAME)
      .select('*', { count: 'exact', head: true })
      .eq('role', '☁️ 訪客');

    const nextIndex = (count || 0) + 1;
    const guestId = 'guest_' + Math.random().toString(36).substring(2, 11);
    const guestName = `訪客 #${nextIndex}`;
    
    const guestData = {
      user_id: guestId,
      name: guestName,
      role: '☁️ 訪客',
      tier: '鄰里人',
      avatar: avatarVal,
      room: 'study',
      gx: 2,
      gy: 2,
      reading_log: [],
      updated_at: new Date()
    };

    const { error } = await supabase.from(TABLE_NAME).insert([guestData]);
    if (error) {
      console.error('Supabase 寫入錯誤:', error);
      alert('進入空間失敗：' + error.message);
      return;
    }

    // 儲存於 sessionStorage 供離開時辨識刪除
    sessionStorage.setItem('space_guest_id', guestId);

    // 通知外層進入
    window.parent.postMessage({
      type: 'GUEST_LOGIN_SUCCESS',
      guestId: guestId,
      name: guestName,
      avatar: avatarVal
    }, '*');
  });

  // 忘記密碼
  document.getElementById('forgot-password-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('login-email').value.trim();
    if (!email) { alert('請先在上方欄位輸入您的電子信箱 (Email)'); return; }
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/profile`,
    });
    if (error) { alert('發送重設密碼信失敗：' + error.message); } 
    else { alert('重設密碼信已發送！'); }
  });
</script>