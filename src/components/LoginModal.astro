---
// LoginModal.astro
---

<div id="rpg-modal" class="modal-backdrop" style="display: none;">
  <div class="modal-card">
    <!-- 頁籤切換 -->
    <div class="modal-tabs">
      <button id="tab-login-mode" type="button" class="tab-btn active">會員登入</button>
      <button id="tab-register-mode" type="button" class="tab-btn">註冊帳號</button>
      <button id="tab-guest-mode" type="button" class="tab-btn">訪客快速進入</button>
    </div>

    <!-- 1. 會員登入表單 -->
    <div id="login-form-container" class="form-section">
      <h3>歡迎回來，旅人</h3>
      <div class="input-group">
        <label for="login-email">電子信箱 (Email)</label>
        <input type="email" id="login-email" placeholder="your@email.com" />
      </div>
      <div class="input-group">
        <label for="login-password">密碼</label>
        <input type="password" id="login-password" placeholder="••••••••" />
      </div>
      <button id="login-submit-btn" type="button" class="primary-btn">登入空間</button>
      <button id="forgot-password-btn" type="button" class="text-btn">忘記密碼？</button>
    </div>

    <!-- 2. 註冊帳號表單 -->
    <div id="register-form-container" class="form-section" style="display: none;">
      <h3>加入空間客舍</h3>
      <div class="input-group">
        <label for="register-name">您的稱呼</label>
        <input type="text" id="register-name" placeholder="例如：阿明" />
      </div>
      <div class="input-group">
        <label for="register-email">電子信箱 (Email)</label>
        <input type="email" id="register-email" placeholder="your@email.com" />
      </div>
      <div class="input-group">
        <label for="register-password">設定密碼 (至少 6 碼)</label>
        <input type="password" id="register-password" placeholder="••••••••" />
      </div>
      <div class="input-group">
        <label for="register-password-confirm">確認密碼</label>
        <input type="password" id="register-password-confirm" placeholder="••••••••" />
      </div>
      <div class="input-group">
        <label for="register-role">身分角色</label>
        <select id="register-role">
          <option value="🌱 鄰里人">🌱 鄰里人</option>
          <option value="☕ 駐站夥伴">☕ 駐站夥伴</option>
          <option value="📚 讀書會成員">📚 讀書會成員</option>
        </select>
      </div>
      <button id="register-submit-btn" type="button" class="primary-btn">註冊並建立身分</button>
    </div>

    <!-- 3. 訪客快速進入表單 -->
    <div id="guest-form-container" class="form-section" style="display: none;">
      <h3>以訪客身分探索</h3>
      <p class="section-desc">無需註冊，直接選擇造型進入客舍互動。</p>
      
      <div class="avatar-selection">
        <label class="avatar-option">
          <input type="radio" name="guest-avatar" value="/assets/player1.png" checked />
          <span class="avatar-box">預設旅人</span>
        </label>
        <label class="avatar-option">
          <input type="radio" name="guest-avatar" value="/assets/player2.png" />
          <span class="avatar-box">探索者</span>
        </label>
      </div>

      <button id="guest-submit-btn" type="button" class="primary-btn guest-btn">快速進入客舍空間</button>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh; height: 100dvh;
    background: rgba(44, 36, 29, 0.6);
    backdrop-filter: blur(4px);
    display: flex; justify-content: center; align-items: center;
    z-index: 9999;
    padding: 20px;
  }
  .modal-card {
    background: #faf6ee;
    width: 100%; max-width: 400px;
    border: 1px solid #e6dcc8;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 16px 40px rgba(44, 36, 29, 0.15);
  }
  .modal-tabs {
    display: flex; gap: 8px; margin-bottom: 20px;
    border-bottom: 1px solid #e6dcc8; padding-bottom: 12px;
  }
  .tab-btn {
    flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #e6dcc8;
    background: #f4efe6; color: #8c7a6b; font-size: 14px; cursor: pointer; transition: all 0.2s;
  }
  .tab-btn.active {
    background: #4a443f; color: #f5f2eb; border-color: #4a443f; font-weight: 500;
  }
  .form-section h3 { margin: 0 0 8px 0; color: #2c241d; font-size: 18px; }
  .section-desc { font-size: 13px; color: #8c7a6b; margin-bottom: 16px; }
  .input-group { margin-bottom: 14px; display: flex; flex-direction: column; gap: 6px; }
  .input-group label { font-size: 13px; color: #5c4f44; font-weight: 500; }
  .input-group input, .input-group select {
    padding: 10px 14px; border: 1px solid #e6dcc8; border-radius: 10px;
    background: #fff; color: #2c241d; font-size: 14px; outline: none;
  }
  .input-group input:focus, .input-group select:focus { border-color: #52796f; }
  .primary-btn {
    width: 100%; padding: 12px; background: #2c241d; color: #faf6ee;
    border: none; border-radius: 10px; font-size: 15px; font-weight: 500; cursor: pointer;
    margin-top: 8px; transition: background 0.2s;
  }
  .primary-btn:hover { background: #4a443f; }
  .guest-btn { background: #52796f; }
  .guest-btn:hover { background: #3d5a52; }
  .text-btn {
    background: none; border: none; color: #8c7a6b; font-size: 13px;
    cursor: pointer; width: 100%; margin-top: 10px; text-align: center;
  }
  .text-btn:hover { color: #2c241d; text-decoration: underline; }
  .avatar-selection { display: flex; gap: 12px; margin-bottom: 16px; }
  .avatar-option { flex: 1; cursor: pointer; }
  .avatar-option input { display: none; }
  .avatar-box {
    display: block; text-align: center; padding: 10px; border: 1px solid #e6dcc8;
    border-radius: 10px; background: #fff; font-size: 13px; color: #5c4f44; transition: all 0.2s;
  }
  .avatar-option input:checked + .avatar-box {
    border-color: #52796f; background: #f0f4f3; color: #52796f; font-weight: 500;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  const TABLE_NAME = 'slowpace_members';

  // 頁籤切換互動
  const tabs = [
    { btn: document.getElementById('tab-login-mode'), form: document.getElementById('login-form-container') },
    { btn: document.getElementById('tab-register-mode'), form: document.getElementById('register-form-container') },
    { btn: document.getElementById('tab-guest-mode'), form: document.getElementById('guest-form-container') }
  ];

  tabs.forEach(current => {
    current.btn?.addEventListener('click', () => {
      tabs.forEach(t => {
        if (t.btn) t.btn.classList.remove('active');
        if (t.form) t.form.style.display = 'none';
      });
      current.btn.classList.add('active');
      if (current.form) current.form.style.display = 'block';
    });
  });

  // 1. 會員登入
  document.getElementById('login-submit-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value.trim();
    if (!email || !password) { alert('請完整填寫 Email 與密碼'); return; }

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) { 
      alert('登入失敗：' + error.message); 
    } else { 
      window.parent.postMessage({ type: 'LOGIN_SUCCESS' }, '*'); 
    }
  });

  // 2. 會員註冊
  document.getElementById('register-submit-btn')?.addEventListener('click', async () => {
    const name = document.getElementById('register-name').value.trim();
    const email = document.getElementById('register-email').value.trim();
    const password = document.getElementById('register-password').value.trim();
    const passwordConfirm = document.getElementById('register-password-confirm').value.trim();
    const role = document.getElementById('register-role').value;
    const selectedAvatar = document.querySelector('input[name="register-avatar"]:checked');
    const avatarVal = selectedAvatar ? selectedAvatar.value : '/assets/player1.png';

    if (!name || !email || !password || !passwordConfirm) { alert('請完整填寫所有註冊欄位'); return; }
    if (password !== passwordConfirm) { alert('兩次輸入的密碼不相符'); return; }
    if (password.length < 6) { alert('密碼長度至少需要 6 個字元'); return; }

    const { data: authData, error: authError } = await supabase.auth.signUp({ email, password });
    if (authError) { 
      alert('註冊失敗：' + authError.message); 
      return; 
    }

    const userId = authData?.user?.id;
    if (userId) {
      const memberPayload = {
        user_id: userId,
        name: name,
        role: role,
        tier: '鄰里人',
        avatar: avatarVal,
        updated_at: new Date().toISOString()
      };

      const { error: dbError } = await supabase
        .from(TABLE_NAME)
        .upsert([memberPayload], { onConflict: 'user_id' });

      if (dbError) {
        console.error("❌ 寫入 slowpace_members 失敗：", dbError.message);
      }
    }

    alert('註冊成功！歡迎加入空間客舍。');
    window.parent.postMessage({ type: 'REGISTER_SUCCESS' }, '*');
  });

  // 3. 訪客快速進入（使用最標準的 upsert 與流水號計算）
  document.getElementById('guest-submit-btn')?.addEventListener('click', async () => {
    const selectedAvatar = document.querySelector('input[name="guest-avatar"]:checked');
    const avatarVal = selectedAvatar ? selectedAvatar.value : '/assets/player1.png';

    console.log("📌 [LoginModal] 開始初始化訪客身分...");

    // 計算流水號
    const { data: existingGuests, error: fetchError } = await supabase
      .from(TABLE_NAME)
      .select('name')
      .like('name', '訪客 #%');

    let nextIndex = 1;
    if (!fetchError && existingGuests && existingGuests.length > 0) {
      existingGuests.forEach(g => {
        const match = g.name?.match(/訪客 #(\d+)/);
        if (match) {
          const num = parseInt(match[1], 10);
          if (num >= nextIndex) nextIndex = num + 1;
        }
      });
    }

    const guestName = `訪客 #${nextIndex}`;
    
    // 檢查本機快取或產生新 ID
    let guestId = localStorage.getItem('space_guest_id');
    if (!guestId) {
      guestId = 'guest_' + Math.random().toString(36).substring(2, 11);
    }

    const guestData = {
      user_id: guestId,
      name: guestName,
      role: '☁️ 訪客',
      tier: '鄰里人',
      avatar: avatarVal,
      updated_at: new Date().toISOString()
    };

    console.log("📌 [LoginModal] 寫入 Payload:", guestData);

    // 標準 upsert 寫入資料庫
    const { data, error: upsertError } = await supabase
      .from(TABLE_NAME)
      .upsert([guestData], { onConflict: 'user_id' })
      .select();

    if (upsertError) {
      console.error("❌ [LoginModal] 寫入失敗：", upsertError.message);
      alert('進入空間失敗：' + upsertError.message);
      return;
    }

    console.log("✅ [LoginModal] 成功寫入 Table：", data);

    // 寫入本地端快取
    localStorage.setItem('space_guest_id', guestId);
    localStorage.setItem('space_guest_name', guestName);
    window.__TEMP_GUEST_ID = guestId;
    window.__TEMP_GUEST_NAME = guestName;

    window.parent.postMessage({
      type: 'GUEST_LOGIN_SUCCESS',
      guestId: guestId,
      name: guestName,
      avatar: avatarVal
    }, '*');
  });

  // 離開頁面時自動清理訪客紀錄
  window.addEventListener('beforeunload', () => {
    const guestId = localStorage.getItem('space_guest_id');
    if (!guestId) return;
    supabase.from(TABLE_NAME).delete().eq('user_id', guestId).then();
    localStorage.removeItem('space_guest_id');
    localStorage.removeItem('space_guest_name');
  });

  // 忘記密碼
  document.getElementById('forgot-password-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('login-email').value.trim();
    if (!email) { alert('請先在上方欄位輸入您的電子信箱 (Email)'); return; }
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/profile`,
    });
    if (error) { alert('發送重設密碼信失敗：' + error.message); } 
    else { alert('重設密碼信已發送！'); }
  });
</script>