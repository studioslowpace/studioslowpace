---
import LoginModal from '../components/LoginModal.astro'; // 請依你實際的登入元件路徑調整

const { onlineCount = 1, totalCount = 0 } = Astro.props;
---

<header class="rpg-hud" id="rpg-hud">
  <!-- 第一列：品牌與使用者控制區 -->
  <div class="hud-top-row">
    <!-- 左側：品牌標誌 -->
    <div class="hud-brand-group">
      <span class="hud-brand">☁️ 空間客舍</span>
    </div>

    <!-- 右側：使用者身分與登出按鈕 -->
    <div class="hud-right-group">
      <div class="hud-user-profile">
        <span class="user-tag" id="hud-tier-tag">🌱 鄰里人</span>
        <strong id="hud-name">加載中...</strong>
      </div>

      <!-- 登出按鈕 -->
      <button id="logout-trigger-btn" class="rpg-btn-logout">🚪 登出</button>
    </div>
  </div>

  <!-- 第二列：無框線、無背景。左：在線 | 中：調色盤 | 右：總數 -->
  <div class="phone-sub-bar-clean">
    <!-- 左側：在線人數 -->
    <div class="sub-bar-left">
      <span>🟢 在線：<strong id="online-count-trigger-home"><span id="online-users-count-home">{onlineCount}</span> 人</strong></span>
    </div>

    <!-- 中間：主題自選色盤 -->
    <div class="sub-bar-center">
      <div class="hud-theme-picker" title="自選主要區域配色">
        <span class="theme-label">🎨 主題</span>
        <input type="color" id="custom-color-picker" value="#faf6ee" />
      </div>
    </div>

    <!-- 右側：總數 -->
    <div class="sub-bar-right">
      <span>📜 總數：<strong id="total-count-trigger-home"><span id="total-users-count-home">{totalCount}</span> 人</strong></span>
    </div>
  </div>
</header>

<!-- 1. ☁️ 身分驗證 Modal (未登入時自動彈出) -->
<div id="rpg-modal" class="rpg-modal-overlay" style="display: none;">
  <div class="rpg-window embed-window" style="width: 100%; max-width: 420px; height: 520px; background: #fff; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--border-color, #e6dcc8); box-shadow: 0 16px 48px rgba(44, 36, 29, 0.15);">
    <div style="background: #0f172a; color: #38bdf8; padding: 12px 16px; font-size: 13px; font-weight: 500; display:flex; justify-content:space-between; align-items:center;">
      <span>◆ 空間客舍 · 身分認證 ◆</span>
    </div>
    <div class="embed-frame-wrapper" style="flex:1; overflow-y: auto; padding: 16px; background: var(--bg-main, #faf6ee);">
      <LoginModal />
    </div>
  </div>
</div>

<!-- 2. 🚪 文青風格登出確認彈窗 -->
<div id="logout-confirm-modal" class="rpg-modal-overlay" style="display: none;">
  <div class="rpg-logout-window">
    <div class="logout-window-header">
      <span>◆ 空間客舍 · 離席確認 ◆</span>
    </div>
    <div class="logout-window-body">
      <p class="logout-quote">「聚散終有時，此處暫歇，他日再會。」</p>
      <p class="logout-desc">您目前正在空間客舍中，請問是否要登出或切換帳號？</p>
      
      <div class="logout-actions">
        <button id="cancel-logout-btn" class="btn-secondary">留在此處</button>
        <button id="confirm-logout-btn" class="btn-primary">確認登出 / 切換</button>
      </div>
    </div>
  </div>
</div>

<style>
  .rpg-hud {
    width: 100%;
    background: var(--bg-card, rgba(255, 255, 255, 0.85));
    border-bottom: 1px solid var(--border-color, #e6dcc8);
    padding: 10px 16px 8px 16px;
    box-sizing: border-box;
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hud-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 12px;
  }

  .hud-brand {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-color, #2c241d);
    letter-spacing: 0.5px;
  }

  .hud-right-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hud-user-profile {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
  }

  .user-tag {
    font-size: 11px;
    color: var(--text-muted, #8c7a6b);
  }

  #hud-name {
    color: var(--accent-hover, #52796f);
    font-weight: 600;
  }

  .rpg-btn-logout {
    background: var(--danger-color, #e07a5f);
    color: #fff;
    border: none;
    padding: 4px 8px;
    border-radius: 8px;
    font-size: 11px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .rpg-btn-logout:hover {
    opacity: 0.9;
  }

  .phone-sub-bar-clean {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--text-muted, #8c7a6b);
    width: 100%;
    padding: 2px 4px;
  }

  .phone-sub-bar-clean strong {
    color: var(--text-color, #2c241d);
  }

  .sub-bar-left { text-align: left; flex: 1; }
  .sub-bar-center { text-align: center; flex: 1; display: flex; justify-content: center; }
  .sub-bar-right { text-align: right; flex: 1; }

  .hud-theme-picker {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    background: var(--bg-input, #f4efe6);
    padding: 2px 8px;
    border-radius: 8px;
    border: 1px solid var(--border-color, #e6dcc8);
  }

  .theme-label { font-size: 10px; font-weight: 600; }
  .hud-theme-picker input[type="color"] {
    width: 16px; height: 16px; border: none; background: transparent; cursor: pointer; padding: 0;
  }

  /* 共用 Modal 遮罩樣式 */
  .rpg-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(44, 36, 29, 0.4);
    backdrop-filter: blur(4px);
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px;
  }

  .rpg-logout-window {
    width: 100%;
    max-width: 320px;
    background: var(--bg-main, #faf6ee);
    border: 1px solid var(--border-color, #e6dcc8);
    border-radius: 16px;
    box-shadow: 0 12px 36px rgba(44, 36, 29, 0.15);
    overflow: hidden;
    animation: modalPop 0.25s ease-out;
  }

  @keyframes modalPop {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .logout-window-header {
    background: var(--bg-input, #f4efe6);
    color: var(--text-color, #2c241d);
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 600;
    border-bottom: 1px solid var(--border-color, #e6dcc8);
    text-align: center;
    letter-spacing: 1px;
  }

  .logout-window-body { padding: 20px 16px; text-align: center; }
  .logout-quote { font-size: 12px; color: var(--accent-hover, #52796f); font-style: italic; margin-bottom: 10px; line-height: 1.5; }
  .logout-desc { font-size: 12px; color: var(--text-muted, #8c7a6b); margin-bottom: 20px; line-height: 1.4; }
  .logout-actions { display: flex; gap: 10px; justify-content: center; }

  .btn-secondary {
    flex: 1; background: var(--bg-input, #f4efe6); color: var(--text-color, #2c241d);
    border: 1px solid var(--border-color, #e6dcc8); padding: 8px 12px; border-radius: 10px; font-size: 12px; cursor: pointer;
  }
  .btn-secondary:hover { background: var(--border-color, #e6dcc8); }

  .btn-primary {
    flex: 1; background: var(--danger-color, #e07a5f); color: #fff; border: none;
    padding: 8px 12px; border-radius: 10px; font-size: 12px; cursor: pointer;
  }
  .btn-primary:hover { opacity: 0.9; }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const TABLE_NAME = 'slowpace_members';

  let currentUserId = '';
  let currentUserName = '';
  let allUserRecords = [];
  let onlineUsersMap = {};
  let presenceChannel = null;

  async function initAuthHeader() {
    const { data: { session } } = await supabase.auth.getSession();

    const nameEl = document.getElementById('hud-name');
    const tierEl = document.getElementById('hud-tier-tag');
    const modal = document.getElementById('rpg-modal');

    if (session?.user) {
      currentUserId = session.user.id;
      
      const { data: member } = await supabase
        .from(TABLE_NAME)
        .select('name, tier')
        .eq('user_id', session.user.id)
        .single();

      currentUserName = member?.name || session.user.email || '旅人';

      if (nameEl) nameEl.textContent = currentUserName;
      if (tierEl && member?.tier) tierEl.textContent = member.tier;
      
      // 已登入：隱藏登入認證 Modal
      if (modal) modal.style.display = 'none';
    } else {
      currentUserName = '訪客';
      if (nameEl) nameEl.textContent = '訪客';
      
      // 未登入：自動彈出身分認證 Modal
      if (modal) modal.style.display = 'flex';
    }

    await fetchAllUserRecordsFromSupabase();
    initPresenceTracker();

    // 🚪 登出確認視窗互動邏輯
    const logoutTriggerBtn = document.getElementById('logout-trigger-btn');
    const logoutModal = document.getElementById('logout-confirm-modal');
    const cancelLogoutBtn = document.getElementById('cancel-logout-btn');
    const confirmLogoutBtn = document.getElementById('confirm-logout-btn');

    logoutTriggerBtn?.addEventListener('click', () => {
      if (logoutModal) logoutModal.style.display = 'flex';
    });

    cancelLogoutBtn?.addEventListener('click', () => {
      if (logoutModal) logoutModal.style.display = 'none';
    });

confirmLogoutBtn?.addEventListener('click', async () => {
      const { error } = await supabase.auth.signOut();
      if (!error) {
        // 1. 關閉登出確認視窗
        if (logoutModal) logoutModal.style.display = 'none';

        // 2. 清除畫面上的使用者名稱與身分，改回訪客
        const nameEl = document.getElementById('hud-name');
        const tierEl = document.getElementById('hud-tier-tag');
        if (nameEl) nameEl.textContent = '訪客';
        if (tierEl) tierEl.textContent = '🌱 鄰里人';

        // 3. 直接彈出「身分認證 Modal」，讓使用者在當前頁面登入/切換帳號！
        const loginModal = document.getElementById('rpg-modal');
        if (loginModal) loginModal.style.display = 'flex';
        
        // 選擇性：如果希望完全重置當前頁面的狀態，也可以用 window.location.reload() 重新整理
        // window.location.reload();
      } else {
        console.error('登出失敗:', error.message);
      }
    });

  async function fetchAllUserRecordsFromSupabase() {
    try {
      const { data, error, count } = await supabase.from(TABLE_NAME).select('*', { count: 'exact' });
      if (error) throw error;
      allUserRecords = data || [];
      const totalCount = count !== null ? count : allUserRecords.length;

      const setTotal = (id) => {
        const el = document.getElementById(id);
        if (el) el.textContent = totalCount;
      };

      setTotal('total-users-count-home');
      setTotal('total-users-count-chat');
      setTotal('total-users-count-dm');
    } catch (err) { 
      console.error("讀取用戶紀錄失敗:", err.message); 
    }
  }

  function initPresenceTracker() {
    const trackName = currentUserName || '訪客';

    if (presenceChannel) supabase.removeChannel(presenceChannel);

    presenceChannel = supabase.channel('community-online-room', {
      config: { presence: { key: currentUserId || trackName } }
    });

    presenceChannel
      .on('presence', { event: 'sync' }, () => {
        const state = presenceChannel.presenceState();
        onlineUsersMap = {};
        Object.keys(state).forEach(key => {
          onlineUsersMap[key] = true;
        });
        const onlineCount = Object.keys(state).length || 1;
        
        const setOnline = (id) => {
          const el = document.getElementById(id);
          if (el) el.textContent = onlineCount;
        };

        setOnline('online-users-count-home');
        setOnline('online-users-count-chat');
        setOnline('online-users-count-dm');
      })
      .subscribe(async (status) => {
        if (status === 'SUBSCRIBED') {
          await presenceChannel.track({ name: trackName, online_at: new Date().toISOString() });
        }
      });
  }

  initAuthHeader();
</script>