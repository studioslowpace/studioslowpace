---
const { title = "預設標題" } = Astro.props;
import Footer from '../components/phonefooter.astro';
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <!-- 全站外層視窗 -->
    <div class="app-viewport">
      <div class="rpg-container">
        
        <!-- 頁面內容 -->
        <main style="flex: 1; overflow-y: auto; padding: 16px;">
          <slot />
        </main>

        <!-- 底部共用導覽列 -->
        <div style="padding: 0 16px 16px 16px;">
          <Footer />
        </div>

      </div>
    </div>
  </body>
</html>

<!-- 使用 is:global 讓這些樣式直接變成全域生效 -->
<style is:global>
  :root {
    --bg-main: #faf6ee;
    --bg-card: rgba(255, 255, 255, 0.9);
    --bg-input: #f4efe6;
    --border-color: #e6dcc8;
    --text-color: #2c241d;
    --accent-hover: #52796f;
    --text-muted: #8c7a6b;
    --danger-color: #e07a5f;
    --success-color: #81b29a;
  }

  * { 
    -webkit-tap-highlight-color: transparent; 
    -webkit-touch-callout: none; 
    box-sizing: border-box; 
  }

  html, body {
    background-color: var(--bg-main);
    color: var(--text-color);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
    margin: 0; 
    padding: 0; 
    width: 100vw; 
    height: 100vh; 
    height: 100dvh; 
    overflow: hidden; 
    touch-action: manipulation;
  }

  .app-viewport { 
    width: 100vw; 
    height: 100vh; 
    height: 100dvh; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    background: var(--bg-main); 
    transition: background 0.5s ease; 
  }
  
  .rpg-container {
    width: 100vw; 
    max-width: 430px; 
    height: 96vh; 
    height: 96dvh; 
    max-height: 860px;
    display: flex; 
    flex-direction: column; 
    justify-content: space-between; 
    overflow: hidden;
    background-color: var(--bg-main); 
    border: 1px solid var(--border-color); 
    border-radius: 28px;
    box-shadow: 0 16px 48px rgba(44, 36, 29, 0.08); 
    transition: background-color 0.5s ease, filter 0.4s ease;
  }
</style>

<!-- 讓這段 JS 在客戶端（瀏覽器）執行 -->
<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
  const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
  const client = createClient(supabaseUrl, supabaseKey);

  // 統一的權限檢查
  async function checkLayoutAdminStatus(user) {
    if (!user) return false;
    const { data: profile, error } = await client
        .from('slowpace_members')
        .select('is_admin')
        .eq('id', user.id)
        .maybeSingle();
    return !error && profile?.is_admin === true;
  }

  // 初始化 Layout 的管理員狀態
  async function initLayoutAuth() {
    try {
      const { data: { session } } = await client.auth.getSession();
      const isAdmin = await checkLayoutAdminStatus(session?.user);
      
      // 依據 isAdmin 控制 Layout 中的按鈕（例如 header 裡的管理者連結）
      const adminLink = document.getElementById('admin-link');
      if (adminLink) {
        adminLink.style.display = isAdmin ? 'inline-block' : 'none';
      }
    } catch (err) {
      console.error("Layout 權限檢查失敗:", err);
    }

    // 實時監聽
    client.auth.onAuthStateChange(async (event, session) => {
      const isAdmin = await checkLayoutAdminStatus(session?.user);
      const adminLink = document.getElementById('admin-link');
      if (adminLink) {
        adminLink.style.display = isAdmin ? 'inline-block' : 'none';
      }
    });
  }

  initLayoutAuth();
</script>