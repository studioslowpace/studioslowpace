---
const { title = "預設標題" } = Astro.props;
import Footer from '../components/phonefooter.astro';
import Header from '../components/phoneheader.astro';
import { supabase } from '../lib/supabase'; // 統一從共用 lib 引入

const TABLE_NAME = 'slowpace_members';
---

<!doctype html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
<body>
    <!-- 外層 viewport：支援響應式置中，無上下邊界空隙 -->
    <div class="app-viewport">
      <div class="rpg-container">
        <!-- 頂部 Header：無空隙緊貼頂部 -->
        <Header />

        <!-- 中間內容區：只有這塊會滾動；手機隱藏捲軸，電腦顯示捲軸 -->
        <main class="app-main">
          <slot />
        </main>

        <!-- 底部 Footer：無空隙緊貼底部 -->
        <div class="app-footer-wrapper">
          <Footer />
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #faf6ee;
    --bg-card: rgba(255, 255, 255, 0.9);
    --bg-input: #f4efe6;
    --border-color: #e6dcc8;
    --text-color: #2c241d;
    --accent-hover: #52796f;
    --text-muted: #8c7a6b;
    --danger-color: #e07a5f;
    --success-color: #81b29a;
  }

  * { 
    -webkit-tap-highlight-color: transparent; 
    -webkit-touch-callout: none; 
    box-sizing: border-box; 
  }

  /* 鎖死外層視窗高度，確保上下無滾動空隙 */
  html, body {
    background-color: var(--bg-main);
    color: var(--text-color);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
    margin: 0; 
    padding: 0; 
    width: 100%;
    height: 100vh; 
    height: 100dvh; 
    overflow: hidden;
  }

  /* 外層視窗：滿版高度，上下無空隙 */
  .app-viewport { 
    width: 100%; 
    height: 100vh; 
    height: 100dvh; 
    display: flex; 
    justify-content: center; 
    align-items: stretch; 
    background: var(--bg-main); 
    overflow: hidden;
    padding: 0; /* 清除內距，讓 Header/Footer 緊貼上下邊界 */
  }
  
  /* 核心容器：無外框線、無陰影、無圓角 */
  .rpg-container {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex; 
    flex-direction: column; 
    justify-content: space-between; 
    background-color: var(--bg-main); 
    border: none; /* 取消包著 Header 和 Footer 的框線 */
    border-radius: 0; /* 取消圓角 */
    box-shadow: none; /* 取消陰影 */
    overflow: hidden;
  }

  /* 中間內容區：內部滾動，手機版預設隱藏捲軸 */
  .app-main {
    flex: 1; 
    display: flex;
    flex-direction: column;
    overflow-y: auto; 
    overflow-x: hidden;
    padding: 0px;
    min-height: 0;
    width: 100%;

    /* 手機版隱藏捲軸 */
    scrollbar-width: none;
  }

  .app-main::-webkit-scrollbar {
    display: none;
  }

  /* 電腦與平板視窗：自適應寬度、無上下空隙與框線，並顯示可見捲軸 */
  @media (min-width: 768px) {
    .app-viewport {
      padding: 0; /* 確保上下完全無空隙 */
    }

    .rpg-container {
      width: 100%;
      max-width: 1120px; /* 電腦版寬度上限，可依需求調整 */
      height: 100vh;
      height: 100dvh;
      border: none;
      border-radius: 0;
      box-shadow: none;
    }

    /* 電腦視窗恢復並美化捲軸 (移動 Bar) */
    .app-main {
      scrollbar-width: thin;
      scrollbar-color: var(--border-color) transparent;
    }

    .app-main::-webkit-scrollbar {
      width: 8px;
      display: block;
    }

    .app-main::-webkit-scrollbar-track {
      background: transparent;
    }

    .app-main::-webkit-scrollbar-thumb {
      background-color: var(--border-color);
      border-radius: 4px;
    }

    .app-main::-webkit-scrollbar-thumb:hover {
      background-color: var(--text-muted);
    }
  }

  /* 底部導覽列：緊貼底部 */
  .app-footer-wrapper {
    flex-shrink: 0;
    padding: 0px;
    width: 100%;
  }
</style>

<!-- 讓這段 JS 在客戶端（瀏覽器）執行 -->
<script>
  import { supabase } from '../lib/supabase'; // 客戶端也統一引入

  // 統一的權限檢查（使用正確的 user_id 欄位）
  async function checkLayoutAdminStatus(user) {
    if (!user) return false;
    const { data: profile, error } = await supabase
        .from('slowpace_members')
        .select('is_admin')
        .eq('user_id', user.id)
        .maybeSingle();
    return !error && profile?.is_admin === true;
  }

  // 初始化 Layout 的管理員狀態
  async function initLayoutAuth() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const isAdmin = await checkLayoutAdminStatus(session?.user);
      
      const adminLink = document.getElementById('admin-link');
      if (adminLink) {
        adminLink.style.display = isAdmin ? 'inline-block' : 'none';
      }
    } catch (err) {
      console.error("Layout 權限檢查失敗:", err);
    }

    // 實時監聽
    supabase.auth.onAuthStateChange(async (event, session) => {
      const isAdmin = await checkLayoutAdminStatus(session?.user);
      const adminLink = document.getElementById('admin-link');
      if (adminLink) {
        adminLink.style.display = isAdmin ? 'inline-block' : 'none';
      }
    });
  }

  // 顯示登入彈窗
  function showLoginModal() {
    const modal = document.getElementById('rpg-modal');
    if (modal) modal.style.display = 'flex';
  }

  // 隱藏登入彈窗
  function hideLoginModal() {
    const modal = document.getElementById('rpg-modal');
    if (modal) modal.style.display = 'none';
  }

  initLayoutAuth();
</script>