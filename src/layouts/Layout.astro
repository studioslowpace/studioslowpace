---
const { title = "預設標題" } = Astro.props;
import Footer from '../components/phonefooter.astro';
import Header from '../components/phoneheader.astro';
import { supabase } from '../lib/supabase';

const TABLE_NAME = 'slowpace_members';

// 1. 在 Layout 頂端統一向 Supabase 查詢會員資料
// (如果是用 Supabase Auth 登入，通常會先取得 user，再對應到 slowpace_members 表)
let username = '旅人';
let tier = '🌱 鄰里人';

try {
  // 這裡假設你有辦法抓到目前的會員資料 (例如用 Cookie 或 Session)
  // 範例先以簡單撈取第一筆或示範為主，可依你的驗證邏輯調整
  const { data: memberData } = await supabase
    .from(TABLE_NAME)
    .select('*')
    .limit(1)
    .single();

  if (memberData) {
    username = memberData.name || '旅人';
    tier = memberData.tier || '🌱 鄰里人';
  }
} catch (e) {
  // 未登入或尚未建立資料時的預設防護
}
---

<!doctype html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
<body>
    <!-- 確保外層 viewport 絕對置中，且禁止全頁滾動 -->
    <div class="app-viewport">
      <div class="rpg-container">
        <Header />
        <!-- 內容區：如果內部有超出的內容，讓它在內部滾動而不撐開外框 -->
        <main class="app-main">
          <slot />
        </main>

        <!-- 底部共用導覽列 -->
        <div class="app-footer-wrapper">
          <Footer />
        </div>
      </div>

    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #faf6ee;
    --bg-card: rgba(255, 255, 255, 0.9);
    --bg-input: #f4efe6;
    --border-color: #e6dcc8;
    --text-color: #2c241d;
    --accent-hover: #52796f;
    --text-muted: #8c7a6b;
    --danger-color: #e07a5f;
    --success-color: #81b29a;
  }

  * { 
    -webkit-tap-highlight-color: transparent; 
    -webkit-touch-callout: none; 
    box-sizing: border-box; 
  }

  /* 鎖死全頁，絕對不允許出現視窗捲軸 */
  html, body {
    background-color: var(--bg-main);
    color: var(--text-color);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
    margin: 0; 
    padding: 0; 
    width: 100vw; 
    height: 100vh; 
    height: 100dvh; 
    overflow: hidden; 
  }

  /* 外層視窗：強迫置中所有內容 */
  .app-viewport { 
    width: 100vw; 
    height: 100vh; 
    height: 100dvh; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    background: var(--bg-main); 
    overflow: hidden;
  }
  
  /* 核心容器：限制最大寬度為 430px，並強制隱藏所有超出範圍的捲軸 */
  .rpg-container {
    width: 100%;
    max-width: 430px; 
    height: 100vh;
    height: 100dvh;
    max-height: 880px;
    display: flex; 
    flex-direction: column; 
    justify-content: space-between; 
    background-color: var(--bg-main); 
    border: 1px solid var(--border-color); 
    border-radius: 0;
    box-shadow: 0 16px 48px rgba(44, 36, 29, 0.08); 
    overflow: hidden; /* 關鍵：切掉任何跑出卡片外面的東西，防止出現捲軸 */
  }

  /* 在桌機版時顯示漂亮的圓角卡片外框 */
  @media (min-width: 480px) {
    .rpg-container {
      border-radius: 28px;
      height: 96vh;
      height: 96dvh;
    }
  }

  /* 主內容區：允許內部滾動，但隱藏醜陋的捲軸 */
  .app-main {
    flex: 1; 
    display: flex;
    overflow-y: auto; 
    overflow-x: auto;
    padding: 0px;
    min-height: 0;
    width: 100%;
  }

  /* 隱藏主流瀏覽器的捲軸 (Chrome, Safari, Edge) */
  .app-main::-webkit-scrollbar {
    display: none;
  }
  /* 隱藏 Firefox 捲軸 */
  .app-main {
    scrollbar-width: none; 
  }

  .app-footer-wrapper {
    padding: 0px;
    width: 100%;
  }
</style>

<!-- 讓這段 JS 在客戶端（瀏覽器）執行 -->
<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
  const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
  const client = createClient(supabaseUrl, supabaseKey);

  

  // 統一的權限檢查
  async function checkLayoutAdminStatus(user) {
    if (!user) return false;
    const { data: profile, error } = await client
        .from('slowpace_members')
        .select('is_admin')
        .eq('id', user.id)
        .maybeSingle();
    return !error && profile?.is_admin === true;
  }

  // 初始化 Layout 的管理員狀態
  async function initLayoutAuth() {
    try {
      const { data: { session } } = await client.auth.getSession();
      const isAdmin = await checkLayoutAdminStatus(session?.user);
      
      // 依據 isAdmin 控制 Layout 中的按鈕（例如 header 裡的管理者連結）
      const adminLink = document.getElementById('admin-link');
      if (adminLink) {
        adminLink.style.display = isAdmin ? 'inline-block' : 'none';
      }
    } catch (err) {
      console.error("Layout 權限檢查失敗:", err);
    }

    // 實時監聽
    client.auth.onAuthStateChange(async (event, session) => {
      const isAdmin = await checkLayoutAdminStatus(session?.user);
      const adminLink = document.getElementById('admin-link');
      if (adminLink) {
        adminLink.style.display = isAdmin ? 'inline-block' : 'none';
      }
    });
  }

  // 顯示登入彈窗
function showLoginModal() {
  const modal = document.getElementById('rpg-modal');
  if (modal) modal.style.display = 'flex'; // 讓它置中顯示
}

// 隱關閉登入彈窗
function hideLoginModal() {
  const modal = document.getElementById('rpg-modal');
  if (modal) modal.style.display = 'none';
}

  initLayoutAuth();
</script>