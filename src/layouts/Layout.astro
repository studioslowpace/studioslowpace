---
const { title = "空間客舍 · Slow Pace Studio" } = Astro.props;
import Header from '../components/phoneheader.astro';
import LoginModal from '../components/LoginModal.astro';
import Footer from '../components/phonefooter.astro';
---

<!doctype html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
</head>
<body>
    <div class="app-viewport">
      <div class="rpg-container">
        <!-- 頂端控制列 (包含登出、狀態與各種 Modal 觸發) -->
        <Header />

        <!-- 內容區 -->
        <main class="app-main">
          <slot />
        </main>

        <!-- 底部共用導覽列 -->
        <div class="app-footer-wrapper">
          <Footer />
        </div>
      </div>
    </div>

    <!-- 全域常駐的身分認證 Modal (未登入時由 Header 自動控制顯示) -->
    <LoginModal />
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #faf6ee;
    --bg-card: rgba(255, 255, 255, 0.9);
    --bg-input: #f4efe6;
    --border-color: #e6dcc8;
    --text-color: #2c241d;
    --accent-hover: #52796f;
    --text-muted: #8c7a6b;
    --danger-color: #e07a5f;
    --success-color: #81b29a;
  }

  * { 
    -webkit-tap-highlight-color: transparent; 
    -webkit-touch-callout: none; 
    box-sizing: border-box; 
  }

  html, body {
    background-color: var(--bg-main);
    color: var(--text-color);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
    margin: 0; 
    padding: 0; 
    width: 100vw; 
    height: 100vh; 
    height: 100dvh; 
    overflow: hidden; 
  }

  .app-viewport { 
    width: 100vw; 
    height: 100vh; 
    height: 100dvh; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    background: var(--bg-main); 
    overflow: hidden;
  }
  
  .rpg-container {
    width: 100%;
    max-width: 430px; 
    height: 100vh;
    height: 100dvh;
    max-height: 880px;
    display: flex; 
    flex-direction: column; 
    justify-content: space-between; 
    background-color: var(--bg-main); 
    border: 1px solid var(--border-color); 
    border-radius: 0;
    box-shadow: 0 16px 48px rgba(44, 36, 29, 0.08); 
    overflow: hidden;
  }

  @media (min-width: 480px) {
    .rpg-container {
      border-radius: 28px;
      height: 96vh;
      height: 96dvh;
    }
  }

  .app-main {
    flex: 1; 
    display: flex;
    overflow-y: auto; 
    overflow-x: auto;
    padding: 0px;
    min-height: 0;
    width: 100%;
  }

  .app-main::-webkit-scrollbar {
    display: none;
  }
  .app-main {
    scrollbar-width: none; 
  }

  .app-footer-wrapper {
    padding: 0px;
    width: 100%;
  }
</style>