---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="購物車 - 商店主頁">
  <div class="shop-container">
    <nav class="breadcrumb">
      <a href="/">全部商品</a> <span class="sep">/</span> <span>購物車</span>
    </nav>

    <!-- 購物車卡片容器 -->
    <div class="cart-card-box">
      <div class="cart-card-header">
        <span id="cart-header-title">購物車 (0 件)</span>
      </div>

      <!-- 商品表格 -->
      <div class="cart-table-wrapper">
        <table class="cart-table">
          <thead>
            <tr>
              <th class="th-product">商品資料</th>
              <th class="th-price">商品單價</th>
              <th class="th-qty">數量</th>
              <th class="th-subtotal">商品小計</th>
              <th class="th-action"></th>
            </tr>
          </thead>
          <tbody id="cart-tbody">
            <!-- JS 動態填入商品列 -->
          </tbody>
        </table>
      </div>

      <!-- 空購物車提示 -->
      <div id="cart-empty" class="cart-empty" style="display: none;">
        <p>目前購物車是空的</p>
        <a href="/" class="btn btn-shop-now">去選購商品</a>
      </div>

      <!-- 結帳總結區塊 (靠右設計) -->
      <div id="cart-summary" class="cart-summary-section" style="display: none;">
        <div class="summary-content">
          <div class="summary-row">
            <span class="summary-label">總計金額</span>
            <span id="cart-total-price" class="total-price">HK$0.00</span>
          </div>
          <div class="summary-actions">
            <a href="/checkout" class="btn btn-checkout">前往結帳</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  interface CartItem {
    id: string;
    title: string;
    price: number;
    currency: string;
    image: string;
    quantity: number;
  }

  function renderCart() {
    const tbody = document.getElementById('cart-tbody');
    const summary = document.getElementById('cart-summary');
    const emptyView = document.getElementById('cart-empty');
    const totalPriceEl = document.getElementById('cart-total-price');
    const headerTitleEl = document.getElementById('cart-header-title');

    const cart: CartItem[] = JSON.parse(localStorage.getItem('cart') || '[]');

    if (!tbody || !summary || !emptyView || !totalPriceEl || !headerTitleEl) return;

    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    headerTitleEl.innerText = `購物車 (${totalItems} 件)`;

    if (cart.length === 0) {
      tbody.innerHTML = '';
      summary.style.display = 'none';
      emptyView.style.display = 'block';
      return;
    }

    emptyView.style.display = 'none';
    summary.style.display = 'block';

    let html = '';
    let total = 0;

    cart.forEach((item, index) => {
      const itemTotal = item.price * item.quantity;
      total += itemTotal;
      html += `
        <tr>
          <td class="td-product">
            <div class="product-info-cell">
              <div class="cart-item-img">
                <img src="${item.image || 'https://via.placeholder.com/150'}" alt="${item.title}" />
              </div>
              <span class="cart-item-title">${item.title}</span>
            </div>
          </td>
          <td class="td-price">${item.currency || 'HK$'}${item.price.toFixed(2)}</td>
          <td class="td-qty">
            <div class="quantity-picker">
              <button type="button" class="qty-btn minus-btn" data-index="${index}">-</button>
              <input type="text" value="${item.quantity}" readonly />
              <button type="button" class="qty-btn plus-btn" data-index="${index}">+</button>
            </div>
          </td>
          <td class="td-subtotal">${item.currency || 'HK$'}${itemTotal.toFixed(2)}</td>
          <td class="td-action">
            <button class="remove-btn" data-index="${index}" title="移除商品">
              刪除
            </button>
          </td>
        </tr>
      `;
    });

    tbody.innerHTML = html;
    totalPriceEl.innerText = `HK$${total.toFixed(2)}`;

    document.querySelectorAll('.minus-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        if (cart[idx].quantity > 1) {
          cart[idx].quantity -= 1;
        } else {
          cart.splice(idx, 1);
        }
        localStorage.setItem('cart', JSON.stringify(cart));
        renderCart();
      });
    });

    document.querySelectorAll('.plus-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        cart[idx].quantity += 1;
        localStorage.setItem('cart', JSON.stringify(cart));
        renderCart();
      });
    });

    document.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        cart.splice(idx, 1);
        localStorage.setItem('cart', JSON.stringify(cart));
        renderCart();
      });
    });
  }

  renderCart();
</script>

<style>
  .shop-container { max-width: 1080px; margin: 0 auto; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #333; }
  .breadcrumb { padding: 10px 0; font-size: 14px; color: #666; border-bottom: 1px solid #eee; margin-bottom: 30px; }
  .breadcrumb a { color: #666; text-decoration: none; }
  .breadcrumb a:hover { color: #c99e58; }
  .breadcrumb .sep { margin: 0 8px; color: #ccc; }

  /* 卡片外框 */
  .cart-card-box { background: #fff; border: 1px solid #eaeaea; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.02); overflow: hidden; margin-bottom: 40px; }
  .cart-card-header { padding: 16px 24px; font-size: 14px; font-weight: 400; border-bottom: 1px solid #eaeaea; color: #444; background: #fcfcfc; letter-spacing: 0.5px; }

  /* 表格樣式 */
  .cart-table-wrapper { width: 100%; overflow-x: auto; }
  .cart-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; }
  .cart-table th { background: #fff; color: #888; font-weight: 400; padding: 14px 24px; border-bottom: 1px solid #eaeaea; font-size: 12px; letter-spacing: 0.5px; }
  .cart-table td { padding: 16px 24px; border-bottom: 1px solid #f2f2f2; vertical-align: middle; }

  .th-product, .td-product { width: 44%; }
  .th-price, .td-price { width: 18%; color: #444; }
  .th-qty, .td-qty { width: 18%; }
  .th-subtotal, .td-subtotal { width: 15%; font-weight: 500; color: #222; }
  .th-action, .td-action { width: 5%; text-align: center; }

  /* 商品圖縮小與標題排版 */
  .product-info-cell { display: flex; align-items: center; gap: 16px; }
  .cart-item-img { width: 45px; height: 60px; background: #f7f7f7; border: 1px solid #eee; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cart-item-img img { max-width: 90%; max-height: 90%; object-fit: contain; }
  .cart-item-title { font-size: 13px; color: #333; line-height: 1.5; font-weight: 400; }

  /* 文青風數量選擇器 */
  .quantity-picker { display: flex; width: 96px; border: 1px solid #e0e0e0; border-radius: 2px; background: #fff; }
  .qty-btn { width: 28px; height: 28px; background: #fafafa; border: none; font-size: 13px; cursor: pointer; color: #666; transition: background 0.2s; }
  .qty-btn:hover { background: #f0f0f0; color: #333; }
  .quantity-picker input { width: 40px; border: none; text-align: center; font-size: 12px; border-left: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; outline: none; background: #fff; color: #333; }

  /* 文青風刪除按鈕 */
  .remove-btn { background: none; border: none; color: #999; cursor: pointer; font-size: 12px; padding: 4px 6px; transition: color 0.2s; }
  .remove-btn:hover { color: #c96b58; }

  /* 總結區塊靠右 */
  .cart-summary-section { padding: 25px 30px; border-top: 1px solid #eaeaea; background: #fcfcfc; display: flex; justify-content: flex-end; }
  .summary-content { display: flex; flex-direction: column; align-items: flex-end; gap: 15px; min-width: 260px; }
  .summary-row { display: flex; justify-content: space-between; width: 100%; font-size: 14px; align-items: center; }
  .summary-label { color: #666; font-weight: 300; }
  .total-price { font-size: 18px; font-weight: 500; color: #111; letter-spacing: 0.5px; }
  
  .btn { padding: 11px 30px; border: none; font-size: 13px; cursor: pointer; text-decoration: none; text-align: center; border-radius: 2px; transition: opacity 0.2s; display: inline-block; letter-spacing: 0.5px; }
  .btn-checkout { background-color: #c99e58; color: #fff; width: 100%; font-weight: 400; }
  .btn-checkout:hover { opacity: 0.9; }

  .cart-empty { text-align: center; padding: 60px 0; color: #666; font-size: 13px; }
  .btn-shop-now { background-color: #333; color: #fff; margin-top: 15px; }
</style>