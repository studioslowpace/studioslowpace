---
// ==========================================
// Astro Frontmatter 區塊 (伺服器端或靜態載入)
// ==========================================
// 若有需要預載的資料可以在此處理
---

<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, interactive-widget=resizes-content">
    <title>客舍萬事屋 | 鄰里人交流區</title>
    
    <!-- Supabase JS SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        /* ==========================================
           0. 全域重置與基礎樣式 (文青自然風)
           ========================================== */
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        
        html, body { 
            height: 100%; 
            background-color: #f3f6f9; 
            color: #334155; 
            overflow: hidden; 
        }
        .hidden { display: none !important; }

        .btn-blue { 
            background-color: #2563eb; 
            color: #ffffff; 
            border: none; 
            cursor: pointer; 
            font-weight: 600; 
            border-radius: 0.75rem; 
            transition: background 0.2s;
        }
        .btn-blue:hover { background-color: #1d4ed8; }

        /* ==========================================
           1. 📱 手機 App 容器 (自動適應 100dvh)
           ========================================== */
        .phone-app-wrapper {
            width: 100%;
            max-width: 420px;
            height: 100vh;
            height: 100dvh;
            margin: 0 auto;
            background: #fafcfd;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: fixed;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }
        @media (min-width: 421px) {
            body { padding: 1rem 0; }
            .phone-app-wrapper {
                position: relative;
                height: calc(100vh - 2rem);
                height: calc(100dvh - 2rem);
                border: 1px solid #cbd5e1;
                border-radius: 1.5rem;
            }
        }

        /* ==========================================
           2. 頂部導航與標題列
           ========================================== */
        .admin-nav { background-color: #0f172a; color: #ffffff; padding: 0.75rem 1rem; border-bottom: 2px solid #2563eb; flex-shrink: 0; }
        
        .phone-title-bar {
            flex-shrink: 0;
            background: #e2e8f0;
            border-bottom: 1px solid #cbd5e1;
            padding: 0.6rem 0.85rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 10;
        }
        .main-title-box {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            color: #1e293b;
            font-weight: 800;
            font-size: 0.9rem;
        }
        .logo-btn {
            font-size: 1.2rem;
            cursor: pointer;
            transition: transform 0.2s;
            user-select: none;
        }
        .logo-btn:hover { transform: scale(1.15); }
        .banner-logo-img { width: 15px; height: 15px; object-fit: cover; }

        .nav-link-btn {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 0.6rem;
            padding: 0.25rem 0.55rem;
            font-size: 0.725rem;
            font-weight: 600;
            color: #475569;
            cursor: pointer;
            text-decoration: none;
        }

        .phone-header {
            flex-shrink: 0;
            background: #f1f5f9;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.55rem 0.85rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            user-select: none;
            z-index: 10;
        }
        .phone-header-title {
            font-size: 0.85rem;
            font-weight: 800;
            color: #1e293b;
            cursor: pointer;
            padding: 0.2rem 0.5rem;
            border-radius: 0.5rem;
            transition: background 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1px;
        }
        .phone-header-title:hover { background: #e2e8f0; }

        .identity-badge {
            font-size: 0.725rem;
            font-weight: 600;
            color: #2563eb;
            background: #ffffff;
            border: 1px solid #bfdbfe;
            padding: 0.2rem 0.55rem;
            border-radius: 9999px;
            cursor: pointer;
        }
        .identity-badge:hover { background: #eff6ff; }

        /* ==========================================
           3. 數據統計與資訊卡片
           ========================================== */
        .phone-sub-bar {
            flex-shrink: 0;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.4rem 0.75rem;
            font-size: 0.725rem;
            color: #64748b;
            display: flex;
            justify-content: space-around;
            text-align: center;
        }
        .phone-sub-bar strong { color: #2563eb; }

        .info-card-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }
        .info-trigger-btn {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            padding: 0.6rem;
            border-radius: 0.75rem;
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
        }
        .info-trigger-btn:hover { background: #f1f5f9; border-color: #cbd5e1; }
        .info-trigger-btn h5 { font-size: 0.8rem; font-weight: 800; color: #1e293b; }
        .info-trigger-btn span { font-size: 0.65rem; color: #64748b; }

        /* ==========================================
           4. 對話訊息捲動區
           ========================================== */
        .phone-chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            background-color: #f8fafc;
            background-image: radial-gradient(#e2e8f0 0.8px, transparent 0.8px);
            background-size: 10px 10px;
            overscroll-behavior: contain;
        }

        .msg-bubble {
            max-width: 78%;
            padding: 0.5rem 0.75rem 0.35rem 0.75rem;
            border-radius: 0.75rem;
            font-size: 0.85rem;
            line-height: 1.45;
            box-shadow: 0 1px 2px rgba(0,0,0,0.03);
            word-break: break-word;
        }
        .msg-row-other { display: flex; justify-content: flex-start; }
        .msg-bubble-other { background-color: #ffffff; color: #1e293b; border: 1px solid #e2e8f0; border-top-left-radius: 0.1rem; }

        .msg-row-self { display: flex; justify-content: flex-end; }
        .msg-bubble-self { background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; border-top-right-radius: 0.1rem; }

        .msg-sender-name { font-size: 0.7rem; font-weight: 700; color: #2563eb; margin-bottom: 0.15rem; display: block; }
        .msg-time-stamp { font-size: 0.6rem; color: #94a3b8; float: right; margin-left: 0.5rem; margin-top: 0.2rem; }

        /* ==========================================
           5. 底部打字輸入列
           ========================================== */
        .phone-input-bar {
            flex-shrink: 0;
            padding: 0.6rem 0.75rem;
            background: #f1f5f9;
            border-top: 1px solid #e2e8f0;
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }
        .phone-input-field {
            flex: 1;
            padding: 0.6rem 0.85rem;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 1.25rem;
            font-size: 0.875rem;
            outline: none;
        }
        .phone-input-field:focus { border-color: #2563eb; }
        .phone-send-btn {
            background-color: #2563eb;
            color: #ffffff;
            border: none;
            border-radius: 1.25rem;
            padding: 0.6rem 1.1rem;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background 0.2s;
        }
        .phone-send-btn:hover { background-color: #1d4ed8; }

        .topic-select-card {
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            border-radius: 0.85rem;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
            cursor: pointer;
            transition: 0.2s;
        }
        .topic-select-card:hover { border-color: #2563eb; background: #fafcfd; }
        .input-field { width: 100%; padding: 0.625rem; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 0.75rem; font-size: 0.875rem; outline: none; }
        .input-field:focus { border-color: #2563eb; }

        /* ==========================================
           6. 登入 / 訪客 Modal 樣式
           ========================================== */
        .rpg-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.75);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 1rem;
        }
        .rpg-window {
            background: #fafcfd;
            border: 2px solid #cbd5e1;
            border-radius: 1rem;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            width: 100%;
        }
        .rpg-title-bar {
            background: #0f172a;
            color: #ffffff;
            padding: 0.75rem 1rem;
            font-size: 0.85rem;
            font-weight: 800;
        }
        .embed-frame-wrapper {
            display: flex;
            flex-direction: column;
            background: #ffffff;
        }
        .embed-iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>

    <!-- 1. 登入 / 訪客 Modal (內嵌 /login 頁面) -->
    <div id="rpg-modal" class="rpg-modal-overlay">
      <div class="rpg-window embed-window" style="max-width: 420px; height: 520px;">
        <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
          <span>◆ 空間客舍 · 身分認證 ◆</span>
        </div>
        <div class="embed-frame-wrapper" style="flex:1;">
          <iframe id="auth-iframe" src="/login" class="embed-iframe"></iframe>
        </div>
      </div>
    </div>

    <!-- 🏮 頂部管理選單 (點擊 Logo 展開) -->
    <div id="admin-navbar" class="hidden admin-nav">
        <div style="max-width: 420px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; gap: 0.35rem; color: #60a5fa; align-items: center; font-size: 0.8rem;">
                <strong>主理人模式</strong>
            </div>
            <div id="admin-logged-out" style="display: flex; gap: 6px;">
                <input type="password" id="admin-password-input" placeholder="密碼" class="input-field" style="padding: 2px 6px; width: 80px; font-size: 0.75rem;">
                <button id="admin-login-btn" class="btn-blue" style="padding: 2px 8px; font-size: 0.75rem;">登入</button>
            </div>
            <div id="admin-logged-in" class="hidden" style="display: flex; gap: 6px; align-items: center;">
                <span style="color: #4ade80; font-size: 0.75rem;">🟢 已登入</span>
                <button id="admin-logout-btn" style="background:#64748b; color:white; border:none; padding:2px 6px; border-radius:4px; cursor:pointer; font-size:0.75rem;">登出</button>
            </div>
        </div>
    </div>

    <!-- 📱 手機應用主容器 -->
    <main class="phone-app-wrapper">
        
        <!-- 頂部標題列 -->
        <div class="phone-title-bar">
            <div class="main-title-box">
                <span id="logo-toggle-btn" class="logo-btn" title="點擊切換主理人模式">
                    <img src="/images/logo-small2.png" alt="Logo" class="banner-logo-img" oncontextmenu="return false;" ondragstart="return false;" />
                </span>
                <span>鄰里人交流區</span>
            </div>
            <button id="external-link-btn" class="nav-link-btn">客舍萬事屋 ↗</button>
        </div>

        <!-- 🔓 交流區主視窗 -->
        <div id="chat-unlocked-box" style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">

            <!-- 🏠 PAGE 1: 交流區首頁 -->
            <div id="page-home" style="flex: 1; display: flex; flex-direction: column; overflow-y: auto; padding: 0.85rem;">
                
                <!-- 數據統計欄 -->
                <div class="phone-sub-bar" style="border-radius: 0.75rem; margin-bottom: 0.75rem; border: 1px solid #e2e8f0;">
                    <span>🟢 在線：<strong id="online-users-count-home">1</strong> 人</span>
                    <span>|</span>
                    <span>📜 鄰里人總數：<strong id="total-users-count-home">0</strong> 人</span>
                </div>

                <!-- 📖 資訊按鈕卡片 (源由 / 守則) -->
                <div class="info-card-grid">
                    <div class="info-trigger-btn" data-modal="modal-origin">
                        <h5>🌱 社群源由</h5>
                        <span>點擊查看詳情</span>
                    </div>
                    <div class="info-trigger-btn" data-modal="modal-rules">
                        <h5>📜 交流區守則</h5>
                        <span>點擊查看公約</span>
                    </div>
                </div>

                <!-- 👤 身分切換列 -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; padding: 0 0.1rem;">
                    <span style="font-size: 0.8rem; font-weight: 800; color: #334155;">📌 請選擇討論主題</span>
                    <div id="my-identity-badge-home" class="identity-badge">👤 載入中</div>
                </div>

                <!-- 主題列表容器 -->
                <div style="flex: 1; display: flex; flex-direction: column;">
                    <div style="display:flex; justify-content:flex-end; margin-bottom:0.25rem;">
                        <button id="btn-add-topic" class="hidden btn-blue" style="padding: 2px 8px; font-size: 0.7rem;">+ 新增主題</button>
                    </div>
                    <div id="topics-list-container"></div>
                </div>
            </div>

            <!-- 💬 PAGE 2: 手機對話模式 -->
            <div id="page-chat" class="hidden" style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
                
                <!-- 對話頂部 Header Bar -->
                <div class="phone-header">
                    <button class="nav-link-btn" id="back-to-home-btn">< 首頁</button>
                    
                    <div class="phone-header-title" id="topic-switcher-trigger">
                        <div style="display: flex; align-items: center; gap: 3px;">
                            <span id="current-topic-title">選擇主題</span>
                            <span style="font-size: 0.6rem; color: #94a3b8;">▼</span>
                        </div>
                        <span id="current-topic-status-badge" style="font-size: 0.6rem; padding: 0px 5px; border-radius: 3px; display: none; font-weight: normal;"></span>
                    </div>

                    <div id="my-identity-badge-chat" class="identity-badge">👤 載入中</div>
                </div>

                <!-- 次頂部數據統計欄 -->
                <div class="phone-sub-bar">
                    <span>🟢 在線：<strong id="online-users-count-chat">1</strong> 人</span>
                    <span>|</span>
                    <span>📜 鄰里人總數：<strong id="total-users-count-chat">0</strong> 人</span>
                </div>

                <!-- 獨立滾動的訊息對話區 -->
                <div id="topic-chat-messages" class="phone-chat-messages">
                    <p style="font-size: 0.75rem; color: #94a3b8; text-align: center; margin: auto;">載入對話中...</p>
                </div>

                <!-- 底部打字發送欄 -->
                <form id="chat-message-form" class="phone-input-bar">
                    <input type="text" id="chat-input-content" placeholder="講啲嘢..." required class="phone-input-field" autocomplete="off">
                    <button type="submit" class="phone-send-btn">送出</button>
                </form>
            </div>
        </div>
    </main>

    <!-- 📖 彈窗：社群源由 -->
    <div id="modal-origin" class="hidden" style="position: fixed; inset:0; background: rgba(15,23,42,0.6); display:flex; align-items:center; justify-content:center; z-index:1200; padding:1rem;">
        <div style="background:#fafcfd; border:1.5px solid #cbd5e1; padding:1.25rem; border-radius:1.25rem; width:100%; max-width:340px; display:flex; flex-direction:column; gap:0.75rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.4rem;">
                <h3 style="font-size: 0.95rem; font-weight: 800; color: #1e293b;">🌱 「客舍萬事屋」源由</h3>
                <button class="modal-close-btn" data-target="modal-origin" style="border:none; background:none; font-size:1.1rem; cursor:pointer; color:#64748b;">✕</button>
            </div>
            <p style="font-size: 0.775rem; color: #475569; line-height: 1.6;">
                「客舍萬事屋」致力於建立一個步調慢、人情味濃厚的技能互助與生活交流聚落。除了任務委託之外，這裡提供了一個專屬於居民的自由對話角落，讓大家能在此分享點滴、互相串聯。
            </p>
            <button class="btn-blue modal-close-btn" data-target="modal-origin" style="padding:0.4rem; font-size:0.8rem;">了解</button>
        </div>
    </div>

    <!-- 📖 彈窗：鄰里守則 -->
    <div id="modal-rules" class="hidden" style="position: fixed; inset:0; background: rgba(15,23,42,0.6); display:flex; align-items:center; justify-content:center; z-index:1200; padding:1rem;">
        <div style="background:#fafcfd; border:1.5px solid #cbd5e1; padding:1.25rem; border-radius:1.25rem; width:100%; max-width:340px; display:flex; flex-direction:column; gap:0.75rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.4rem;">
                <h3 style="font-size: 0.95rem; font-weight: 800; color: #1e293b;">📜 鄰里公約 (使用守則)</h3>
                <button class="modal-close-btn" data-target="modal-rules" style="border:none; background:none; font-size:1.1rem; cursor:pointer; color:#64748b;">✕</button>
            </div>
            <ul style="font-size: 0.775rem; color: #475569; line-height: 1.6; padding-left: 1.1rem; display:flex; flex-direction:column; gap:0.35rem;">
                <li><strong>友善溫暖交流</strong>：請保持尊重與包容，嚴禁言語攻擊。</li>
                <li><strong>維護資訊安全</strong>：請勿散播他人私隱或未授權廣告。</li>
                <li><strong>私密主題密碼</strong>：有密碼保護的主題請勿擅自外流。</li>
            </ul>
            <button class="btn-blue modal-close-btn" data-target="modal-rules" style="padding:0.4rem; font-size:0.8rem;">我已瞭解</button>
        </div>
    </div>

    <!-- 📌 彈窗：對話模式中的主題切換清單 -->
    <div id="topic-switcher-modal" class="hidden" style="position: fixed; inset:0; background: rgba(15,23,42,0.6); display:flex; align-items:center; justify-content:center; z-index:1000; padding:1rem;">
        <div style="background:#fafcfd; padding:1.25rem; border-radius:1.25rem; width:100%; max-width:360px; max-height:80vh; display:flex; flex-direction:column; gap:0.75rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3 style="font-size: 0.95rem; font-weight: 800; color: #334155;">📌 切換討論主題</h3>
                <button id="close-topic-switcher" style="border:none; background:none; font-size:1.1rem; cursor:pointer; color:#888;">✕</button>
            </div>
            <div id="topics-switcher-list-container" style="overflow-y:auto; flex:1;"></div>
        </div>
    </div>

    <!-- 📌 彈窗：主理人新增主題 -->
    <div id="topic-modal" class="hidden" style="position: fixed; inset:0; background: rgba(15,23,42,0.6); display:flex; align-items:center; justify-content:center; z-index:1100; padding:1rem;">
        <div style="background:white; padding:1.25rem; border-radius:1rem; width:100%; max-width:320px; display:flex; flex-direction:column; gap:0.75rem;">
            <h3 style="font-size: 0.95rem; font-weight: 800; color: #1e293b;">📌 新增討論主題</h3>
            <form id="create-topic-form" style="display:flex; flex-direction:column; gap:0.6rem;">
                <div>
                    <label style="font-size:0.7rem; font-weight:bold; color:#64748b;">主題名稱</label>
                    <input type="text" id="new-topic-title" required class="input-field" placeholder="例如: 🔒 核心幹部基地">
                </div>
                <div>
                    <label style="font-size:0.7rem; font-weight:bold; color:#64748b;">主題簡介</label>
                    <input type="text" id="new-topic-desc" class="input-field" placeholder="簡短描述">
                </div>
                <div>
                    <label style="font-size:0.7rem; font-weight:bold; color:#2563eb;">進入密碼 (選填)</label>
                    <input type="password" id="new-topic-password" class="input-field" placeholder="留空代表公開">
                </div>
                <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.25rem;">
                    <input type="checkbox" id="new-topic-anonymous" style="width:16px; height:16px; cursor:pointer;">
                    <label for="new-topic-anonymous" style="font-size:0.75rem; font-weight:bold; color:#1e293b; cursor:pointer;">
                        🕵️ 發起匿名限時主題（對話將保留 24 小時）
                    </label>
                </div>
                <div style="display:flex; gap:0.5rem; margin-top:0.4rem;">
                    <button type="button" id="cancel-topic-modal" style="flex:1; padding:0.4rem; background:#f1f5f9; border:none; border-radius:0.6rem; font-weight:bold; cursor:pointer; font-size:0.8rem;">取消</button>
                    <button type="submit" class="btn-blue" style="flex:1; padding:0.4rem; font-size:0.8rem;">確認建立</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript 邏輯 -->
    <script>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const supabase = window.supabase.createClient(supabaseUrl, supabaseKey);
        const defaultPassword = "slow2024";

        let allUserRecords = [];
        let topics = [];
        let activeTopicId = null;
        let chatSubscription = null;
        let presenceChannel = null;
        let unlockedTopics = {};
        let isAdmin = false;
        
        // 用於儲存登入後的使用者資訊
        let userId = null;
        let playerName = '訪客';
        let playerAvatar = '/assets/player1.png';

        window.addEventListener('DOMContentLoaded', async () => {
            await initAuthCheck();
            fetchAllUserRecordsFromSupabase();
            initPresenceTracker();
            if (window.lucide) lucide.createIcons();
            initEventListeners();
        });

        // ==========================================
        // 區塊一：身分驗證、初始化與登入狀態管理
        // ==========================================
        const modal = document.getElementById('rpg-modal');
        const logoutBtn = document.getElementById('logout-btn');
        const hudName = document.getElementById('my-identity-badge-home');
        const hudTierTag = document.getElementById('my-identity-badge-chat');

        async function initAuthCheck() {
            const guestId = sessionStorage.getItem('space_guest_id');

            if (guestId) {
                userId = guestId;
                playerName = sessionStorage.getItem('space_guest_name') || '訪客';
                playerAvatar = sessionStorage.getItem('space_guest_avatar') || '/assets/player1.png';
                if (modal) modal.style.display = 'none';
                updateUserUI(playerName);
                await startAppSession();
            } else {
                const { data: { session } } = await supabase.auth.getSession();
                if (session && session.user) {
                    userId = session.user.id;
                    if (modal) modal.style.display = 'none';
                    await loadUserProfile(userId);
                    await startAppSession();
                } else {
                    if (modal) modal.style.display = 'flex';
                }
            }
        }

        // 監聽來自 iframe (/login) 的登入成功訊息
        window.addEventListener('message', async (event) => {
            // 處理訪客登入成功
            if (event.data && event.data.type === 'GUEST_LOGIN_SUCCESS') {
                userId = event.data.guestId;
                playerName = event.data.name;
                playerAvatar = event.data.avatar;
                
                // 同時存入 sessionStorage 供後續判斷
                sessionStorage.setItem('space_guest_id', userId);
                sessionStorage.setItem('space_guest_name', playerName);
                sessionStorage.setItem('space_guest_avatar', playerAvatar);

                if (modal) modal.style.display = 'none';
                updateUserUI(playerName);
                await startAppSession();
            }
            
            // 處理一般會員登入成功
            if (event.data && event.data.type === 'LOGIN_SUCCESS') {
                if (modal) modal.style.display = 'none';
                const { data: { session } } = await supabase.auth.getSession();
                if (session && session.user) {
                    userId = session.user.id;
                    await loadUserProfile(userId);
                    await startAppSession();
                }
            }
        });

        supabase.auth.onAuthStateChange(async (event, session) => {
            if ((event === 'SIGNED_IN' || event === 'USER_UPDATED') && session?.user) {
                userId = session.user.id;
                if (modal) modal.style.display = 'none';
                await loadUserProfile(userId);
                await startAppSession();
            }
        });

        function updateUserUI(name) {
            const homeBadge = document.getElementById('my-identity-badge-home');
            const chatBadge = document.getElementById('my-identity-badge-chat');
            if (homeBadge) homeBadge.textContent = `👤 ${name}`;
            if (chatBadge) chatBadge.textContent = `👤 ${name}`;
        }

        async function loadUserProfile(uid) {
            try {
                const { data, error } = await supabase.from('profiles').select('*').eq('id', uid).single();
                if (data) {
                    playerName = data.name || data.full_name || '會員';
                    updateUserUI(playerName);
                }
            } catch (err) {
                console.error("載入使用者檔案失敗", err);
            }
        }

        async function startAppSession() {
            fetchTopics();
        }

        // ==========================================
        // 區塊二：其他聊天室與應用邏輯
        // ==========================================
        async function fetchAllUserRecordsFromSupabase() {
            try {
                const { data, error } = await supabase.from('alluser_record').select('*');
                if (error) throw error;
                allUserRecords = data || [];
                const totalCount = allUserRecords.length;
                document.getElementById('total-users-count-home').textContent = totalCount;
                document.getElementById('total-users-count-chat').textContent = totalCount;
            } catch (err) { console.error("讀取用戶紀錄失敗:", err.message); }
        }

        function initPresenceTracker() {
            if (presenceChannel) supabase.removeChannel(presenceChannel);

            presenceChannel = supabase.channel('community-online-room', {
                config: { presence: { key: userId || 'anonymous' } }
            });

            presenceChannel
                .on('presence', { event: 'sync' }, () => {
                    const state = presenceChannel.presenceState();
                    const onlineCount = Object.keys(state).length || 1;
                    document.getElementById('online-users-count-home').textContent = onlineCount;
                    document.getElementById('online-users-count-chat').textContent = onlineCount;
                })
                .subscribe(async (status) => {
                    if (status === 'SUBSCRIBED') {
                        await presenceChannel.track({ name: playerName, online_at: new Date().toISOString() });
                    }
                });
        }

        function confirmSwitchIdentity() {
            if (confirm(`您目前的身分是「${playerName}」\n是否要登出並切換身分？`)) {
                logoutChatUser();
            }
        }

        function logoutChatUser() {
            sessionStorage.clear();
            supabase.auth.signOut();
            if (presenceChannel) supabase.removeChannel(presenceChannel);
            location.reload();
        }

        async function fetchTopics() {
            try {
                const { data, error } = await supabase
                    .from('chat_topics')
                    .select('*')
                    .order('sort_order', { ascending: true })
                    .order('created_at', { ascending: false });

                if (error) throw error;
                topics = data || [];
                renderTopicsList();
            } catch (err) { console.error("讀取主題失敗:", err.message); }
        }

        window.moveTopicOrder = async function(event, topicId, direction) {
            event.stopPropagation();
            const index = topics.findIndex(t => String(t.id) === String(topicId));
            if (index === -1) return;

            const targetIndex = direction === 'up' ? index - 1 : index + 1;
            if (targetIndex < 0 || targetIndex >= topics.length) {
                alert("已經到底囉，無法再移動！");
                return;
            }

            const currentTopic = topics[index];
            const targetTopic = topics[targetIndex];

            let newCurrentOrder = targetTopic.sort_order ?? targetIndex;
            let newTargetOrder = currentTopic.sort_order ?? index;

            if (newCurrentOrder === newTargetOrder) {
                newCurrentOrder = direction === 'up' ? newTargetOrder - 1 : newTargetOrder + 1;
            }

            try {
                const { error: err1 } = await supabase.from('chat_topics').update({ sort_order: newCurrentOrder }).eq('id', currentTopic.id);
                const { error: err2 } = await supabase.from('chat_topics').update({ sort_order: newTargetOrder }).eq('id', targetTopic.id);

                if (err1 || err2) throw (err1 || err2);
                fetchTopics();
            } catch (err) {
                alert("排序調整失敗: " + err.message);
            }
        };

        window.deleteTopic = async function(event, topicId, topicTitle) {
            event.stopPropagation();
            if (!confirm(`⚠️ 確定要立即刪除主題「${topicTitle}」嗎？\n此動作會即時清空該主題內的所有對話，且無法復原！`)) return;

            try {
                const { error } = await supabase.from('chat_topics').delete().eq('id', topicId);
                if (error) throw error;

                alert("🗑️ 主題與對話紀錄已成功刪除！");
                if (String(activeTopicId) === String(topicId)) {
                    backToHome();
                }
                fetchTopics();
            } catch (err) {
                alert("刪除失敗: " + err.message);
            }
        };

        function renderTopicsList() {
            const container = document.getElementById('topics-list-container');
            const switcherContainer = document.getElementById('topics-switcher-list-container');
            
            const htmlContent = topics.length === 0 
                ? `<p style="font-size:0.75rem; color:#a09587; text-align:center; padding:1rem;">尚無討論主題</p>`
                : topics.map((topic, index) => {
                    const hasPassword = topic.password && topic.password.trim() !== '';
                    const timeInfo = getTopicTimeRemainingHtml(topic);
                    const timeRemainingText = timeInfo.text 
                        ? ` <span style="font-size:0.6rem; background:${timeInfo.expired ? '#f3f4f6' : '#fee2e2'}; color:${timeInfo.expired ? '#6b7280' : '#991b1b'}; padding:1px 4px; border-radius:3px;">${timeInfo.text}</span>` 
                        : '';

                    const lockIcon = hasPassword ? '🔒 ' : (topic.is_anonymous ? '⏳ ' : '💬 ');
                    
                    let adminControls = '';
                    if (isAdmin) {
                        const upBtn = index > 0 ? `<button onclick="moveTopicOrder(event, '${topic.id}', 'up')" style="background:#e2e8f0; border:none; padding:1px 4px; border-radius:3px; font-size:0.6rem; cursor:pointer;">⬆️</button>` : '';
                        const downBtn = index < topics.length - 1 ? `<button onclick="moveTopicOrder(event, '${topic.id}', 'down')" style="background:#e2e8f0; border:none; padding:1px 4px; border-radius:3px; font-size:0.6rem; cursor:pointer;">⬇️</button>` : '';
                        const deleteBtn = `<button onclick="deleteTopic(event, '${topic.id}', '${topic.title}')" style="background:#ef4444; color:white; border:none; padding:1px 5px; border-radius:3px; font-size:0.6rem; cursor:pointer;">刪除</button>`;
                        
                        adminControls = `<div style="display:flex; gap:3px; align-items:center;" onclick="event.stopPropagation();">${upBtn}${downBtn}${deleteBtn}</div>`;
                    }

                    return `
                        <div onclick="trySelectTopic('${topic.id}')" class="topic-select-card" style="display:flex; flex-direction:column; gap:4px;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <h4 style="font-size: 0.85rem; font-weight: 800; color: #574332; display:flex; align-items:center; gap:4px;">
                                    ${lockIcon}${topic.title}${timeRemainingText}
                                </h4>
                                ${adminControls}
                            </div>
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <p style="font-size: 0.7rem; color: #786858; margin:0;">${topic.description || '無簡介'}</p>
                                <span style="font-size:0.7rem; color:#3b7a57; font-weight:bold;">進入 〉</span>
                            </div>
                        </div>
                    `;
                }).join('');

            if (container) container.innerHTML = htmlContent;
            if (switcherContainer) switcherContainer.innerHTML = htmlContent;
        }

        window.trySelectTopic = function(topicId) {
            const topic = topics.find(t => String(t.id) === String(topicId));
            if (!topic) return;

            if (topic.password && topic.password.trim() !== '' && !unlockedTopics[topicId]) {
                const inputPwd = prompt(`🔒 主題「${topic.title}」需要密碼：`);
                if (inputPwd === null) return;

                if (inputPwd.trim() === topic.password.trim()) {
                    unlockedTopics[topicId] = true;
                    enterTopicChat(topic);
                } else {
                    alert("❌ 密碼錯誤！");
                }
            } else {
                enterTopicChat(topic);
            }
        };

        function enterTopicChat(topic) {
            activeTopicId = topic.id;
            document.getElementById('current-topic-title').textContent = topic.title;

            const badgeContainer = document.getElementById('current-topic-status-badge');
            if (badgeContainer) {
                const timeInfo = getTopicTimeRemainingHtml(topic);

                if (timeInfo.text) {
                    badgeContainer.innerHTML = timeInfo.text;
                    badgeContainer.style.background = timeInfo.expired ? '#f3f4f6' : '#fee2e2';
                    badgeContainer.style.color = timeInfo.expired ? '#6b7280' : '#991b1b';
                    badgeContainer.style.display = 'inline-block';
                } else if (topic.is_anonymous) {
                    badgeContainer.innerHTML = `🕵️ 匿名主題`;
                    badgeContainer.style.background = '#e0f2fe';
                    badgeContainer.style.color = '#0369a1';
                    badgeContainer.style.display = 'inline-block';
                } else {
                    badgeContainer.style.display = 'none';
                }
            }

            document.getElementById('topic-switcher-modal').classList.add('hidden');
            document.getElementById('page-home').classList.add('hidden');
            document.getElementById('page-chat').classList.remove('hidden');

            loadTopicMessages(topic.id);
            subscribeToTopicChat(topic.id);
        }

        function getTopicTimeRemainingHtml(topic) {
            if (!topic.is_anonymous || !topic.expires_at) return '';

            const now = new Date();
            const expireDate = new Date(topic.expires_at);
            const diffMs = expireDate - now;

            if (!isNaN(expireDate.getTime()) && diffMs > 0) {
                const diffHrs = String(Math.floor(diffMs / (1000 * 60 * 60))).padStart(2, '0');
                const diffMins = String(Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
                
                return { text: `⏳ 剩餘 ${diffHrs}小時 ${diffMins}分`, expired: false };
            } else {
                return { text: `⏳ 已過期`, expired: true };
            }
        }

        function backToHome() {
            activeTopicId = null;
            document.getElementById('page-chat').classList.add('hidden');
            document.getElementById('page-home').classList.remove('hidden');
        }

        async function loadTopicMessages(topicId) {
            const container = document.getElementById('topic-chat-messages');
            if (!container) return;

            try {
                const { data, error } = await supabase
                    .from('topic_messages')
                    .select('*')
                    .eq('topic_id', topicId)
                    .order('created_at', { ascending: true });

                if (error) throw error;
                renderTopicMessages(data || []);
            } catch (err) {
                container.innerHTML = `<p style="font-size:0.75rem; color:#ef4444; text-align:center;">載入失敗</p>`;
            }
        }

        function renderTopicMessages(messages) {
            const container = document.getElementById('topic-chat-messages');
            if (!container) return;

            if (messages.length === 0) {
                container.innerHTML = `<p style="font-size: 0.75rem; color: #a09587; text-align: center; margin: auto;">開始交流吧！</p>`;
                return;
            }

            const currentUserName = playerName || '';
            const currentTopic = topics.find(t => String(t.id) === String(activeTopicId));
            const isAnonTopic = currentTopic && currentTopic.is_anonymous;

            container.innerHTML = messages.map(msg => {
                const timeStr = new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const isSelf = (msg.sender_name === currentUserName);

                const displayName = isAnonTopic 
                    ? (isSelf ? `我 (匿名)` : getConsistentAnonymousName(msg.sender_name, activeTopicId))
                    : msg.sender_name;

                if (isSelf) {
                    return `
                        <div class="msg-row-self">
                            <div class="msg-bubble msg-bubble-self">
                                <div>${msg.content}</div>
                                <span class="msg-time-stamp">${timeStr}</span>
                            </div>
                        </div>
                    `;
                } else {
                    return `
                        <div class="msg-row-other">
                            <div class="msg-bubble msg-bubble-other">
                                <span class="msg-sender-name">${displayName}</span>
                                <div>${msg.content}</div>
                                <span class="msg-time-stamp">${timeStr}</span>
                            </div>
                        </div>
                    `;
                }
            }).join('');

            container.scrollTop = container.scrollHeight;
        }

        function getConsistentAnonymousName(realName, topicId) {
            let hash = 0;
            const str = (realName || '居民') + (topicId || '');
            for (let i = 0; i < str.length; i++) {
                hash = str.charCodeAt(i) + ((hash << 5) - hash);
            }
            const anonymousNumbers = Math.abs(hash) % 900 + 100;
            return `🕵️ 匿名居民 #${anonymousNumbers}`;
        }

        function subscribeToTopicChat(topicId) {
            if (chatSubscription) supabase.removeChannel(chatSubscription);

            chatSubscription = supabase.channel(`topic-${topicId}`)
                .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'topic_messages', filter: `topic_id=eq.${topicId}` }, () => {
                    loadTopicMessages(topicId);
                })
                .subscribe();
        }

        // ==========================================
        // 區塊三：事件綁定初始化
        // ==========================================
        function initEventListeners() {
            // 身分切換點擊
            document.getElementById('my-identity-badge-home').addEventListener('click', confirmSwitchIdentity);
            document.getElementById('my-identity-badge-chat').addEventListener('click', confirmSwitchIdentity);

            // 外部連結跳轉
            document.getElementById('external-link-btn').addEventListener('click', () => {
                window.open('https://studioslowpace.com/skillsupermarket.html', '_blank');
            });

            // Logo 切換主理人面板
            document.getElementById('logo-toggle-btn').addEventListener('click', () => {
                document.getElementById('admin-navbar').classList.toggle('hidden');
            });

            // 主理人登入與登出
            document.getElementById('admin-login-btn').addEventListener('click', () => {
                if (document.getElementById('admin-password-input').value === defaultPassword) {
                    isAdmin = true;
                    document.getElementById('admin-logged-out').classList.add('hidden');
                    document.getElementById('admin-logged-in').classList.remove('hidden');
                    document.getElementById('btn-add-topic').classList.remove('hidden');
                    renderTopicsList();
                    alert("🟢 主理人權限已解鎖！");
                } else { alert("密碼錯誤"); }
            });

            document.getElementById('admin-logout-btn').addEventListener('click', () => {
                isAdmin = false;
                document.getElementById('admin-logged-out').classList.remove('hidden');
                document.getElementById('admin-logged-in').classList.add('hidden');
                document.getElementById('btn-add-topic').classList.add('hidden');
                renderTopicsList();
            });

            // 資訊彈窗開關
            document.querySelectorAll('.info-trigger-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-modal');
                    document.getElementById(targetId).classList.remove('hidden');
                });
            });

            document.querySelectorAll('.modal-close-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-target');
                    document.getElementById(targetId).classList.add('hidden');
                });
            });

            // 新增主題按鈕與 Modal
            document.getElementById('btn-add-topic').addEventListener('click', () => {
                document.getElementById('topic-modal').classList.remove('hidden');
            });

            document.getElementById('cancel-topic-modal').addEventListener('click', () => {
                document.getElementById('topic-modal').classList.add('hidden');
            });

            document.getElementById('create-topic-form').addEventListener('submit', async (event) => {
                event.preventDefault();
                const title = document.getElementById('new-topic-title').value.trim();
                const desc = document.getElementById('new-topic-desc').value.trim();
                const password = document.getElementById('new-topic-password').value.trim();
                const isAnon = document.getElementById('new-topic-anonymous').checked;

                if (!title) return;

                let expiresAt = null;
                if (isAnon) {
                    const now = new Date();
                    now.setHours(now.getHours() + 24);
                    expiresAt = now.toISOString();
                }

                try {
                    const { error } = await supabase.from('chat_topics').insert([{ 
                        title: isAnon ? `⏳ [限時] ${title}` : title, 
                        description: desc, 
                        password: password,
                        is_anonymous: isAnon,
                        expires_at: expiresAt
                    }]);
                    if (error) throw error;

                    document.getElementById('topic-modal').classList.add('hidden');
                    document.getElementById('new-topic-title').value = '';
                    document.getElementById('new-topic-desc').value = '';
                    document.getElementById('new-topic-password').value = '';
                    document.getElementById('new-topic-anonymous').checked = false;
                    
                    fetchTopics();
                    alert(isAnon ? "⏳ 已成功發起匿名限時討論區（將於 24 小時後自動銷毀）！" : "📌 成功建立新討論主題！");
                } catch (err) { alert("建立失敗: " + err.message); }
            });

            // 對話中切換主題 Modal
            document.getElementById('topic-switcher-trigger').addEventListener('click', () => {
                document.getElementById('topic-switcher-modal').classList.remove('hidden');
            });

            document.getElementById('close-topic-switcher').addEventListener('click', () => {
                document.getElementById('topic-switcher-modal').classList.add('hidden');
            });

            // 返回首頁
            document.getElementById('back-to-home-btn').addEventListener('click', backToHome);

            // 發送訊息表單
            document.getElementById('chat-message-form').addEventListener('submit', async (event) => {
                event.preventDefault();
                if (!activeTopicId) return;

                const contentInput = document.getElementById('chat-input-content');
                if (!playerName || !contentInput.value.trim()) return;

                try {
                    const { error } = await supabase.from('topic_messages').insert([{
                        topic_id: activeTopicId,
                        sender_name: playerName,
                        content: contentInput.value.trim()
                    }]);

                    if (error) throw error;
                    contentInput.value = '';
                } catch (err) { alert("發送失敗: " + err.message); }
            });
        }
    </script>
</body>
</html>