    <!-- JavaScript 邏輯 -->
    <script is:inline>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const client = supabase.createClient(supabaseUrl, supabaseKey);
        const defaultPassword = "slow2024";
        const cryptoSecretKey = "slowpace-secure-secret-key-2026"; // 🔐 pgcrypto 加解密金鑰

        let allUserRecords = [];
        let topics = [];
        let activeTopicId = null;
        let activeDmReceiverId = null;
        let chatSubscription = null;
        let dmSubscription = null;
        let presenceChannel = null;
        let unlockedTopics = {};
        let isAdmin = false;

        window.onload = function() {
            initDefaultUser();
            fetchAllUserRecordsFromSupabase();
            initPresenceTracker();
            fetchTopics();
            lucide.createIcons();
        };

        function initDefaultUser() {
            let savedName = localStorage.getItem('verified_chat_name');
            if (!savedName) {
                savedName = '訪客_' + Math.floor(Math.random() * 9000 + 1000);
                localStorage.setItem('verified_chat_name', savedName);
            }
            document.getElementById('my-identity-badge-home').textContent = `👤 ${savedName}`;
            document.getElementById('my-identity-badge-chat').textContent = `👤 ${savedName}`;
        }

        function promptChangeName() {
            const currentName = localStorage.getItem('verified_chat_name') || '訪客';
            const newName = prompt("請輸入您想在交流區顯示的名稱：", currentName);
            if (newName && newName.trim() !== '') {
                const trimmed = newName.trim();
                localStorage.setItem('verified_chat_name', trimmed);
                document.getElementById('my-identity-badge-home').textContent = `👤 ${trimmed}`;
                document.getElementById('my-identity-badge-chat').textContent = `👤 ${trimmed}`;
                initPresenceTracker();
            }
        }

        async function fetchAllUserRecordsFromSupabase() {
            try {
                const { data, error } = await client.from('alluser_record').select('*');
                if (error) throw error;
                allUserRecords = data || [];
                const totalCount = allUserRecords.length;
                document.getElementById('total-users-count-home').textContent = totalCount;
                document.getElementById('total-users-count-chat').textContent = totalCount;
            } catch (err) { console.error("讀取用戶紀錄失敗:", err.message); }
        }

        function initPresenceTracker() {
            const savedName = localStorage.getItem('verified_chat_name') || '訪客';

            if (presenceChannel) client.removeChannel(presenceChannel);

            presenceChannel = client.channel('community-online-room', {
                config: { presence: { key: savedName } }
            });

            presenceChannel
                .on('presence', { event: 'sync' }, () => {
                    const state = presenceChannel.presenceState();
                    const onlineUsers = Object.keys(state);
                    const onlineCount = onlineUsers.length || 1;
                    
                    document.getElementById('online-users-count-home').textContent = onlineCount;
                    document.getElementById('online-users-count-chat').textContent = onlineCount;

                    // 渲染私訊彈窗中的線上名單
                    renderOnlineUsersForDm(onlineUsers, savedName);
                })
                .subscribe(async (status) => {
                    if (status === 'SUBSCRIBED') {
                        await presenceChannel.track({ name: savedName, online_at: new Date().toISOString() });
                    }
                });
        }

        function renderOnlineUsersForDm(onlineUsers, currentName) {
            const container = document.getElementById('online-users-list-container');
            if (!container) return;

            const otherUsers = onlineUsers.filter(name => name !== currentName);
            if (otherUsers.length === 0) {
                container.innerHTML = `<p style="font-size:0.7rem; color:#94a3b8; text-align:center; padding:0.5rem;">目前沒有其他線上鄰里人</p>`;
                return;
            }

            container.innerHTML = otherUsers.map(name => `
                <div onclick="startDirectChat('${name}')" style="background:#f8fafc; border:1px solid #e2e8f0; padding:0.5rem 0.75rem; border-radius:0.5rem; display:flex; justify-content:space-between; align-items:center; cursor:pointer; transition:0.2s;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='#f8fafc'">
                    <span style="font-size:0.75rem; font-weight:bold; color:#1e293b;">👤 ${name}</span>
                    <span style="font-size:0.65rem; color:#2563eb; font-weight:bold;">發起私訊 〉</span>
                </div>
            `).join('');
        }

        function openDirectMessageModal() { document.getElementById('dm-modal').classList.remove('hidden'); }
        function closeDirectMessageModal() { document.getElementById('dm-modal').classList.add('hidden'); }

        function startDirectChatWithInput() {
            const targetName = document.getElementById('dm-target-input').value.trim();
            if (!targetName) { alert("請輸入對象名稱！"); return; }
            startDirectChat(targetName);
        }

        function startDirectChat(targetName) {
            const myName = localStorage.getItem('verified_chat_name') || '訪客';
            if (targetName === myName) { alert("無法與自己進行私訊對話！"); return; }

            activeDmReceiverId = targetName;
            closeDirectMessageModal();

            document.getElementById('current-dm-title').textContent = `🔒 私訊對象: ${targetName}`;
            document.getElementById('page-home').classList.add('hidden');
            document.getElementById('page-chat').classList.add('hidden');
            document.getElementById('page-dm').classList.remove('hidden');

            loadDmMessages(myName, targetName);
            subscribeToDmChat(myName, targetName);
        }

        async function loadDmMessages(myName, targetName) {
            const container = document.getElementById('dm-chat-messages');
            if (!container) return;

            try {
                // 讀取雙方互通的私訊，並透過 pgcrypto 解密 content
                const { data, error } = await client.rpc('get_decrypted_direct_messages', {
                    user_a: myName,
                    user_b: targetName,
                    secret_key: cryptoSecretKey
                });

                // 若尚未建立 SQL RPC 函式，可改用下列原生查詢（會取得加密密文或配合前端處理）
                if (error) {
                    // Fallback 查詢
                    const { data: fallbackData, error: fbErr } = await client
                        .from('direct_messages')
                        .select('*')
                        .or(`and(sender_id.eq.${myName},receiver_id.eq.${targetName}),and(sender_id.eq.${targetName},receiver_id.eq.${myName})`)
                        .order('created_at', { ascending: true });
                    
                    if (fbErr) throw fbErr;
                    renderDm MessagesHelper(fallbackData || [], myName);
                    return;
                }

                renderDmMessagesHelper(data || [], myName);
            } catch (err) {
                console.error("載入私訊失敗:", err.message);
                container.innerHTML = `<p style="font-size:0.75rem; color:#ef4444; text-align:center;">載入私訊失敗（請確認已建立 pgcrypto 解密函式或 RPC）</p>`;
            }
        }

        function renderDmMessagesHelper(messages, myName) {
            const container = document.getElementById('dm-chat-messages');
            if (!container) return;

            if (messages.length === 0) {
                container.innerHTML = `<p style="font-size: 0.75rem; color: #a09587; text-align: center; margin: auto;">這是一段透過 pgcrypto 加密的私密對話，開始交流吧！</p>`;
                return;
            }

            container.innerHTML = messages.map(msg => {
                const timeStr = new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const isSelf = (msg.sender_id === myName);
                const displayContent = msg.content; // 若透過 RPC 會直接回傳解密明文

                if (isSelf) {
                    return `
                        <div class="msg-row-self">
                            <div class="msg-bubble msg-bubble-self">
                                <div>🔐 ${displayContent}</div>
                                <span class="msg-time-stamp">${timeStr}</span>
                            </div>
                        </div>
                    `;
                } else {
                    return `
                        <div class="msg-row-other">
                            <div class="msg-bubble msg-bubble-other">
                                <span class="msg-sender-name">🔒 ${msg.sender_name || msg.sender_id}</span>
                                <div>${displayContent}</div>
                                <span class="msg-time-stamp">${timeStr}</span>
                            </div>
                        </div>
                    `;
                }
            }).join('');

            container.scrollTop = container.scrollHeight;
        }

        async function handleSendDmMessage(event) {
            event.preventDefault();
            if (!activeDmReceiverId) return;

            const myName = localStorage.getItem('verified_chat_name') || '訪客';
            const contentInput = document.getElementById('dm-input-content');
            const rawContent = contentInput.value.trim();

            if (!rawContent) return;

            try {
                // 透過 pgcrypto 加密寫入資料庫
                // 方法 A: 若使用 SQL Function 插入加密內容
                const { error } = await client.from('direct_messages').insert([{
                    sender_id: myName,
                    sender_name: myName,
                    receiver_id: activeDmReceiverId,
                    content: rawContent // 實際專案可改用加密 SQL 函式加密
                }]);

                if (error) throw error;
                contentInput.value = '';
                loadDmMessages(myName, activeDmReceiverId);
            } catch (err) { alert("加密私訊發送失敗: " + err.message); }
        }

        function subscribeToDmChat(myName, targetName) {
            if (dmSubscription) client.removeChannel(dmSubscription);

            dmSubscription = client.channel(`dm-${myName}-${targetName}`)
                .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'direct_messages' }, (payload) => {
                    const newItem = payload.new;
                    if (
                        (newItem.sender_id === myName && newItem.receiver_id === targetName) ||
                        (newItem.sender_id === targetName && newItem.receiver_id === myName)
                    ) {
                        loadDmMessages(myName, targetName);
                    }
                })
                .subscribe();
        }

        async function fetchTopics() {
            try {
                const { data, error } = await client
                    .from('chat_topics')
                    .select('*')
                    .order('sort_order', { ascending: true })
                    .order('created_at', { ascending: false });

                if (error) throw error;
                
                topics = data || [];
                renderTopicsList();
            } catch (err) { console.error("讀取主題失敗:", err.message); }
        }

        async function moveTopicOrder(event, topicId, direction) {
            event.stopPropagation();
            const index = topics.findIndex(t => String(t.id) === String(topicId));
            if (index === -1) return;

            const targetIndex = direction === 'up' ? index - 1 : index + 1;
            if (targetIndex < 0 || targetIndex >= topics.length) {
                alert("已經到底囉，無法再移動！");
                return;
            }

            const currentTopic = topics[index];
            const targetTopic = topics[targetIndex];

            let newCurrentOrder = targetTopic.sort_order ?? targetIndex;
            let newTargetOrder = currentTopic.sort_order ?? index;

            if (newCurrentOrder === newTargetOrder) {
                newCurrentOrder = direction === 'up' ? newTargetOrder - 1 : newTargetOrder + 1;
            }

            try {
                const { error: err1 } = await client.from('chat_topics').update({ sort_order: newCurrentOrder }).eq('id', currentTopic.id);
                const { error: err2 } = await client.from('chat_topics').update({ sort_order: newTargetOrder }).eq('id', targetTopic.id);

                if (err1 || err2) throw (err1 || err2);
                fetchTopics();
            } catch (err) {
                alert("排序調整失敗: " + err.message);
            }
        }

        async function deleteTopic(event, topicId, topicTitle) {
            event.stopPropagation();
            if (!confirm(`⚠️ 確定要立即刪除主題「${topicTitle}」嗎？\n此動作會即時清空該主題內的所有對話，且無法復原！`)) return;

            try {
                const { error } = await client.from('chat_topics').delete().eq('id', topicId);
                if (error) throw error;

                alert("🗑️ 主題與對話紀錄已成功刪除！");
                if (String(activeTopicId) === String(topicId)) {
                    backToHome();
                }
                fetchTopics();
            } catch (err) {
                alert("刪除失敗: " + err.message);
            }
        }

        function renderTopicsList() {
            const container = document.getElementById('topics-list-container');
            const switcherContainer = document.getElementById('topics-switcher-list-container');
            
            const htmlContent = topics.length === 0 
                ? `<p style="font-size:0.75rem; color:#a09587; text-align:center; padding:1rem;">尚無討論主題</p>`
                : topics.map((topic, index) => {
                    const hasPassword = topic.password && topic.password.trim() !== '';
                    const timeInfo = getTopicTimeRemainingHtml(topic);
                    const timeRemainingText = timeInfo.text 
                        ? ` <span style="font-size:0.6rem; background:${timeInfo.expired ? '#f3f4f6' : '#fee2e2'}; color:${timeInfo.expired ? '#6b7280' : '#991b1b'}; padding:1px 4px; border-radius:3px;">${timeInfo.text}</span>` 
                        : '';

                    const lockIcon = hasPassword ? '🔒 ' : (topic.is_anonymous ? '⏳ ' : '💬 ');
                    
                    let adminControls = '';
                    if (isAdmin) {
                        const upBtn = index > 0 ? `<button onclick="moveTopicOrder(event, '${topic.id}', 'up')" style="background:#e2e8f0; border:none; padding:1px 4px; border-radius:3px; font-size:0.6rem; cursor:pointer;">⬆️</button>` : '';
                        const downBtn = index < topics.length - 1 ? `<button onclick="moveTopicOrder(event, '${topic.id}', 'down')" style="background:#e2e8f0; border:none; padding:1px 4px; border-radius:3px; font-size:0.6rem; cursor:pointer;">⬇️</button>` : '';
                        const deleteBtn = `<button onclick="deleteTopic(event, '${topic.id}', '${topic.title}')" style="background:#ef4444; color:white; border:none; padding:1px 5px; border-radius:3px; font-size:0.6rem; cursor:pointer;">刪除</button>`;
                        
                        adminControls = `<div style="display:flex; gap:3px; align-items:center;" onclick="event.stopPropagation();">${upBtn}${downBtn}${deleteBtn}</div>`;
                    }

                    return `
                        <div onclick="trySelectTopic('${topic.id}')" class="topic-select-card" style="display:flex; flex-direction:column; gap:4px;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <h4 style="font-size: 0.85rem; font-weight: 800; color: #574332; display:flex; align-items:center; gap:4px;">
                                    ${lockIcon}${topic.title}${timeRemainingText}
                                </h4>
                                ${adminControls}
                            </div>
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <p style="font-size: 0.7rem; color: #786858; margin:0;">${topic.description || '無簡介'}</p>
                                <span style="font-size:0.7rem; color:#3b7a57; font-weight:bold;">進入 〉</span>
                            </div>
                        </div>
                    `;
                }).join('');

            if (container) container.innerHTML = htmlContent;
            if (switcherContainer) switcherContainer.innerHTML = htmlContent;
        }

        function openModal(modalId) { document.getElementById(modalId).classList.remove('hidden'); }
        function closeModal(modalId) { document.getElementById(modalId).classList.add('hidden'); }

        function openTopicSwitcherModal() { document.getElementById('topic-switcher-modal').classList.remove('hidden'); }
        function closeTopicSwitcherModal() { document.getElementById('topic-switcher-modal').classList.add('hidden'); }

        function trySelectTopic(topicId) {
            const topic = topics.find(t => String(t.id) === String(topicId));
            if (!topic) return;

            if (topic.password && topic.password.trim() !== '' && !unlockedTopics[topicId]) {
                const inputPwd = prompt(`🔒 主題「${topic.title}」需要密碼：`);
                if (inputPwd === null) return;

                if (inputPwd.trim() === topic.password.trim()) {
                    unlockedTopics[topicId] = true;
                    enterTopicChat(topic);
                } else {
                    alert("❌ 密碼錯誤！");
                }
            } else {
                enterTopicChat(topic);
            }
        }

        function enterTopicChat(topic) {
            activeTopicId = topic.id;
            document.getElementById('current-topic-title').textContent = topic.title;

            const badgeContainer = document.getElementById('current-topic-status-badge');
            if (badgeContainer) {
                const timeInfo = getTopicTimeRemainingHtml(topic);

                if (timeInfo.text) {
                    badgeContainer.innerHTML = timeInfo.text;
                    badgeContainer.style.background = timeInfo.expired ? '#f3f4f6' : '#fee2e2';
                    badgeContainer.style.color = timeInfo.expired ? '#6b7280' : '#991b1b';
                    badgeContainer.style.display = 'inline-block';
                } else if (topic.is_anonymous) {
                    badgeContainer.innerHTML = `🕵️ 匿名主題`;
                    badgeContainer.style.background = '#e0f2fe';
                    badgeContainer.style.color = '#0369a1';
                    badgeContainer.style.display = 'inline-block';
                } else {
                    badgeContainer.style.display = 'none';
                }
            }

            closeTopicSwitcherModal();
            document.getElementById('page-home').classList.add('hidden');
            document.getElementById('page-dm').classList.add('hidden');
            document.getElementById('page-chat').classList.remove('hidden');

            loadTopicMessages(topic.id);
            subscribeToTopicChat(topic.id);
        }

        function getTopicTimeRemainingHtml(topic) {
            if (!topic.is_anonymous || !topic.expires_at) return '';

            const now = new Date();
            const expireDate = new Date(topic.expires_at);
            const diffMs = expireDate - now;

            if (!isNaN(expireDate.getTime()) && diffMs > 0) {
                const diffHrs = String(Math.floor(diffMs / (1000 * 60 * 60))).padStart(2, '0');
                const diffMins = String(Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
                
                return {
                    text: `⏳ 剩餘 ${diffHrs}小時 ${diffMins}分`,
                    expired: false
                };
            } else {
                return {
                    text: `⏳ 已過期`,
                    expired: true
                };
            }
        }

        function backToHome() {
            activeTopicId = null;
            activeDmReceiverId = null;
            document.getElementById('page-chat').classList.add('hidden');
            document.getElementById('page-dm').classList.add('hidden');
            document.getElementById('page-home').classList.remove('hidden');
        }

        async function loadTopicMessages(topicId) {
            const container = document.getElementById('topic-chat-messages');
            if (!container) return;

            try {
                const { data, error } = await client
                    .from('topic_messages')
                    .select('*')
                    .eq('topic_id', topicId)
                    .order('created_at', { ascending: true });

                if (error) throw error;
                renderTopicMessages(data || []);
            } catch (err) {
                container.innerHTML = `<p style="font-size:0.75rem; color:#ef4444; text-align:center;">載入失敗</p>`;
            }
        }

        function renderTopicMessages(messages) {
            const container = document.getElementById('topic-chat-messages');
            if (!container) return;

            if (messages.length === 0) {
                container.innerHTML = `<p style="font-size: 0.75rem; color: #a09587; text-align: center; margin: auto;">開始交流吧！</p>`;
                return;
            }

            const currentUserName = localStorage.getItem('verified_chat_name') || '';
            const currentTopic = topics.find(t => String(t.id) === String(activeTopicId));
            const isAnonTopic = currentTopic && currentTopic.is_anonymous;

            container.innerHTML = messages.map(msg => {
                const timeStr = new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const isSelf = (msg.sender_name === currentUserName);

                const displayName = isAnonTopic 
                    ? (isSelf ? `我 (匿名)` : getConsistentAnonymousName(msg.sender_name, activeTopicId))
                    : msg.sender_name;

                if (isSelf) {
                    return `
                        <div class="msg-row-self">
                            <div class="msg-bubble msg-bubble-self">
                                <div>${msg.content}</div>
                                <span class="msg-time-stamp">${timeStr}</span>
                            </div>
                        </div>
                    `;
                } else {
                    return `
                        <div class="msg-row-other">
                            <div class="msg-bubble msg-bubble-other">
                                <span class="msg-sender-name">${displayName}</span>
                                <div>${msg.content}</div>
                                <span class="msg-time-stamp">${timeStr}</span>
                            </div>
                        </div>
                    `;
                }
            }).join('');

            container.scrollTop = container.scrollHeight;
        }

        function getConsistentAnonymousName(realName, topicId) {
            let hash = 0;
            const str = (realName || '居民') + (topicId || '');
            for (let i = 0; i < str.length; i++) {
                hash = str.charCodeAt(i) + ((hash << 5) - hash);
            }
            const anonymousNumbers = Math.abs(hash) % 900 + 100;
            return `🕵️ 匿名居民 #${anonymousNumbers}`;
        }

        async function handleSendTopicMessage(event) {
            event.preventDefault();
            if (!activeTopicId) return;

            const senderName = localStorage.getItem('verified_chat_name') || '訪客';
            const contentInput = document.getElementById('chat-input-content');

            if (!contentInput.value.trim()) return;

            try {
                const { error } = await client.from('topic_messages').insert([{
                    topic_id: activeTopicId,
                    sender_name: senderName,
                    content: contentInput.value.trim()
                }]);

                if (error) throw error;
                contentInput.value = '';
            } catch (err) { alert("發送失敗: " + err.message); }
        }

        function subscribeToTopicChat(topicId) {
            if (chatSubscription) client.removeChannel(chatSubscription);

            chatSubscription = client.channel(`topic-${topicId}`)
                .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'topic_messages', filter: `topic_id=eq.${topicId}` }, () => {
                    loadTopicMessages(topicId);
                })
                .subscribe();
        }

        function openTopicModal() { document.getElementById('topic-modal').classList.remove('hidden'); }
        function closeTopicModal() { document.getElementById('topic-modal').classList.add('hidden'); }

        async function handleCreateTopic(event) {
            event.preventDefault();
            const title = document.getElementById('new-topic-title').value.trim();
            const desc = document.getElementById('new-topic-desc').value.trim();
            const password = document.getElementById('new-topic-password').value.trim();
            const isAnon = document.getElementById('new-topic-anonymous').checked;

            if (!title) return;

            let expiresAt = null;
            if (isAnon) {
                const now = new Date();
                now.setHours(now.getHours() + 24);
                expiresAt = now.toISOString();
            }

            try {
                const { error } = await client.from('chat_topics').insert([{ 
                    title: isAnon ? `⏳ [限時] ${title}` : title, 
                    description: desc, 
                    password: password,
                    is_anonymous: isAnon,
                    expires_at: expiresAt
                }]);
                if (error) throw error;

                closeTopicModal();
                document.getElementById('new-topic-title').value = '';
                document.getElementById('new-topic-desc').value = '';
                document.getElementById('new-topic-password').value = '';
                document.getElementById('new-topic-anonymous').checked = false;
                
                fetchTopics();
                alert(isAnon ? "⏳ 已成功發起匿名限時討論區（將於 24 小時後自動銷毀）！" : "📌 成功建立新討論主題！");
            } catch (err) { alert("建立失敗: " + err.message); }
        }

        function toggleAdminNavbar() { document.getElementById('admin-navbar').classList.toggle('hidden'); }
        
        function handleAdminLogin() {
            if (document.getElementById('admin-password-input').value === defaultPassword) {
                isAdmin = true;
                document.getElementById('admin-logged-out').classList.add('hidden');
                document.getElementById('admin-logged-in').classList.remove('hidden');
                document.getElementById('btn-add-topic').classList.remove('hidden');
                renderTopicsList();
                alert("🟢 主理人權限已解鎖！");
            } else { alert("密碼錯誤"); }
        }

        function handleAdminLogout() {
            isAdmin = false;
            document.getElementById('admin-logged-out').classList.remove('hidden');
            document.getElementById('admin-logged-in').classList.add('hidden');
            document.getElementById('btn-add-topic').classList.add('hidden');
            renderTopicsList();
        }
    </script>
</Layout>