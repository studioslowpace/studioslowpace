---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="填寫訂單 - 結帳頁面">
  <div class="shop-container">
    <nav class="breadcrumb">
      <a href="/cart">購物車</a> <span class="sep">/</span> <span>填寫訂單</span>
    </nav>

    <h1 class="page-title">結帳</h1>

    <div class="checkout-grid">
      <!-- 左側：收件人與付款資訊表單 -->
      <div class="checkout-form-section">
        <form id="checkout-form">
          <h3>顧客資訊</h3>
          <div class="form-group">
            <label>姓名 *</label>
            <input type="text" id="name" required placeholder="請輸入全名" />
          </div>
          <div class="form-group">
            <label>電子郵件 *</label>
            <input type="email" id="email" required placeholder="name@example.com" />
          </div>
          <div class="form-group">
            <label>聯絡電話 *</label>
            <input type="tel" id="phone" required placeholder="請輸入電話號碼" />
          </div>

          <h3 class="mt-30">取貨 / 送貨方式</h3>
          <div class="delivery-options">
            <label class="radio-label option-card">
              <input type="radio" name="delivery" value="pickup" checked />
              <div class="option-info">
                <span class="option-title">店內自取</span>
                <span class="option-desc">留貨兩星期，開店期間憑訂單姓名及電話自取</span>
              </div>
            </label>
            <label class="radio-label option-card">
              <input type="radio" name="delivery" value="shipping" />
              <div class="option-info">
                <span class="option-title">郵寄</span>
                <span class="option-desc">郵費及收件地址會在下單後由店主發信/聯絡確認</span>
              </div>
            </label>
          </div>

          <!-- 選擇郵寄時動態顯示地址輸入欄位 -->
          <div class="form-group" id="address-group" style="display: none;">
            <label>收件地址 / 順豐站或智能櫃代碼</label>
            <textarea id="address" rows="3" placeholder="請輸入詳細郵寄地址或順豐站/智能櫃代碼"></textarea>
          </div>

          <h3 class="mt-30">付款方式</h3>
          <div class="payment-options">
            <label class="radio-label">
              <input type="radio" name="payment" value="fps_payme" checked /> 轉數快 (FPS) / PayMe
            </label>
            <label class="radio-label">
              <input type="radio" name="payment" value="cash" /> 現金 (Cash)
            </label>
          </div>

          <button type="submit" id="btn-submit" class="btn btn-submit-order">確認送出訂單</button>
        </form>
      </div>

      <!-- 右側：訂單摘要 -->
      <div class="checkout-summary-section">
        <h3>訂單摘要</h3>
        <div id="checkout-items-list" class="checkout-items-list">
          <!-- JS 動態載入 -->
        </div>
        <div class="summary-total-row">
          <span>應付總額</span>
          <span id="checkout-total-price" class="total-price">HK$0.00</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  interface CartItem {
    id?: string;
    title: string;
    price: number;
    currency: string;
    image: string;
    quantity: number;
  }

  const cart: CartItem[] = JSON.parse(localStorage.getItem('cart') || '[]');
  const listContainer = document.getElementById('checkout-items-list');
  const totalPriceEl = document.getElementById('checkout-total-price');
  const addressGroup = document.getElementById('address-group');
  const deliveryRadios = document.querySelectorAll('input[name="delivery"]');
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;

  if (cart.length === 0) {
    alert('您的購物車是空的，將返回首頁');
    window.location.href = '/';
  }

  // 渲染購物車清單
  let calculatedTotal = 0;
  if (listContainer && totalPriceEl) {
    let html = '';
    cart.forEach(item => {
      const itemTotal = item.price * item.quantity;
      calculatedTotal += itemTotal;
      html += `
        <div class="summary-item">
          <span class="summary-item-title">${item.title} × ${item.quantity}</span>
          <span class="summary-item-price">${item.currency || 'HK$'}${itemTotal.toFixed(2)}</span>
        </div>
      `;
    });
    listContainer.innerHTML = html;
    totalPriceEl.innerText = `HK$${calculatedTotal.toFixed(2)}`;
  }

  // 切換店內自取 / 郵寄時顯示或隱藏地址輸入框
  deliveryRadios.forEach(radio => {
    radio.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (addressGroup) {
        addressGroup.style.display = val === 'shipping' ? 'block' : 'none';
      }
    });
  });

  // 提交表單處理
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = '處理訂單中...';
    }

    const nameInput = (document.getElementById('name') as HTMLInputElement).value;
    const emailInput = (document.getElementById('email') as HTMLInputElement).value;
    const phoneInput = (document.getElementById('phone') as HTMLInputElement).value;
    const deliveryMethod = (document.querySelector('input[name="delivery"]:checked') as HTMLInputElement).value;
    const addressInput = (document.getElementById('address') as HTMLTextAreaElement).value;
    const paymentMethod = (document.querySelector('input[name="payment"]:checked') as HTMLInputElement).value;

    const deliveryText = deliveryMethod === 'pickup' 
      ? '店內自取 (留貨兩星期)' 
      : '郵寄 (郵費及收件地址下單後聯絡確認)';
      
    const paymentText = paymentMethod === 'fps_payme' 
      ? '轉數快 (FPS) / PayMe' 
      : '現金 (Cash)';

    // 1. 寫入 Supabase orders 表格
    const { data: orderData, error: dbError } = await supabase
      .from('orders')
      .insert([
        {
          customer_name: nameInput,
          customer_email: emailInput,
          customer_phone: phoneInput,
          delivery_method: deliveryText,
          address: deliveryMethod === 'shipping' ? addressInput : '店內自取',
          payment_method: paymentText,
          items: cart,
          total_price: calculatedTotal,
          status: 'pending'
        }
      ])
      .select()
      .single();

    if (dbError) {
      alert('訂單建立失敗：' + dbError.message);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerText = '確認送出訂單';
      }
      return;
    }

    // 2. 清空 LocalStorage 購物車
    localStorage.removeItem('cart');

    // 3. 提示並導回首頁
    alert(`🎉 訂單已成功送出！\n訂單編號：${orderData.id.slice(0, 8)}\n確認信將發送至您的 Email。`);
    window.location.href = '/';
  });
</script>

<style is:global>
  .shop-container { max-width: 1000px; margin: 0 auto; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #333; }
  .breadcrumb { padding: 10px 0; font-size: 14px; color: #666; border-bottom: 1px solid #eee; margin-bottom: 30px; }
  .breadcrumb a { color: #666; text-decoration: none; }
  .breadcrumb .sep { margin: 0 8px; color: #ccc; }
  .page-title { font-size: 22px; font-weight: 400; margin-bottom: 30px; }

  .checkout-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px; }
  @media (max-width: 768px) { .checkout-grid { grid-template-columns: 1fr; } }

  .checkout-form-section h3, .checkout-summary-section h3 { font-size: 15px; font-weight: 500; margin-bottom: 18px; border-bottom: 1px solid #eee; padding-bottom: 8px; color: #333; }
  .mt-30 { margin-top: 30px; }

  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; font-size: 12px; color: #666; margin-bottom: 6px; }
  .form-group input, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #ddd; font-size: 13px; outline: none; border-radius: 4px; box-sizing: border-box; }
  .form-group input:focus, .form-group textarea:focus { border-color: #c99e58; }

  .delivery-options, .payment-options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .option-card { border: 1px solid #eee; padding: 12px 15px; border-radius: 4px; background: #fafafa; transition: border-color 0.2s; }
  .option-card:has(input:checked) { border-color: #c99e58; background: #fff; }

  .radio-label { font-size: 13px; color: #333; display: flex; align-items: flex-start; gap: 10px; cursor: pointer; }
  .radio-label input[type="radio"] { margin-top: 3px; accent-color: #c99e58; }
  .option-info { display: flex; flex-direction: column; gap: 3px; }
  .option-title { font-weight: 500; color: #222; }
  .option-desc { font-size: 12px; color: #888; line-height: 1.4; }

  .btn-submit-order { background-color: #c99e58; color: #fff; width: 100%; padding: 14px; border: none; font-size: 14px; cursor: pointer; border-radius: 4px; letter-spacing: 0.5px; transition: opacity 0.2s; margin-top: 10px; }
  .btn-submit-order:hover { opacity: 0.9; }
  .btn-submit-order:disabled { background-color: #ccc; cursor: not-allowed; }

  .checkout-summary-section { background: #fafafa; border: 1px solid #eee; padding: 25px; border-radius: 4px; height: fit-content; }
  .checkout-items-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; max-height: 300px; overflow-y: auto; }
  .summary-item { display: flex; justify-content: space-between; font-size: 13px; color: #444; gap: 15px; }
  .summary-item-title { flex: 1; line-height: 1.4; }
  .summary-total-row { display: flex; justify-content: space-between; border-top: 1px solid #e5e5e5; padding-top: 15px; font-size: 15px; font-weight: 600; }
  .total-price { color: #111; font-size: 18px; }
</style>