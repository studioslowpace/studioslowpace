---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="檢索新圖書 — 空間客舍">
    <div class="literary-container">
        
        <!-- 頁面標題（文青風格留白與細緻排版） -->
        <header class="literary-header">
            <span class="sub-tag">空間客舍 · 藏書研究室</span>
            <h1>檢索新圖書</h1>
            <p class="intro-text">尋找字裡行間的星光，探索每一冊值得駐足的靈魂。</p>
        </header>

        <!-- 搜尋列區塊 -->
        <div class="search-section">
            <div class="search-bar-wrapper">
                <input type="text" id="query" placeholder="輸入書名、作者或 ISBN 條碼尋找圖書..." autocomplete="off">
                <button id="searchBtn" class="literary-btn">尋覓書籍</button>
            </div>
            <div id="status" class="status-msg">請在上方輸入關鍵字開始檢索。</div>
        </div>

        <!-- 檢索結果展示區 -->
        <div id="searchResults" class="results-grid"></div>

    </div>

    <!-- 核心互動指令碼 -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
    <script is:inline>
        const GOOGLE_API_KEY = "AIzaSyAALLccQZnHSWI0unwfM6zaS5M8ZzGi4i4";
        let currentSearchResults = []; 

        document.addEventListener("DOMContentLoaded", () => {
            const searchBtn = document.getElementById('searchBtn');
            const queryInput = document.getElementById('query');

            searchBtn.addEventListener('click', searchBooks);
            queryInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') searchBooks();
            });
        });

        async function searchBooks() {
            const queryInput = document.getElementById('query');
            const statusDiv = document.getElementById('status');
            const resultsDiv = document.getElementById('searchResults');
            
            const query = queryInput.value.trim();
            resultsDiv.innerHTML = '';
            currentSearchResults = [];
            
            if (!query) { 
                statusDiv.innerText = '⚠️ 請輸入關鍵字查詢。'; 
                return; 
            }

            statusDiv.innerText = '🍃 正在翻閱無垠書海，尋找相符的足跡...';
            const url = `https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(query)}&maxResults=6&key=${GOOGLE_API_KEY}`;

            try {
                const response = await fetch(url);
                const data = await response.json();
                const items = data.items || [];

                if (items.length === 0) {
                    statusDiv.innerText = '☕ 找不到相關的圖書記錄，試著換個作者或書名看看？';
                    return;
                }

                statusDiv.innerText = `✨ 找到 ${items.length} 冊契合的圖書：`;

                items.forEach((item, index) => {
                    const info = item.volumeInfo || {};
                    const title = info.title || '無題';
                    const authors = info.authors ? info.authors.join(' / ') : '佚名';
                    const publisher = info.publisher || '獨立出版';
                    const pubDate = info.publishedDate || '年代不詳';
                    const pageCount = info.pageCount ? `${info.pageCount} 頁` : '頁數未詳';
                    const description = info.description || '這本書暫無詳細的內容簡介。';
                    
                    let isbn = '無 ISBN';
                    if (info.industryIdentifiers) {
                        const id13 = info.industryIdentifiers.find(id => id.type === 'ISBN_13');
                        const id10 = info.industryIdentifiers.find(id => id.type === 'ISBN_10');
                        isbn = id13 ? id13.identifier : (id10 ? id10.identifier : info.industryIdentifiers[0].identifier);
                    }

                    let imgUrl = 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=300&q=80';
                    if (info.imageLinks && (info.imageLinks.thumbnail || info.imageLinks.smallThumbnail)) {
                        imgUrl = info.imageLinks.thumbnail || info.imageLinks.smallThumbnail;
                        imgUrl = imgUrl.replace(/^http:\/\//i, 'https://');
                        // 升級為高畫質縮圖
                        imgUrl = imgUrl.replace(/zoom=[0-9]/, 'zoom=2');
                    }

                    const bookObj = { title, authors, publisher, pubDate, pageCount, isbn, imgUrl, description };
                    currentSearchResults.push(bookObj);

                    // 建立文青風格美學卡片
                    const card = document.createElement('article');
                    card.className = 'literary-card';

                    card.innerHTML = `
                        <div class="card-cover-wrapper">
                            <img src="${bookObj.imgUrl}" alt="${bookObj.title}" loading="lazy">
                        </div>
                        <div class="card-content">
                            <div class="card-header-row">
                                <h2 class="book-title">${bookObj.title}</h2>
                                <span class="book-isbn">ISBN: ${bookObj.isbn}</span>
                            </div>
                            <p class="book-authors">著：${bookObj.authors}</p>
                            <div class="book-metadata">
                                <span>${bookObj.publisher}</span>
                                <span>·</span>
                                <span>${bookObj.pubDate}</span>
                                <span>·</span>
                                <span>${bookObj.pageCount}</span>
                            </div>
                            <p class="book-desc">${bookObj.description}</p>
                            <div class="card-actions">
                                <button class="literary-btn-sm" onclick="copyBookDetails(${index})">📋 複製書本資料</button>
                                <button class="literary-btn-sm outline" onclick="window.open('https://www.google.com/search?q=${encodeURIComponent(bookObj.title + ' ' + bookObj.authors)}', '_blank')">🔍 探索更多</button>
                            </div>
                        </div>
                    `;

                    resultsDiv.appendChild(card);
                });

            } catch (error) {
                console.error(error);
                statusDiv.innerText = '💥 網路連結微恙，請稍後再試。';
            }
        }

        function copyBookDetails(index) {
            const b = currentSearchResults[index];
            const text = `【書籍資訊】\n書名：${b.title}\n作者：${b.authors}\n出版社：${b.publisher} (${b.pubDate})\n頁數：${b.pageCount}\nISBN：${b.isbn}\n簡介：${b.description}`;
            navigator.clipboard.writeText(text).then(() => {
                alert('✒️ 已經將這冊書的詳細文字收進剪貼簿中。');
            });
        }
    </script>

    <style is:global>
        :root {
            --bg-paper: #f4f1ea;        /* 溫潤宣紙米色 */
            --card-surface: #faf8f5;    /* 卡片浮雕色 */
            --text-ink: #2b2927;        /* 墨色深灰 */
            --text-muted: #78746c;      /* 沉穩亞麻灰 */
            --accent-green: #4a5c4e;    /* 沉靜松針綠 */
            --accent-green-hover: #3b4c3f;
            --border-line: #e2ddd5;     /* 柔和分隔線 */
            --shadow-subtle: 0 10px 30px rgba(43, 41, 39, 0.04);
        }

        body {
            background-color: var(--bg-paper);
            color: var(--text-ink);
            font-family: "Noto Serif TC", "Songti TC", Georgia, serif;
            margin: 0;
            padding: 0;
            line-height: 1.8;
        }

        .literary-container {
            max-width: 900px;
            margin: 60px auto;
            padding: 0 24px;
        }

        /* 頂部文青標題 */
        .literary-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .sub-tag {
            font-size: 13px;
            letter-spacing: 0.2em;
            color: var(--text-muted);
            text-transform: uppercase;
            display: block;
            margin-bottom: 12px;
        }

        .literary-header h1 {
            font-size: 32px;
            font-weight: 400;
            letter-spacing: 0.05em;
            color: var(--text-ink);
            margin: 0 0 12px 0;
        }

        .intro-text {
            font-size: 15px;
            color: var(--text-muted);
            font-style: italic;
            margin: 0;
        }

        /* 搜尋列 */
        .search-section {
            margin-bottom: 40px;
        }

        .search-bar-wrapper {
            display: flex;
            gap: 12px;
            background: var(--card-surface);
            padding: 8px;
            border-radius: 50px;
            border: 1px solid var(--border-line);
            box-shadow: var(--shadow-subtle);
        }

        input[type="text"] {
            flex: 1;
            background: transparent;
            border: none;
            padding: 12px 24px;
            font-size: 15px;
            color: var(--text-ink);
            outline: none;
            font-family: inherit;
        }

        input[type="text"]::placeholder {
            color: #b3aea4;
        }

        .literary-btn {
            background-color: var(--accent-green);
            color: #fff;
            border: none;
            padding: 12px 28px;
            border-radius: 40px;
            font-size: 14px;
            letter-spacing: 0.1em;
            cursor: pointer;
            transition: background 0.3s ease;
            font-family: inherit;
        }

        .literary-btn:hover {
            background-color: var(--accent-green-hover);
        }

        .status-msg {
            text-align: center;
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 14px;
            letter-spacing: 0.05em;
        }

        /* 檢索結果清單（單欄大卡片，極具散文集或書單質感） */
        .results-grid {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .literary-card {
            background: var(--card-surface);
            border: 1px solid var(--border-line);
            border-radius: 16px;
            padding: 28px;
            display: flex;
            gap: 24px;
            box-shadow: var(--shadow-subtle);
            transition: transform 0.3s ease;
        }

        .literary-card:hover {
            transform: translateY(-2px);
        }

        @media (max-width: 680px) {
            .literary-card {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }
        }

        .card-cover-wrapper img {
            width: 110px;
            height: 160px;
            object-fit: cover;
            border-radius: 6px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.08);
            background-color: #eee;
        }

        .card-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .card-header-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 8px;
        }

        .book-title {
            font-size: 18px;
            font-weight: 500;
            color: var(--text-ink);
            margin: 0;
        }

        .book-isbn {
            font-size: 12px;
            color: var(--text-muted);
            letter-spacing: 0.05em;
        }

        .book-authors {
            font-size: 14px;
            color: var(--accent-green);
            margin: 0;
            font-weight: 500;
        }

        .book-metadata {
            font-size: 12px;
            color: var(--text-muted);
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .book-desc {
            font-size: 13px;
            color: #5c574f;
            line-height: 1.7;
            margin: 6px 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .card-actions {
            display: flex;
            gap: 10px;
            margin-top: 8px;
        }

        .literary-btn-sm {
            background-color: var(--accent-green);
            color: #fff;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: opacity 0.2s;
            font-family: inherit;
        }

        .literary-btn-sm.outline {
            background-color: transparent;
            color: var(--text-ink);
            border: 1px solid var(--border-line);
        }

        .literary-btn-sm:hover {
            opacity: 0.85;
        }
    </style>
</BaseLayout>