---
// 完全不載入 BaseLayout，獨立渲染
---

<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>檢索新圖書 — 空間客舍</title>
</head>
<body>

    <div class="literary-container">
        <!-- 頁面標題 -->
        <header class="literary-header">
            <span class="sub-tag">空間客舍 · 藏書研究室</span>
            <h1>檢索新圖書</h1>
            <p class="intro-text">尋找字裡行間的星光，探索每一冊值得駐足的靈魂。</p>
        </header>

        <!-- 搜尋列區塊 -->
        <div class="search-section">
            <div class="search-bar-wrapper">
                <input type="text" id="query" placeholder="輸入書名、作者或 ISBN 條碼尋找圖書..." autocomplete="off">
                <button id="searchBtn" class="literary-btn">尋覓書籍</button>
            </div>
            <div id="status" class="status-msg">請在上方輸入關鍵字開始檢索。</div>
        </div>

        <!-- 檢索結果展示區 -->
        <div id="searchResults" class="results-grid"></div>
    </div>

    <!-- 核心互動指令碼 -->
    <script>
        const GOOGLE_API_KEY = "AIzaSyAALLccQZnHSWI0unwfM6zaS5M8ZzGi4i4";
        let currentSearchResults = []; 

        document.addEventListener("DOMContentLoaded", () => {
            const searchBtn = document.getElementById('searchBtn');
            const queryInput = document.getElementById('query');

            if (searchBtn) searchBtn.addEventListener('click', searchBooks);
            if (queryInput) {
                queryInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') searchBooks();
                });
            }
        });

        async function searchBooks() {
            const queryInput = document.getElementById('query');
            const statusDiv = document.getElementById('status');
            const resultsDiv = document.getElementById('searchResults');
            
            if (!queryInput) return;
            const query = queryInput.value.trim();
            resultsDiv.innerHTML = '';
            currentSearchResults = [];
            
            if (!query) { 
                statusDiv.innerText = '⚠️ 請輸入關鍵字查詢。'; 
                return; 
            }

            statusDiv.innerText = '🍃 正在翻閱無垠書海，尋找相符的足跡...';
            const url = `https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(query)}&maxResults=6&key=${GOOGLE_API_KEY}`;

            try {
                const response = await fetch(url);
                const data = await response.json();
                const items = data.items || [];

                if (items.length === 0) {
                    statusDiv.innerText = '☕ 找不到相關的圖書記錄，試著換個作者或書名看看？';
                    return;
                }

                statusDiv.innerText = `✨ 找到 ${items.length} 冊契合的圖書：`;

                const htmlContent = items.map((item, index) => {
                    const info = item.volumeInfo || {};
                    const title = info.title || '無題';
                    const authors = info.authors ? info.authors.join(' / ') : '佚名';
                    const publisher = info.publisher || '獨立出版';
                    const pubDate = info.publishedDate || '年代不詳';
                    const pageCount = info.pageCount ? `${info.pageCount} 頁` : '頁數未詳';
                    const description = info.description || '這本書暫無詳細的內容簡介。';
                    
                    let isbn = '無 ISBN';
                    if (info.industryIdentifiers) {
                        const id13 = info.industryIdentifiers.find(id => id.type === 'ISBN_13');
                        const id10 = info.industryIdentifiers.find(id => id.type === 'ISBN_10');
                        isbn = id13 ? id13.identifier : (id10 ? id10.identifier : info.industryIdentifiers[0].identifier);
                    }

                    let imgUrl = 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=300&q=80';
                    if (info.imageLinks && (info.imageLinks.thumbnail || info.imageLinks.smallThumbnail)) {
                        imgUrl = info.imageLinks.thumbnail || info.imageLinks.smallThumbnail;
                        imgUrl = imgUrl.replace(/^http:\/\//i, 'https://');
                        imgUrl = imgUrl.replace(/zoom=[0-9]/, 'zoom=2');
                    }

                    currentSearchResults.push({ title, authors, publisher, pubDate, pageCount, isbn, imgUrl, description });

                    return `
                        <article class="literary-card">
                            <div class="card-cover-wrapper">
                                <img src="${imgUrl}" alt="${title}" loading="lazy">
                            </div>
                            <div class="card-content">
                                <div class="card-header-row">
                                    <h2 class="book-title">${title}</h2>
                                    <span class="book-isbn">ISBN: ${isbn}</span>
                                </div>
                                <p class="book-authors">著：${authors}</p>
                                <div class="book-metadata">
                                    <span>${publisher}</span>
                                    <span>·</span>
                                    <span>${pubDate}</span>
                                    <span>·</span>
                                    <span>${pageCount}</span>
                                </div>
                                <p class="book-desc">${description}</p>
                                <div class="card-actions">
                                    <button class="literary-btn-sm" onclick="copyBookDetails(${index})">📋 複製書本資料</button>
                                    <button class="literary-btn-sm outline" onclick="window.open('https://www.google.com/search?q=${encodeURIComponent(title + ' ' + authors)}', '_blank')">🔍 探索更多</button>
                                </div>
                            </div>
                        </article>
                    `;
                }).join('');

                resultsDiv.innerHTML = htmlContent;

            } catch (error) {
                console.error(error);
                statusDiv.innerText = '💥 網路連結微恙，請稍後再試。';
            }
        }

        window.copyBookDetails = function(index) {
            const b = currentSearchResults[index];
            const text = `【書籍資訊】\n書名：${b.title}\n作者：${b.authors}\n出版社：${b.publisher} (${b.pubDate})\n頁數：${b.pageCount}\nISBN：${b.isbn}\n簡介：${b.description}`;
            navigator.clipboard.writeText(text).then(() => {
                alert('✒️ 已經將這冊書的詳細文字收進剪貼簿中。');
            });
        };
    </script>

    <!-- 獨立樣式 -->
    <style>
        body {
            background-color: #f4f1ea;
            color: #2b2927;
            font-family: "Noto Serif TC", "Songti TC", Georgia, serif;
            margin: 0;
            padding: 0;
            line-height: 1.8;
        }

        .literary-container {
            max-width: 900px;
            margin: 60px auto;
            padding: 0 24px;
        }

        .literary-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .sub-tag {
            font-size: 13px;
            letter-spacing: 0.2em;
            color: #78746c;
            text-transform: uppercase;
            display: block;
            margin-bottom: 12px;
        }

        .literary-header h1 {
            font-size: 32px;
            font-weight: 400;
            letter-spacing: 0.05em;
            color: #2b2927;
            margin: 0 0 12px 0;
        }

        .intro-text {
            font-size: 15px;
            color: #78746c;
            font-style: italic;
            margin: 0;
        }

        .search-section {
            margin-bottom: 40px;
        }

        .search-bar-wrapper {
            display: flex;
            gap: 12px;
            background: #faf8f5;
            padding: 8px;
            border-radius: 50px;
            border: 1px solid #e2ddd5;
            box-shadow: 0 10px 30px rgba(43, 41, 39, 0.04);
        }

        #query {
            flex: 1;
            background: transparent;
            border: none;
            padding: 12px 24px;
            font-size: 15px;
            color: #2b2927;
            outline: none;
            font-family: inherit;
        }

        #query::placeholder {
            color: #b3aea4;
        }

        .literary-btn {
            background-color: #4a5c4e;
            color: #fff;
            border: none;
            padding: 12px 28px;
            border-radius: 40px;
            font-size: 14px;
            letter-spacing: 0.1em;
            cursor: pointer;
            transition: background 0.3s ease;
            font-family: inherit;
        }

        .literary-btn:hover {
            background-color: #3b4c3f;
        }

        .status-msg {
            text-align: center;
            font-size: 13px;
            color: #78746c;
            margin-top: 14px;
            letter-spacing: 0.05em;
        }

        .results-grid {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .literary-card {
            background: #faf8f5;
            border: 1px solid #e2ddd5;
            border-radius: 16px;
            padding: 28px;
            display: flex;
            gap: 24px;
            box-shadow: 0 10px 30px rgba(43, 41, 39, 0.04);
            align-items: flex-start;
        }

        @media (max-width: 680px) {
            .literary-card {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }
        }

        .card-cover-wrapper img {
            width: 110px;
            height: 160px;
            object-fit: cover;
            border-radius: 6px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.08);
            background-color: #eee;
        }

        .card-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .card-header-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 8px;
        }

        .book-title {
            font-size: 18px;
            font-weight: 500;
            color: #2b2927;
            margin: 0;
        }

        .book-isbn {
            font-size: 12px;
            color: #78746c;
            letter-spacing: 0.05em;
        }

        .book-authors {
            font-size: 14px;
            color: #4a5c4e;
            margin: 0;
            font-weight: 500;
        }

        .book-metadata {
            font-size: 12px;
            color: #78746c;
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .book-desc {
            font-size: 13px;
            color: #5c574f;
            line-height: 1.7;
            margin: 6px 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .card-actions {
            display: flex;
            gap: 10px;
            margin-top: 8px;
        }

        .literary-btn-sm {
            background-color: #4a5c4e;
            color: #fff;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: opacity 0.2s;
            font-family: inherit;
        }

        .literary-btn-sm.outline {
            background-color: transparent;
            color: #2b2927;
            border: 1px solid #e2ddd5;
        }

        .literary-btn-sm:hover {
            opacity: 0.85;
        }
    </style>
</body>
</html>