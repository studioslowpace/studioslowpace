---
import Layout from '../layouts/BaseLayout.astro';
---
<Layout title="會員登入 · 空間客舍">
  <div style="max-width: 400px; margin: 100px auto; padding: 20px; background: #1e293b; border-radius: 8px; color: #fff; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
    <h2>🔐 會員登入</h2>
    <input type="email" id="login-email" placeholder="電子信箱 (Email)" style="width:100%; padding:10px; margin-bottom:10px; background:#0f172a; color:#fff; border:1px solid #334155; border-radius:4px; box-sizing:border-box;" />
    <input type="password" id="login-password" placeholder="密碼" style="width:100%; padding:10px; margin-bottom:10px; background:#0f172a; color:#fff; border:1px solid #334155; border-radius:4px; box-sizing:border-box;" />
    
    <button id="login-submit-btn" style="width:100%; padding:10px; background:#0284c7; color:#fff; border:none; border-radius:4px; font-weight:bold; cursor:pointer; margin-bottom: 12px;">登入</button>
    
    <div style="text-align: right;">
      <button id="forgot-password-btn" style="background: none; border: none; color: #38bdf8; cursor: pointer; font-size: 0.85rem; text-decoration: underline; padding: 0;">忘記密碼？</button>
    </div>
  </div>

  <script>
    import { supabase } from '../utils/auth';

    // 登入按鈕事件
    document.getElementById('login-submit-btn')?.addEventListener('click', async () => {
      const email = (document.getElementById('login-email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('login-password') as HTMLInputElement).value.trim();

      if (!email || !password) {
        alert('請完整填寫 Email 與密碼');
        return;
      }

      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        alert('登入失敗：' + error.message);
      } else {
        alert('登入成功！');
        window.location.href = '/'; // 登入後自動導向 2D 空間主頁
      }
    });

    // 忘記密碼按鈕事件（已修正 ID 對應至 #login-email）
    document.getElementById('forgot-password-btn')?.addEventListener('click', async () => {
      const email = (document.getElementById('login-email') as HTMLInputElement).value.trim();
      
      if (!email) {
        alert('請先在上方欄位輸入您的電子信箱 (Email)');
        return;
      }

      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/profile`, // 重設密碼後導向的頁面
      });

      if (error) {
        alert('發送重設密碼信失敗：' + error.message);
      } else {
        alert('重設密碼信已發送！請檢查您的電子信箱（包含垃圾郵件匣）。');
      }
    });
  </script>
</Layout>