---
// src/pages/login.astro
import Layout from '../layouts/BaseLayout.astro';
import LoginModal from '../components/LoginModal.astro';
---
<Layout title="會員登入 · 空間客舍">
  <div style="max-width: 400px; margin: 80px auto; padding: 20px; background: #1e293b; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
    <LoginModal />
  </div>
</Layout>
<script>
  import { supabase } from '../lib/supabase';

  // 方法二：直接用 Supabase 狀態監聽（只要偵測到登入狀態成立就自動跳轉）
  supabase.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_IN' && session) {
      window.location.href = '/profile';
    }
  });
</script>