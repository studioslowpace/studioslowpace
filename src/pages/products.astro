---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="空間客舍 - 商品管理系統">
<Fragment slot="head">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</Fragment>

    <style is:global>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html, body {
            height: 100%;
        }
        body {
            background-color: #ebf3dd; 
            font-family: "Noto Sans TC", sans-serif;
            color: #4A4A4A;
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            width: 100%;
        }
        body.admin-mode { background: #f0f4f8; }

        :root {
            --bg-color: #f7f5f2;
            --card-bg: #ebf3dd;
            --text-main: #333333;
            --text-muted: #999999;
            --primary-green: #4CAF50;
            --danger-red: #d9534f;
            --primary-blue: #2b579a;
            --border-color: #efefef;
        }

        .container { 
            max-width: 1100px; 
            background: var(--card-bg); 
            padding: 25px; 
            border-radius: 16px; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.05); 
            margin: 20px auto;
            width: 100%;
            box-sizing: border-box;
        }

        .header-section { 
            display: flex; 
            flex-direction: column;
            gap: 14px; 
            margin-bottom: 18px; 
        }

        .title-area { 
            display: flex; 
            align-items: baseline;
            justify-content: flex-start;
            width: 100%;
            gap: 15px;
        }
        .title-area h1 { 
            margin: 0; 
            font-size: 36px; 
            color: var(--primary-blue); 
            letter-spacing: 2px; 
            font-weight: bold; 
            line-height: 1;
        }

        .logo-img {
            display: inline-block;
            vertical-align: baseline;
        }

        /* 工具列與篩選按鈕 */
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .filter-group, .action-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        button, select, input {
            padding: 10px 14px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 15px;
            box-sizing: border-box;
        }
        button { cursor: pointer; background: var(--primary-blue); color: white; border: none; }
        button:hover { background: #1e3f70; }
        .btn-secondary { background: #888; }
        .btn-secondary:hover { background: #666; }
        .btn-danger { background: var(--danger-red); }
        .btn-danger:hover { background: #b52b27; }
        .btn-success { background: var(--primary-green); }
        .btn-success:hover { background: #388E3C; }

        /* 商品表格 */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            border-bottom: 1px solid var(--border-color);
            padding: 12px 15px;
            text-align: left;
            font-size: 15px;
        }
        th { background: #f0f4f8; color: #333; font-weight: bold; }
        tr:hover { background: #fafafa; }
        .product-img {
            width: 45px;
            height: 45px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #ddd;
        }

        /* 彈窗樣式 */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
            display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.3s ease; z-index: 900;
        }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        .modal-card {
            background: white; padding: 25px; border-radius: 12px;
            width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15); box-sizing: border-box;
        }
        .modal-card h3 { margin-top: 0; color: #333; font-size: 20px; margin-bottom: 15px; }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block; font-weight: bold; margin-bottom: 5px; font-size: 14px; color: #333;
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 6px; border: 1px solid #ccc; font-size: 15px;
        }
        .modal-buttons {
            display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;
        }
    </style>

<div class="container">
    <div class="header-section">
        <div class="title-area">
            <img src="/images/logo-small2.png" alt="Logo" class="logo-img" style="width: 45px; height: 45px;" oncontextmenu="return false;" ondragstart="return false;">
            <h1>商品管理系統</h1>
        </div>
    </div>

    <!-- 上方工具列：大總類篩選與功能按鈕 -->
    <div class="toolbar">
        <div class="filter-group">
            <button onclick="filterCategory('ALL')" class="btn-secondary">全部商品</button>
            <button onclick="filterCategory('全新書')">全新書</button>
            <button onclick="filterCategory('二手書')">二手書</button>
            <button onclick="filterCategory('小誌(Zine)')">小誌(Zine)</button>
            <button onclick="filterCategory('文創產品')">文創產品</button>
        </div>
        <div class="action-group">
            <button onclick="openAddModal()" class="btn-success">➕ 新增商品</button>
        </div>
    </div>

    <!-- 商品列表表格 -->
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>圖片</th>
                    <th>名稱</th>
                    <th>大總類</th>
                    <th>分類</th>
                    <th>價格</th>
                    <th>庫存</th>
                    <th id="th-dynamic-col">出版日期</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody id="product-table-body">
                <!-- 由 JS 動態載入 -->
            </tbody>
        </table>
    </div>
</div>

<!-- 新增/編輯商品彈窗 -->
<div class="modal-overlay" id="productModal">
    <div class="modal-card">
        <h3 id="modal-title">新增商品</h3>
        <input type="hidden" id="p-id">

        <div class="form-group">
            <label>大總類：</label>
            <select id="p-main-category" onchange="onMainCategoryChange()">
                <option value="全新書">全新書</option>
                <option value="二手書">二手書</option>
                <option value="小誌(Zine)">小誌(Zine)</option>
                <option value="文創產品">文創產品</option>
            </select>
        </div>

        <div class="form-group">
            <label>分類：</label>
            <select id="p-sub-category">
                <!-- 動態載入子分類 -->
            </select>
        </div>

        <div class="form-group">
            <label>商品名稱：</label>
            <input type="text" id="p-name" placeholder="請輸入商品名稱">
        </div>

        <div class="form-group">
            <label>價格 (HKD)：</label>
            <input type="number" id="p-price" placeholder="0">
        </div>

        <div class="form-group">
            <label>庫存數量：</label>
            <input type="number" id="p-stock" placeholder="0">
        </div>

        <div class="form-group">
            <label id="lbl-creator">作者：</label>
            <input type="text" id="p-creator" placeholder="請輸入作者">
        </div>

        <div class="form-group">
            <label id="lbl-spec">出版社：</label>
            <input type="text" id="p-spec" placeholder="請輸入出版社">
        </div>

        <div class="form-group">
            <label id="lbl-date">出版日期：</label>
            <input type="date" id="p-date">
        </div>

        <div class="form-group">
            <label>圖片網址 (Image URL)：</label>
            <input type="text" id="p-image" placeholder="/images/products/sample.jpg">
        </div>

        <div class="modal-buttons">
            <button class="btn-secondary" onclick="closeModal()">取消</button>
            <button onclick="saveProduct()">儲存商品</button>
        </div>
    </div>
</div>

<script>
// --- Supabase 設定 ---
const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
const TABLE_NAME = 'products'; 

window.client = window.client || (window.supabase ? window.supabase.createClient(supabaseUrl, supabaseKey) : null);
const client = window.client;

let allProducts = [];
let currentFilter = 'ALL';

// --- 分類對應對照表 ---
const categoryMap = {
    '全新書': ['小說', '散文', '詩集', '非中文書', '簡體字書', '其他'],
    '二手書': ['小說', '散文', '詩集', '非中文書', '簡體字書', '其他'],
    '小誌(Zine)': ['主打內容', '主打設計', '主打實驗'],
    '文創產品': ['明信片', '文具', '日常用品', '飾物']
};

// --- 初始化載入 ---
async function initProducts() {
    await fetchProducts();
}

async function fetchProducts() {
    if (!client) {
        allProducts = [];
        renderTable();
        return;
    }
    const { data, error } = await client.from(TABLE_NAME).select('*');
    if (!error && data) {
        allProducts = data;
        renderTable();
    } else {
        console.error("無法取得商品資料:", error);
    }
}

window.addEventListener('DOMContentLoaded', initProducts);

// --- 篩選與回到主頁 ---
window.filterCategory = function(cat) {
    if (cat === 'ALL') {
        // 按全部商品回到 products 主頁
        window.location.href = '/products'; 
    } else {
        currentFilter = cat;
        renderTable();
    }
};

// --- 渲染表格 ---
function renderTable() {
    const tbody = document.getElementById('product-table-body');
    const thDynamic = document.getElementById('th-dynamic-col');
    
    if (currentFilter === '小誌(Zine)' || currentFilter === '文創產品') {
        thDynamic.innerText = "推出日期";
    } else {
        thDynamic.innerText = "出版日期";
    }

    const filtered = currentFilter === 'ALL' 
        ? allProducts 
        : allProducts.filter(p => p.main_category === currentFilter);

    if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; color:#888; padding: 20px;">暫無相關商品</td></tr>`;
        return;
    }

    tbody.innerHTML = filtered.map(p => `
        <tr>
            <td><img src="${p.image || '/images/logo-small2.png'}" class="product-img" alt="商品圖片"></td>
            <td><strong>${p.name}</strong></td>
            <td>${p.main_category || '全新書'}</td>
            <td>${p.sub_category || '-'}</td>
            <td>$${p.price || 0}</td>
            <td>${p.stock || 0}</td>
            <td>${p.date || '-'}</td>
            <td>
                <button onclick="openEditModal('${p.id}')" style="padding: 6px 12px; font-size: 13px;">編輯</button>
                <button onclick="deleteProduct('${p.id}')" class="btn-danger" style="padding: 6px 12px; font-size: 13px; margin-left: 5px;">刪除</button>
            </td>
        </tr>
    `).join('');
}

// --- 當大總類變更時，自動更新子分類與欄位名稱 ---
window.onMainCategoryChange = function() {
    const mainCat = document.getElementById('p-main-category').value;
    const subSelect = document.getElementById('p-sub-category');
    
    const subCategories = categoryMap[mainCat] || [];
    subSelect.innerHTML = subCategories.map(sub => `<option value="${sub}">${sub}</option>`).join('');

    const lblCreator = document.getElementById('lbl-creator');
    const lblSpec = document.getElementById('lbl-spec');
    const lblDate = document.getElementById('lbl-date');

    const inputCreator = document.getElementById('p-creator');
    const inputSpec = document.getElementById('p-spec');
    const inputDate = document.getElementById('p-date');

    if (mainCat === '小誌(Zine)' || mainCat === '文創產品') {
        lblCreator.innerText = "創作者：";
        inputCreator.placeholder = "請輸入創作者";
        lblSpec.innerText = "尺寸：";
        inputSpec.placeholder = "請輸入尺寸";
        lblDate.innerText = "推出日期：";
    } else {
        lblCreator.innerText = "作者：";
        inputCreator.placeholder = "請輸入作者";
        lblSpec.innerText = "出版社：";
        inputSpec.placeholder = "請輸入出版社";
        lblDate.innerText = "出版日期：";
    }
};

// --- 開啟新增彈窗 ---
window.openAddModal = function() {
    document.getElementById('modal-title').innerText = "新增商品";
    document.getElementById('p-id').value = "";
    document.getElementById('p-main-category').value = "全新書";
    onMainCategoryChange();
    document.getElementById('p-name').value = "";
    document.getElementById('p-price').value = "";
    document.getElementById('p-stock').value = "";
    document.getElementById('p-creator').value = "";
    document.getElementById('p-spec').value = "";
    document.getElementById('p-date').value = "";
    document.getElementById('p-image').value = "";

    document.getElementById('productModal').classList.add('active');
};

// --- 開啟編輯彈窗 ---
window.openEditModal = function(id) {
    const product = allProducts.find(p => p.id == id);
    if (!product) return;

    document.getElementById('modal-title').innerText = "編輯商品";
    document.getElementById('p-id').value = product.id;
    document.getElementById('p-main-category').value = product.main_category || '全新書';
    onMainCategoryChange(); 
    document.getElementById('p-sub-category').value = product.sub_category || '';
    document.getElementById('p-name').value = product.name || '';
    document.getElementById('p-price').value = product.price || 0;
    document.getElementById('p-stock').value = product.stock || 0;
    document.getElementById('p-creator').value = product.creator || '';
    document.getElementById('p-spec').value = product.spec || '';
    document.getElementById('p-date').value = product.date || '';
    document.getElementById('p-image').value = product.image || '';

    document.getElementById('productModal').classList.add('active');
};

window.closeModal = function() {
    document.getElementById('productModal').classList.remove('active');
};

// --- 儲存商品（新增或更新） ---
window.saveProduct = async function() {
    const id = document.getElementById('p-id').value;
    const main_category = document.getElementById('p-main-category').value;
    const sub_category = document.getElementById('p-sub-category').value;
    const name = document.getElementById('p-name').value.trim();
    const price = parseFloat(document.getElementById('p-price').value) || 0;
    const stock = parseInt(document.getElementById('p-stock').value) || 0;
    const creator = document.getElementById('p-creator').value.trim();
    const spec = document.getElementById('p-spec').value.trim();
    const date = document.getElementById('p-date').value;
    const image = document.getElementById('p-image').value.trim();

    if (!name) {
        alert("請輸入商品名稱！");
        return;
    }

    const payload = { main_category, sub_category, name, price, stock, creator, spec, date, image };

    if (!client) {
        alert("尚未連線至 Supabase 資料庫");
        return;
    }

    if (id) {
        const { error } = await client.from(TABLE_NAME).update(payload).eq('id', id);
        if (error) {
            alert("更新失敗: " + error.message);
            return;
        }
    } else {
        const { error } = await client.from(TABLE_NAME).insert([payload]);
        if (error) {
            alert("新增失敗: " + error.message);
            return;
        }
    }

    closeModal();
    fetchData();
};

// --- 刪除商品 ---
window.deleteProduct = async function(id) {
    if (!confirm("確定要刪除此商品嗎？")) return;
    if (!client) return;

    const { error } = await client.from(TABLE_NAME).delete().eq('id', id);
    if (!error) {
        fetchData();
    } else {
        alert("刪除失敗: " + error.message);
    }
};
</script>
</BaseLayout>