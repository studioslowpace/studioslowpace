---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="購物車 - 商店主頁">
  <div class="shop-container">
    <nav class="breadcrumb">
      <a href="/">全部商品</a> <span class="sep">/</span> <span>購物車</span>
    </nav>

    <h1 class="page-title">您的購物車</h1>

    <!-- 購物車列表內容 (透過 JS 動態渲染) -->
    <div id="cart-content-wrapper">
      <div id="cart-items-container" class="cart-items-list">
        <!-- JS 動態填入 -->
      </div>

      <!-- 結帳總結區塊 -->
      <div id="cart-summary" class="cart-summary-section" style="display: none;">
        <div class="summary-row">
          <span>總計金額</span>
          <span id="cart-total-price" class="total-price">HK$0.00</span>
        </div>
        <div class="summary-actions">
          <a href="/checkout" class="btn btn-checkout">前往結帳</a>
        </div>
      </div>
    </div>

    <!-- 空購物車提示 -->
    <div id="cart-empty" class="cart-empty" style="display: none;">
      <p>目前購物車是空的</p>
      <a href="/" class="btn btn-shop-now">去選購商品</a>
    </div>
  </div>
</Layout>

<script>
  interface CartItem {
    id: string;
    title: string;
    price: number;
    currency: string;
    image: string;
    quantity: number;
  }

  function renderCart() {
    const container = document.getElementById('cart-items-container');
    const summary = document.getElementById('cart-summary');
    const emptyView = document.getElementById('cart-empty');
    const totalPriceEl = document.getElementById('cart-total-price');

    const cart: CartItem[] = JSON.parse(localStorage.getItem('cart') || '[]');

    if (!container || !summary || !emptyView || !totalPriceEl) return;

    if (cart.length === 0) {
      container.innerHTML = '';
      summary.style.display = 'none';
      emptyView.style.display = 'block';
      return;
    }

    emptyView.style.display = 'none';
    summary.style.display = 'block';

    let html = '';
    let total = 0;

    cart.forEach((item, index) => {
      const itemTotal = item.price * item.quantity;
      total += itemTotal;
      html += `
        <div class="cart-item">
          <div class="cart-item-img">
            <img src="${item.image || 'https://via.placeholder.com/150'}" alt="${item.title}" />
          </div>
          <div class="cart-item-details">
            <h4 class="cart-item-title">${item.title}</h4>
            <div class="cart-item-price">${item.currency || 'HK$'}${item.price.toFixed(2)}</div>
          </div>
          <div class="cart-item-qty">
            <button class="qty-btn minus-btn" data-index="${index}">-</button>
            <span>${item.quantity}</span>
            <button class="qty-btn plus-btn" data-index="${index}">+</button>
          </div>
          <div class="cart-item-subtotal">
            ${item.currency || 'HK$'}${itemTotal.toFixed(2)}
          </div>
          <div class="cart-item-remove">
            <button class="remove-btn" data-index="${index}">刪除</button>
          </div>
        </div>
      `;
    });

    container.innerHTML = html;
    totalPriceEl.innerText = `HK$${total.toFixed(2)}`;

    // 綁定數量加減與刪除事件
    document.querySelectorAll('.minus-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        if (cart[idx].quantity > 1) {
          cart[idx].quantity -= 1;
        } else {
          cart.splice(idx, 1);
        }
        localStorage.setItem('cart', JSON.stringify(cart));
        renderCart();
      });
    });

    document.querySelectorAll('.plus-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        cart[idx].quantity += 1;
        localStorage.setItem('cart', JSON.stringify(cart));
        renderCart();
      });
    });

    document.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        cart.splice(idx, 1);
        localStorage.setItem('cart', JSON.stringify(cart));
        renderCart();
      });
    });
  }

  renderCart();
</script>

<style>
  .shop-container { max-width: 900px; margin: 0 auto; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #333; }
  .breadcrumb { padding: 10px 0; font-size: 14px; color: #666; border-bottom: 1px solid #eee; margin-bottom: 30px; }
  .breadcrumb a { color: #666; text-decoration: none; }
  .breadcrumb .sep { margin: 0 8px; color: #ccc; }
  .page-title { font-size: 22px; font-weight: 400; margin-bottom: 30px; }

  .cart-items-list { display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px; }
  .cart-item { display: flex; align-items: center; gap: 20px; padding-bottom: 20px; border-bottom: 1px solid #eee; }
  .cart-item-img { width: 70px; height: 85px; background: #eaeaea; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cart-item-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .cart-item-details { flex: 1; }
  .cart-item-title { font-size: 14px; font-weight: 400; margin: 0 0 6px 0; color: #333; }
  .cart-item-price { font-size: 13px; color: #666; }
  .cart-item-qty { display: flex; align-items: center; gap: 10px; border: 1px solid #ddd; padding: 4px 8px; }
  .qty-btn { background: none; border: none; cursor: pointer; font-size: 14px; }
  .cart-item-subtotal { font-size: 14px; font-weight: 600; width: 90px; text-align: right; }
  .remove-btn { background: none; border: none; color: #999; cursor: pointer; font-size: 12px; }
  .remove-btn:hover { color: #ff4d4f; }

  .cart-summary-section { border-top: 1px solid #eee; padding-top: 25px; display: flex; flex-direction: column; align-items: flex-end; }
  .summary-row { display: flex; gap: 40px; font-size: 16px; margin-bottom: 20px; }
  .total-price { font-weight: 700; color: #111; }
  .btn { padding: 12px 30px; border: none; font-size: 14px; cursor: pointer; text-decoration: none; text-align: center; border-radius: 2px; }
  .btn-checkout { background-color: #ff6600; color: #fff; }
  .btn-checkout:hover { opacity: 0.9; }

  .cart-empty { text-align: center; padding: 60px 0; color: #666; }
  .btn-shop-now { background-color: #c99e58; color: #fff; display: inline-block; margin-top: 15px; }
</style>