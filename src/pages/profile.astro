---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="個人會員專區 · 空間客舍">
  <div class="profile-viewport">

    <!-- 頂端導航列 -->
    <header class="profile-navbar">
      <a href="/slowplace" class="back-btn">
        <span class="btn-icon">←</span>
        <span>返回客舍自由空間</span>
      </a>
      <div class="brand-title">空間客舍 · 讀者手帳專區</div>
      <button id="profile-logout-btn" class="nav-logout-btn">🚪 登出</button>
    </header>

    <!-- 載入中狀態 -->
    <div id="loading-state" class="state-container">
      <div class="spinner"></div>
      <p>正在翻開您的閱讀手帳...</p>
    </div>

    <!-- 主內容區塊 (預設隱藏) -->
    <main id="profile-content" class="profile-main-grid" style="display: none;">

      <!-- ================= 左側欄：客舍空間捷徑與操作面板 ================= -->
      <aside class="profile-left-col">
        <div class="card nav-hub-card">
          <h2 class="card-title">🏮 客舍空間捷徑</h2>
          <p class="card-desc">從個人專區快速前往客舍各處。</p>
          <div class="hub-links">
            <a href="/slowplace" class="hub-link-item">
              <span class="hub-icon">🪑</span>
              <span class="hub-text">
                <strong>自由空間</strong>
                <small>入座木椅計時、共讀桌與館藏書架</small>
              </span>
              <span class="hub-arrow">→</span>
            </a>
            <a href="/chatroom" class="hub-link-item">
              <span class="hub-icon">💬</span>
              <span class="hub-text">
                <strong>客舍聊天室</strong>
                <small>與旅人交流與查看私訊</small>
              </span>
              <span class="hub-arrow">→</span>
            </a>
            <a href="/record" class="hub-link-item">
              <span class="hub-icon">📜</span>
              <span class="hub-text">
                <strong>我的閱讀記錄</strong>
                <small>管理書單、頁數進度與累積時數</small>
              </span>
              <span class="hub-arrow">→</span>
            </a>
          </div>
        </div>

        <!-- 空間精神小語卡片 -->
        <div class="card quote-card">
          <div class="quote-symbol">“</div>
          <p class="quote-text">閱讀不是為了抵達終點，而是為自己在吵雜的世界裡，闢出一塊安靜的角落。</p>
          <div class="quote-author">—— 空間客舍 Slow Pace Studio</div>
        </div>
      </aside>

      <!-- ================= 右側欄：讀者名片、閱讀時間概覽、走勢圖與資料 ================= -->
      <section class="profile-right-col">

        <!-- 讀者名片卡片（放右側） -->
        <div class="card profile-card">
          <div class="profile-card-top">
            <div class="avatar-wrapper">
              <img id="profile-avatar-img" src="/assets/player1.png" alt="Avatar" class="profile-avatar" />
              <div id="profile-tier-badge" class="tier-badge">🌱 鄰里人</div>
            </div>
            <div class="profile-identity">
              <h1 id="profile-name-display" class="profile-name">旅人</h1>
              <p id="profile-role-display" class="profile-role">☁️ 晴空選書</p>
            </div>
          </div>

          <div class="quick-actions">
            <button type="button" id="toggle-edit-profile-btn" class="action-btn">✏️ 編輯資料</button>
            <button type="button" id="toggle-edit-password-btn" class="action-btn outline">🔒 修改密碼</button>
          </div>
        </div>

        <!-- 閱讀統計看板 + 走勢圖按鈕（放右側） -->
        <div class="card stats-card">
          <h2 class="card-title">📖 閱讀時間概覽</h2>
          <div class="stats-grid">
            <div class="stat-box">
              <div class="stat-icon">🕯️</div>
              <div class="stat-info">
                <span class="stat-label">今日閱讀</span>
                <strong id="display-daily-reading" class="stat-value">0分</strong>
              </div>
            </div>

            <div class="stat-box">
              <div class="stat-icon alt">📚</div>
              <div class="stat-info">
                <span class="stat-label">累積總閱讀</span>
                <strong id="display-total-reading" class="stat-value">0分</strong>
              </div>
            </div>
          </div>

          <!-- 閱讀足跡圖示按鈕 -->
          <button type="button" id="btn-toggle-chart" class="chart-toggle-btn">
            <span class="btn-left">
              <span class="icon">📊</span>
              <span>本月閱讀走勢圖</span>
            </span>
            <span id="chart-arrow" class="arrow">▼</span>
          </button>
        </div>

        <!-- 折疊展開區塊：當月閱讀走勢二維平面直條圖 -->
        <div id="chart-section" class="card chart-card" style="display: none;">
          <div class="chart-header">
            <div>
              <h2 class="card-title" id="chart-month-title">📅 本月閱讀每日走勢</h2>
              <p class="card-desc">X 軸為日期、Y 軸為閱讀時長；懸浮或點擊長條可查看當日紀錄。</p>
            </div>
            <div class="chart-meta-badges">
              <span id="selected-day-readout" class="selected-day-tag">點選長條查看日期</span>
              <span id="display-month-total" class="month-total-tag">本月總計：0分</span>
            </div>
          </div>

          <!-- 二維平面直條圖容器 (Y軸刻度 + 格線 + 垂直長條 + X軸日期) -->
          <div class="chart-scroll-area">
            <div class="cartesian-chart">
              <div class="y-axis-column" aria-hidden="true">
                <span id="y-axis-max">60分</span>
                <span id="y-axis-mid">30分</span>
                <span>0分</span>
              </div>

              <div class="plot-and-x-axis">
                <div class="plot-grid-lines" aria-hidden="true">
                  <div class="grid-line"></div>
                  <div class="grid-line"></div>
                  <div class="grid-line grid-line--base"></div>
                </div>
                <div id="monthly-bar-chart" class="bar-chart-wrapper" role="img" aria-label="當月每日閱讀時間平面直條圖"></div>
                <div class="axis-caption-row">
                  <span class="axis-caption">← X 軸：日期（日）→</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 聯絡資訊卡片 -->
        <div class="card info-card">
          <h2 class="card-title">✉️ 聯絡資訊</h2>
          <p class="card-desc">你的會員聯絡資料與帳號資訊。</p>
          <ul class="info-list">
            <li>
              <span class="info-label">電子信箱</span>
              <span id="display-email" class="info-val">-</span>
            </li>
            <li>
              <span class="info-label">聯絡電話</span>
              <span id="display-phone" class="info-val">-</span>
            </li>
            <li>
              <span class="info-label">IG 帳號</span>
              <span id="display-ig" class="info-val">-</span>
            </li>
          </ul>
        </div>

        <!-- 修改個人資料表單 (預設隱藏) -->
        <form id="profile-form" class="card form-card" style="display: none;">
          <h2 class="card-title">✏️ 編輯個人資料</h2>

          <div class="form-group">
            <label class="form-label" for="edit-name">客舍稱號</label>
            <input type="text" id="edit-name" maxlength="12" required placeholder="請輸入您的稱號" />
          </div>

          <div class="form-group">
            <label class="form-label" for="edit-role">身份標籤</label>
            <select id="edit-role">
              <option value="☁️ 晴空選書">☁️ 晴空選書</option>
              <option value="🍃 散文漫遊">🍃 散文漫遊</option>
              <option value="✍️ 靜心寫作">✍️ 靜心寫作</option>
              <option value="☕ 咖啡陪伴">☕ 咖啡陪伴</option>
              <option value="🌙 夜讀漫步">🌙 夜讀漫步</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="edit-phone">聯絡電話</label>
              <input type="text" id="edit-phone" placeholder="例：0912-345-678" />
            </div>
            <div class="form-group">
              <label class="form-label" for="edit-ig">IG 帳號</label>
              <input type="text" id="edit-ig" placeholder="例：@slowpace_studio" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">選擇分身造型</label>
            <div class="avatar-select-grid" id="edit-avatar-group">
              <label class="avatar-option-item">
                <input type="radio" name="edit-avatar" value="/assets/player1.png" style="display:none;" />
                <img src="/assets/player1.png" alt="P1" />
                <span>分身一號</span>
              </label>
              <label class="avatar-option-item">
                <input type="radio" name="edit-avatar" value="/assets/player2.png" style="display:none;" />
                <img src="/assets/player2.png" alt="P2" />
                <span>分身二號</span>
              </label>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="primary-btn">💾 儲存修改內容</button>
          </div>
        </form>

        <!-- 修改密碼表單 (預設隱藏) -->
        <div id="password-form-container" class="card form-card" style="display: none;">
          <h2 class="card-title">🔒 變更會員密碼</h2>

          <div class="form-group">
            <label class="form-label" for="new-password">新密碼 (至少 6 位數)</label>
            <div class="pwd-input-wrapper">
              <input type="password" id="new-password" placeholder="••••••••" />
              <button type="button" id="toggle-pwd-1" class="eye-btn" title="切換顯示密碼">👁️</button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="new-password-confirm">再次確認新密碼</label>
            <div class="pwd-input-wrapper">
              <input type="password" id="new-password-confirm" placeholder="••••••••" />
              <button type="button" id="toggle-pwd-2" class="eye-btn" title="切換顯示密碼">👁️</button>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" id="update-password-btn" class="accent-btn">確認變更密碼</button>
          </div>
        </div>

      </section>
    </main>
  </div>

  <style>
    :root {
      --bg-base: #FAF7F2;
      --bg-card: #FFFFFF;
      --bg-subtle: #F4EFE6;
      --border-color: #E8E2D5;
      --border-active: #C5BBAA;

      --text-main: #2C241D;
      --text-muted: #8C8275;
      --text-light: #A3998E;

      --accent-brand: #52796F;
      --accent-hover: #354F52;
      --accent-warm: #DDA15E;
      --accent-danger: #BC4749;

      --shadow-sm: 0 4px 12px rgba(44, 36, 29, 0.03);
      --shadow-md: 0 8px 24px rgba(44, 36, 29, 0.06);
      --radius-lg: 20px;
      --radius-md: 14px;
      --radius-sm: 10px;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    .profile-viewport {
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-base);
    }

    /* 頂端導航列 */
    .profile-navbar {
      width: 100%;
      min-height: 64px;
      padding: 10px 24px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: var(--bg-card);
      transition: all 0.2s ease;
    }

    .back-btn:hover {
      background: var(--bg-subtle);
      color: var(--text-main);
    }

    .brand-title {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--text-main);
    }

    .nav-logout-btn {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--accent-danger);
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .nav-logout-btn:hover {
      background: #FDF2F2;
      border-color: #F8D7DA;
    }

    /* 載入狀態 */
    .state-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 16px;
      color: var(--text-muted);
      font-size: 0.95rem;
      padding: 40px 16px;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid var(--border-color);
      border-top-color: var(--accent-brand);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* 全闊自適應雙欄佈局 */
    .profile-main-grid {
      width: 100%;
      flex: 1;
      padding: 24px;
      display: grid;
      grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }

    .profile-left-col,
    .profile-right-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
      min-width: 0;
    }

    @media (max-width: 900px) {
      .profile-main-grid {
        grid-template-columns: 1fr;
        padding: 16px;
        gap: 16px;
      }

      .brand-title {
        order: -1;
        width: 100%;
        text-align: center;
      }
    }

    /* 通用卡片 */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 22px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s ease;
    }

    .card:hover {
      box-shadow: var(--shadow-md);
    }

    .card-title {
      font-size: 1.08rem;
      font-weight: 700;
      margin: 0 0 6px 0;
      color: var(--text-main);
    }

    .card-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin: 0 0 16px 0;
    }

    /* 左側空間捷徑 */
    .hub-links {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .hub-link-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      text-decoration: none;
      color: var(--text-main);
      transition: all 0.2s ease;
    }

    .hub-link-item:hover {
      background: var(--bg-subtle);
      border-color: var(--border-active);
      transform: translateX(2px);
    }

    .hub-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      flex-shrink: 0;
    }

    .hub-text {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .hub-text strong {
      font-size: 0.9rem;
      font-weight: 700;
    }

    .hub-text small {
      font-size: 0.74rem;
      color: var(--text-muted);
    }

    .hub-arrow {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    /* 右側讀者名片 */
    .profile-card {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .profile-card-top {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .avatar-wrapper {
      position: relative;
      flex-shrink: 0;
    }

    .profile-avatar {
      width: 78px;
      height: 78px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--bg-subtle);
      border: 3px solid var(--bg-card);
      box-shadow: 0 0 0 2px var(--border-color);
    }

    .tier-badge {
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      padding: 2px 10px;
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .profile-identity {
      flex: 1;
      min-width: 160px;
    }

    .profile-name {
      font-size: 1.35rem;
      font-weight: 700;
      margin: 0 0 4px 0;
    }

    .profile-role {
      font-size: 0.86rem;
      color: var(--text-muted);
      margin: 0;
    }

    .quick-actions {
      display: flex;
      gap: 12px;
      width: 100%;
    }

    .action-btn {
      flex: 1;
      padding: 10px 12px;
      font-size: 0.84rem;
      font-weight: 600;
      border-radius: var(--radius-sm);
      border: 1px solid var(--accent-brand);
      background: var(--accent-brand);
      color: #FFFFFF;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .action-btn:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }

    .action-btn.outline {
      background: transparent;
      color: var(--text-main);
      border-color: var(--border-color);
    }

    .action-btn.outline:hover {
      background: var(--bg-subtle);
    }

    /* 右側閱讀時間概覽 */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    @media (max-width: 540px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
    }

    .stat-box {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 14px 16px;
    }

    .stat-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .stat-icon.alt {
      background: #FAF3E0;
    }

    .stat-info {
      display: flex;
      flex-direction: column;
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .stat-value {
      font-size: 1.12rem;
      font-weight: 700;
      color: var(--text-main);
    }

    /* 閱讀走勢圖按鈕 */
    .chart-toggle-btn {
      width: 100%;
      padding: 12px 16px;
      background: linear-gradient(135deg, #52796F 0%, #354F52 100%);
      color: #FFFFFF;
      border: none;
      border-radius: var(--radius-md);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 12px rgba(82, 121, 111, 0.2);
      transition: all 0.2s ease;
    }

    .chart-toggle-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(82, 121, 111, 0.3);
    }

    .chart-toggle-btn .btn-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chart-toggle-btn .arrow {
      font-size: 0.75rem;
      transition: transform 0.3s ease;
    }

    .chart-toggle-btn.active .arrow {
      transform: rotate(180deg);
    }

    /* 右側聯絡資訊卡片 */
    .info-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .info-list li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      font-size: 0.88rem;
      padding-bottom: 10px;
      border-bottom: 1px dashed var(--border-color);
    }

    .info-list li:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .info-label {
      color: var(--text-muted);
      flex-shrink: 0;
    }

    .info-val {
      font-weight: 600;
      color: var(--text-main);
      word-break: break-word;
      text-align: right;
    }

    /* 二維平面直條圖樣式 */
    .chart-card {
      background: #FFFFFF;
      animation: fadeIn 0.25s ease;
