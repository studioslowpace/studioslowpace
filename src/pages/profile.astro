  </style>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const SUPABASE_URL = 'https://blqlrxqckiuvgevmakbu.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
    const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    const TABLE_NAME = 'slowpace_members';

    let currentUserId: string | null = null;
    let currentProfile: any = null;

    // 走勢圖狀態：'month'（按月）或 'year'（按年）
    let chartGranularity: 'month' | 'year' = 'month';
    const initialNow = new Date();
    let activeYear = initialNow.getFullYear();
    let activeMonth = initialNow.getMonth(); // 0-11

    // 將秒數轉為「X小時Y分」或「Y分」
    function formatReadingDuration(seconds = 0): string {
      const safeSec = Math.max(0, Math.floor(Number(seconds) || 0));
      const totalMinutes = Math.floor(safeSec / 60);
      if (totalMinutes < 1) return '0分';

      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;

      if (hours > 0) {
        return minutes > 0 ? `${hours}小時${minutes}分` : `${hours}小時`;
      }
      return `${minutes}分`;
    }

    function formatDateKey(d: Date): string {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function getTodayDateString(): string {
      return formatDateKey(new Date());
    }

    function normalizeReadingLogs(rawLogs: any): { date: string; seconds: number }[] {
      let parsed = rawLogs;
      if (typeof parsed === 'string') {
        try { parsed = JSON.parse(parsed); } catch { parsed = []; }
      }
      if (!Array.isArray(parsed)) return [];
      return parsed
        .filter((item: any) => item && typeof item.date === 'string')
        .map((item: any) => ({
          date: item.date,
          seconds: Math.max(0, Number(item.seconds) || 0)
        }));
    }

    // 渲染直條圖（支援按月切換月份、按年顯示 12 個月；Y 軸每格 30 分鐘，最高 12 小時）
    function renderTrendChart(logs: { date: string; seconds: number }[]) {
      const titleEl = document.getElementById('chart-period-title');
      const periodLabelEl = document.getElementById('period-label');
      const periodTotalEl = document.getElementById('display-period-total');
      const readoutEl = document.getElementById('selected-bar-readout');
      const yAxisEl = document.getElementById('y-axis-container');
      const hGridEl = document.getElementById('h-grid-container');
      const vGridEl = document.getElementById('v-grid-container');
      const plotInnerEl = document.getElementById('chart-plot-inner');
      const barsRowEl = document.getElementById('bar-chart-columns');
      const xTicksRowEl = document.getElementById('x-axis-ticks-row');
      const xTrackEl = document.getElementById('x-axis-scroll-track');

      if (
        !titleEl || !periodLabelEl || !periodTotalEl || !yAxisEl ||
        !hGridEl || !vGridEl || !plotInnerEl || !barsRowEl || !xTicksRowEl
      ) return;

      const todayStr = getTodayDateString();
      const [todayY, todayM, todayD] = todayStr.split('-').map(Number);

      let buckets: { key: string; axisText: string; detailText: string; seconds: number; isHighlight: boolean }[] = [];

      if (chartGranularity === 'month') {
        const daysInMonth = new Date(activeYear, activeMonth + 1, 0).getDate();
        const daySecMap = new Map<number, number>();

        logs.forEach(log => {
          const [y, m, d] = log.date.split('-').map(Number);
          if (y === activeYear && m === (activeMonth + 1)) {
            daySecMap.set(d, (daySecMap.get(d) || 0) + log.seconds);
          }
        });

        titleEl.textContent = `${activeYear}年 ${activeMonth + 1}月 閱讀走勢`;
        periodLabelEl.textContent = `${activeYear}-${String(activeMonth + 1).padStart(2, '0')}`;

        for (let day = 1; day <= daysInMonth; day++) {
          const sec = daySecMap.get(day) || 0;
          const isToday = (activeYear === todayY && (activeMonth + 1) === todayM && day === todayD);
          buckets.push({
            key: `${activeYear}-${String(activeMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`,
            axisText: `${day}`,
            detailText: `${activeMonth + 1}/${day}日 · ${formatReadingDuration(sec)}`,
            seconds: sec,
            isHighlight: isToday
          });
        }
      } else {
        const monthSecMap = new Map<number, number>();

        logs.forEach(log => {
          const [y, m] = log.date.split('-').map(Number);
          if (y === activeYear && m >= 1 && m <= 12) {
            monthSecMap.set(m, (monthSecMap.get(m) || 0) + log.seconds);
          }
        });

        titleEl.textContent = `${activeYear}年 全年閱讀走勢`;
        periodLabelEl.textContent = `${activeYear}年`;

        for (let m = 1; m <= 12; m++) {
          const sec = monthSecMap.get(m) || 0;
          const isCurrentMonth = (activeYear === todayY && m === todayM);
          buckets.push({
            key: `${activeYear}-${String(m).padStart(2, '0')}`,
            axisText: `${m}月`,
            detailText: `${activeYear}年${m}月 · ${formatReadingDuration(sec)}`,
            seconds: sec,
            isHighlight: isCurrentMonth
          });
        }
      }

      const totalSec = buckets.reduce((acc, b) => acc + b.seconds, 0);
      periodTotalEl.textContent = `期間總計：${formatReadingDuration(totalSec)}`;

      // Y 軸每格 30 分鐘（1800 秒），最多顯示 12 小時（43200 秒 = 24 格）
      const maxValSec = Math.max(...buckets.map(b => b.seconds), 0);
      let stepsCount = Math.max(2, Math.ceil(maxValSec / 1800));
      if (stepsCount > 24) stepsCount = 24;
      const yMaxSec = stepsCount * 1800;

      let yHtml = '';
      let hGridHtml = '';
      for (let i = stepsCount; i >= 0; i--) {
        const stepSec = i * 1800;
        yHtml += `<span>${stepSec === 0 ? '0分' : formatReadingDuration(stepSec)}</span>`;
        hGridHtml += `<div class="h-grid-line ${i === 0 ? 'h-grid-line--zero' : ''}"></div>`;
      }
      yAxisEl.innerHTML = yHtml;
      hGridEl.innerHTML = hGridHtml;

      // 當月天數多時設定最小寬度，方便 X 軸左右滑動查看
      const minPlotWidth = chartGranularity === 'month' ? buckets.length * 26 : 520;
      plotInnerEl.style.minWidth = `${minPlotWidth}px`;
      xTicksRowEl.style.minWidth = `${minPlotWidth}px`;

      let vGridHtml = '';
      let barsHtml = '';
      let xHtml = '';

      buckets.forEach((b, idx) => {
        const pct = b.seconds > 0 ? Math.min(100, Math.max(3, Math.round((b.seconds / yMaxSec) * 100))) : 0;
        vGridHtml += `<div class="v-grid-cell"></div>`;
        barsHtml += `
          <div class="bar-slot ${b.isHighlight ? 'today-slot' : ''}" data-index="${idx}" data-detail="${b.detailText}">
            <div class="bar-rect" style="height: ${pct}%;"></div>
          </div>
        `;
        xHtml += `
          <div class="x-day-cell ${b.isHighlight ? 'today-tick' : ''}" data-index="${idx}">${b.axisText}</div>
        `;
      });

      vGridEl.innerHTML = vGridHtml;
      barsRowEl.innerHTML = barsHtml;
      xTicksRowEl.innerHTML = xHtml;

      if (readoutEl) {
        readoutEl.textContent = '懸浮或點選直條查看時數';
      }

      // 綁定直條懸浮與點擊事件
      barsRowEl.querySelectorAll('.bar-slot').forEach(slot => {
        const detail = slot.getAttribute('data-detail') || '';
        slot.addEventListener('mouseenter', () => {
          if (readoutEl && detail) readoutEl.textContent = detail;
        });
        slot.addEventListener('click', () => {
          barsRowEl.querySelectorAll('.bar-slot').forEach(s => s.classList.remove('active-bar'));
          slot.classList.add('active-bar');
          if (readoutEl && detail) readoutEl.textContent = `已選：${detail}`;
        });
      });

      if (xTrackEl) xTrackEl.scrollLeft = 0;
      const chartViewport = document.getElementById('chart-scroll-viewport');
      if (chartViewport) chartViewport.scrollLeft = 0;
    }

    // 同步 X 軸滑動列與直條圖捲動位置
    function syncHorizontalScroll() {
      const chartViewport = document.getElementById('chart-scroll-viewport');
      const xTrack = document.getElementById('x-axis-scroll-track');
      const btnLeft = document.getElementById('btn-x-scroll-left');
      const btnRight = document.getElementById('btn-x-scroll-right');

      if (!chartViewport || !xTrack) return;

      let locking = false;
      chartViewport.addEventListener('scroll', () => {
        if (locking) return;
        locking = true;
        xTrack.scrollLeft = chartViewport.scrollLeft;
        locking = false;
      });

      xTrack.addEventListener('scroll', () => {
        if (locking) return;
        locking = true;
        chartViewport.scrollLeft = xTrack.scrollLeft;
        locking = false;
      });

      btnLeft?.addEventListener('click', () => {
        chartViewport.scrollBy({ left: -140, behavior: 'smooth' });
      });

      btnRight?.addEventListener('click', () => {
        chartViewport.scrollBy({ left: 140, behavior: 'smooth' });
      });
    }

    function setupUIEvents() {
      const btnPanelChart = document.getElementById('btn-panel-chart');
      const btnPanelEdit = document.getElementById('btn-panel-edit');
      const btnPanelPassword = document.getElementById('btn-panel-password');

      const chartSection = document.getElementById('chart-section');
      const profileForm = document.getElementById('profile-form');
      const passwordFormContainer = document.getElementById('password-form-container');
      const rightPanelsAnchor = document.getElementById('right-panels-anchor');

      const btnViewMonth = document.getElementById('btn-view-month');
      const btnViewYear = document.getElementById('btn-view-year');
      const btnPrevPeriod = document.getElementById('btn-prev-period');
      const btnNextPeriod = document.getElementById('btn-next-period');
      const logoutBtn = document.getElementById('profile-logout-btn');

      // 切換面板（走勢圖 / 編輯資料 / 修改密碼），手機版自動捲動到面板位置
      function switchRightPanel(target: 'chart' | 'edit' | 'password') {
        if (chartSection) chartSection.style.display = target === 'chart' ? 'block' : 'none';
        if (profileForm) profileForm.style.display = target === 'edit' ? 'block' : 'none';
        if (passwordFormContainer) passwordFormContainer.style.display = target === 'password' ? 'block' : 'none';

        btnPanelChart?.classList.toggle('active', target === 'chart');
        btnPanelEdit?.classList.toggle('active', target === 'edit');
        btnPanelPassword?.classList.toggle('active', target === 'password');

        if (window.innerWidth <= 820 && rightPanelsAnchor) {
          rightPanelsAnchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      btnPanelChart?.addEventListener('click', () => switchRightPanel('chart'));
      btnPanelEdit?.addEventListener('click', () => switchRightPanel('edit'));
      btnPanelPassword?.addEventListener('click', () => switchRightPanel('password'));

      // 切換按月 / 按年顯示
      btnViewMonth?.addEventListener('click', () => {
        chartGranularity = 'month';
        btnViewMonth.classList.add('active');
        btnViewYear?.classList.remove('active');
        renderTrendChart(normalizeReadingLogs(currentProfile?.reading_logs));
      });

      btnViewYear?.addEventListener('click', () => {
        chartGranularity = 'year';
        btnViewYear.classList.add('active');
        btnViewMonth?.classList.remove('active');
        renderTrendChart(normalizeReadingLogs(currentProfile?.reading_logs));
      });

      // 上一期 / 下一期（月份或年份）
      btnPrevPeriod?.addEventListener('click', () => {
        if (chartGranularity === 'month') {
          activeMonth -= 1;
          if (activeMonth < 0) {
            activeMonth = 11;
            activeYear -= 1;
          }
        } else {
          activeYear -= 1;
        }
        renderTrendChart(normalizeReadingLogs(currentProfile?.reading_logs));
      });

      btnNextPeriod?.addEventListener('click', () => {
        if (chartGranularity === 'month') {
          activeMonth += 1;
          if (activeMonth > 11) {
            activeMonth = 0;
            activeYear += 1;
          }
        } else {
          activeYear += 1;
        }
        renderTrendChart(normalizeReadingLogs(currentProfile?.reading_logs));
      });

      // 登出
      logoutBtn?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        localStorage.clear();
        window.location.href = '/slowplace';
      });

      setupPasswordToggle('new-password', 'toggle-pwd-1');
      setupPasswordToggle('new-password-confirm', 'toggle-pwd-2');
      syncHorizontalScroll();
    }

    function setupPasswordToggle(inputId: string, btnId: string) {
      const input = document.getElementById(inputId) as HTMLInputElement;
      const btn = document.getElementById(btnId);
      btn?.addEventListener('click', () => {
        if (input.type === 'password') {
          input.type = 'text';
          btn.textContent = '🔒';
        } else {
          input.type = 'password';
          btn.textContent = '👁️';
        }
      });
    }

    async function initProfile() {
      const loadingState = document.getElementById('loading-state');
      const profileContent = document.getElementById('profile-content');

      const { data: { session } } = await supabase.auth.getSession();

      if (!session || !session.user) {
        alert('您尚未登入，請先前往客舍空間進行登入。');
        window.location.href = '/slowplace';
        return;
      }

      currentUserId = session.user.id;
      const userEmail = session.user.email || '';

      const { data: profile } = await supabase
        .from(TABLE_NAME)
        .select('*')
        .eq('user_id', currentUserId)
        .single();

      const { data: contact } = await supabase
        .from('member_contacts')
        .select('phone, ig')
        .eq('user_id', currentUserId)
        .maybeSingle();

      currentProfile = {
        ...(profile || {}),
        email: userEmail,
        phone: contact?.phone || '',
        ig: contact?.ig || ''
      };

      renderProfileData();
      setupUIEvents();

      if (loadingState) loadingState.style.display = 'none';
      if (profileContent) profileContent.style.display = 'grid';
    }

    function renderProfileData() {
      const avatarImg = document.getElementById('profile-avatar-img') as HTMLImageElement;
      const nameDisplay = document.getElementById('profile-name-display');
      const roleDisplay = document.getElementById('profile-role-display');
      const tierBadge = document.getElementById('profile-tier-badge');

      const dailyReadingEl = document.getElementById('display-daily-reading');
      const totalReadingEl = document.getElementById('display-total-reading');

      const displayEmail = document.getElementById('display-email');
      const displayPhone = document.getElementById('display-phone');
      const displayIg = document.getElementById('display-ig');

      const editName = document.getElementById('edit-name') as HTMLInputElement;
      const editRole = document.getElementById('edit-role') as HTMLSelectElement;
      const editPhone = document.getElementById('edit-phone') as HTMLInputElement;
      const editIg = document.getElementById('edit-ig') as HTMLInputElement;

      if (avatarImg) avatarImg.src = currentProfile.avatar || '/assets/player1.png';
      if (nameDisplay) nameDisplay.textContent = currentProfile.name || '旅人';
      if (roleDisplay) roleDisplay.textContent = currentProfile.role || '漫步者';
      if (tierBadge) tierBadge.textContent = currentProfile.is_admin ? '👑 店主' : '🌱 鄰里人';

      const todayStr = getTodayDateString();
      const logs = normalizeReadingLogs(currentProfile.reading_logs);

      const logsTodaySec = logs
        .filter(item => item.date === todayStr)
        .reduce((sum, item) => sum + item.seconds, 0);
      const logsTotalSec = logs.reduce((sum, item) => sum + item.seconds, 0);

      const fallbackDailySec = currentProfile.daily_reading_date === todayStr ? Number(currentProfile.daily_reading_seconds || 0) : 0;
      const fallbackTotalSec = Number(currentProfile.total_reading_seconds || 0);

      const rawDailySec = logs.length > 0 ? logsTodaySec : fallbackDailySec;
      const rawTotalSec = logs.length > 0 ? logsTotalSec : fallbackTotalSec;

      if (dailyReadingEl) dailyReadingEl.textContent = formatReadingDuration(rawDailySec);
      if (totalReadingEl) totalReadingEl.textContent = formatReadingDuration(rawTotalSec);

      renderTrendChart(logs);

      if (displayEmail) displayEmail.textContent = currentProfile.email;
      if (displayPhone) displayPhone.textContent = currentProfile.phone || '未填寫';
      if (displayIg) displayIg.textContent = currentProfile.ig || '未填寫';

      if (editName) editName.value = currentProfile.name || '';
      if (editRole) editRole.value = currentProfile.role || '漫步者';
      if (editPhone) editPhone.value = currentProfile.phone || '';
      if (editIg) editIg.value = currentProfile.ig || '';

      const avatarOptions = document.querySelectorAll('.avatar-option-item');
      avatarOptions.forEach(item => {
        const radio = item.querySelector('input[type="radio"]') as HTMLInputElement;
        if (radio && radio.value === (currentProfile.avatar || '/assets/player1.png')) {
          radio.checked = true;
          item.classList.add('selected');
        }
        item.addEventListener('click', () => {
          avatarOptions.forEach(o => o.classList.remove('selected'));
          item.classList.add('selected');
          if (radio) radio.checked = true;
        });
      });
    }

    document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentUserId) return;

      const newName = (document.getElementById('edit-name') as HTMLInputElement).value.trim();
      const newRole = (document.getElementById('edit-role') as HTMLSelectElement).value;
      const newPhone = (document.getElementById('edit-phone') as HTMLInputElement).value.trim();
      const newIg = (document.getElementById('edit-ig') as HTMLInputElement).value.trim();
      const selectedAvatar = (document.querySelector('input[name="edit-avatar"]:checked') as HTMLInputElement)?.value || '/assets/player1.png';

      if (!newName) {
        alert('請輸入您的客舍稱號！');
        return;
      }

      await supabase.auth.updateUser({ data: { name: newName, avatar: selectedAvatar } });

      const { error: dbError } = await supabase
        .from(TABLE_NAME)
        .update({
          name: newName,
          role: newRole,
          avatar: selectedAvatar,
          updated_at: new Date().toISOString()
        })
        .eq('user_id', currentUserId);

      const { error: contactError } = await supabase
        .from('member_contacts')
        .upsert({
          user_id: currentUserId,
          name: newName,
          phone: newPhone,
          ig: newIg
        }, { onConflict: 'user_id' });

      if (dbError || contactError) {
        alert('儲存失敗：' + (dbError?.message || contactError?.message));
      } else {
        alert('個人資料已更新！');
        currentProfile.name = newName;
        currentProfile.role = newRole;
        currentProfile.phone = newPhone;
        currentProfile.ig = newIg;
        currentProfile.avatar = selectedAvatar;
        renderProfileData();
      }
    });

    document.getElementById('update-password-btn')?.addEventListener('click', async () => {
      const newPassword = (document.getElementById('new-password') as HTMLInputElement).value.trim();
      const newPasswordConfirm = (document.getElementById('new-password-confirm') as HTMLInputElement).value.trim();

      if (!newPassword || newPassword.length < 6) {
        alert('新密碼長度至少需要 6 位數');
        return;
      }
      if (newPassword !== newPasswordConfirm) {
        alert('兩次輸入的新密碼不符');
        return;
      }

      const { error } = await supabase.auth.updateUser({ password: newPassword });

      if (error) {
        alert('修改密碼失敗：' + error.message);
      } else {
        alert('密碼已更新！');
        (document.getElementById('new-password') as HTMLInputElement).value = '';
        (document.getElementById('new-password-confirm') as HTMLInputElement).value = '';
      }
    });

    initProfile();
  </script>
</Layout>