---
import Layout from '../layouts/Layout.astro';
---

<Layout title="個人會員專區 · 空間客舍">
  <div class="profile-viewport">

    <!-- 載入中狀態 -->
    <div id="loading-state" class="state-container">
      <div class="spinner"></div>
      <p>正在翻開您的閱讀手帳...</p>
    </div>

    <!-- 主內容區塊 (預設隱藏；桌面左右雙欄，手機單欄上下排列) -->
    <main id="profile-content" class="profile-main-grid" style="display: none;">

      <!-- ================= 左側欄（手機上方）：個人資料、三個功能按鈕與登出 ================= -->
      <aside class="profile-left-col">
        <div class="card personal-hub-card">

          <!-- 讀者名片 -->
          <div class="profile-card-top">
            <div class="avatar-wrapper">
              <img id="profile-avatar-img" src="/assets/player1.png" alt="Avatar" class="profile-avatar" oncontextmenu="return false;" ondragstart="return false;" />
              <div id="profile-tier-badge" class="tier-badge">🌱 鄰里人</div>
            </div>
            <div class="profile-identity">
              <h1 id="profile-name-display" class="profile-name">旅人</h1>
              <p id="profile-role-display" class="profile-role">漫步者</p>
            </div>
          </div>

          <!-- 閱讀時間概覽 -->
          <div class="stats-section">
            <h2 class="section-mini-title">📖 閱讀時間概覽</h2>
            <div class="stats-grid">
              <div class="stat-box">
                <div class="stat-icon">🕯️</div>
                <div class="stat-info">
                  <span class="stat-label">今日閱讀</span>
                  <strong id="display-daily-reading" class="stat-value">0分</strong>
                </div>
              </div>

              <div class="stat-box">
                <div class="stat-icon alt">📚</div>
                <div class="stat-info">
                  <span class="stat-label">累積總閱讀</span>
                  <strong id="display-total-reading" class="stat-value">0分</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- 聯絡資訊 -->
          <div class="contact-section">
            <h2 class="section-mini-title">✉️ 聯絡資訊</h2>
            <ul class="info-list">
              <li>
                <span class="info-label">電子信箱</span>
                <span id="display-email" class="info-val">-</span>
              </li>
              <li>
                <span class="info-label">聯絡電話</span>
                <span id="display-phone" class="info-val">-</span>
              </li>
              <li>
                <span class="info-label">IG 帳號</span>
                <span id="display-ig" class="info-val">-</span>
              </li>
            </ul>
          </div>

          <!-- 個人資料下方的三個面板功能按鈕（手機與電腦皆顯示） -->
          <div class="three-panel-btns" role="group" aria-label="面板功能切換">
            <button type="button" id="btn-panel-chart" class="panel-switch-btn active">
              <span>📊</span>
              <span>走勢圖</span>
            </button>
            <button type="button" id="btn-panel-edit" class="panel-switch-btn">
              <span>✏️</span>
              <span>編輯資料</span>
            </button>
            <button type="button" id="btn-panel-password" class="panel-switch-btn">
              <span>🔒</span>
              <span>修改密碼</span>
            </button>
          </div>

          <!-- 登出按鈕（放在個人資料內） -->
          <button type="button" id="profile-logout-btn" class="card-logout-btn">🚪 登出帳號</button>
        </div>
      </aside>

      <!-- ================= 右側欄（手機下方）：走勢圖表、編輯資料與修改密碼視窗 ================= -->
      <section id="right-panels-anchor" class="profile-right-col">

        <!-- 閱讀走勢圖視窗（支援月份切換與按年顯示，Y軸每格30分鐘上限12小時，X軸底部左右滑動） -->
        <div id="chart-section" class="card chart-card">
          <div class="chart-header">
            <div>
              <h2 class="card-title" id="chart-period-title">2026年 11月 閱讀走勢</h2>
              <p class="card-desc">Y 軸每格 30 分鐘（上限 12 小時），水平與垂直虛線輔助對照。</p>
            </div>

            <div class="chart-controls-bar">
              <!-- 檢視維度切換：月 / 年 -->
              <div class="granularity-switch">
                <button type="button" id="btn-view-month" class="gran-btn active">按月</button>
                <button type="button" id="btn-view-year" class="gran-btn">按年</button>
              </div>

              <!-- 切換不同月份或年份 -->
              <div class="period-nav">
                <button type="button" id="btn-prev-period" class="period-step-btn" title="上一期">‹</button>
                <span id="period-label" class="period-label">2026-11</span>
                <button type="button" id="btn-next-period" class="period-step-btn" title="下一期">›</button>
              </div>
            </div>
          </div>

          <div class="chart-summary-strip">
            <span id="selected-bar-readout" class="selected-bar-tag">懸浮或點選直條查看時數</span>
            <span id="display-period-total" class="period-total-tag">期間總計：0分</span>
          </div>

          <!-- 帶淺色外框線的平面直條圖容器 -->
          <div class="chart-frame-wrapper">
            <div class="cartesian-row">
              <div id="y-axis-container" class="y-axis-column" aria-hidden="true"></div>

              <div id="chart-scroll-viewport" class="chart-scroll-viewport">
                <div id="chart-plot-inner" class="chart-plot-inner">
                  <div id="h-grid-container" class="h-grid-layer" aria-hidden="true"></div>
                  <div id="v-grid-container" class="v-grid-layer" aria-hidden="true"></div>
                  <div id="bar-chart-columns" class="bar-columns-row" role="img" aria-label="閱讀時間直條圖"></div>
                </div>
              </div>
            </div>

            <!-- X 軸放在底部，附左右按鍵可捲動查看不夠位顯示的日子 -->
            <div class="x-axis-bottom-bar">
              <button type="button" id="btn-x-scroll-left" class="x-scroll-btn" title="向左查看更早日子" aria-label="向左捲動">◀</button>
              <div id="x-axis-scroll-track" class="x-axis-scroll-track">
                <div id="x-axis-ticks-row" class="x-axis-ticks-row"></div>
              </div>
              <button type="button" id="btn-x-scroll-right" class="x-scroll-btn" title="向右查看較晚日子" aria-label="向右捲動">▶</button>
            </div>
          </div>
        </div>

        <!-- 編輯個人資料視窗 -->
        <form id="profile-form" class="card form-card" style="display: none;">
          <h2 class="card-title">✏️ 編輯個人資料</h2>

          <div class="form-group">
            <label class="form-label" for="edit-name">客舍稱號</label>
            <input type="text" id="edit-name" maxlength="12" required placeholder="請輸入您的稱號" />
          </div>

          <div class="form-group">
            <label class="form-label" for="edit-role">身份標籤</label>
            <select id="edit-role">
              <option value="漫步者" selected>漫步者</option>
              <option value="探索者">探索者</option>
              <option value="實踐者">實踐者</option>
              <option value="觀察者">觀察者</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="edit-phone">聯絡電話</label>
              <input type="text" id="edit-phone" placeholder="例：0912-345-678" />
            </div>
            <div class="form-group">
              <label class="form-label" for="edit-ig">IG 帳號</label>
              <input type="text" id="edit-ig" placeholder="例：@slowpace_studio" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">選擇分身造型</label>
            <div class="avatar-select-grid" id="edit-avatar-group">
              <label class="avatar-option-item">
                <input type="radio" name="edit-avatar" value="/assets/player1.png" style="display:none;" />
                <img src="/assets/player1.png" alt="P1" oncontextmenu="return false;" ondragstart="return false;" />
                <span>分身一號</span>
              </label>
              <label class="avatar-option-item">
                <input type="radio" name="edit-avatar" value="/assets/player2.png" style="display:none;" />
                <img src="/assets/player2.png" alt="P2" oncontextmenu="return false;" ondragstart="return false;" />
                <span>分身二號</span>
              </label>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="primary-btn">💾 儲存修改內容</button>
          </div>
        </form>

        <!-- 修改密碼視窗 -->
        <div id="password-form-container" class="card form-card" style="display: none;">
          <h2 class="card-title">🔒 變更會員密碼</h2>

          <div class="form-group">
            <label class="form-label" for="new-password">新密碼 (至少 6 位數)</label>
            <div class="pwd-input-wrapper">
              <input type="password" id="new-password" placeholder="••••••••" />
              <button type="button" id="toggle-pwd-1" class="eye-btn" title="切換顯示密碼">👁️</button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="new-password-confirm">再次確認新密碼</label>
            <div class="pwd-input-wrapper">
              <input type="password" id="new-password-confirm" placeholder="••••••••" />
              <button type="button" id="toggle-pwd-2" class="eye-btn" title="切換顯示密碼">👁️</button>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" id="update-password-btn" class="accent-btn">確認變更密碼</button>
          </div>
        </div>

      </section>
    </main>
  </div>

  <style is:global>
    :root {
      --bg-base: #FAF7F2;
      --bg-card: #FFFFFF;
      --bg-subtle: #F4EFE6;
      --border-color: #E8E2D5;
      --border-active: #C5BBAA;

      --text-main: #2C241D;
      --text-muted: #8C8275;
      --text-light: #A3998E;

      --accent-brand: #52796F;
      --accent-hover: #354F52;
      --accent-warm: #DDA15E;
      --accent-danger: #BC4749;

      --shadow-sm: 0 4px 12px rgba(44, 36, 29, 0.03);
      --shadow-md: 0 8px 24px rgba(44, 36, 29, 0.06);
      --radius-lg: 20px;
      --radius-md: 14px;
      --radius-sm: 10px;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    .profile-viewport {
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-base);
    }

    .state-container {
      flex: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 16px;
      color: var(--text-muted);
      font-size: 0.95rem;
      padding: 40px 16px;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid var(--border-color);
      border-top-color: var(--accent-brand);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* 全闊自適應雙欄佈局：桌面左右雙欄，手機單欄上下排列 */
    .profile-main-grid {
      width: 100%;
      min-height: 100vh;
      padding: 20px;
      display: grid;
      grid-template-columns: minmax(310px, 380px) minmax(0, 1fr);
      gap: 20px;
      align-items: start;
    }

    .profile-left-col,
    .profile-right-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
      min-width: 0;
    }

    @media (max-width: 820px) {
      .profile-main-grid {
        grid-template-columns: 1fr;
        padding: 14px;
        gap: 16px;
      }
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }

    .card-title {
      font-size: 1.06rem;
      font-weight: 700;
      margin: 0 0 4px 0;
      color: var(--text-main);
    }

    .card-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin: 0;
    }

    .section-mini-title {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--text-muted);
      margin: 0 0 10px 0;
      letter-spacing: 0.02em;
    }

    /* 個人資料卡片 */
    .personal-hub-card {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .profile-card-top {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border-color);
    }

    .avatar-wrapper {
      position: relative;
      flex-shrink: 0;
    }

    .profile-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--bg-subtle);
      border: 2px solid var(--border-color);
    }

    .tier-badge {
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      padding: 1px 8px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .profile-identity {
      min-width: 0;
      flex: 1;
    }

    .profile-name {
      font-size: 1.28rem;
      font-weight: 700;
      margin: 0 0 4px 0;
      word-break: break-word;
    }

    .profile-role {
      font-size: 0.84rem;
      color: var(--text-muted);
      margin: 0;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .stat-box {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      min-width: 0;
    }

    .stat-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      flex-shrink: 0;
    }

    .stat-icon.alt {
      background: #FAF3E0;
    }

    .stat-info {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .stat-label {
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    .stat-value {
      font-size: 0.98rem;
      font-weight: 700;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .info-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px 14px;
    }

    .info-list li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      font-size: 0.84rem;
      padding-bottom: 6px;
      border-bottom: 1px dashed var(--border-color);
    }

    .info-list li:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .info-label {
      color: var(--text-muted);
      flex-shrink: 0;
    }

    .info-val {
      font-weight: 600;
      color: var(--text-main);
      text-align: right;
      word-break: break-word;
    }

    /* 個人資料下方三個面板功能按鈕 */
    .three-panel-btns {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      padding-top: 4px;
    }

    .panel-switch-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 10px 6px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: var(--bg-base);
      color: var(--text-main);
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .panel-switch-btn:hover {
      background: var(--bg-subtle);
      border-color: var(--border-active);
    }

    .panel-switch-btn.active {
      background: var(--accent-brand);
      border-color: var(--accent-brand);
      color: #FFFFFF;
    }

    /* 登出按鈕（個人資料內） */
    .card-logout-btn {
      width: 100%;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      border: 1px solid #F1C4C4;
      background: #FDF4F4;
      color: var(--accent-danger);
      font-size: 0.86rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .card-logout-btn:hover {
      background: var(--accent-danger);
      border-color: var(--accent-danger);
      color: #FFFFFF;
    }

    /* 走勢圖區 */
    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }

    .chart-controls-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .granularity-switch {
      display: inline-flex;
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 2px;
    }

    .gran-btn {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .gran-btn.active {
      background: var(--accent-brand);
      color: #FFFFFF;
    }

    .period-nav {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 2px 6px;
    }

    .period-step-btn {
      border: none;
      background: transparent;
      color: var(--text-main);
      font-size: 1rem;
      font-weight: 700;
      padding: 2px 6px;
      cursor: pointer;
      border-radius: 6px;
    }

    .period-step-btn:hover {
      background: var(--bg-subtle);
    }

    .period-label {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-main);
      min-width: 66px;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .chart-summary-strip {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }

    .selected-bar-tag {
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .period-total-tag {
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent-brand);
    }

    /* 淺色外框線圖表框 */
    .chart-frame-wrapper {
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      background: #FCFBF8;
      padding: 16px 12px 12px 12px;
    }

    .cartesian-row {
      display: flex;
      align-items: stretch;
      height: 220px;
    }

    .y-axis-column {
      width: 58px;
      height: 220px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-end;
      padding-right: 8px;
      font-size: 0.68rem;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      flex-shrink: 0;
    }

    .chart-scroll-viewport {
      flex: 1;
      height: 220px;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      border-left: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-active);
      position: relative;
    }

    .chart-scroll-viewport::-webkit-scrollbar {
      display: none;
    }

    .chart-plot-inner {
      position: relative;
      height: 100%;
      min-width: 100%;
    }

    .h-grid-layer {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      pointer-events: none;
      z-index: 0;
    }

    .h-grid-line {
      width: 100%;
      border-top: 1px dashed rgba(140, 130, 117, 0.22);
    }

    .h-grid-line--zero {
      border-top: none;
    }

    .v-grid-layer {
      position: absolute;
      inset: 0;
      display: flex;
      pointer-events: none;
      z-index: 0;
    }

    .v-grid-cell {
      flex: 1;
