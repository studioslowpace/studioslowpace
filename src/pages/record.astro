---
// src/pages/record.astro
import Layout from '../layouts/Layout.astro';
---
<Layout title="個人書櫃與閱讀記錄 · 空間客舍">
  <div class="reading-page-container">
    <header class="reading-top-bar">
      <a href="/" class="back-btn">〈 返回空間</a>
      <h2 id="page-title">📖 個人閱讀清單與心得</h2>
      <button id="open-add-modal-btn" class="rpg-btn" style="width: auto; padding: 6px 14px; font-size: 12px; display: none;">➕ 新增記錄</button>
    </header>

    <!-- 閱讀清單列表 (直列只顯示書名與作者) -->
    <div class="logs-container" id="my-logs-list">
      <div style="text-align:center; color:#94a3b8; padding:20px;">載入記錄中...</div>
    </div>
  </div>

  <!-- 新增記錄彈窗 (Modal) -->
  <div id="add-record-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 440px; max-height: 90vh; display: flex; flex-direction: column;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>✍️ 新增閱讀記錄</span>
        <button id="close-add-modal-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="rpg-content" style="padding: 16px; overflow-y: auto; flex: 1;">
        <div class="form-grid">
          <div class="form-row"><label>書名</label><input type="text" id="book-title-input" placeholder="例：《白》" /></div>
          <div class="form-row-2">
            <div><label>作者</label><input type="text" id="book-author-input" placeholder="韓江" /></div>
            <div><label>譯者</label><input type="text" id="book-translator-input" placeholder="張雅眉" /></div>
          </div>
          <div class="form-row-2">
            <div><label>閱讀日期</label><input type="date" id="start-date-input" /></div>
            <div><label>完成日期</label><input type="date" id="finish-date-input" /></div>
          </div>
          <div class="form-row-2">
            <div><label>出版社</label><input type="text" id="publisher-input" placeholder="漫遊者文化" /></div>
            <div>
              <label>喜愛程度 (1-5星)</label>
              <select id="rating-input" style="width:100%; background:var(--bg-main); color:#fff; border:1px solid var(--border-color); padding:8px; border-radius:6px;">
                <option value="5">⭐⭐⭐⭐⭐ (5星)</option>
                <option value="4">⭐⭐⭐⭐ (4星)</option>
                <option value="3">⭐⭐⭐ (3星)</option>
                <option value="2">⭐⭐ (2星)</option>
                <option value="1">⭐ (1星)</option>
              </select>
            </div>
          </div>
          <div class="form-row"><label>記一些字句：</label><textarea id="quote-input" placeholder="摘錄喜歡的句子..."></textarea></div>
          <div class="form-row"><label>記一些疑問：</label><textarea id="questions-input" placeholder="閱讀時產生的疑問..."></textarea></div>
          <div class="form-row"><label>記一些感受：</label><textarea id="review-input" placeholder="讀後心得與感受..."></textarea></div>
        </div>
        <button id="submit-log-btn" class="rpg-btn" style="margin-top: 12px;">儲存記錄</button>
      </div>
    </div>
  </div>

  <!-- 記錄詳細檢視彈窗 (Modal - 依據相片格式) -->
  <div id="log-detail-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 500px; max-height: 90vh; display: flex; flex-direction: column;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>📖 閱讀筆記詳情</span>
        <button id="detail-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="rpg-content paper-sheet" style="padding: 20px; overflow-y: auto; flex: 1; font-size: 13px; line-height: 1.6;">
        <div class="detail-grid">
          <div class="detail-line"><strong>書名</strong> <span id="modal-book" class="line-content"></span></div>
          <div class="detail-row-2">
            <div class="detail-line"><strong>作者</strong> <span id="modal-author" class="line-content"></span></div>
            <div class="detail-line"><strong>譯者</strong> <span id="modal-translator" class="line-content"></span></div>
          </div>
          <div class="detail-row-2">
            <div class="detail-line"><strong>閱讀日期</strong> <span id="modal-start-date" class="line-content"></span></div>
            <div class="detail-line"><strong>出版社</strong> <span id="modal-publisher" class="line-content"></span></div>
          </div>
          <div class="detail-row-2">
            <div class="detail-line"><strong>完成日期</strong> <span id="modal-finish-date" class="line-content"></span></div>
            <div class="detail-line"><strong>喜愛程度</strong> <span id="modal-rating" class="line-content" style="color: #f59e0b;"></span></div>
          </div>
        </div>

        <div class="detail-section" style="margin-top: 16px;">
          <div class="section-title">記一些字句：</div>
          <div id="modal-quote" class="section-content-box"></div>
        </div>

        <div class="detail-section">
          <div class="section-title">記一些疑問：</div>
          <div id="modal-questions" class="section-content-box"></div>
        </div>

        <div class="detail-section">
          <div class="section-title">記一些感受：</div>
          <div id="modal-review" class="section-content-box"></div>
        </div>
      </div>
    </div>
  </div>

  <style>
    :root {
      --bg-main: #0f172a;
      --bg-card: #1e293b;
      --border-color: #334155;
      --accent-color: #38bdf8;
      --accent-hover: #0284c7;
    }
    body {
      background: var(--bg-main);
      color: #f8fafc;
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .reading-page-container {
      max-width: 600px;
      margin: 0 auto;
      min-height: 100vh;
      padding: 16px;
      box-sizing: border-box;
    }
    .reading-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    .back-btn {
      color: var(--accent-color);
      text-decoration: none;
      font-size: 13px;
    }
    .logs-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .log-item-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 14px 16px;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: border-color 0.2s;
    }
    .log-item-card:hover {
      border-color: var(--accent-color);
    }
    
    /* 表單排版 */
    .form-grid { display: flex; flex-direction: column; gap: 10px; }
    .form-row { display: flex; flex-direction: column; gap: 4px; }
    .form-row-2 { display: flex; gap: 10px; }
    .form-row-2 > div { flex: 1; display: flex; flex-direction: column; gap: 4px; }
    label { font-size: 11px; color: #94a3b8; }
    input, textarea, select {
      background: var(--bg-main);
      border: 1px solid var(--border-color);
      color: #fff;
      padding: 8px;
      border-radius: 6px;
      font-size: 13px;
      outline: none;
      box-sizing: border-box;
      width: 100%;
    }
    textarea { height: 50px; resize: none; }

    .rpg-btn {
      background: var(--accent-hover);
      color: #fff;
      border: none;
      padding: 10px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
      width: 100%;
    }
    
    /* 詳情紙張格式 (對應相片) */
    .paper-sheet { background: #111827; color: #e5e7eb; }
    .detail-grid { display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px; }
    .detail-row-2 { display: flex; gap: 16px; }
    .detail-line { flex: 1; display: flex; align-items: baseline; border-bottom: 1px dotted #374151; padding-bottom: 4px; font-size: 12px; }
    .detail-line strong { width: 65px; color: #94a3b8; flex-shrink: 0; }
    .line-content { color: #f9fafb; font-weight: 500; }
    
    .detail-section { margin-top: 12px; }
    .section-title { font-weight: bold; color: var(--accent-color); margin-bottom: 4px; font-size: 12px; }
    .section-content-box { background: rgba(30, 41, 59, 0.5); border-left: 2px solid var(--accent-color); padding: 8px 10px; border-radius: 4px; font-size: 12px; white-space: pre-wrap; word-break: break-all; color: #cbd5e1; }

    /* Modal 共同樣式 */
    .rpg-modal-overlay {
      position: fixed; inset: 0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px);
      display: flex; align-items: center; justify-content: center; z-index: 100;
    }
    .rpg-window {
      background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; width: 90%;
      box-shadow: 0 25px 50px rgba(0,0,0,0.5); overflow: hidden;
    }
    .rpg-title-bar { background: var(--bg-main); color: var(--accent-color); padding: 10px 16px; font-size: 13px; border-bottom: 1px solid var(--border-color); }
    .rpg-btn-sm { background: var(--bg-main); color: #cbd5e1; border: 1px solid var(--border-color); border-radius: 4px; cursor: pointer; }
  </style>

  <script>
    import { supabase } from '../lib/supabase';

    const LOGS_TABLE = 'reading_record';
    let currentUserId: string | null = null;
    let isOwner = false;
    let cachedLogs: any[] = [];

    const listContainer = document.getElementById('my-logs-list');
    const submitBtn = document.getElementById('submit-log-btn');
    const openAddModalBtn = document.getElementById('open-add-modal-btn');
    const addRecordModal = document.getElementById('add-record-modal');
    const closeAddModalBtn = document.getElementById('close-add-modal-btn');

    const detailModal = document.getElementById('log-detail-modal');
    const detailCloseBtn = document.getElementById('detail-close-btn');

    async function initPage() {
      const { data: { session } } = await supabase.auth.getSession();
      const guestId = sessionStorage.getItem('space_guest_id');

      const urlParams = new URLSearchParams(window.location.search);
      const targetUserId = urlParams.get('user_id');

      if (targetUserId) {
        currentUserId = targetUserId;
        isOwner = false;
      } else if (session && session.user) {
        currentUserId = session.user.id;
        isOwner = true;
      } else if (guestId) {
        currentUserId = guestId;
        isOwner = true;
      } else {
        window.location.href = '/login';
        return;
      }

      // 如果是本人，顯示「新增記錄」按鈕
      if (isOwner && openAddModalBtn) {
        openAddModalBtn.style.display = 'block';
      }

      await fetchAndRenderLogs();
    }

    async function fetchAndRenderLogs() {
      if (!currentUserId || !listContainer) return;
      listContainer.innerHTML = '<div style="text-align:center; color:#94a3b8; padding:20px;">載入記錄中...</div>';

      const { data, error } = await supabase
        .from(LOGS_TABLE)
        .select('*')
        .eq('user_id', currentUserId)
        .order('created_at', { ascending: false });

      if (error) {
        listContainer.innerHTML = '<div style="text-align:center; color:#ef4444; padding:20px;">載入記錄失敗</div>';
        return;
      }

      cachedLogs = data || [];

      if (cachedLogs.length === 0) {
        listContainer.innerHTML = '<div style="text-align:center; color:#64748b; padding:20px;">目前尚無閱讀記錄</div>';
        return;
      }

      let html = '';
      cachedLogs.forEach((item) => {
        html += `
          <div class="log-item-card" data-id="${item.id}">
            <span style="font-weight:bold; color:var(--accent-color); font-size:14px;">《${item.book_title || '無題'}》</span>
            <span style="font-size:12px; color:#94a3b8;">作者：${item.author || '佚名'}</span>
          </div>
        `;
      });
      listContainer.innerHTML = html;

      // 點擊直列卡片，彈出詳細筆記 Modal
      document.querySelectorAll('.log-item-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const logId = (e.currentTarget as HTMLElement).dataset.id;
          const log = cachedLogs.find(l => l.id === logId);
          if (log) {
            (document.getElementById('modal-book') as HTMLElement).textContent = `《${log.book_title || ''}》`;
            (document.getElementById('modal-author') as HTMLElement).textContent = log.author || '佚名';
            (document.getElementById('modal-translator') as HTMLElement).textContent = log.translator || '無';
            (document.getElementById('modal-start-date') as HTMLElement).textContent = log.start_date || '未填寫';
            (document.getElementById('modal-finish-date') as HTMLElement).textContent = log.finish_date || '未填寫';
            (document.getElementById('modal-publisher') as HTMLElement).textContent = log.publisher || '未填寫';
            
            const ratingNum = log.rating || 5;
            (document.getElementById('modal-rating') as HTMLElement).textContent = '⭐'.repeat(ratingNum);

            (document.getElementById('modal-quote') as HTMLElement).textContent = log.quote || '無記錄字句';
            (document.getElementById('modal-questions') as HTMLElement).textContent = log.questions || '無記錄疑問';
            (document.getElementById('modal-review') as HTMLElement).textContent = log.review || '無記錄感受';

            if (detailModal) detailModal.style.display = 'flex';
          }
        });
      });
    }

    // 按鈕控制彈窗開關
    openAddModalBtn?.addEventListener('click', () => { if (addRecordModal) addRecordModal.style.display = 'flex'; });
    closeAddModalBtn?.addEventListener('click', () => { if (addRecordModal) addRecordModal.style.display = 'none'; });
    detailCloseBtn?.addEventListener('click', () => { if (detailModal) detailModal.style.display = 'none'; });

    // 儲存新記錄
    submitBtn?.addEventListener('click', async () => {
      const bookTitle = (document.getElementById('book-title-input') as HTMLInputElement).value.trim();
      const author = (document.getElementById('book-author-input') as HTMLInputElement).value.trim() || '佚名';
      const translator = (document.getElementById('book-translator-input') as HTMLInputElement).value.trim();
      const startDate = (document.getElementById('start-date-input') as HTMLInputElement).value;
      const finishDate = (document.getElementById('finish-date-input') as HTMLInputElement).value;
      const publisher = (document.getElementById('publisher-input') as HTMLInputElement).value.trim();
      const rating = parseInt((document.getElementById('rating-input') as HTMLSelectElement).value) || 5;
      const quote = (document.getElementById('quote-input') as HTMLTextAreaElement).value.trim();
      const questions = (document.getElementById('questions-input') as HTMLTextAreaElement).value.trim();
      const review = (document.getElementById('review-input') as HTMLTextAreaElement).value.trim();

      if (!bookTitle) {
        alert('請填寫書名！');
        return;
      }

      if (!currentUserId) return;

      submitBtn.textContent = '儲存中...';
      const { error } = await supabase.from(LOGS_TABLE).insert({
        user_id: currentUserId,
        book_title: bookTitle,
        author: author,
        translator: translator,
        start_date: startDate,
        finish_date: finishDate,
        publisher: publisher,
        rating: rating,
        quote: quote,
        questions: questions,
        review: review
      });

      submitBtn.textContent = '儲存記錄';

      if (error) {
        alert('儲存失敗：' + error.message);
      } else {
        // 清空輸入欄位
        (document.getElementById('book-title-input') as HTMLInputElement).value = '';
        (document.getElementById('book-author-input') as HTMLInputElement).value = '';
        (document.getElementById('book-translator-input') as HTMLInputElement).value = '';
        (document.getElementById('start-date-input') as HTMLInputElement).value = '';
        (document.getElementById('finish-date-input') as HTMLInputElement).value = '';
        (document.getElementById('publisher-input') as HTMLInputElement).value = '';
        (document.getElementById('quote-input') as HTMLTextAreaElement).value = '';
        (document.getElementById('questions-input') as HTMLTextAreaElement).value = '';
        (document.getElementById('review-input') as HTMLTextAreaElement).value = '';

        if (addRecordModal) addRecordModal.style.display = 'none';
        await fetchAndRenderLogs();
      }
    });

    initPage();
  </script>
</Layout>