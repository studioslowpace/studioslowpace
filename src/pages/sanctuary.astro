---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 晴空文青共讀空間">
  <!-- 1. 創角 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 晴空書友登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">午後的長沙灣天空湛藍。請留下你的稱號，並選擇今日的讀者身份：</p>
        <input type="text" id="rpg-name-input" placeholder="例如：尋書人、阿朗..." maxlength="12" autofocus />
        
        <div class="role-selector-group">
          <label class="role-chip"><input type="radio" name="user-role" value="晴空選書" checked /> ☁️ 晴空選書</label>
          <label class="role-chip"><input type="radio" name="user-role" value="散文漫遊" /> 🍃 散文漫遊</label>
          <label class="role-chip"><input type="radio" name="user-role" value="靜心寫作" /> ✍️ 靜心寫作</label>
          <label class="role-chip"><input type="radio" name="user-role" value="浪費時間" /> ☕ 浪費時間</label>
        </div>

        <button id="rpg-start-btn" class="rpg-btn">▶ 推開晴空之門</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 閱讀與專心設定 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處安坐。請輸入書名與目前的閱讀章節：</p>
        <input type="text" id="rpg-book-input" placeholder="書名（例：《少女核》）" maxlength="20" />
        <div class="progress-input-group">
          <span>進度：第</span>
          <input type="number" id="rpg-chapter-input" value="1" min="1" max="99" style="width: 60px; text-align:center;" />
          <span>章</span>
        </div>
        <div class="rpg-btn-group" style="margin-top: 14px;">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">☁️ 開啟晴空專心 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 留言簿 Modal -->
  <div id="guestbook-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 460px;">
      <div class="rpg-title-bar"><span>📜 晴空靈魂留言簿</span></div>
      <div class="rpg-content">
        <p class="rpg-text">在不同的藍天底下，靈魂在此交會。留下一句金句或午後書評吧：</p>
        <div id="guestbook-list" class="guestbook-list"></div>
        <input type="text" id="guestbook-input" placeholder="寫下你的午後金句..." maxlength="40" />
        <div class="rpg-btn-group">
          <button id="guestbook-close-btn" class="rpg-btn-ghost">關閉</button>
          <button id="guestbook-submit-btn" class="rpg-btn">✍️ 留下足跡</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 主介面 -->
  <main class="rpg-container">
    <header class="rpg-hud">
      <div class="hud-left">
        <span class="hud-brand">☁️ 空間客舍</span>
        <span class="hud-divider">/</span>
        <div class="channel-tabs">
          <button class="channel-tab active" data-room="study">📖 晴空自修室</button>
          <button class="channel-tab" data-room="chat">☕ 藍調書話間</button>
          <button class="channel-tab" data-room="salon">🏛️ 微風沙龍</button>
        </div>
      </div>
      <div class="hud-right">
        <span class="user-tag" id="hud-role-tag">☁️ 讀者</span>
        <strong id="hud-name" style="color: #e0f2fe;">旅人</strong>
        <button id="btn-open-guestbook" class="rpg-btn-sm">📜 留言簿</button>
        <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 離開</a>
      </div>
    </header>

    <div class="canvas-wrapper">
      <canvas id="rpg-canvas" width="832" height="416"></canvas>
    </div>

    <footer class="rpg-footer">
      <div class="build-palette">
        <span class="palette-title">配置工具：</span>
        <button class="tool-btn active" data-tool="move">🚶 移動/入座</button>
        <button class="tool-btn" data-tool="seat">🪑 建造座位</button>
        <button class="tool-btn" data-tool="shelf">📚 建造書架</button>
      </div>

      <div class="action-dock">
        <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background:#38bdf8; color:#0f172a; font-weight:bold;">🚶 起立走動</button>
        <button id="btn-moktak" class="rpg-btn-sm">🪵 敲木魚</button>
        <span class="moktak-counter">功德榜: <strong id="moktak-count" style="color: #38bdf8;">0</strong> 功德</span>
      </div>
    </footer>
  </main>

  <style is:global>
    /* 🎨 文青天空藍色系設計 */
    body { 
      background-color: #0f172a; 
      color: #cbd5e1; 
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif, serif; 
      margin: 0; 
      padding: 0; 
      overflow: hidden; 
    }
    
    .rpg-modal-overlay { 
      position: fixed; inset: 0; 
      background: rgba(15, 23, 42, 0.75); 
      backdrop-filter: blur(6px); 
      display: flex; align-items: center; justify-content: center; 
      z-index: 100; 
    }
    
    .rpg-window { 
      background: #1e293b; 
      border: 1px solid #334155; 
      border-radius: 12px; 
      width: 90%; max-width: 420px; 
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2); 
    }
    
    .rpg-title-bar { 
      background: #0f172a; 
      color: #38bdf8; 
      padding: 12px 18px; 
      font-size: 13px; 
      font-weight: 500; 
      letter-spacing: 0.05em;
      border-top-left-radius: 11px;
      border-top-right-radius: 11px;
      border-bottom: 1px solid #334155; 
    }
    
    .rpg-content { padding: 22px; }
    
    .rpg-text { 
      font-size: 13px; 
      color: #94a3b8; 
      margin-bottom: 16px; 
      line-height: 1.7; 
    }
    
    .rpg-window input[type="text"], .rpg-window input[type="number"] { 
      width: 100%; 
      background: #0f172a; 
      border: 1px solid #334155; 
      color: #f8fafc; 
      padding: 10px 14px; 
      font-family: inherit; 
      font-size: 13px; 
      box-sizing: border-box; 
      margin-bottom: 16px; 
      outline: none; 
      border-radius: 8px; 
      transition: border-color 0.2s;
    }
    .rpg-window input[type="text"]:focus, .rpg-window input[type="number"]:focus {
      border-color: #38bdf8;
    }

    .role-selector-group { display: flex; flex-wrap: gap; gap: 8px; margin-bottom: 18px; }
    .role-chip { 
      background: #0f172a; 
      border: 1px solid #334155; 
      padding: 6px 12px; 
      border-radius: 20px; 
      font-size: 12px; 
      cursor: pointer; 
      color: #cbd5e1; 
      transition: all 0.2s;
    }
    .role-chip:hover { border-color: #38bdf8; color: #38bdf8; }
    .role-chip input { margin-right: 6px; accent-color: #38bdf8; }
    
    .progress-input-group { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #94a3b8; }
    
    .rpg-btn { 
      background: #0284c7; 
      color: #f8fafc; 
      border: none; 
      padding: 10px 16px; 
      font-family: inherit; 
      font-size: 13px; 
      cursor: pointer; 
      width: 100%; 
      font-weight: 500; 
      border-radius: 8px; 
      transition: background 0.2s;
    }
    .rpg-btn:hover { background: #0ea5e9; }
    
    .rpg-btn-ghost { 
      background: transparent; 
      color: #94a3b8; 
      border: 1px solid #334155; 
      padding: 10px 16px; 
      font-family: inherit; 
      font-size: 13px; 
      cursor: pointer; 
      width: 100%; 
      border-radius: 8px; 
      transition: all 0.2s;
    }
    .rpg-btn-ghost:hover { border-color: #64748b; color: #f8fafc; }
    
    .rpg-btn-group { display: flex; gap: 10px; }
    
    .guestbook-list { 
      max-height: 160px; 
      overflow-y: auto; 
      background: #0f172a; 
      border: 1px solid #334155; 
      border-radius: 8px; 
      padding: 12px; 
      margin-bottom: 14px; 
      font-size: 12px; 
      line-height: 1.6;
    }
    .guestbook-item { margin-bottom: 8px; border-bottom: 1px dashed #1e293b; padding-bottom: 6px; }
    .guestbook-author { color: #38bdf8; font-weight: 500; }
    
    .rpg-container { width: 100vw; height: 100vh; display: flex; flex-direction: column; justify-content: space-between; }
    
    .rpg-hud { 
      background: #1e293b; 
      border-bottom: 1px solid #334155; 
      padding: 10px 24px; 
      display: flex; justify-content: space-between; align-items: center; 
      font-size: 13px; 
    }
    .hud-left { display: flex; align-items: center; gap: 14px; }
    .hud-brand { font-weight: 600; color: #38bdf8; letter-spacing: 0.05em; }
    .hud-divider { color: #334155; }
    
    .channel-tabs { display: flex; gap: 8px; }
    .channel-tab { 
      background: #0f172a; 
      color: #94a3b8; 
      border: 1px solid #334155; 
      padding: 6px 14px; 
      font-family: inherit; 
      font-size: 12px; 
      cursor: pointer; 
      border-radius: 20px; 
      transition: all 0.2s;
    }
    .channel-tab:hover { color: #f8fafc; border-color: #64748b; }
    .channel-tab.active { background: #0284c7; color: #f8fafc; border-color: #0284c7; font-weight: 500; }
    
    .hud-right { display: flex; align-items: center; gap: 12px; }
    .user-tag { 
      background: #0f172a; 
      border: 1px solid #334155; 
      padding: 4px 10px; 
      border-radius: 12px; 
      font-size: 11px; 
      color: #38bdf8; 
    }
    
    .rpg-btn-sm { 
      background: #0f172a; 
      color: #cbd5e1; 
      border: 1px solid #334155; 
      padding: 6px 12px; 
      font-family: inherit; 
      font-size: 12px; 
      cursor: pointer; 
      border-radius: 8px; 
      transition: all 0.2s;
    }
    .rpg-btn-sm:hover { border-color: #38bdf8; color: #38bdf8; }
    
    .canvas-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; background: #0b1329; padding: 12px; }
    
    #rpg-canvas { 
      border: 1px solid #1e293b; 
      background: #0f172a; 
      cursor: pointer; 
      image-rendering: pixelated; 
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4); 
      border-radius: 12px; 
    }
    
    .rpg-footer { 
      background: #1e293b; 
      border-top: 1px solid #334155; 
      padding: 12px 24px; 
      display: flex; justify-content: space-between; align-items: center; 
    }
    .build-palette { display: flex; align-items: center; gap: 10px; }
    .palette-title { font-size: 12px; color: #94a3b8; }
    
    .tool-btn { 
      background: #0f172a; 
      color: #94a3b8; 
      border: 1px solid #334155; 
      padding: 6px 14px; 
      font-family: inherit; 
      font-size: 12px; 
      cursor: pointer; 
      border-radius: 8px; 
      transition: all 0.2s;
    }
    .tool-btn:hover { color: #f8fafc; border-color: #64748b; }
    .tool-btn.active { background: #0284c7; color: #f8fafc; border-color: #0284c7; font-weight: 500; }
    
    .action-dock { display: flex; align-items: center; gap: 12px; }
    .moktak-counter { font-size: 12px; color: #94a3b8; }
  </style>

  <script>
    const TILE_SIZE = 32;

    let playerName = '冒險者';
    let playerRole = '☁️ 讀者';
    let playerGx = 3;
    let playerGy = 8;
    let currentTool = 'move';
    let currentRoom = 'study';
    let isDND = false;
    let currentTask = '';
    let currentChapter = 1;
    let moktakCount = 0;

    let moveQueue: { gx: number; gy: number }[] = [];
    let moveTimer = 0;

    const imageCache: Record<string, HTMLImageElement> = {};
    const imageFailed: Record<string, boolean> = {};

    function getLoadedImage(src: string): HTMLImageElement | null {
      if (imageFailed[src]) return null;
      if (!imageCache[src]) {
        const img = new Image();
        img.onerror = () => { imageFailed[src] = true; };
        img.src = src;
        imageCache[src] = img;
      }
      return imageFailed[src] ? null : imageCache[src];
    }

    const rooms: Record<string, { 
      name: string; 
      items: { type: string; gx: number; gy: number; label: string; imgSrc: string }[];
      npcs: { name: string; task: string; gx: number; gy: number; imgSrc: string }[];
    }> = {
      study: {
        name: '晴空自修室',
        items: [
          { type: 'seat', gx: 8, gy: 5, label: '晴空木椅 A', imgSrc: '/assets/chair.png' },
          { type: 'seat', gx: 18, gy: 5, label: '晴空木椅 B', imgSrc: '/assets/chair.png' },
          { type: 'shelf', gx: 13, gy: 2, label: '藍調書櫃', imgSrc: '/assets/shelf.png' }
        ],
        npcs: [
          { name: '店長', task: '整理晴空筆記', gx: 21, gy: 4, imgSrc: '/assets/intern.png' }
        ]
      },
      chat: {
        name: '藍調書話間',
        items: [
          { type: 'seat', gx: 6, gy: 6, label: '微風沙發 A', imgSrc: '/assets/chair.png' },
          { type: 'seat', gx: 20, gy: 6, label: '靠窗交流位', imgSrc: '/assets/chair.png' }
        ],
        npcs: [
          { name: '實習生', task: '澆灌窗台綠意', gx: 7, gy: 10, imgSrc: '/assets/intern.png' }
        ]
      },
      salon: {
        name: '微風沙龍',
        items: [
          { type: 'seat', gx: 13, gy: 4, label: '講者席', imgSrc: '/assets/chair.png' }
        ],
        npcs: []
      }
    };

    let guestbookMessages = [
      { author: '阿朗', text: '「在長沙灣的藍天午後，讀著少女核，靈魂感到無比清澈。」' },
      { author: 'Mi', text: '「歡迎來到晴空客舍，祝大家閱讀愉快！」' }
    ];

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const guestbookModal = document.getElementById('guestbook-modal');
    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const chapterInput = document.getElementById('rpg-chapter-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const hudRoleTag = document.getElementById('hud-role-tag');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const moktakBtn = document.getElementById('btn-moktak');
    const moktakCountSpan = document.getElementById('moktak-count');
    const openGuestbookBtn = document.getElementById('btn-open-guestbook');
    const closeGuestbookBtn = document.getElementById('guestbook-close-btn');
    const submitGuestbookBtn = document.getElementById('guestbook-submit-btn');
    const guestbookInput = document.getElementById('guestbook-input') as HTMLInputElement;
    const guestbookList = document.getElementById('guestbook-list');

    let pendingSeat: { gx: number; gy: number; label: string } | null = null;
    let isGameStarted = false;

    startBtn?.addEventListener('click', () => {
      const val = nameInput?.value.trim();
      if (val) playerName = val;
      const selectedRole = document.querySelector('input[name="user-role"]:checked') as HTMLInputElement;
      if (selectedRole) playerRole = selectedRole.value;
      if (hudName) hudName.textContent = playerName;
      if (hudRoleTag) hudRoleTag.textContent = playerRole;
      if (modal) modal.style.display = 'none';

      if (!isGameStarted) {
        isGameStarted = true;
        gameLoop();
      }
    });

    document.querySelectorAll('.channel-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.channel-tab').forEach(t => t.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentRoom = target.dataset.room!;
        isDND = false;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
        playerGx = 3; playerGy = 8;
        moveQueue = [];
      });
    });

    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;
      });
    });

    function isCellOccupied(gx: number, gy: number): boolean {
      const maxCols = Math.floor(canvas.width / TILE_SIZE);
      const maxRows = Math.floor(canvas.height / TILE_SIZE);
      if (gx < 0 || gx >= maxCols || gy < 0 || gy >= maxRows) return true;

      const roomData = rooms[currentRoom];
      const hasItem = roomData.items.some(item => item.gx === gx && item.gy === gy);
      const hasNpc = roomData.npcs.some(npc => npc.gx === gx && npc.gy === gy);
      return hasItem || hasNpc;
    }

    canvas?.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      const targetGx = Math.floor(clickX / TILE_SIZE);
      const targetGy = Math.floor(clickY / TILE_SIZE);
      const roomData = rooms[currentRoom];

      if (currentTool === 'move') {
        const hitSeat = roomData.items.find(item => item.type === 'seat' && item.gx === targetGx && item.gy === targetGy);
        if (hitSeat) {
          pendingSeat = { gx: hitSeat.gx, gy: hitSeat.gy, label: hitSeat.label };
          if (seatModal) seatModal.style.display = 'flex';
        } else if (!isCellOccupied(targetGx, targetGy)) {
          moveQueue = [];
          let currX = playerGx;
          let currY = playerGy;

          while (currX !== targetGx) {
            currX += currX < targetGx ? 1 : -1;
            moveQueue.push({ gx: currX, gy: currY });
          }
          while (currY !== targetGy) {
            currY += currY < targetGy ? 1 : -1;
            moveQueue.push({ gx: currX, gy: currY });
          }

          if (isDND) {
            isDND = false;
            if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
          }
        }
      } else {
        if (!isCellOccupied(targetGx, targetGy) && !(playerGx === targetGx && playerGy === targetGy)) {
          const imgSrc = currentTool === 'shelf' ? '/assets/shelf.png' : '/assets/chair.png';
          roomData.items.push({ type: currentTool, gx: targetGx, gy: targetGy, label: '晴空傢俱', imgSrc });
        }
      }
    });

    confirmSeatBtn?.addEventListener('click', () => {
      if (pendingSeat) {
        playerGx = pendingSeat.gx;
        playerGy = pendingSeat.gy;
        moveQueue = [];
        const bookName = bookInput?.value.trim() || '晴空閱讀中';
        currentChapter = parseInt(chapterInput?.value) || 1;
        currentTask = `${bookName} (第 ${currentChapter} 章)`;
        isDND = true;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        if (seatModal) seatModal.style.display = 'none';
      }
    });

    cancelSeatBtn?.addEventListener('click', () => {
      if (seatModal) seatModal.style.display = 'none';
    });

    leaveSeatBtn?.addEventListener('click', () => {
      isDND = false;
      if (playerGy + 1 < Math.floor(canvas.height / TILE_SIZE) && !isCellOccupied(playerGx, playerGy + 1)) {
        playerGy += 1;
      }
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
    });

    openGuestbookBtn?.addEventListener('click', () => {
      renderGuestbook();
      if (guestbookModal) guestbookModal.style.display = 'flex';
    });
    closeGuestbookBtn?.addEventListener('click', () => {
      if (guestbookModal) guestbookModal.style.display = 'none';
    });
    submitGuestbookBtn?.addEventListener('click', () => {
      const text = guestbookInput?.value.trim();
      if (text) {
        guestbookMessages.unshift({ author: playerName, text: `「${text}」` });
        guestbookInput.value = '';
        renderGuestbook();
      }
    });

    function renderGuestbook() {
      if (!guestbookList) return;
      let html = '';
      guestbookMessages.forEach(m => {
        html += `<div class="guestbook-item"><span class="guestbook-author">${m.author}</span>: ${m.text}</div>`;
      });
      guestbookList.innerHTML = html;
    }

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      // 🎨 文青風天空藍深色背景色調
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // 極簡柔和網格線
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.05)';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += TILE_SIZE) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
      }
      for (let y = 0; y < canvas.height; y += TILE_SIZE) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
      }

      const roomData = rooms[currentRoom];

      moveTimer++;
      if (moveQueue.length > 0 && moveTimer % 8 === 0) {
        const nextStep = moveQueue.shift()!;
        if (!isCellOccupied(nextStep.gx, nextStep.gy)) {
          playerGx = nextStep.gx;
          playerGy = nextStep.gy;
        } else {
          moveQueue = [];
        }
      }

      roomData.items.forEach(item => {
        const px = item.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = item.gy * TILE_SIZE + TILE_SIZE / 2;
        const img = getLoadedImage(item.imgSrc);
        
        if (img && img.complete && img.naturalWidth !== 0) {
          ctx.drawImage(img, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#334155'; // 備用方塊改為柔和藍灰
          ctx.fillRect(px - 14, py - 14, 28, 28);
        }
        ctx.fillStyle = '#38bdf8';
        ctx.font = '9px sans-serif';
        ctx.fillText(`🪑 ${item.label}`, px - 24, py - 18);
      });

      roomData.npcs.forEach(npc => {
        const px = npc.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = npc.gy * TILE_SIZE + TILE_SIZE / 2;
        const npcImg = getLoadedImage(npc.imgSrc);
        
        if (npcImg && npcImg.complete && npcImg.naturalWidth !== 0) {
          ctx.drawImage(npcImg, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#0284c7';
          ctx.fillRect(px - 12, px - 12, 24, 24);
        }
        ctx.fillStyle = '#f8fafc';
        ctx.font = '10px sans-serif';
        ctx.fillText(npc.name, px - 18, py - 18);
      });

      const pScreenX = playerGx * TILE_SIZE + TILE_SIZE / 2;
      const pScreenY = playerGy * TILE_SIZE + TILE_SIZE / 2;
      const playerImg = getLoadedImage('/assets/player.png');

      if (playerImg && playerImg.complete && playerImg.naturalWidth !== 0) {
        ctx.drawImage(playerImg, pScreenX - 16, pScreenY - 16, 32, 32);
      } else {
        ctx.fillStyle = isDND ? '#10b981' : '#38bdf8';
        ctx.fillRect(pScreenX - 12, pScreenY - 12, 24, 24);
      }

      if (isDND) {
        ctx.fillStyle = '#047857';
        ctx.fillRect(pScreenX - 55, pScreenY - 52, 110, 20);
        ctx.fillStyle = '#d1fae5';
        ctx.font = 'bold 10px sans-serif';
        ctx.fillText('☁️ 晴空專心 (DND)', pScreenX - 48, pScreenY - 38);
      }

      ctx.fillStyle = '#f8fafc';
      ctx.font = '11px sans-serif';
      ctx.fillText(`[${playerRole}] ${playerName}`, pScreenX - 35, pScreenY + 24);
      if (isDND) {
        ctx.fillStyle = '#38bdf8';
        ctx.font = '10px sans-serif';
        ctx.fillText(`📖 讀: ${currentTask}`, pScreenX - 40, pScreenY + 36);
      }
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    moktakBtn?.addEventListener('click', () => {
      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      
      osc.type = 'sine';
      osc.frequency.setValueAtTime(600, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.15);
      
      gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
      
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      osc.start();
      osc.stop(audioCtx.currentTime + 0.15);

      moktakCount++;
      if (moktakCountSpan) moktakCountSpan.textContent = String(moktakCount);
    });
  </script>