---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 共讀空間">
  <!-- 1. 創角 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 身份登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">歡迎來到長沙灣空間客舍。請輸入稱號，並選擇你的書友身份組：</p>
        <input type="text" id="rpg-name-input" placeholder="例如：尋書人、阿朗..." maxlength="12" autofocus />
        
        <div class="role-selector-group">
          <label class="role-chip"><input type="radio" name="user-role" value="科幻迷" checked /> 🌌 科幻迷</label>
          <label class="role-chip"><input type="radio" name="user-role" value="歷史愛好者" /> 📜 歷史愛好者</label>
          <label class="role-chip"><input type="radio" name="user-role" value="寫作中" /> ✍️ 寫作中</label>
          <label class="role-chip"><input type="radio" name="user-role" value="閒逛者" /> ☕ 閒逛者</label>
        </div>

        <button id="rpg-start-btn" class="rpg-btn">▶ 推門入館</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 閱讀與專心設定 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處安坐。請輸入書名與目前的閱讀章節：</p>
        <input type="text" id="rpg-book-input" placeholder="書名（例：《少女核》）" maxlength="20" />
        <div class="progress-input-group">
          <span>進度：第</span>
          <input type="number" id="rpg-chapter-input" value="1" min="1" max="99" style="width: 60px; text-align:center;" />
          <span>章</span>
        </div>
        <div class="rpg-btn-group" style="margin-top: 14px;">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">🛑 開啟專心勿擾 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 留言簿 Modal -->
  <div id="guestbook-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 460px;">
      <div class="rpg-title-bar"><span>📜 客舍靈魂留言簿</span></div>
      <div class="rpg-content">
        <p class="rpg-text">即使不同時間到來，靈魂也能在此交會。留下一句金句或書評吧：</p>
        <div id="guestbook-list" class="guestbook-list"></div>
        <input type="text" id="guestbook-input" placeholder="寫下你的金句或心得..." maxlength="40" />
        <div class="rpg-btn-group">
          <button id="guestbook-close-btn" class="rpg-btn-ghost">關閉</button>
          <button id="guestbook-submit-btn" class="rpg-btn">✍️ 留下足跡</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 主介面 -->
  <main class="rpg-container">
    <header class="rpg-hud">
      <div class="hud-left">
        <span class="hud-brand">🏠 空間客舍</span>
        <span class="hud-divider">/</span>
        <div class="channel-tabs">
          <button class="channel-tab active" data-room="study">📖 靜心自修室</button>
          <button class="channel-tab" data-room="chat">☕ 自由書話間</button>
          <button class="channel-tab" data-room="salon">🏛️ 文學沙龍</button>
        </div>
      </div>
      <div class="hud-right">
        <span class="user-tag" id="hud-role-tag">📖 讀者</span>
        <strong id="hud-name">旅人</strong>
        <button id="btn-open-guestbook" class="rpg-btn-sm">📜 留言簿</button>
        <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 離開</a>
      </div>
    </header>

    <div class="canvas-wrapper">
      <canvas id="rpg-canvas" width="850" height="430"></canvas>
    </div>

    <footer class="rpg-footer">
      <div class="build-palette">
        <span class="palette-title">工具：</span>
        <button class="tool-btn active" data-tool="move">🚶 移動/入座</button>
        <button class="tool-btn" data-tool="seat">🪑 建造座位</button>
        <button class="tool-btn" data-tool="shelf">📚 建造書架</button>
      </div>

      <div class="action-dock">
        <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background:#8b3a3a; color:#fff;">🚶 起立走動</button>
        <button id="btn-moktak" class="rpg-btn-sm">🪵 敲木魚</button>
        <span class="moktak-counter">功德榜: <strong id="moktak-count">0</strong> 功德</span>
      </div>
    </footer>
  </main>

  <style is:global>
    body { background-color: #141210; color: #e6e2d3; font-family: serif, monospace; margin: 0; padding: 0; overflow: hidden; }
    .rpg-modal-overlay { position: fixed; inset: 0; background: rgba(15, 14, 12, 0.85); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .rpg-window { background: #25221d; border: 2px solid #8c7d6b; border-radius: 8px; width: 90%; max-width: 420px; box-shadow: 0 20px 40px rgba(0,0,0,0.6); }
    .rpg-title-bar { background: #3d3730; color: #f4f0ea; padding: 10px 16px; font-size: 13px; font-weight: bold; border-bottom: 2px solid #8c7d6b; }
    .rpg-content { padding: 20px; }
    .rpg-text { font-size: 13px; color: #b5a48b; margin-bottom: 14px; line-height: 1.6; }
    .rpg-window input[type="text"], .rpg-window input[type="number"] { width: 100%; background: #181614; border: 1px solid #6b5c4a; color: #f4f0ea; padding: 10px; font-family: serif; font-size: 14px; box-sizing: border-box; margin-bottom: 14px; outline: none; border-radius: 6px; }
    .role-selector-group { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
    .role-chip { background: #1e1b17; border: 1px solid #554d42; padding: 6px 10px; border-radius: 6px; font-size: 12px; cursor: pointer; color: #d1cbb8; }
    .role-chip input { margin-right: 4px; }
    .progress-input-group { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #b5a48b; }
    .rpg-btn { background: #5c4a38; color: #f4f0ea; border: 1px solid #8c7d6b; padding: 10px; font-family: serif; font-size: 13px; cursor: pointer; width: 100%; font-weight: bold; border-radius: 6px; }
    .rpg-btn:hover { background: #7a634b; }
    .rpg-btn-ghost { background: transparent; color: #b5a48b; border: 1px solid #6b5c4a; padding: 10px; font-family: serif; font-size: 13px; cursor: pointer; width: 100%; border-radius: 6px; }
    .rpg-btn-group { display: flex; gap: 10px; }
    .guestbook-list { max-height: 160px; overflow-y: auto; background: #181614; border: 1px solid #554d42; border-radius: 6px; padding: 10px; margin-bottom: 12px; font-size: 12px; }
    .guestbook-item { margin-bottom: 8px; border-bottom: 1px dashed #332d26; padding-bottom: 6px; }
    .guestbook-author { color: #d4af37; font-weight: bold; }
    .rpg-container { width: 100vw; height: 100vh; display: flex; flex-direction: column; justify-content: space-between; }
    .rpg-hud { background: #1c1a17; border-bottom: 1px solid #3d3730; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; font-size: 13px; }
    .hud-left { display: flex; align-items: center; gap: 12px; }
    .hud-brand { font-weight: bold; color: #d4af37; }
    .hud-divider { color: #554d42; }
    .channel-tabs { display: flex; gap: 6px; }
    .channel-tab { background: #25221d; color: #9c8e7b; border: 1px solid #4a3f35; padding: 4px 10px; font-family: serif; font-size: 12px; cursor: pointer; border-radius: 6px; }
    .channel-tab.active { background: #5c4a38; color: #f4f0ea; border-color: #d4af37; }
    .hud-right { display: flex; align-items: center; gap: 10px; }
    .user-tag { background: #2b2520; border: 1px solid #6b5c4a; padding: 2px 8px; border-radius: 4px; font-size: 11px; color: #d4af37; }
    .rpg-btn-sm { background: #2b2520; color: #d1cbb8; border: 1px solid #6b5c4a; padding: 6px 12px; font-family: serif; font-size: 12px; cursor: pointer; border-radius: 6px; }
    .canvas-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; background: #141210; padding: 12px; }
    #rpg-canvas { border: 2px solid #3d3730; background: #181614; cursor: pointer; image-rendering: pixelated; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border-radius: 8px; }
    .rpg-footer { background: #1c1a17; border-top: 1px solid #3d3730; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; }
    .build-palette { display: flex; align-items: center; gap: 8px; }
    .palette-title { font-size: 12px; color: #8a7e6c; }
    .tool-btn { background: #25221d; color: #b5a48b; border: 1px solid #554d42; padding: 6px 12px; font-family: serif; font-size: 12px; cursor: pointer; border-radius: 6px; }
    .tool-btn.active { background: #5c4a38; color: #f4f0ea; border-color: #d4af37; }
    .action-dock { display: flex; align-items: center; gap: 12px; }
    .moktak-counter { font-size: 12px; color: #d4af37; }
  </style>

  <script>
    let playerName = '冒險者';
    let playerRole = '📖 讀者';
    let playerX = 120;
    let playerY = 300;
    let targetX = 120;
    let targetY = 300;
    let currentTool = 'move';
    let currentRoom = 'study';
    let isDND = false;
    let currentTask = '';
    let currentChapter = 1;
    let moktakCount = 0;

    const imageCache: Record<string, HTMLImageElement> = {};
    function getLoadedImage(src: string): HTMLImageElement {
      if (!imageCache[src]) {
        const img = new Image();
        img.src = src;
        imageCache[src] = img;
      }
      return imageCache[src];
    }

    const rooms: Record<string, { 
      name: string; 
      items: { type: string; x: number; y: number; label: string; imgSrc: string }[];
      npcs: { name: string; task: string; x: number; y: number; imgSrc: string }[];
    }> = {
      study: {
        name: '靜心自修室',
        items: [
          { type: 'seat', x: 260, y: 160, label: '極靜自修木椅 A', imgSrc: '/assets/chair.png' },
          { type: 'seat', x: 580, y: 160, label: '極靜自修木椅 B', imgSrc: '/assets/chair.png' },
          { type: 'shelf', x: 420, y: 80, label: '文獻參考書櫃', imgSrc: '/assets/shelf.png' }
        ],
        npcs: [
          { name: '店長 Mi', task: '整理圖書帳目', x: 680, y: 140, imgSrc: '/assets/npc_mi.png' }
        ]
      },
      chat: {
        name: '自由書話間',
        items: [
          { type: 'seat', x: 200, y: 220, label: '茶水沙發 A', imgSrc: '/assets/chair.png' },
          { type: 'seat', x: 640, y: 220, label: '靠窗交流位', imgSrc: '/assets/chair.png' }
        ],
        npcs: [
          { name: '實習生', task: '維護空間綠意', x: 220, y: 320, imgSrc: '/assets/intern.png' }
        ]
      },
      salon: {
        name: '文學沙龍',
        items: [
          { type: 'seat', x: 420, y: 140, label: '講者席', imgSrc: '/assets/chair.png' }
        ],
        npcs: []
      }
    };

    let guestbookMessages = [
      { author: '阿朗', text: '「在長沙灣的午後，讀著少女核，靈魂感到無比安定。」' },
      { author: 'Mi', text: '「歡迎來到空間客舍，祝大家閱讀愉快！」' }
    ];

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const guestbookModal = document.getElementById('guestbook-modal');
    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const chapterInput = document.getElementById('rpg-chapter-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const hudRoleTag = document.getElementById('hud-role-tag');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const moktakBtn = document.getElementById('btn-moktak');
    const moktakCountSpan = document.getElementById('moktak-count');
    const openGuestbookBtn = document.getElementById('btn-open-guestbook');
    const closeGuestbookBtn = document.getElementById('guestbook-close-btn');
    const submitGuestbookBtn = document.getElementById('guestbook-submit-btn');
    const guestbookInput = document.getElementById('guestbook-input') as HTMLInputElement;
    const guestbookList = document.getElementById('guestbook-list');

    let pendingSeat: { x: number; y: number; label: string } | null = null;
    let isGameStarted = false;

    startBtn?.addEventListener('click', () => {
      const val = nameInput?.value.trim();
      if (val) playerName = val;
      const selectedRole = document.querySelector('input[name="user-role"]:checked') as HTMLInputElement;
      if (selectedRole) playerRole = selectedRole.value;
      if (hudName) hudName.textContent = playerName;
      if (hudRoleTag) hudRoleTag.textContent = playerRole;
      if (modal) modal.style.display = 'none';

      if (!isGameStarted) {
        isGameStarted = true;
        gameLoop();
      }
    });

    document.querySelectorAll('.channel-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.channel-tab').forEach(t => t.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentRoom = target.dataset.room!;
        isDND = false;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
        playerX = 120; playerY = 300; targetX = 120; targetY = 300;
      });
    });

    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;
      });
    });

    canvas?.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;
      const currentItems = rooms[currentRoom].items;

      if (currentTool === 'move') {
        const hitSeat = currentItems.find(item => item.type === 'seat' && Math.hypot(item.x - clickX, item.y - clickY) < 35);
        if (hitSeat) {
          pendingSeat = { x: hitSeat.x, y: hitSeat.y, label: hitSeat.label };
          if (seatModal) seatModal.style.display = 'flex';
        } else {
          targetX = clickX; targetY = clickY;
          if (isDND) { isDND = false; if (leaveSeatBtn) leaveSeatBtn.style.display = 'none'; }
        }
      } else {
        const imgSrc = currentTool === 'shelf' ? '/assets/shelf.png' : '/assets/chair.png';
        currentItems.push({ type: currentTool, x: clickX, y: clickY, label: '自建傢俱', imgSrc });
      }
    });

    confirmSeatBtn?.addEventListener('click', () => {
      if (pendingSeat) {
        playerX = pendingSeat.x; playerY = pendingSeat.y;
        targetX = pendingSeat.x; targetY = pendingSeat.y;
        const bookName = bookInput?.value.trim() || '靜心閱讀中';
        currentChapter = parseInt(chapterInput?.value) || 1;
        currentTask = `${bookName} (第 ${currentChapter} 章)`;
        isDND = true;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        if (seatModal) seatModal.style.display = 'none';
      }
    });

    cancelSeatBtn?.addEventListener('click', () => {
      if (seatModal) seatModal.style.display = 'none';
    });

    leaveSeatBtn?.addEventListener('click', () => {
      isDND = false; targetY += 35;
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
    });

    openGuestbookBtn?.addEventListener('click', () => {
      renderGuestbook();
      if (guestbookModal) guestbookModal.style.display = 'flex';
    });
    closeGuestbookBtn?.addEventListener('click', () => {
      if (guestbookModal) guestbookModal.style.display = 'none';
    });
    submitGuestbookBtn?.addEventListener('click', () => {
      const text = guestbookInput?.value.trim();
      if (text) {
        guestbookMessages.unshift({ author: playerName, text: `「${text}」` });
        guestbookInput.value = '';
        renderGuestbook();
      }
    });

    function renderGuestbook() {
      if (!guestbookList) return;
      let html = '';
      guestbookMessages.forEach(m => {
        html += `<div class="guestbook-item"><span class="guestbook-author">${m.author}</span>: ${m.text}</div>`;
      });
      guestbookList.innerHTML = html;
    }

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#181512';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      const roomData = rooms[currentRoom];

      roomData.items.forEach(item => {
        const img = getLoadedImage(item.imgSrc);
        if (img.complete && img.naturalWidth !== 0) {
          ctx.drawImage(img, item.x - 18, item.y - 18, 36, 36);
        } else {
          ctx.fillStyle = '#6b4f3b';
          ctx.fillRect(item.x - 16, item.y - 16, 32, 32);
        }
        ctx.fillStyle = '#d4af37';
        ctx.font = '10px serif';
        ctx.fillText(`🪑 ${item.label}`, item.x - 28, item.y - 22);
      });

      roomData.npcs.forEach(npc => {
        const npcImg = getLoadedImage(npc.imgSrc);
        if (npcImg.complete && npcImg.naturalWidth !== 0) {
          ctx.drawImage(npcImg, npc.x - 16, npc.y - 16, 32, 32);
        } else {
          ctx.fillStyle = '#2980b9';
          ctx.fillRect(npc.x - 12, npc.y - 12, 24, 24);
        }
        ctx.fillStyle = '#ffffff';
        ctx.font = '11px serif';
        ctx.fillText(npc.name, npc.x - 20, npc.y - 20);
        ctx.fillStyle = '#b5a48b';
        ctx.fillText(`(${npc.task})`, npc.x - 25, npc.y + 24);
      });

      playerX += (targetX - playerX) * 0.12;
      playerY += (targetY - playerY) * 0.12;

      const playerImg = getLoadedImage('/assets/player.png');
      if (playerImg.complete && playerImg.naturalWidth !== 0) {
        ctx.drawImage(playerImg, playerX - 16, playerY - 16, 32, 32);
      } else {
        ctx.fillStyle = isDND ? '#388e3c' : '#d97706';
        ctx.fillRect(playerX - 12, playerY - 12, 24, 24);
      }

      if (isDND) {
        ctx.fillStyle = '#8b3a3a';
        ctx.fillRect(playerX - 55, playerY - 52, 110, 20);
        ctx.fillStyle = '#ffcccc';
        ctx.font = 'bold 10px serif';
        ctx.fillText('🛑 專心勿擾 (DND)', playerX - 48, playerY - 38);
      }

      ctx.fillStyle = '#ffffff';
      ctx.font = '12px serif';
      ctx.fillText(`[${playerRole}] ${playerName}`, playerX - 35, playerY + 26);
      if (isDND) {
        ctx.fillStyle = '#facc15';
        ctx.font = '11px serif';
        ctx.fillText(`📖 讀: ${currentTask}`, playerX - 45, playerY + 40);
      }
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    // 原生 Web Audio 敲木魚聲 (免安裝套件，杜絕 404)
    moktakBtn?.addEventListener('click', () => {
      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      
      osc.type = 'sine';
      osc.frequency.setValueAtTime(600, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.15);
      
      gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
      
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      osc.start();
      osc.stop(audioCtx.currentTime + 0.15);

      moktakCount++;
      if (moktakCountSpan) moktakCountSpan.textContent = String(moktakCount);
    });
  </script>