---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 多人線上共讀空間">
  <!-- 1. 創角與頭像選擇 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 多人連線登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">午後的長沙灣天空湛藍。請選擇你的分身造型與書友身份：</p>
        
        <div class="avatar-selector-label">選擇分身造型：</div>
        <div class="avatar-selector-group">
          <label class="avatar-card">
            <input type="radio" name="player-avatar" value="/assets/player1.png" checked />
            <img src="/assets/player1.png" alt="Player 1" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="avatar-fallback" style="display:none;">👤 P1</span>
            <span class="avatar-name">分身一號</span>
          </label>
          <label class="avatar-card">
            <input type="radio" name="player-avatar" value="/assets/player2.png" />
            <img src="/assets/player2.png" alt="Player 2" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="avatar-fallback" style="display:none;">👤 P2</span>
            <span class="avatar-name">分身二號</span>
          </label>
        </div>

        <input type="text" id="rpg-name-input" placeholder="輸入你的稱號（例：尋書人）" maxlength="12" autofocus />
        
        <div class="role-selector-group">
          <label class="role-chip"><input type="radio" name="user-role" value="晴空選書" checked /> ☁️ 晴空選書</label>
          <label class="role-chip"><input type="radio" name="user-role" value="散文漫遊" /> 🍃 散文漫遊</label>
          <label class="role-chip"><input type="radio" name="user-role" value="靜心寫作" /> ✍️ 靜心寫作</label>
        </div>

        <button id="rpg-start-btn" class="rpg-btn">▶ 進入線上客舍</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 閱讀與專心設定 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處安坐。請輸入書名與目前的閱讀章節：</p>
        <input type="text" id="rpg-book-input" placeholder="書名（例：《少女核》）" maxlength="20" />
        <div class="progress-input-group">
          <span>進度：第</span>
          <input type="number" id="rpg-chapter-input" value="1" min="1" max="99" style="width: 60px; text-align:center;" />
          <span>章</span>
        </div>
        <div class="rpg-btn-group" style="margin-top: 14px;">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">☁️ 開啟晴空專心 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 留言簿 Modal -->
  <div id="guestbook-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 460px;">
      <div class="rpg-title-bar"><span>📜 晴空靈魂留言簿</span></div>
      <div class="rpg-content">
        <p class="rpg-text">在不同的藍天底下，靈魂在此交會。留下一句金句或午後書評吧：</p>
        <div id="guestbook-list" class="guestbook-list"></div>
        <input type="text" id="guestbook-input" placeholder="寫下你的午後金句..." maxlength="40" />
        <div class="rpg-btn-group">
          <button id="guestbook-close-btn" class="rpg-btn-ghost">關閉</button>
          <button id="guestbook-submit-btn" class="rpg-btn">✍️ 留下足跡</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 主介面 -->
  <main class="rpg-container">
    <header class="rpg-hud">
      <div class="hud-left">
        <span class="hud-brand">☁️ 空間客舍</span>
        <span class="hud-divider">/</span>
        <div class="channel-tabs">
          <button class="channel-tab active" data-room="study">📖 晴空自修室</button>
          <button class="channel-tab" data-room="chat">☕ 藍調書話間</button>
          <button class="channel-tab" data-room="salon">🏛️ 微風沙龍</button>
        </div>
      </div>
      <div class="hud-right">
        <span class="online-indicator">🟢 線上: <strong id="online-count">1</strong> 人</span>
        <span class="user-tag" id="hud-role-tag">☁️ 讀者</span>
        <strong id="hud-name" style="color: #e0f2fe;">旅人</strong>
        <button id="btn-open-guestbook" class="rpg-btn-sm">📜 留言簿</button>
        <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 離開</a>
      </div>
    </header>

    <div class="canvas-wrapper">
      <canvas id="rpg-canvas" width="960" height="540"></canvas>
    </div>

    <footer class="rpg-footer">
      <div class="build-palette">
        <span class="palette-title">配置工具：</span>
        <button class="tool-btn active" data-tool="move">🚶 移動/入座</button>
        <button class="tool-btn" data-tool="seat">🪑 建造座位</button>
        <button class="tool-btn" data-tool="shelf">📚 建造書架</button>
      </div>

      <div class="action-dock">
        <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background:#38bdf8; color:#0f172a; font-weight:bold;">🚶 起立走動</button>
        <button id="btn-moktak" class="rpg-btn-sm">🪵 敲木魚</button>
        <span class="moktak-counter">功德榜: <strong id="moktak-count" style="color: #38bdf8;">0</strong> 功德</span>
      </div>
    </footer>
  </main>

  <style is:global>
    body { background-color: #0f172a; color: #cbd5e1; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 0; overflow: hidden; }
    .rpg-modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .rpg-window { background: #1e293b; border: 1px solid #334155; border-radius: 12px; width: 90%; max-width: 440px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
    .rpg-title-bar { background: #0f172a; color: #38bdf8; padding: 12px 18px; font-size: 13px; font-weight: 500; border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom: 1px solid #334155; }
    .rpg-content { padding: 22px; }
    .rpg-text { font-size: 13px; color: #94a3b8; margin-bottom: 14px; line-height: 1.6; }
    
    .avatar-selector-label { font-size: 12px; color: #94a3b8; margin-bottom: 8px; }
    .avatar-selector-group { display: flex; gap: 12px; margin-bottom: 16px; }
    .avatar-card { flex: 1; background: #0f172a; border: 2px solid #334155; border-radius: 10px; padding: 10px; text-align: center; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .avatar-card:hover { border-color: #64748b; }
    .avatar-card input { display: none; }
    .avatar-card input:checked + img, .avatar-card input:checked ~ .avatar-fallback { border-color: #38bdf8; }
    .avatar-card input:checked ~ .avatar-name { color: #38bdf8; font-weight: bold; }
    .avatar-card img { width: 48px; height: 48px; object-fit: contain; image-rendering: pixelated; border-radius: 6px; background: #1e293b; padding: 4px; border: 1px solid #334155; }
    .avatar-fallback { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #1e293b; border-radius: 6px; font-size: 14px; color: #38bdf8; border: 1px solid #334155; }
    .avatar-name { font-size: 12px; color: #cbd5e1; }

    .rpg-window input[type="text"], .rpg-window input[type="number"] { width: 100%; background: #0f172a; border: 1px solid #334155; color: #f8fafc; padding: 10px 14px; font-family: inherit; font-size: 13px; box-sizing: border-box; margin-bottom: 14px; outline: none; border-radius: 8px; }
    .rpg-window input[type="text"]:focus { border-color: #38bdf8; }
    .role-selector-group { display: flex; gap: 8px; margin-bottom: 16px; }
    .role-chip { background: #0f172a; border: 1px solid #334155; padding: 6px 12px; border-radius: 20px; font-size: 12px; cursor: pointer; color: #cbd5e1; }
    .role-chip input { margin-right: 6px; accent-color: #38bdf8; }
    .progress-input-group { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #94a3b8; }
    .rpg-btn { background: #0284c7; color: #f8fafc; border: none; padding: 10px; font-family: inherit; font-size: 13px; cursor: pointer; width: 100%; font-weight: 500; border-radius: 8px; }
    .rpg-btn:hover { background: #0ea5e9; }
    .rpg-btn-ghost { background: transparent; color: #94a3b8; border: 1px solid #334155; padding: 10px; font-family: inherit; font-size: 13px; cursor: pointer; width: 100%; border-radius: 8px; }
    .rpg-btn-group { display: flex; gap: 10px; }
    .guestbook-list { max-height: 160px; overflow-y: auto; background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 12px; margin-bottom: 12px; font-size: 12px; }
    .guestbook-item { margin-bottom: 8px; border-bottom: 1px dashed #1e293b; padding-bottom: 6px; }
    .guestbook-author { color: #38bdf8; font-weight: 500; }
    .rpg-container { width: 100vw; height: 100vh; display: flex; flex-direction: column; justify-content: space-between; }
    .rpg-hud { background: #1e293b; border-bottom: 1px solid #334155; padding: 10px 24px; display: flex; justify-content: space-between; align-items: center; font-size: 13px; }
    .hud-left { display: flex; align-items: center; gap: 14px; }
    .hud-brand { font-weight: 600; color: #38bdf8; }
    .hud-divider { color: #334155; }
    .channel-tabs { display: flex; gap: 8px; }
    .channel-tab { background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 6px 14px; font-family: inherit; font-size: 12px; cursor: pointer; border-radius: 20px; }
    .channel-tab.active { background: #0284c7; color: #f8fafc; border-color: #0284c7; font-weight: 500; }
    .hud-right { display: flex; align-items: center; gap: 14px; }
    .online-indicator { font-size: 12px; color: #34d399; }
    .user-tag { background: #0f172a; border: 1px solid #334155; padding: 4px 10px; border-radius: 12px; font-size: 11px; color: #38bdf8; }
    .rpg-btn-sm { background: #0f172a; color: #cbd5e1; border: 1px solid #334155; padding: 6px 12px; font-family: inherit; font-size: 12px; cursor: pointer; border-radius: 8px; }
    .canvas-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; background: #0b1329; padding: 12px; }
    #rpg-canvas { border: 1px solid #1e293b; background: #0f172a; cursor: pointer; image-rendering: pixelated; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4); border-radius: 12px; }
    .rpg-footer { background: #1e293b; border-top: 1px solid #334155; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; }
    .build-palette { display: flex; align-items: center; gap: 10px; }
    .palette-title { font-size: 12px; color: #94a3b8; }
    .tool-btn { background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 6px 14px; font-family: inherit; font-size: 12px; cursor: pointer; border-radius: 8px; }
    .tool-btn.active { background: #0284c7; color: #f8fafc; border-color: #0284c7; font-weight: 500; }
    .action-dock { display: flex; align-items: center; gap: 12px; }
    .moktak-counter { font-size: 12px; color: #94a3b8; }
  </style>

  <script>
    import { createClient } from '@supabase/supabase-js';

    // 建立 Supabase 客戶端（請確保專案中有設定 PUBLIC_SUPABASE_URL 與 PUBLIC_SUPABASE_ANON_KEY）
    // 如果你在專案中已有共用的 supabase.ts，也可以直接 import 引入
    const SUPABASE_URL = 'https://blqlrxqckiuvgevmakbu.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG'; // 請確保這串是正確的 anon/public key
    const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const TILE_SIZE = 48;
    const userId = 'user_' + Math.random().toString(36).substring(2, 9); // 產生隨機訪客 ID

    let playerName = '冒險者';
    let playerRole = '☁️ 讀者';
    let playerAvatar = '/assets/player1.png';
    let playerGx = 4;
    let playerGy = 5;
    let currentTool = 'move';
    let currentRoom = 'study';
    let isDND = false;
    let currentTask = '';
    let moktakCount = 0;

    let moveQueue: { gx: number; gy: number }[] = [];
    let moveTimer = 0;

    // 儲存其他線上玩家的字典 { [userId]: playerState }
    let onlinePlayers: Record<string, any> = {};

    const imageCache: Record<string, HTMLImageElement> = {};
    const imageFailed: Record<string, boolean> = {};

    function getLoadedImage(src: string): HTMLImageElement | null {
      if (imageFailed[src]) return null;
      if (!imageCache[src]) {
        const img = new Image();
        img.onerror = () => { imageFailed[src] = true; };
        img.src = src;
        imageCache[src] = img;
      }
      return imageFailed[src] ? null : imageCache[src];
    }

    const rooms: Record<string, { 
      name: string; 
      items: { type: string; gx: number; gy: number; label: string; imgSrc: string }[];
      npcs: { name: string; task: string; gx: number; gy: number; imgSrc: string }[];
    }> = {
      study: {
        name: '晴空自修室',
        items: [
          { type: 'seat', gx: 6, gy: 3, label: '晴空木椅 A', imgSrc: '/assets/chair.png' },
          { type: 'seat', gx: 12, gy: 3, label: '晴空木椅 B', imgSrc: '/assets/chair.png' },
          { type: 'shelf', gx: 9, gy: 1, label: '藍調書櫃', imgSrc: '/assets/shelf.png' }
        ],
        npcs: [
          { name: '店長 Mi', task: '整理晴空筆記', gx: 16, gy: 2, imgSrc: '/assets/npc_mi.png' }
        ]
      },
      chat: {
        name: '藍調書話間',
        items: [
          { type: 'seat', gx: 4, gy: 4, label: '微風沙發 A', imgSrc: '/assets/chair.png' },
          { type: 'seat', gx: 14, gy: 4, label: '靠窗交流位', imgSrc: '/assets/chair.png' }
        ],
        npcs: [
          { name: '實習生', task: '澆灌窗台綠意', gx: 5, gy: 8, imgSrc: '/assets/intern.png' }
        ]
      },
      salon: {
        name: '微風沙龍',
        items: [
          { type: 'seat', gx: 9, gy: 3, label: '講者席', imgSrc: '/assets/chair.png' }
        ],
        npcs: []
      }
    };

    let guestbookMessages = [
      { author: '阿朗', text: '「在長沙灣的藍天午後，讀著少女核，靈魂感到無比清澈。」' },
      { author: 'Mi', text: '「歡迎來到晴空客舍，祝大家閱讀愉快！」' }
    ];

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const guestbookModal = document.getElementById('guestbook-modal');
    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const chapterInput = document.getElementById('rpg-chapter-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const hudRoleTag = document.getElementById('hud-role-tag');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const moktakBtn = document.getElementById('btn-moktak');
    const moktakCountSpan = document.getElementById('moktak-count');
    const openGuestbookBtn = document.getElementById('btn-open-guestbook');
    const closeGuestbookBtn = document.getElementById('guestbook-close-btn');
    const submitGuestbookBtn = document.getElementById('guestbook-submit-btn');
    const guestbookInput = document.getElementById('guestbook-input') as HTMLInputElement;
    const guestbookList = document.getElementById('guestbook-list');
    const onlineCountSpan = document.getElementById('online-count');

    let pendingSeat: { gx: number; gy: number; label: string } | null = null;
    let isGameStarted = false;
    let presenceChannel: any = null;

    // 啟動 Supabase Realtime Presence 頻道
    function initRealtimeSync() {
      presenceChannel = supabase.channel('sanctuary_room_multiplayer', {
        config: { presence: { key: userId } }
      });

      presenceChannel
        .on('presence', { event: 'sync' }, () => {
          const state = presenceChannel.presenceState();
          onlinePlayers = {};
          let totalCount = 0;

          Object.keys(state).forEach(key => {
            const userPresences = state[key] as any[];
            if (userPresences && userPresences.length > 0) {
              const info = userPresences[0];
              // 只同步同一個房間的玩家
              if (info.room === currentRoom && key !== userId) {
                onlinePlayers[key] = info;
              }
              totalCount++;
            }
          });

          if (onlineCountSpan) onlineCountSpan.textContent = String(totalCount);
        })
        .subscribe(async (status: string) => {
          if (status === 'SUBSCRIBED') {
            await updateMyPresence();
          }
        });
    }

    // 發送我自己的即時狀態給所有線上訪客
    async function updateMyPresence() {
      if (!presenceChannel) return;
      await presenceChannel.track({
        name: playerName,
        role: playerRole,
        avatar: playerAvatar,
        room: currentRoom,
        gx: playerGx,
        gy: playerGy,
        isDND: isDND,
        task: currentTask
      });
    }

    startBtn?.addEventListener('click', async () => {
      const val = nameInput?.value.trim();
      if (val) playerName = val;

      const selectedAvatar = document.querySelector('input[name="player-avatar"]:checked') as HTMLInputElement;
      if (selectedAvatar) playerAvatar = selectedAvatar.value;

      const selectedRole = document.querySelector('input[name="user-role"]:checked') as HTMLInputElement;
      if (selectedRole) playerRole = selectedRole.value;

      if (hudName) hudName.textContent = playerName;
      if (hudRoleTag) hudRoleTag.textContent = playerRole;
      if (modal) modal.style.display = 'none';

      if (!isGameStarted) {
        isGameStarted = true;
        initRealtimeSync();
        gameLoop();
      }
    });

    document.querySelectorAll('.channel-tab').forEach(tab => {
      tab.addEventListener('click', async (e) => {
        document.querySelectorAll('.channel-tab').forEach(t => t.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentRoom = target.dataset.room!;
        isDND = false;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
        playerGx = 4; playerGy = 5;
        moveQueue = [];
        await updateMyPresence();
      });
    });

    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;
      });
    });

    function isCellOccupied(gx: number, gy: number): boolean {
      const maxCols = Math.floor(canvas.width / TILE_SIZE);
      const maxRows = Math.floor(canvas.height / TILE_SIZE);
      if (gx < 0 || gx >= maxCols || gy < 0 || gy >= maxRows) return true;

      const roomData = rooms[currentRoom];
      const hasItem = roomData.items.some(item => item.gx === gx && item.gy === gy);
      const hasNpc = roomData.npcs.some(npc => npc.gx === gx && npc.gy === gy);
      const hasOther = Object.values(onlinePlayers).some((p: any) => p.gx === gx && p.gy === gy);
      return hasItem || hasNpc || hasOther;
    }

    canvas?.addEventListener('click', async (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      const targetGx = Math.floor(clickX / TILE_SIZE);
      const targetGy = Math.floor(clickY / TILE_SIZE);
      const roomData = rooms[currentRoom];

      if (currentTool === 'move') {
        const hitSeat = roomData.items.find(item => item.type === 'seat' && item.gx === targetGx && item.gy === targetGy);
        if (hitSeat) {
          pendingSeat = { gx: hitSeat.gx, gy: hitSeat.gy, label: hitSeat.label };
          if (seatModal) seatModal.style.display = 'flex';
        } else if (!isCellOccupied(targetGx, targetGy)) {
          moveQueue = [];
          let currX = playerGx;
          let currY = playerGy;

          while (currX !== targetGx) {
            currX += currX < targetGx ? 1 : -1;
            moveQueue.push({ gx: currX, gy: currY });
          }
          while (currY !== targetGy) {
            currY += currY < targetGy ? 1 : -1;
            moveQueue.push({ gx: currX, gy: currY });
          }

          if (isDND) {
            isDND = false;
            if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
          }
        }
      } else {
        if (!isCellOccupied(targetGx, targetGy) && !(playerGx === targetGx && playerGy === targetGy)) {
          const imgSrc = currentTool === 'shelf' ? '/assets/shelf.png' : '/assets/chair.png';
          roomData.items.push({ type: currentTool, gx: targetGx, gy: targetGy, label: '晴空傢俱', imgSrc });
        }
      }
    });

    confirmSeatBtn?.addEventListener('click', async () => {
      if (pendingSeat) {
        playerGx = pendingSeat.gx;
        playerGy = pendingSeat.gy;
        moveQueue = [];
        const bookName = bookInput?.value.trim() || '晴空閱讀中';
        const chapter = parseInt(chapterInput?.value) || 1;
        currentTask = `${bookName} (第 ${chapter} 章)`;
        isDND = true;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        if (seatModal) seatModal.style.display = 'none';
        await updateMyPresence();
      }
    });

    cancelSeatBtn?.addEventListener('click', () => {
      if (seatModal) seatModal.style.display = 'none';
    });

    leaveSeatBtn?.addEventListener('click', async () => {
      isDND = false;
      if (playerGy + 1 < Math.floor(canvas.height / TILE_SIZE) && !isCellOccupied(playerGx, playerGy + 1)) {
        playerGy += 1;
      }
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      await updateMyPresence();
    });

    openGuestbookBtn?.addEventListener('click', () => {
      renderGuestbook();
      if (guestbookModal) guestbookModal.style.display = 'flex';
    });
    closeGuestbookBtn?.addEventListener('click', () => {
      if (guestbookModal) guestbookModal.style.display = 'none';
    });
    submitGuestbookBtn?.addEventListener('click', () => {
      const text = guestbookInput?.value.trim();
      if (text) {
        guestbookMessages.unshift({ author: playerName, text: `「${text}」` });
        guestbookInput.value = '';
        renderGuestbook();
      }
    });

    function renderGuestbook() {
      if (!guestbookList) return;
      let html = '';
      guestbookMessages.forEach(m => {
        html += `<div class="guestbook-item"><span class="guestbook-author">${m.author}</span>: ${m.text}</div>`;
      });
      guestbookList.innerHTML = html;
    }

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.strokeStyle = 'rgba(56, 189, 248, 0.06)';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += TILE_SIZE) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
      }
      for (let y = 0; y < canvas.height; y += TILE_SIZE) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
      }

      const roomData = rooms[currentRoom];

      moveTimer++;
      if (moveQueue.length > 0 && moveTimer % 6 === 0) {
        const nextStep = moveQueue.shift()!;
        if (!isCellOccupied(nextStep.gx, nextStep.gy)) {
          playerGx = nextStep.gx;
          playerGy = nextStep.gy;
          updateMyPresence(); // 移動時實時同步座標
        } else {
          moveQueue = [];
        }
      }

      // 1. 繪製傢俱物件
      roomData.items.forEach(item => {
        const px = item.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = item.gy * TILE_SIZE + TILE_SIZE / 2;
        const img = getLoadedImage(item.imgSrc);
        
        if (img && img.complete && img.naturalWidth !== 0) {
          ctx.drawImage(img, px - 24, py - 24, 48, 48);
        } else {
          ctx.fillStyle = '#334155';
          ctx.fillRect(px - 20, py - 20, 40, 40);
        }
        ctx.fillStyle = '#38bdf8';
        ctx.font = '10px sans-serif';
        ctx.fillText(`🪑 ${item.label}`, px - 32, py - 26);
      });

      // 2. 繪製常駐 NPC
      roomData.npcs.forEach(npc => {
        const px = npc.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = npc.gy * TILE_SIZE + TILE_SIZE / 2;
        const npcImg = getLoadedImage(npc.imgSrc);
        
        if (npcImg && npcImg.complete && npcImg.naturalWidth !== 0) {
          ctx.drawImage(npcImg, px - 24, py - 24, 48, 48);
        } else {
          ctx.fillStyle = '#0284c7';
          ctx.fillRect(px - 20, py - 20, 40, 40);
        }
        ctx.fillStyle = '#f8fafc';
        ctx.font = '11px sans-serif';
        ctx.fillText(npc.name, px - 24, py - 28);
      });

      // 3. 繪製真正的線上其他玩家 (Realtime Peers)
      Object.values(onlinePlayers).forEach((op: any) => {
        const px = op.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = op.gy * TILE_SIZE + TILE_SIZE / 2;
        const opImg = getLoadedImage(op.avatar || '/assets/player2.png');

        if (opImg && opImg.complete && opImg.naturalWidth !== 0) {
          ctx.drawImage(opImg, px - 24, py - 24, 48, 48);
        } else {
          ctx.fillStyle = '#10b981';
          ctx.fillRect(px - 20, py - 20, 40, 40);
        }

        ctx.fillStyle = '#34d399';
        ctx.font = '10px sans-serif';
        ctx.fillText(`[${op.role}] ${op.name}`, px - 35, py + 32);
        if (op.isDND && op.task) {
          ctx.fillStyle = '#facc15';
          ctx.font = '9px sans-serif';
          ctx.fillText(`📖 ${op.task}`, px - 35, py + 44);
        }
      });

      // 4. 繪製你自己的玩家分身
      const pScreenX = playerGx * TILE_SIZE + TILE_SIZE / 2;
      const pScreenY = playerGy * TILE_SIZE + TILE_SIZE / 2;
      const playerImg = getLoadedImage(playerAvatar);

      if (playerImg && playerImg.complete && playerImg.naturalWidth !== 0) {
        ctx.drawImage(playerImg, pScreenX - 24, pScreenY - 24, 48, 48);
      } else {
        ctx.fillStyle = isDND ? '#10b981' : '#38bdf8';
        ctx.fillRect(pScreenX - 20, pScreenY - 20, 40, 40);
      }

      if (isDND) {
        ctx.fillStyle = '#047857';
        ctx.fillRect(pScreenX - 60, pScreenY - 58, 120, 22);
        ctx.fillStyle = '#d1fae5';
        ctx.font = 'bold 10px sans-serif';
        ctx.fillText('☁️ 晴空專心 (DND)', pScreenX - 52, pScreenY - 43);
      }

      ctx.fillStyle = '#f8fafc';
      ctx.font = '11px sans-serif';
      ctx.fillText(`[${playerRole}] ${playerName}`, pScreenX - 35, pScreenY + 32);
      if (isDND) {
        ctx.fillStyle = '#38bdf8';
        ctx.font = '10px sans-serif';
        ctx.fillText(`📖 讀: ${currentTask}`, pScreenX - 45, pScreenY + 44);
      }
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    moktakBtn?.addEventListener('click', () => {
      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      
      osc.type = 'sine';
      osc.frequency.setValueAtTime(600, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.15);
      
      gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
      
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      osc.start();
      osc.stop(audioCtx.currentTime + 0.15);

      moktakCount++;
      if (moktakCountSpan) moktakCountSpan.textContent = String(moktakCount);
    });
  </script>