---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 沉浸式共讀空間">
  <!-- 1. 創角 / 進入對話框 -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 進入共讀空間 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">歡迎來到長沙灣空間客舍。請輸入你的稱號，開啟今日的閱讀與創作旅程：</p>
        <input type="text" id="rpg-name-input" placeholder="例如：阿朗、尋書人..." maxlength="12" autofocus />
        <button id="rpg-start-btn" class="rpg-btn">▶ 推門入館</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座與填寫任務 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none; opacity: 0;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 沉浸閱讀設定 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處安坐。請輸入你正在閱讀的書籍或執行的專案：</p>
        <input type="text" id="rpg-book-input" placeholder="例如：《少女核》、編寫 Astro 專案..." maxlength="25" />
        <div class="rpg-btn-group">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">🛑 開啟專心勿擾 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 主畫面 -->
  <main class="rpg-container">
    <header class="rpg-hud">
      <div class="hud-left">
        <span class="hud-brand">空間客舍</span>
        <span class="hud-divider">|</span>
        <span class="hud-label">讀者：</span><strong id="hud-name">旅人</strong>
      </div>
      <div class="hud-center">
        <span class="mode-badge" id="current-mode-label">🚶 移動與入座模式</span>
      </div>
      <div class="hud-right">
        <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 返回主站</a>
      </div>
    </header>

    <!-- Canvas 畫布區 -->
    <div class="canvas-wrapper">
      <canvas id="rpg-canvas" width="850" height="450"></canvas>
    </div>

    <!-- 底部功能與打造工具列 -->
    <footer class="rpg-footer">
      <div class="build-palette">
        <span class="palette-title">打造工具：</span>
        <button class="tool-btn active" data-tool="move">🚶 移動/入座</button>
        <button class="tool-btn" data-tool="seat">🪑 建造座位</button>
        <button class="tool-btn" data-tool="shelf">📚 建造書架</button>
        <button class="tool-btn" data-tool="plant">🌿 放置盆栽</button>
      </div>
      
      <div class="action-dock">
        <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background:#8b3a3a; color:#fff;">🚶 站起來走動</button>
        <button id="btn-moktak" class="rpg-btn-sm">🪵 敲木魚</button>
        <span class="moktak-counter">功德: <strong id="moktak-count">0</strong></span>
      </div>
    </footer>
  </main>

  <style is:global>
    body {
      background-color: #141210;
      color: #e6e2d3;
      font-family: serif, monospace;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    /* 視窗風格 Modal */
    .rpg-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 14, 12, 0.85);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      transition: opacity 0.3s ease;
    }
    .rpg-window {
      background: #25221d;
      border: 2px solid #8c7d6b;
      border-radius: 8px;
      width: 90%;
      max-width: 420px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
    }
    .rpg-title-bar {
      background: #3d3730;
      color: #f4f0ea;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: bold;
      border-bottom: 2px solid #8c7d6b;
      letter-spacing: 1px;
    }
    .rpg-content { padding: 24px; }
    .rpg-text { font-size: 13px; color: #b5a48b; margin-bottom: 16px; line-height: 1.6; }
    .rpg-window input[type="text"] {
      width: 100%;
      background: #181614;
      border: 1px solid #6b5c4a;
      color: #f4f0ea;
      padding: 12px;
      font-family: serif;
      font-size: 14px;
      box-sizing: border-box;
      margin-bottom: 18px;
      outline: none;
      border-radius: 6px;
    }
    .rpg-window input[type="text"]:focus { border-color: #d4af37; }
    .rpg-btn {
      background: #5c4a38;
      color: #f4f0ea;
      border: 1px solid #8c7d6b;
      padding: 10px;
      font-family: serif;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
      font-weight: bold;
      border-radius: 6px;
      transition: background 0.2s;
    }
    .rpg-btn:hover { background: #7a634b; }
    .rpg-btn-ghost {
      background: transparent;
      color: #b5a48b;
      border: 1px solid #6b5c4a;
      padding: 10px;
      font-family: serif;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
      border-radius: 6px;
    }
    .rpg-btn-group { display: flex; gap: 10px; }

    /* 主容器 */
    .rpg-container {
      width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* 頂部 HUD 導覽 */
    .rpg-hud {
      background: #1c1a17;
      border-bottom: 1px solid #3d3730;
      padding: 12px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
    }
    .hud-left { display: flex; align-items: center; gap: 10px; }
    .hud-brand { font-weight: bold; color: #d4af37; letter-spacing: 1px; }
    .hud-divider { color: #554d42; }
    .hud-label { color: #8a7e6c; }
    .mode-badge {
      background: #2b2520;
      border: 1px solid #6b5c4a;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      color: #d1cbb8;
    }
    .rpg-btn-sm {
      background: #2b2520;
      color: #d1cbb8;
      border: 1px solid #6b5c4a;
      padding: 6px 14px;
      font-family: serif;
      font-size: 12px;
      cursor: pointer;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .rpg-btn-sm:hover { background: #4a3f35; color: #fff; }

    /* 畫布包裝器 */
    .canvas-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #141210;
      padding: 12px;
    }
    #rpg-canvas {
      border: 2px solid #3d3730;
      background: #181614;
      cursor: pointer;
      image-rendering: pixelated;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border-radius: 8px;
    }

    /* 底部打造工具列 */
    .rpg-footer {
      background: #1c1a17;
      border-top: 1px solid #3d3730;
      padding: 12px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .build-palette { display: flex; align-items: center; gap: 8px; }
    .palette-title { font-size: 12px; color: #8a7e6c; }
    .tool-btn {
      background: #25221d;
      color: #b5a48b;
      border: 1px solid #554d42;
      padding: 6px 12px;
      font-family: serif;
      font-size: 12px;
      cursor: pointer;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .tool-btn.active {
      background: #5c4a38;
      color: #f4f0ea;
      border-color: #d4af37;
    }
    .action-dock { display: flex; align-items: center; gap: 12px; }
    .moktak-counter { font-size: 12px; color: #d4af37; }
  </style>

  <script>
    import * as Tone from 'tone';

    let playerName = '冒險者';
    let playerX = 120;
    let playerY = 320;
    let targetX = 120;
    let targetY = 320;
    let currentTool = 'move';
    let isDND = false;
    let currentTask = '';
    let moktakCount = 0;
    let audioOn = false;

    // 初始空間傢俱與座位
    let customItems: { type: string; x: number; y: number; label: string }[] = [
      { type: 'seat', x: 280, y: 180, label: '窗邊靜讀木椅' },
      { type: 'seat', x: 580, y: 180, label: '角落沙發區' },
      { type: 'shelf', x: 430, y: 90, label: '香港文學書牆' }
    ];

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const modeLabel = document.getElementById('current-mode-label');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const moktakBtn = document.getElementById('btn-moktak');
    const moktakCountSpan = document.getElementById('moktak-count');

    let pendingSeat: { x: number; y: number; label: string } | null = null;

    startBtn?.addEventListener('click', () => {
      const val = nameInput?.value.trim();
      if (val) playerName = val;
      if (hudName) hudName.textContent = playerName;
      if (modal) {
        modal.style.opacity = '0';
        setTimeout(() => modal.style.display = 'none', 300);
      }
      gameLoop();
    });

    // 工具切換
    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;

        if (currentTool === 'move') {
          if (modeLabel) modeLabel.textContent = '🚶 移動與入座模式';
        } else if (currentTool === 'seat') {
          if (modeLabel) modeLabel.textContent = '🪑 建造座位模式';
        } else if (currentTool === 'shelf') {
          if (modeLabel) modeLabel.textContent = '📚 建造書架模式';
        } else if (currentTool === 'plant') {
          if (modeLabel) modeLabel.textContent = '🌿 放置盆栽模式';
        }
      });
    });

    // 畫布互動
    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      if (currentTool === 'move') {
        const hitSeat = customItems.find(item => item.type === 'seat' && Math.hypot(item.x - clickX, item.y - clickY) < 35);
        if (hitSeat) {
          pendingSeat = { x: hitSeat.x, y: hitSeat.y, label: hitSeat.label };
          if (seatModal) {
            seatModal.style.display = 'flex';
            setTimeout(() => seatModal.style.opacity = '1', 10);
          }
        } else {
          targetX = clickX;
          targetY = clickY;
          if (isDND) {
            isDND = false;
            if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
          }
        }
      } else {
        let type = currentTool;
        let label = type === 'seat' ? '自建木椅' : type === 'shelf' ? '精選書櫃' : '綠意植栽';
        customItems.push({ type, x: clickX, y: clickY, label });
      }
    });

    confirmSeatBtn?.addEventListener('click', () => {
      if (pendingSeat) {
        playerX = pendingSeat.x;
        playerY = pendingSeat.y;
        targetX = pendingSeat.x;
        targetY = pendingSeat.y;
        currentTask = bookInput?.value.trim() || '專心沉澱中';
        isDND = true;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        closeSeatModal();
      }
    });

    cancelSeatBtn?.addEventListener('click', closeSeatModal);
    function closeSeatModal() {
      if (seatModal) {
        seatModal.style.opacity = '0';
        setTimeout(() => seatModal.style.display = 'none', 300);
      }
    }

    leaveSeatBtn?.addEventListener('click', () => {
      isDND = false;
      targetY += 30;
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
    });

    // 繪製引擎
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 地板 (木質調暗色系)
      ctx.fillStyle = '#1b1815';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // 繪製自建物件
      customItems.forEach(item => {
        if (item.type === 'seat') {
          ctx.fillStyle = '#6b4f3b';
          ctx.fillRect(item.x - 16, item.y - 16, 32, 32);
          ctx.fillStyle = '#d4af37';
          ctx.font = '10px serif';
          ctx.fillText(`🪑 ${item.label}`, item.x - 28, item.y - 20);
        } else if (item.type === 'shelf') {
          ctx.fillStyle = '#4a382b';
          ctx.fillRect(item.x - 22, item.y - 24, 44, 48);
          ctx.fillStyle = '#e6e2d3';
          ctx.font = '10px serif';
          ctx.fillText(`📚 ${item.label}`, item.x - 28, item.y - 28);
        } else if (item.type === 'plant') {
          ctx.fillStyle = '#2e5a36';
          ctx.beginPath();
          ctx.arc(item.x, item.y, 16, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#e6e2d3';
          ctx.font = '10px serif';
          ctx.fillText(`🌿 ${item.label}`, item.x - 22, item.y - 20);
        }
      });

      // 玩家平滑移動
      playerX += (targetX - playerX) * 0.12;
      playerY += (targetY - playerY) * 0.12;

      // DND 狀態標籤
      if (isDND) {
        ctx.fillStyle = '#8b3a3a';
        ctx.fillRect(playerX - 45, playerY - 45, 90, 18);
        ctx.fillStyle = '#ffcccc';
        ctx.font = 'bold 10px serif';
        ctx.fillText('🛑 專心勿擾 (DND)', playerX - 39, playerY - 32);
      }

      // 玩家角色本體
      ctx.fillStyle = isDND ? '#388e3c' : '#d97706';
      ctx.fillRect(playerX - 12, playerY - 12, 24, 24);

      // 玩家名稱與任務
      ctx.fillStyle = '#ffffff';
      ctx.font = '12px serif';
      ctx.fillText(`${playerName} (我)`, playerX - 25, playerY + 26);
      if (isDND) {
        ctx.fillStyle = '#facc15';
        ctx.font = '11px serif';
        ctx.fillText(`正在讀: ${currentTask}`, playerX - 40, playerY + 40);
      }
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    // 木魚與音效
    moktakBtn?.addEventListener('click', async () => {
      await Tone.start();
      const synth = new Tone.Synth({
        oscillator: { type: 'sine' },
        envelope: { attack: 0.001, decay: 0.15, sustain: 0, release: 0.1 }
      }).toDestination();
      synth.triggerAttackRelease('C5', '8n');
      
      moktakCount++;
      if (moktakCountSpan) moktakCountSpan.textContent = String(moktakCount);
    });
  </script>
</Layout>