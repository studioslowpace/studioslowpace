---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 像素 RPG 共讀空間">
  <!-- 1. 創角 / 進入 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 創角登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">歡迎來到長沙灣「空間客舍」像素小鎮。</p>
        <input type="text" id="rpg-name-input" placeholder="輸入你的暱稱..." maxlength="10" autofocus />
        <button id="rpg-start-btn" class="rpg-btn">▶ 推門進入小鎮</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座 / 專心閱讀 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none; opacity: 0;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span id="seat-window-title">◆ 選擇閱讀座位 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你準備在此處入座。請輸入你正在閱讀或處理的任務：</p>
        <input type="text" id="rpg-book-input" placeholder="例如：《少女核》、寫程式..." maxlength="20" />
        <div class="rpg-btn-group">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">🛑 設為專心模式 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 主遊戲畫面 -->
  <main class="rpg-container">
    <!-- 頂部 HUD -->
    <header class="rpg-hud">
      <div class="hud-box">
        <span class="hud-label">玩家：</span><strong id="hud-name">旅人</strong>
      </div>
      <div class="hud-box">
        <span class="hud-label">地點：</span><span>長沙灣 · 空間客舍</span>
      </div>
      <div class="hud-box">
        <button id="audio-toggle" class="rpg-btn-sm">🔊 音效：關</button>
        <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 返回</a>
      </div>
    </header>

    <!-- 4. 2D 像素遊戲 Canvas 畫布 -->
    <div class="canvas-wrapper">
      <canvas id="rpg-canvas" width="800" height="480"></canvas>
    </div>

    <!-- 底部事件與控制列 -->
    <footer class="rpg-footer">
      <div id="log-text" class="log-box">📜 點擊地圖任意處移動像素小人，點擊座椅區域即可入座專心閱讀。</div>
      <div class="action-dock">
        <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background:#8b0000; color:#fff;">🛑 解除專心模式</button>
        <button id="btn-moktak" class="rpg-btn-sm">🪵 敲木魚 (+1)</button>
        <span style="font-size:12px; color:#d4af37;">功德: <strong id="moktak-count">0</strong></span>
      </div>
    </footer>
  </main>

  <style is:global>
    body {
      background-color: #121110;
      color: #e6e2d3;
      font-family: monospace, sans-serif;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    /* Modals */
    .rpg-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      transition: opacity 0.3s;
    }
    .rpg-window {
      background: #2b2823;
      border: 3px solid #b5a48b;
      width: 90%;
      max-width: 380px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.8);
    }
    .rpg-title-bar {
      background: #4a4135;
      color: #f4f0ea;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: bold;
      border-bottom: 2px solid #b5a48b;
    }
    .rpg-content { padding: 18px; }
    .rpg-text { font-size: 13px; color: #d1cbb8; margin-bottom: 12px; }
    .rpg-window input[type="text"] {
      width: 100%;
      background: #121110;
      border: 2px solid #7a6d5c;
      color: #fff;
      padding: 8px 12px;
      font-family: monospace;
      font-size: 14px;
      box-sizing: border-box;
      margin-bottom: 14px;
      outline: none;
    }
    .rpg-btn {
      background: #5c4a38;
      color: #f4f0ea;
      border: 2px solid #b5a48b;
      padding: 8px;
      font-family: monospace;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
      font-weight: bold;
    }
    .rpg-btn-ghost {
      background: transparent;
      color: #b5a48b;
      border: 2px solid #7a6d5c;
      padding: 8px;
      font-family: monospace;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
    }
    .rpg-btn-group { display: flex; gap: 8px; }

    /* 主遊戲區域 */
    .rpg-container {
      width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .rpg-hud {
      background: #23201c;
      border-bottom: 2px solid #4a4135;
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
    }
    .hud-box { display: flex; align-items: center; gap: 8px; }
    .hud-label { color: #8a7e6c; }
    .rpg-btn-sm {
      background: #38332d;
      color: #d1cbb8;
      border: 1px solid #7a6d5c;
      padding: 4px 10px;
      font-family: monospace;
      font-size: 11px;
      cursor: pointer;
    }

    /* Canvas 容器 (自動縮放與像素防鋸齒) */
    .canvas-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      background: #0d0c0b;
    }
    #rpg-canvas {
      border: 3px solid #b5a48b;
      background: #000;
      cursor: pointer;
      /* 關鍵：保持像素畫質清晰不模糊 */
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      max-width: 100%;
      max-height: 100%;
    }

    /* 底部訊息面板 */
    .rpg-footer {
      background: #23201c;
      border-top: 2px solid #4a4135;
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .log-box {
      flex: 1;
      font-size: 12px;
      color: #d1cbb8;
      background: #121110;
      padding: 6px 12px;
      border: 1px solid #4a4135;
      border-radius: 4px;
    }
    .action-dock { display: flex; align-items: center; gap: 10px; }
  </style>

  <script>
    import * as Tone from 'tone';

    // 遊戲狀態 Variables
    let playerName = '冒險者';
    let playerX = 160;
    let playerY = 320;
    let targetX = 160;
    let targetY = 320;
    let isDND = false;
    let currentBook = '';
    let moktakCount = 0;
    let audioOn = false;

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const logBox = document.getElementById('log-text');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const moktakBtn = document.getElementById('btn-moktak');
    const moktakCountSpan = document.getElementById('moktak-count');
    const audioToggle = document.getElementById('audio-toggle');

    let pendingSeat: { x: number; y: number; name: string } | null = null;

    // 可入座的區域 (x, y, 範圍, 名稱)
    const seats = [
      { x: 340, y: 220, label: '客舍露天咖啡座' },
      { x: 580, y: 220, label: '長沙灣工坊木椅' }
    ];

    // NPC 列表
    const npcs = [
      { name: '空間主理人', x: 280, y: 160, book: '客舍日誌', color: '#ffcc00' },
      { name: '實習生阿修', x: 620, y: 160, book: '藝術展籌備', color: '#66ccff' }
    ];

    // 1. 進入遊戲
    startBtn?.addEventListener('click', () => {
      const val = nameInput?.value.trim();
      if (val) playerName = val;
      if (hudName) hudName.textContent = playerName;

      if (modal) {
        modal.style.opacity = '0';
        setTimeout(() => modal.style.display = 'none', 300);
      }
      gameLoop();
    });

    // 2. 點擊 Canvas 移動或入座
    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;

      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      // 檢查是否點擊入座區
      const hitSeat = seats.find(s => Math.hypot(s.x - clickX, s.y - clickY) < 30);

      if (hitSeat) {
        pendingSeat = { x: hitSeat.x, y: hitSeat.y, name: hitSeat.label };
        if (seatModal) {
          seatModal.style.display = 'flex';
          setTimeout(() => seatModal.style.opacity = '1', 10);
        }
      } else {
        targetX = clickX;
        targetY = clickY;
        if (isDND) {
          isDND = false;
          if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
          if (logBox) logBox.textContent = `[移動] 站起身來，在客舍小鎮漫步。`;
        }
      }
    });

    // 3. 確認入座 (DND 模式)
    confirmSeatBtn?.addEventListener('click', () => {
      if (pendingSeat) {
        playerX = pendingSeat.x;
        playerY = pendingSeat.y;
        targetX = pendingSeat.x;
        targetY = pendingSeat.y;
        currentBook = bookInput?.value.trim() || '自主專心閱讀';
        isDND = true;

        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        if (logBox) logBox.textContent = `🛑 [專心模式] 你已在「${pendingSeat.name}」入座。正在讀：《${currentBook}》`;

        closeSeatModal();
      }
    });

    cancelSeatBtn?.addEventListener('click', closeSeatModal);

    function closeSeatModal() {
      if (seatModal) {
        seatModal.style.opacity = '0';
        setTimeout(() => seatModal.style.display = 'none', 300);
      }
    }

    leaveSeatBtn?.addEventListener('click', () => {
      isDND = false;
      playerY += 20;
      targetY = playerY;
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      if (logBox) logBox.textContent = `[狀態] 已離座，解除請勿打擾狀態。`;
    });

    // 4. Canvas 繪製核心 (像素繪圖 Engine)
    function draw() {
      // (1) 清空畫布
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // (2) 畫草地背景
      ctx.fillStyle = '#5c8a38';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // (3) 畫石板路
      ctx.fillStyle = '#a39e93';
      ctx.fillRect(0, 360, canvas.width, 120); // 下方大路
      ctx.fillRect(100, 0, 80, 360); // 縱向小路

      // 石板路紋路
      ctx.strokeStyle = '#827d73';
      ctx.lineWidth = 2;
      for (let x = 0; x < canvas.width; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 360);
        ctx.lineTo(x, 480);
        ctx.stroke();
      }

      // (4) 畫建築物：左側咖啡館，右側工坊 (RPG Maker 風格)
      // 左房屋 (空間客舍咖啡館)
      ctx.fillStyle = '#7a5230';
      ctx.fillRect(220, 80, 160, 120);
      ctx.fillStyle = '#3a2514'; // 屋頂
      ctx.beginPath();
      ctx.moveTo(200, 80);
      ctx.lineTo(300, 20);
      ctx.lineTo(400, 80);
      ctx.fill();

      // 右房屋 (創作工坊)
      ctx.fillStyle = '#54606e';
      ctx.fillRect(520, 80, 160, 120);
      ctx.fillStyle = '#2d353d'; // 屋頂
      ctx.beginPath();
      ctx.moveTo(500, 80);
      ctx.lineTo(600, 20);
      ctx.lineTo(700, 80);
      ctx.fill();

      // (5) 畫水池 (右邊)
      ctx.fillStyle = '#3b82f6';
      ctx.fillRect(720, 0, 80, 360);

      // (6) 畫座位區 (露天座與木椅)
      seats.forEach(s => {
        ctx.fillStyle = '#8c6b4d';
        ctx.fillRect(s.x - 15, s.y - 15, 30, 30);
        ctx.fillStyle = '#d4af37';
        ctx.font = '10px monospace';
        ctx.fillText('🪑入座', s.x - 16, s.y - 20);
      });

      // (7) 畫小動物 (裝飾)
      // 小貓
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(140, 180, 12, 8);
      ctx.fillText('🐱', 138, 180);
      // 小雞
      ctx.fillText('🐔', 450, 220);

      // (8) 畫 NPC 們
      npcs.forEach(n => {
        ctx.fillStyle = '#8b0000';
        ctx.fillRect(n.x - 25, n.y - 35, 50, 14);
        ctx.fillStyle = '#fff';
        ctx.font = '9px monospace';
        ctx.fillText('🛑 專心', n.x - 20, n.y - 24);

        ctx.fillStyle = n.color;
        ctx.fillRect(n.x - 10, n.y - 10, 20, 20); // NPC 像素方塊

        ctx.fillStyle = '#fff';
        ctx.font = '10px monospace';
        ctx.fillText(`${n.name}`, n.x - 20, n.y + 22);
        ctx.fillStyle = '#d1cbb8';
        ctx.fillText(`《${n.book}》`, n.x - 22, n.y + 34);
      });

      // (9) 移動邏輯與畫玩家自己
      playerX += (targetX - playerX) * 0.1;
      playerY += (targetY - playerY) * 0.1;

      // 玩家 DND 標示
      if (isDND) {
        ctx.fillStyle = '#c0392b';
        ctx.fillRect(playerX - 35, playerY - 40, 70, 15);
        ctx.fillStyle = '#ffffff';
        ctx.font = '10px monospace';
        ctx.fillText('🛑 請勿打擾', playerX - 30, playerY - 29);
      }

      // 玩家角色本體
      ctx.fillStyle = isDND ? '#27ae60' : '#e67e22';
      ctx.fillRect(playerX - 10, playerY - 10, 20, 20);

      // 玩家名字與任務
      ctx.fillStyle = '#ffffff';
      ctx.font = '11px monospace';
      ctx.fillText(`${playerName} (我)`, playerX - 20, playerY + 22);
      if (isDND) {
        ctx.fillStyle = '#f39c12';
        ctx.font = '10px monospace';
        ctx.fillText(`讀：《${currentBook}》`, playerX - 30, playerY + 34);
      }
    }

    // 遊戲主循環 Frame
    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    // 音效與木魚
    audioToggle?.addEventListener('click', async () => {
      await Tone.start();
      audioOn = !audioOn;
      if (audioToggle) audioToggle.textContent = audioOn ? '🔊 音效：開' : '🔊 音效：關';
    });

    moktakBtn?.addEventListener('click', async () => {
      if (audioOn) {
        const synth = new Tone.Synth({
          oscillator: { type: 'sine' },
          envelope: { attack: 0.001, decay: 0.15, sustain: 0, release: 0.1 }
        }).toDestination();
        synth.triggerAttackRelease('C5', '8n');
      }
      moktakCount++;
      if (moktakCountSpan) moktakCountSpan.textContent = String(moktakCount);
    });
  </script>
</Layout>