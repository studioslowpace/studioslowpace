---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 仿 Discord 沉浸式共讀空間">
  <!-- 1. 創角 / 進入對話框（支援身份組選擇） -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 身份登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">歡迎來到長沙灣空間客舍。請輸入稱號，並選擇你的書友身份組：</p>
        <input type="text" id="rpg-name-input" placeholder="例如：尋書人、阿朗..." maxlength="12" autofocus />
        
        <div class="role-selector-group">
          <label class="role-chip"><input type="radio" name="user-role" value="科幻迷" checked /> 🌌 科幻迷</label>
          <label class="role-chip"><input type="radio" name="user-role" value="歷史愛好者" /> 📜 歷史愛好者</label>
          <label class="role-chip"><input type="radio" name="user-role" value="寫作馬拉松中" /> ✍️ 寫作中</label>
          <label class="role-chip"><input type="radio" name="user-role" value="純粹路過" /> ☕ 閒逛者</label>
        </div>

        <button id="rpg-start-btn" class="rpg-btn">▶ 推門入館</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座與閱讀進度設定 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none; opacity: 0;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 閱讀與專心設定 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處安坐。請輸入書名與目前的閱讀進度：</p>
        <input type="text" id="rpg-book-input" placeholder="書名（例：《少女核》）" maxlength="20" />
        <div class="progress-input-group">
          <span>進度：第</span>
          <input type="number" id="rpg-chapter-input" value="1" min="1" max="99" style="width: 60px; text-align:center;" />
          <span>章</span>
        </div>
        <div class="rpg-btn-group" style="margin-top: 14px;">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">🛑 開啟專心勿擾 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 離線留言簿 Modal (靈魂相遇留言板) -->
  <div id="guestbook-modal" class="rpg-modal-overlay" style="display: none; opacity: 0;">
    <div class="rpg-window" style="max-width: 460px;">
      <div class="rpg-title-bar"><span>📜 客舍靈魂留言簿</span></div>
      <div class="rpg-content">
        <p class="rpg-text">即使不同時間到來，靈魂也能在此交會。留下一句金句或書評吧：</p>
        <div id="guestbook-list" class="guestbook-list">
          <!-- 動態載入留言 -->
        </div>
        <input type="text" id="guestbook-input" placeholder="寫下你的金句或心得..." maxlength="40" />
        <div class="rpg-btn-group">
          <button id="guestbook-close-btn" class="rpg-btn-ghost">關閉</button>
          <button id="guestbook-submit-btn" class="rpg-btn">✍️ 留下足跡</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 主介面 -->
  <main class="rpg-container">
    <!-- Discord 風格頂部伺服器與頻道切換列 -->
    <header class="rpg-hud">
      <div class="hud-left">
        <span class="hud-brand">🏠 空間客舍</span>
        <span class="hud-divider">/</span>
        <!-- Discord 風格頻道切換 -->
        <div class="channel-tabs">
          <button class="channel-tab active" data-room="study">📖 靜心自修室</button>
          <button class="channel-tab" data-room="chat">☕ 自由書話間</button>
          <button class="channel-tab" data-room="salon">🏛️ 文學沙龍</button>
        </div>
      </div>
      <div class="hud-right">
        <span class="user-tag" id="hud-role-tag">📖 讀者</span>
        <strong id="hud-name">旅人</strong>
        <button id="btn-open-guestbook" class="rpg-btn-sm">📜 留言簿</button>
        <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 離開</a>
      </div>
    </header>

    <!-- Canvas 畫布區 -->
    <div class="canvas-wrapper">
      <canvas id="rpg-canvas" width="850" height="430"></canvas>
    </div>

    <!-- 底部 Discord 風格工具列與成就排行榜 -->
    <footer class="rpg-footer">
      <div class="build-palette">
        <span class="palette-title">工具：</span>
        <button class="tool-btn active" data-tool="move">🚶 移動/入座</button>
        <button class="tool-btn" data-tool="seat">🪑 建造座位</button>
        <button class="tool-btn" data-tool="shelf">📚 建造書架</button>
      </div>

      <div class="action-dock">
        <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background:#8b3a3a; color:#fff;">🚶 起立走動</button>
        <button id="btn-moktak" class="rpg-btn-sm">🪵 敲木魚</button>
        <span class="moktak-counter">功德榜: <strong id="moktak-count">0</strong> 功德</span>
      </div>
    </footer>
  </main>

  <style is:global>
    body {
      background-color: #141210;
      color: #e6e2d3;
      font-family: serif, monospace;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    /* Modal 視窗風格 */
    .rpg-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 14, 12, 0.85);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      transition: opacity 0.3s ease;
    }
    .rpg-window {
      background: #25221d;
      border: 2px solid #8c7d6b;
      border-radius: 8px;
      width: 90%;
      max-width: 420px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
    }
    .rpg-title-bar {
      background: #3d3730;
      color: #f4f0ea;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: bold;
      border-bottom: 2px solid #8c7d6b;
      letter-spacing: 1px;
    }
    .rpg-content { padding: 20px; }
    .rpg-text { font-size: 13px; color: #b5a48b; margin-bottom: 14px; line-height: 1.6; }
    .rpg-window input[type="text"], .rpg-window input[type="number"] {
      width: 100%;
      background: #181614;
      border: 1px solid #6b5c4a;
      color: #f4f0ea;
      padding: 10px;
      font-family: serif;
      font-size: 14px;
      box-sizing: border-box;
      margin-bottom: 14px;
      outline: none;
      border-radius: 6px;
    }
    .role-selector-group {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }
    .role-chip {
      background: #1e1b17;
      border: 1px solid #554d42;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12px;
      cursor: pointer;
      color: #d1cbb8;
    }
    .role-chip input { margin-right: 4px; }
    .progress-input-group {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #b5a48b;
    }

    .rpg-btn {
      background: #5c4a38;
      color: #f4f0ea;
      border: 1px solid #8c7d6b;
      padding: 10px;
      font-family: serif;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
      font-weight: bold;
      border-radius: 6px;
      transition: background 0.2s;
    }
    .rpg-btn:hover { background: #7a634b; }
    .rpg-btn-ghost {
      background: transparent;
      color: #b5a48b;
      border: 1px solid #6b5c4a;
      padding: 10px;
      font-family: serif;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
      border-radius: 6px;
    }
    .rpg-btn-group { display: flex; gap: 10px; }

    /* 留言簿清單樣式 */
    .guestbook-list {
      max-height: 160px;
      overflow-y: auto;
      background: #181614;
      border: 1px solid #554d42;
      border-radius: 6px;
      padding: 10px;
      margin-bottom: 12px;
      font-size: 12px;
    }
    .guestbook-item {
      margin-bottom: 8px;
      border-bottom: 1px dashed #332d26;
      padding-bottom: 6px;
    }
    .guestbook-author { color: #d4af37; font-weight: bold; }

    /* 主容器 */
    .rpg-container {
      width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Discord 風格頂部 HUD */
    .rpg-hud {
      background: #1c1a17;
      border-bottom: 1px solid #3d3730;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
    }
    .hud-left { display: flex; align-items: center; gap: 12px; }
    .hud-brand { font-weight: bold; color: #d4af37; letter-spacing: 1px; }
    .hud-divider { color: #554d42; }
    .channel-tabs { display: flex; gap: 6px; }
    .channel-tab {
      background: #25221d;
      color: #9c8e7b;
      border: 1px solid #4a3f35;
      padding: 4px 10px;
      font-family: serif;
      font-size: 12px;
      cursor: pointer;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .channel-tab.active {
      background: #5c4a38;
      color: #f4f0ea;
      border-color: #d4af37;
    }
    .hud-right { display: flex; align-items: center; gap: 10px; }
    .user-tag {
      background: #2b2520;
      border: 1px solid #6b5c4a;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      color: #d4af37;
    }
    .rpg-btn-sm {
      background: #2b2520;
      color: #d1cbb8;
      border: 1px solid #6b5c4a;
      padding: 6px 12px;
      font-family: serif;
      font-size: 12px;
      cursor: pointer;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .rpg-btn-sm:hover { background: #4a3f35; color: #fff; }

    /* 畫布包裝器 */
    .canvas-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #141210;
      padding: 12px;
    }
    #rpg-canvas {
      border: 2px solid #3d3730;
      background: #181614;
      cursor: pointer;
      image-rendering: pixelated;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border-radius: 8px;
    }

    /* 底部工具列 */
    .rpg-footer {
      background: #1c1a17;
      border-top: 1px solid #3d3730;
      padding: 12px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .build-palette { display: flex; align-items: center; gap: 8px; }
    .palette-title { font-size: 12px; color: #8a7e6c; }
    .tool-btn {
      background: #25221d;
      color: #b5a48b;
      border: 1px solid #554d42;
      padding: 6px 12px;
      font-family: serif;
      font-size: 12px;
      cursor: pointer;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .tool-btn.active {
      background: #5c4a38;
      color: #f4f0ea;
      border-color: #d4af37;
    }
    .action-dock { display: flex; align-items: center; gap: 12px; }
    .moktak-counter { font-size: 12px; color: #d4af37; }
  </style>

  <script>
    import * as Tone from 'tone';

    let playerName = '冒險者';
    let playerRole = '📖 讀者';
    let playerX = 120;
    let playerY = 300;
    let targetX = 120;
    let targetY = 300;
    let currentTool = 'move';
    let currentRoom = 'study'; // 'study', 'chat', 'salon'
    let isDND = false;
    let currentTask = '';
    let currentChapter = 1;
    let moktakCount = 0;

    // 房間佈局與傢俱狀態
    const rooms: Record<string, { name: string; items: { type: string; x: number; y: number; label: string }[] }> = {
      study: {
        name: '靜心自修室',
        items: [
          { type: 'seat', x: 260, y: 160, label: '極靜自修木椅 A' },
          { type: 'seat', x: 580, y: 160, label: '極靜自修木椅 B' },
          { type: 'shelf', x: 420, y: 80, label: '文獻參考書櫃' }
        ]
      },
      chat: {
        name: '自由書話間',
        items: [
          { type: 'seat', x: 200, y: 220, label: '茶水沙發 A' },
          { type: 'seat', x: 420, y: 220, label: '茶水沙發 B' },
          { type: 'seat', x: 640, y: 220, label: '靠窗交流位' }
        ]
      },
      salon: {
        name: '文學沙龍',
        items: [
          { type: 'seat', x: 420, y: 140, label: '講者席' },
          { type: 'seat', x: 300, y: 260, label: '第一排座位' },
          { type: 'seat', x: 540, y: 260, label: '第二排座位' }
        ]
      }
    };

    // 靈魂留言簿資料（LocalStorage 支援）
    let guestbookMessages = [
      { author: '阿朗', text: '「在長沙灣的午後，讀著少女核，靈魂感到無比安定。」' },
      { author: 'Mi', text: '「歡迎來到空間客舍，祝大家閱讀愉快！」' }
    ];

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const guestbookModal = document.getElementById('guestbook-modal');
    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const chapterInput = document.getElementById('rpg-chapter-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const hudRoleTag = document.getElementById('hud-role-tag');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const moktakBtn = document.getElementById('btn-moktak');
    const moktakCountSpan = document.getElementById('moktak-count');
    const openGuestbookBtn = document.getElementById('btn-open-guestbook');
    const closeGuestbookBtn = document.getElementById('guestbook-close-btn');
    const submitGuestbookBtn = document.getElementById('guestbook-submit-btn');
    const guestbookInput = document.getElementById('guestbook-input') as HTMLInputElement;
    const guestbookList = document.getElementById('guestbook-list');

    let pendingSeat: { x: number; y: number; label: string } | null = null;

    startBtn?.addEventListener('click', () => {
      const val = nameInput?.value.trim();
      if (val) playerName = val;
      const selectedRole = document.querySelector('input[name="user-role"]:checked') as HTMLInputElement;
      if (selectedRole) playerRole = selectedRole.value;

      if (hudName) hudName.textContent = playerName;
      if (hudRoleTag) hudRoleTag.textContent = playerRole;

      if (modal) {
        modal.style.opacity = '0';
        setTimeout(() => modal.style.display = 'none', 300);
      }
      gameLoop();
    });

    // Discord 風格房間/頻道切換
    document.querySelectorAll('.channel-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.channel-tab').forEach(t => t.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentRoom = target.dataset.room!;
        // 離開座位並重置位置
        isDND = false;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
        playerX = 120;
        playerY = 300;
        targetX = 120;
        targetY = 300;
      });
    });

    // 打造工具切換
    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;
      });
    });

    // 畫布點擊
    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;
      const currentItems = rooms[currentRoom].items;

      if (currentTool === 'move') {
        const hitSeat = currentItems.find(item => item.type === 'seat' && Math.hypot(item.x - clickX, item.y - clickY) < 35);
        if (hitSeat) {
          pendingSeat = { x: hitSeat.x, y: hitSeat.y, label: hitSeat.label };
          if (seatModal) {
            seatModal.style.display = 'flex';
            setTimeout(() => seatModal.style.opacity = '1', 10);
          }
        } else {
          targetX = clickX;
          targetY = clickY;
          if (isDND) {
            isDND = false;
            if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
          }
        }
      } else {
        let type = currentTool;
        let label = type === 'seat' ? '自建座位' : '裝飾書架';
        currentItems.push({ type, x: clickX, y: clickY, label });
      }
    });

    confirmSeatBtn?.addEventListener('click', () => {
      if (pendingSeat) {
        playerX = pendingSeat.x;
        playerY = pendingSeat.y;
        targetX = pendingSeat.x;
        targetY = pendingSeat.y;
        const bookName = bookInput?.value.trim() || '靜心閱讀中';
        currentChapter = parseInt(chapterInput?.value) || 1;
        currentTask = `${bookName} (第 ${currentChapter} 章)`;
        isDND = true;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        closeSeatModal();
      }
    });

    cancelSeatBtn?.addEventListener('click', closeSeatModal);
    function closeSeatModal() {
      if (seatModal) {
        seatModal.style.opacity = '0';
        setTimeout(() => seatModal.style.display = 'none', 300);
      }
    }

    leaveSeatBtn?.addEventListener('click', () => {
      isDND = false;
      targetY += 35;
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
    });

    // 靈魂留言簿開關
    openGuestbookBtn?.addEventListener('click', () => {
      renderGuestbook();
      if (guestbookModal) {
        guestbookModal.style.display = 'flex';
        setTimeout(() => guestbookModal.style.opacity = '1', 10);
      }
    });
    closeGuestbookBtn?.addEventListener('click', () => {
      if (guestbookModal) {
        guestbookModal.style.opacity = '0';
        setTimeout(() => guestbookModal.style.display = 'none', 300);
      }
    });
    submitGuestbookBtn?.addEventListener('click', () => {
      const text = guestbookInput?.value.trim();
      if (text) {
        guestbookMessages.unshift({ author: playerName, text: `「${text}」` });
        guestbookInput.value = '';
        renderGuestbook();
      }
    });

    function renderGuestbook() {
      if (!guestbookList) return;
      let html = '';
      guestbookMessages.forEach(m => {
        html += `<div class="guestbook-item"><span class="guestbook-author">${m.author}</span>: ${m.text}</div>`;
      });
      guestbookList.innerHTML = html;
    }

    // 繪製畫布引擎
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 地板
      ctx.fillStyle = '#181512';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // 繪製當前房間的物件
      const currentItems = rooms[currentRoom].items;
      currentItems.forEach(item => {
        if (item.type === 'seat') {
          ctx.fillStyle = '#6b4f3b';
          ctx.fillRect(item.x - 16, item.y - 16, 32, 32);
          ctx.fillStyle = '#d4af37';
          ctx.font = '10px serif';
          ctx.fillText(`🪑 ${item.label}`, item.x - 28, item.y - 20);
        } else if (item.type === 'shelf') {
          ctx.fillStyle = '#4a382b';
          ctx.fillRect(item.x - 22, item.y - 24, 44, 48);
          ctx.fillStyle = '#e6e2d3';
          ctx.font = '10px serif';
          ctx.fillText(`📚 ${item.label}`, item.x - 28, item.y - 28);
        }
      });

      // 玩家移動平滑插值
      playerX += (targetX - playerX) * 0.12;
      playerY += (targetY - playerY) * 0.12;

      // DND 狀態標籤與閱讀進度條
      if (isDND) {
        ctx.fillStyle = '#8b3a3a';
        ctx.fillRect(playerX - 55, playerY - 48, 110, 20);
        ctx.fillStyle = '#ffcccc';
        ctx.font = 'bold 10px serif';
        ctx.fillText('🛑 專心勿擾 (DND)', playerX - 48, playerY - 34);
      }

      // 玩家角色本體
      ctx.fillStyle = isDND ? '#388e3c' : '#d97706';
      ctx.fillRect(playerX - 12, playerY - 12, 24, 24);

      // 玩家身分組標籤與名稱
      ctx.fillStyle = '#ffffff';
      ctx.font = '12px serif';
      ctx.fillText(`[${playerRole}] ${playerName}`, playerX - 35, playerY + 26);
      if (isDND) {
        ctx.fillStyle = '#facc15';
        ctx.font = '11px serif';
        ctx.fillText(`📖 讀: ${currentTask}`, playerX - 45, playerY + 40);
      }
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    // 木魚功德榜
    moktakBtn?.addEventListener('click', async () => {
      await Tone.start();
      const synth = new Tone.Synth({
        oscillator: { type: 'sine' },
        envelope: { attack: 0.001, decay: 0.15, sustain: 0, release: 0.1 }
      }).toDestination();
      synth.triggerAttackRelease('C5', '8n');
      
      moktakCount++;
      if (moktakCountSpan) moktakCountSpan.textContent = String(moktakCount);
    });
  </script>
</Layout>