---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="空間客舍 · 自建打造模式">
  <!-- 1. 進入 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 建築師模式 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">歡迎來到長沙灣空間客舍。在這裡，你可以親手打造與佈置你的閱讀角落。</p>
        <input type="text" id="rpg-name-input" placeholder="輸入你的名字..." maxlength="12" autofocus />
        <button id="rpg-start-btn" class="rpg-btn">▶ 進入客舍開始打造</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座填書 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none; opacity: 0;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 入座與專心任務 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處坐下了。請輸入你正在進行的閱讀或開發任務：</p>
        <input type="text" id="rpg-book-input" placeholder="例如：《少女核》、寫 Astro 程式..." maxlength="25" />
        <div class="rpg-btn-group">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">🛑 進入專心模式 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 主遊戲與編輯介面 -->
  <main class="rpg-container">
    <header class="rpg-hud">
      <div class="hud-box">
        <span class="hud-label">建築師：</span><strong id="hud-name">旅人</strong>
      </div>
      <div class="hud-box">
        <span class="hud-label">模式：</span><span id="current-mode-label" style="color:#d4af37;">🛠️ 建造/點擊移動</span>
      </div>
      <div class="hud-box">
        <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 離開</a>
      </div>
    </header>

    <!-- 畫布區 -->
    <div class="canvas-wrapper">
      <canvas id="rpg-canvas" width="800" height="420"></canvas>
    </div>

    <!-- 底部工具列：供手動選擇要建造的物品 -->
    <footer class="rpg-footer">
      <div class="build-palette">
        <span style="font-size:12px; color:#8a7e6c;">選擇工具：</span>
        <button class="tool-btn active" data-tool="move">🚶 移動角色</button>
        <button class="tool-btn" data-tool="seat">🪑 建造座位</button>
        <button class="tool-btn" data-tool="shelf">📚 建造書架</button>
        <button class="tool-btn" data-tool="plant">🌿 放置盆栽</button>
      </div>
      <div id="log-text" class="log-box">📜 提示：選擇「建造座位」後點擊地圖即可新增座位，點擊「移動角色」後點擊座椅即可入座！</div>
    </footer>
  </main>

  <style is:global>
    body {
      background-color: #0b0a09;
      color: #e6e2d3;
      font-family: monospace, sans-serif;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    .rpg-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      transition: opacity 0.3s;
    }
    .rpg-window {
      background: #23201c;
      border: 3px solid #b5a48b;
      width: 90%;
      max-width: 400px;
      box-shadow: 0 15px 30px rgba(0,0,0,0.9);
    }
    .rpg-title-bar {
      background: #4a4135;
      color: #f4f0ea;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: bold;
      border-bottom: 2px solid #b5a48b;
    }
    .rpg-content { padding: 20px; }
    .rpg-text { font-size: 13px; color: #d1cbb8; margin-bottom: 14px; }
    .rpg-window input[type="text"] {
      width: 100%;
      background: #121110;
      border: 2px solid #7a6d5c;
      color: #fff;
      padding: 10px;
      font-family: monospace;
      font-size: 14px;
      box-sizing: border-box;
      margin-bottom: 14px;
      outline: none;
    }
    .rpg-btn {
      background: #5c4a38;
      color: #f4f0ea;
      border: 2px solid #b5a48b;
      padding: 9px;
      font-family: monospace;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
      font-weight: bold;
    }
    .rpg-btn-ghost {
      background: transparent;
      color: #b5a48b;
      border: 2px solid #7a6d5c;
      padding: 9px;
      font-family: monospace;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
    }
    .rpg-btn-group { display: flex; gap: 10px; }
    .rpg-container {
      width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .rpg-hud {
      background: #1c1a17;
      border-bottom: 2px solid #4a4135;
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
    }
    .hud-box { display: flex; align-items: center; gap: 8px; }
    .hud-label { color: #8a7e6c; }
    .canvas-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #060505;
      padding: 8px;
    }
    #rpg-canvas {
      border: 4px solid #b5a48b;
      background: #161412;
      cursor: pointer;
      image-rendering: pixelated;
    }
    .rpg-footer {
      background: #1c1a17;
      border-top: 2px solid #4a4135;
      padding: 8px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .build-palette {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .tool-btn {
      background: #2b2621;
      color: #b5a48b;
      border: 1px solid #7a6d5c;
      padding: 4px 10px;
      font-family: monospace;
      font-size: 11px;
      cursor: pointer;
      border-radius: 4px;
    }
    .tool-btn.active {
      background: #5c4a38;
      color: #fff;
      border-color: #d4af37;
    }
    .log-box {
      font-size: 12px;
      color: #d1cbb8;
      background: #121110;
      padding: 6px 12px;
      border: 1px solid #4a4135;
      border-radius: 4px;
    }
  </style>

  <script>
    let playerName = '建築師';
    let playerX = 100;
    let playerY = 320;
    let targetX = 100;
    let targetY = 320;
    let currentTool = 'move'; // 'move', 'seat', 'shelf', 'plant'
    let isDND = false;
    let currentTask = '';

    // 動態自建物件陣列（玩家自己蓋的！）
    let customItems: { type: string; x: number; y: number; label: string }[] = [
      { type: 'seat', x: 300, y: 180, label: '窗邊木椅' },
      { type: 'seat', x: 550, y: 180, label: '交流沙發' }
    ];

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const modeLabel = document.getElementById('current-mode-label');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const logBox = document.getElementById('log-text');

    let pendingSeat: { x: number; y: number; label: string } | null = null;

    startBtn?.addEventListener('click', () => {
      const val = nameInput?.value.trim();
      if (val) playerName = val;
      if (hudName) hudName.textContent = playerName;
      if (modal) {
        modal.style.opacity = '0';
        setTimeout(() => modal.style.display = 'none', 300);
      }
      gameLoop();
    });

    // 底部工具列切換
    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;

        if (currentTool === 'move') {
          if (modeLabel) modeLabel.textContent = '🚶 移動與入座模式';
          if (logBox) logBox.textContent = '📜 點擊地圖移動角色，點擊現有座位可入座。';
        } else if (currentTool === 'seat') {
          if (modeLabel) modeLabel.textContent = '🪑 建造座位模式';
          if (logBox) logBox.textContent = '🔨 點擊畫布任意空白處，直接建造一個新座位！';
        } else if (currentTool === 'shelf') {
          if (modeLabel) modeLabel.textContent = '📚 建造書架模式';
          if (logBox) logBox.textContent = '🔨 點擊畫布任意處放置書架裝飾。';
        } else if (currentTool === 'plant') {
          if (modeLabel) modeLabel.textContent = '🌿 放置盆栽模式';
          if (logBox) logBox.textContent = '🔨 點擊畫布任意處放置綠意盆栽。';
        }
      });
    });

    // 點擊畫布：根據目前工具決定是「移動/入座」還是「動手建造」
    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      if (currentTool === 'move') {
        // 檢查是否點擊到座椅
        const hitSeat = customItems.find(item => item.type === 'seat' && Math.hypot(item.x - clickX, item.y - clickY) < 30);
        if (hitSeat) {
          pendingSeat = { x: hitSeat.x, y: hitSeat.y, label: hitSeat.label };
          if (seatModal) {
            seatModal.style.display = 'flex';
            setTimeout(() => seatModal.style.opacity = '1', 10);
          }
        } else {
          targetX = clickX;
          targetY = clickY;
          if (isDND) {
            isDND = false;
            if (logBox) logBox.textContent = `[移動] 你站起身來，在客舍中四處走動。`;
          }
        }
      } else {
        // 建造模式：手動新增物品
        let type = currentTool;
        let label = type === 'seat' ? '自建木椅' : type === 'shelf' ? '典籍書架' : '綠意盆栽';
        customItems.push({ type, x: clickX, y: clickY, label });
        if (logBox) logBox.textContent = `✨ [建造成功] 你在座標 (${Math.round(clickX)}, ${Math.round(clickY)}) 放置了「${label}」！`;
      }
    });

    confirmSeatBtn?.addEventListener('click', () => {
      if (pendingSeat) {
        playerX = pendingSeat.x;
        playerY = pendingSeat.y;
        targetX = pendingSeat.x;
        targetY = pendingSeat.y;
        currentTask = bookInput?.value.trim() || '專心沉澱中';
        isDND = true;
        if (logBox) logBox.textContent = `🛑 [專心模式] 已在「${pendingSeat.label}」入座。任務：${currentTask}`;
        closeSeatModal();
      }
    });

    cancelSeatBtn?.addEventListener('click', closeSeatModal);
    function closeSeatModal() {
      if (seatModal) {
        seatModal.style.opacity = '0';
        setTimeout(() => seatModal.style.display = 'none', 300);
      }
    }

    let targetX = 100;
    let targetY = 320;

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 地板
      ctx.fillStyle = '#221f1b';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // 繪製玩家自建的所有物件 (座位、書架、盆栽)
      customItems.forEach(item => {
        if (item.type === 'seat') {
          ctx.fillStyle = '#7a5230';
          ctx.fillRect(item.x - 14, item.y - 14, 28, 28);
          ctx.fillStyle = '#d4af37';
          ctx.font = '10px monospace';
          ctx.fillText(`🪑 ${item.label}`, item.x - 24, item.y - 18);
        } else if (item.type === 'shelf') {
          ctx.fillStyle = '#5c4033';
          ctx.fillRect(item.x - 18, item.y - 20, 36, 40);
          ctx.fillStyle = '#fff';
          ctx.font = '10px monospace';
          ctx.fillText('📚 書架', item.x - 16, item.y - 24);
        } else if (item.type === 'plant') {
          ctx.fillStyle = '#27ae60';
          ctx.beginPath();
          ctx.arc(item.x, item.y, 14, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#fff';
          ctx.font = '10px monospace';
          ctx.fillText('🌿 盆栽', item.x - 16, item.y - 18);
        }
      });

      // 玩家移動
      playerX += (targetX - playerX) * 0.12;
      playerY += (targetY - playerY) * 0.12;

      // DND 狀態標籤
      if (isDND) {
        ctx.fillStyle = '#c0392b';
        ctx.fillRect(playerX - 35, playerY - 40, 70, 16);
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 10px monospace';
        ctx.fillText('🛑 專心勿擾', playerX - 30, playerY - 29);
      }

      // 玩家方塊
      ctx.fillStyle = isDND ? '#2ecc71' : '#e67e22';
      ctx.fillRect(playerX - 10, playerY - 10, 20, 20);

      // 玩家名稱
      ctx.fillStyle = '#ffffff';
      ctx.font = '11px monospace';
      ctx.fillText(`${playerName} (我)`, playerX - 22, playerY + 22);
      if (isDND) {
        ctx.fillStyle = '#f1c40f';
        ctx.font = '10px monospace';
        ctx.fillText(`任務: ${currentTask}`, playerX - 32, playerY + 35);
      }
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }
  </script>
</Layout>