---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · RPG 沉浸式共讀空間">
  <!-- 1. RPG 角色建立 / 登入畫面 -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 角色創角與登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">歡迎來到長沙灣藝術空間 —— <strong>空間客舍</strong>。</p>
        <p class="rpg-text">請輸入你的冒險者稱號，並選擇你的身分：</p>
        
        <input type="text" id="rpg-name-input" placeholder="輸入名字（例：阿朗、空間訪客...）" maxlength="12" autofocus />
        
        <div class="class-selector">
          <label><input type="radio" name="rpg-class" value="社區讀者" checked /> 📖 社區讀者</label>
          <label><input type="radio" name="rpg-class" value="獨立創作者" /> 🎨 獨立創作者</label>
          <label><input type="radio" name="rpg-class" value="空間實習生" /> 🌿 空間實習生</label>
        </div>

        <button id="rpg-start-btn" class="rpg-btn">▶ 踏入客舍</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座填寫書名 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none; opacity: 0;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span id="seat-window-title">◆ 互動選單 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text" id="seat-desc">你準備在此處駐足。請問你目前正在閱讀或進行什麼任務？</p>
        <input type="text" id="rpg-book-input" placeholder="例如：《少女核》、編寫 Astro 專案..." maxlength="25" />
        <div class="rpg-btn-group">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">離開</button>
          <button id="seat-confirm-btn" class="rpg-btn">🛡️ 進入專心模式 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 主遊戲介面 (RPG HUD + Map) -->
  <main class="rpg-container">
    <!-- 頂部 RPG 狀態欄 (HUD) -->
    <header class="rpg-hud">
      <div class="hud-box">
        <span class="hud-label">玩家:</span> <strong id="hud-name">旅人</strong> 
        <span class="hud-tag" id="hud-class">📖 社區讀者</span>
      </div>
      <div class="hud-box">
        <span class="hud-label">據點:</span> <span>長沙灣 · 空間客舍</span>
      </div>
      <div class="hud-box">
        <button id="audio-toggle" class="rpg-btn-sm">🔊 音效: 關</button>
        <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 離開</a>
      </div>
    </header>

    <!-- 空間客舍地圖區 (Grid / Room Layout) -->
    <div id="rpg-map" class="rpg-map">
      <!-- 客舍區域標記 -->
      <div class="map-zone" style="top: 15px; left: 50%; transform: translateX(-50%); width: 80%;">
        🏛️ 空間客舍 · 核心展覽與圖書牆
      </div>
      <div class="map-zone" style="top: 120px; left: 25px; width: 140px; height: 110px;">
        ☕ 交流吧台區
      </div>
      <div class="map-zone" style="top: 120px; right: 25px; width: 140px; height: 110px;">
        💻 創作工作坊
      </div>

      <!-- 可互動座位 / 點擊入座 -->
      <div class="rpg-seat" data-id="seat-window" data-x="18" data-y="75" data-name="窗邊閱讀角">
        🪑 窗邊木椅
      </div>
      <div class="rpg-seat" data-id="seat-sofa" data-x="82" data-y="75" data-name="沙發討論區">
        🛋️ 交流沙發
      </div>
      <div class="rpg-seat" data-id="seat-desk" data-x="50" data-y="55" data-name="中央木大桌">
        🪑 創作大桌
      </div>

      <!-- 玩家與NPC實體渲染層 -->
      <div id="rpg-entities"></div>
    </div>

    <!-- 底部 RPG 對話/訊息記錄框 (Log Box) -->
    <footer class="rpg-footer">
      <div class="rpg-log-window">
        <div class="log-title">📜 系統訊息 / 事件記錄</div>
        <div id="rpg-log-text" class="log-content">歡迎來到空間客舍。點擊地圖任意處移動，或點擊座椅入座並設定專心任務。</div>
      </div>
      <div class="rpg-dock">
        <button id="btn-leave-seat" class="rpg-btn" style="display:none;">🚶 起立走動</button>
        <button id="btn-moktak" class="rpg-btn">🪵 敲響木魚 (+1)</button>
        <span class="moktak-counter">功德: <strong id="moktak-count">0</strong></span>
      </div>
    </footer>
  </main>

  <style is:global>
    /* 復古 RPG 介面色調與字體 */
    body {
      background-color: #1a1917;
      color: #e6e2d3;
      font-family: monospace, serif;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    /* 視窗與對話框 (RPG Window Style) */
    .rpg-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      transition: opacity 0.3s;
    }
    .rpg-window {
      background: #2b2925;
      border: 3px solid #b5a48b;
      border-radius: 4px;
      width: 90%;
      max-width: 420px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    .rpg-title-bar {
      background: #4a3f35;
      color: #f4f0ea;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: bold;
      border-bottom: 2px solid #b5a48b;
      letter-spacing: 1px;
    }
    .rpg-content {
      padding: 20px;
    }
    .rpg-text {
      font-size: 13px;
      line-height: 1.6;
      color: #d1cbb8;
      margin-top: 0;
      margin-bottom: 14px;
    }
    .rpg-window input[type="text"] {
      width: 100%;
      background: #1a1917;
      border: 2px solid #7a6d5c;
      color: #fff;
      padding: 10px;
      font-family: monospace;
      font-size: 14px;
      box-sizing: border-box;
      margin-bottom: 14px;
      outline: none;
    }
    .rpg-window input[type="text"]:focus {
      border-color: #d4af37;
    }
    .class-selector {
      display: flex;
      gap: 12px;
      margin-bottom: 18px;
      font-size: 12px;
    }
    .class-selector label {
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* 按鈕樣式 */
    .rpg-btn {
      background: #5c4a38;
      color: #f4f0ea;
      border: 2px solid #b5a48b;
      padding: 8px 16px;
      font-family: monospace;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
      font-weight: bold;
      transition: background 0.2s;
    }
    .rpg-btn:hover {
      background: #7a634b;
      border-color: #d4af37;
    }
    .rpg-btn-ghost {
      background: transparent;
      color: #b5a48b;
      border: 2px solid #7a6d5c;
      padding: 8px 16px;
      font-family: monospace;
      font-size: 13px;
      cursor: pointer;
      width: 100%;
    }
    .rpg-btn-sm {
      background: #38332d;
      color: #d1cbb8;
      border: 1px solid #7a6d5c;
      padding: 4px 10px;
      font-family: monospace;
      font-size: 11px;
      cursor: pointer;
      border-radius: 2px;
    }
    .rpg-btn-group {
      display: flex;
      gap: 10px;
    }

    /* 主框架佈局 */
    .rpg-container {
      width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-sizing: border-box;
    }
    .rpg-hud {
      background: #252320;
      border-bottom: 2px solid #b5a48b;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
    }
    .hud-box {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .hud-label { color: #8a7e6c; }
    .hud-tag {
      background: #3d352b;
      border: 1px solid #7a6d5c;
      padding: 1px 6px;
      border-radius: 4px;
      font-size: 11px;
    }

    /* 2D 像素/地圖風格舞台 */
    .rpg-map {
      position: relative;
      flex: 1;
      max-width: 900px;
      width: 92%;
      margin: 10px auto;
      background: #22201d;
      border: 3px solid #b5a48b;
      border-radius: 6px;
      overflow: hidden;
      cursor: pointer;
      box-shadow: inset 0 0 30px rgba(0,0,0,0.6);
    }
    .map-zone {
      position: absolute;
      background: rgba(58, 50, 42, 0.4);
      border: 1px dashed #6b5c4a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      color: #8a7e6c;
      border-radius: 4px;
      pointer-events: none;
    }

    /* 座位物件 */
    .rpg-seat {
      position: absolute;
      padding: 6px 10px;
      background: #38332d;
      border: 2px solid #8c7d6b;
      border-radius: 6px;
      font-size: 11px;
      color: #e6e2d3;
      transform: translate(-50%, -50%);
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0,0,0,0.4);
      transition: transform 0.2s, background 0.2s;
      z-index: 10;
    }
    .rpg-seat:hover {
      transform: translate(-50%, -50%) scale(1.08);
      background: #5c4a38;
      border-color: #d4af37;
    }

    /* 角色實體 (Entity) */
    .rpg-entity {
      position: absolute;
      transform: translate(-50%, -50%);
      transition: left 0.6s ease-out, top 0.6s ease-out;
      display: flex;
      flex-direction: column;
      align-items: center;
      pointer-events: none;
      z-index: 20;
    }
    .entity-dnd-badge {
      background: #8b0000;
      color: #ffcccc;
      font-size: 9px;
      padding: 1px 5px;
      border: 1px solid #ff4d4d;
      border-radius: 3px;
      margin-bottom: 2px;
      white-space: nowrap;
      font-weight: bold;
      animation: pulse-dnd 1.5s infinite;
    }
    @keyframes pulse-dnd {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }
    .entity-avatar { font-size: 24px; }
    .entity-nametag {
      background: rgba(30, 28, 25, 0.9);
      border: 1px solid #7a6d5c;
      color: #f4f0ea;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 3px;
      white-space: nowrap;
      text-align: center;
      margin-top: 2px;
    }
    .entity-subtext {
      font-size: 9px;
      color: #b5a48b;
      display: block;
    }

    /* 底部對話記錄與動作面板 */
    .rpg-footer {
      background: #252320;
      border-top: 2px solid #b5a48b;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }
    .rpg-log-window {
      flex: 1;
      background: #1a1917;
      border: 2px solid #4a3f35;
      padding: 8px 12px;
      border-radius: 4px;
      height: 48px;
      overflow: hidden;
    }
    .log-title {
      font-size: 10px;
      color: #8a7e6c;
      margin-bottom: 2px;
    }
    .log-content {
      font-size: 12px;
      color: #d1cbb8;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rpg-dock {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .moktak-counter {
      font-size: 12px;
      color: #d4af37;
      white-space: nowrap;
    }
  </style>

  <script>
    import * as Tone from 'tone';

    let playerName = '冒險者';
    let playerClass = '📖 社區讀者';
    let playerX = 25;
    let playerY = 82;
    let isDND = false;
    let currentTask = '';
    let currentSeatId: string | null = null;
    let moktakClicks = 0;
    let soundOn = false;

    // DOM 元素
    const rpgModal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const hudClass = document.getElementById('hud-class');
    const mapContainer = document.getElementById('rpg-map');
    const entitiesLayer = document.getElementById('rpg-entities');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const moktakBtn = document.getElementById('btn-moktak');
    const moktakCountSpan = document.getElementById('moktak-count');
    const audioToggle = document.getElementById('audio-toggle');
    const logText = document.getElementById('rpg-log-text');

    let pendingSeat: { id: string; x: number; y: number; name: string } | null = null;

    // 空間客舍的其他 NPC / 駐點冒險者
    const npcs = [
      { id: 'npc1', name: '空間主理人', class: '🏛️ 主理人', x: 82, y: 75, task: '整理長沙灣社群檔案', isDND: true },
      { id: 'npc2', name: '實習生阿修', class: '🌿 實習生', x: 30, y: 40, task: '佈置藝術工作坊', isDND: false }
    ];

    function logMessage(msg: string) {
      if (logText) logText.textContent = msg;
    }

    // 1. 開始冒險
    startBtn?.addEventListener('click', () => {
      const val = nameInput?.value.trim();
      if (val) playerName = val;
      
      const selectedRadio = document.querySelector('input[name="rpg-class"]:checked') as HTMLInputElement;
      if (selectedRadio) playerClass = selectedRadio.value === '社區讀者' ? '📖 社區讀者' : selectedRadio.value === '獨立創作者' ? '🎨 獨立創作者' : '🌿 空間實習生';

      if (hudName) hudName.textContent = playerName;
      if (hudClass) hudClass.textContent = playerClass;

      if (rpgModal) {
        rpgModal.style.opacity = '0';
        setTimeout(() => { rpgModal.style.display = 'none'; }, 300);
      }
      logMessage(`[系統] 玩家 ${playerName} (${playerClass}) 已成功進入空間客舍。`);
      renderEntities();
    });

    // 2. 點擊座位：開啓 RPG 任務/閱讀輸入框
    document.querySelectorAll('.rpg-seat').forEach(seat => {
      seat.addEventListener('click', (e) => {
        e.stopPropagation();
        const el = e.currentTarget as HTMLElement;
        pendingSeat = {
          id: el.dataset.id!,
          x: parseFloat(el.dataset.x!),
          y: parseFloat(el.dataset.y!),
          name: el.dataset.name!
        };

        const seatWinTitle = document.getElementById('seat-window-title');
        const seatDesc = document.getElementById('seat-desc');
        if (seatWinTitle) seatWinTitle.textContent = `◆ 駐足：${pendingSeat.name} ◆`;
        if (seatDesc) seatDesc.textContent = `你在 ${pendingSeat.name} 坐下了。請設定你目前的專心任務或閱讀書目：`;
        if (bookInput) bookInput.value = currentTask;

        if (seatModal) {
          seatModal.style.display = 'flex';
          setTimeout(() => { seatModal.style.opacity = '1'; }, 10);
        }
      });
    });

    // 3. 確認入座並進入 DND (不想被打擾) 模式
    confirmSeatBtn?.addEventListener('click', () => {
      if (pendingSeat) {
        playerX = pendingSeat.x;
        playerY = pendingSeat.y;
        currentSeatId = pendingSeat.id;
        currentTask = bookInput?.value.trim() || '靜心閱讀中';
        isDND = true;

        closeSeatModal();
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'block';
        logMessage(`[狀態] 🛡️ 已進入「不想被打擾」專心模式。任務：${currentTask}`);
        renderEntities();
      }
    });

    cancelSeatBtn?.addEventListener('click', closeSeatModal);

    function closeSeatModal() {
      if (seatModal) {
        seatModal.style.opacity = '0';
        setTimeout(() => { seatModal.style.display = 'none'; }, 300);
      }
    }

    // 4. 地圖移動 (點擊地板走動)
    mapContainer?.addEventListener('click', (e) => {
      const rect = mapContainer.getBoundingClientRect();
      playerX = ((e.clientX - rect.left) / rect.width) * 100;
      playerY = ((e.clientY - rect.top) / rect.height) * 100;

      // 移動會自動解除坐姿與 DND
      if (isDND) {
        isDND = false;
        currentSeatId = null;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
        logMessage(`[移動] 你站起身來，在空間客舍中自由漫步。`);
      } else {
        logMessage(`[移動] 你移動到了座標 (${Math.round(playerX)}, ${Math.round(playerY)})。`);
      }
      renderEntities();
    });

    // 手動起立
    leaveSeatBtn?.addEventListener('click', () => {
      isDND = false;
      currentSeatId = null;
      playerY += 6; // 稍微移開座位
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      logMessage(`[狀態] 解除專心模式，可以開始交流了。`);
      renderEntities();
    });

    // 5. 渲染玩家與 NPC
    function renderEntities() {
      if (!entitiesLayer) return;

      let html = `
        <div class="rpg-entity" style="left: ${playerX}%; top: ${playerY}%;">
          ${isDND ? `<div class="entity-dnd-badge">🛑 專心勿擾</div>` : ''}
          <div class="entity-avatar">${isDND ? '🧘' : '🚶'}</div>
          <div class="entity-nametag">
            <div>${playerName}</div>
            <span class="entity-subtext">${isDND ? currentTask : playerClass}</span>
          </div>
        </div>
      `;

      // 渲染 NPC
      npcs.forEach(n => {
        html += `
          <div class="rpg-entity" style="left: ${n.x}%; top: ${n.y}%;">
            ${n.isDND ? `<div class="entity-dnd-badge">🛑 專心勿擾</div>` : ''}
            <div class="entity-avatar">📖</div>
            <div class="entity-nametag">
              <div>${n.name}</div>
              <span class="entity-subtext">${n.task}</span>
            </div>
          </div>
        `;
      });

      entitiesLayer.innerHTML = html;
    }

    // 音效與木魚互動
    audioToggle?.addEventListener('click', async () => {
      await Tone.start();
      soundOn = !soundOn;
      if (audioToggle) audioToggle.textContent = soundOn ? '🔊 音效: 開' : '🔊 音效: 關';
    });

    moktakBtn?.addEventListener('click', async () => {
      if (soundOn) {
        const synth = new Tone.Synth({
          oscillator: { type: 'sine' },
          envelope: { attack: 0.001, decay: 0.15, sustain: 0, release: 0.1 }
        }).toDestination();
        synth.triggerAttackRelease('C5', '8n');
      }
      moktakClicks++;
      if (moktakCountSpan) moktakCountSpan.textContent = String(moktakClicks);
      logMessage(`[功德] 敲擊木魚一次。累積功德值：${moktakClicks}`);
    });

    renderEntities();
  </script>
</Layout>