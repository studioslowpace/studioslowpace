---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="檢索新圖書 — 空間客舍">
    <div class="literary-container">
        
        <header class="literary-header">
            <nav class="nav-links">
                <a href="/library">📖 雲端藏書閣</a>
                <span class="divider">/</span>
                <span class="active">🌐 檢索新圖書</span>
            </nav>
            <h1>檢索新圖書</h1>
            <p class="intro-text">跨越無垠書海，尋覓值得收進客舍藍微光裡的點滴星光。</p>
        </header>

        <section class="literary-panel">
            <div class="search-bar-wrapper">
                <input type="text" id="query" placeholder="請輸入書名、作者或 ISBN 條碼..." autocomplete="off">
                <button id="searchBtn" class="literary-btn-primary">尋覓書籍</button>
            </div>
            <div id="status" class="status-msg">準備就緒，請在上方輸入關鍵字開始檢索。</div>
            <div id="searchResults" class="results-grid"></div>
        </section>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
    <script is:inline>
        const GOOGLE_API_KEY = "AIzaSyAALLccQZnHSWI0unwfM6zaS5M8ZzGi4i4";
        
        window.supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        window.supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        window.TABLE_NAME = 'my_library'; 
        window.client = supabase.createClient(window.supabaseUrl, window.supabaseKey);

        let currentSearchResults = []; 

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll('.auth-modal').forEach(el => el.remove());

            const searchBtn = document.getElementById('searchBtn');
            const queryInput = document.getElementById('query');

            if (searchBtn) searchBtn.addEventListener('click', searchBooks);
            if (queryInput) {
                queryInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') searchBooks();
                });
            }
        });

        async function searchBooks() {
            const queryInput = document.getElementById('query');
            const statusDiv = document.getElementById('status');
            const resultsDiv = document.getElementById('searchResults');
            
            if (!queryInput) return;
            const query = queryInput.value.trim();
            resultsDiv.innerHTML = '';
            currentSearchResults = [];
            
            if (!query) { 
                statusDiv.innerText = '⚠️ 請輸入檢索關鍵字。'; 
                return; 
            }

            statusDiv.innerText = '🍃 正在翻閱無垠書海，尋找相符的足跡...';
            const url = `https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(query)}&maxResults=5&key=${GOOGLE_API_KEY}`;

            try {
                const response = await fetch(url);
                const data = await response.json();
                const items = data.items || [];

                if (items.length === 0) {
                    statusDiv.innerText = '☕ 找不到相關的圖書記錄，試著換個作者或書名看看？';
                    return;
                }

                statusDiv.innerText = `✨ 找到 ${items.length} 冊契合的圖書：`;

                items.forEach((item, index) => {
                    const info = item.volumeInfo || {};
                    const title = info.title || '無題';
                    const authors = info.authors ? info.authors.join(' / ') : '佚名';
                    const publisher = info.publisher || '獨立出版';
                    const pubDate = info.publishedDate || '年代不詳';
                    const pageCount = info.pageCount ? `${info.pageCount} 頁` : '頁數未詳';
                    const description = info.description || '這本書暫無詳細的內容簡介。';
                    
                    let isbn = '無 ISBN';
                    if (info.industryIdentifiers) {
                        const id13 = info.industryIdentifiers.find(id => id.type === 'ISBN_13');
                        const id10 = info.industryIdentifiers.find(id => id.type === 'ISBN_10');
                        isbn = id13 ? id13.identifier : (id10 ? id10.identifier : info.industryIdentifiers[0].identifier);
                    }

                    let imgUrl = 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=300&q=80';
                    if (info.imageLinks && (info.imageLinks.thumbnail || info.imageLinks.smallThumbnail)) {
                        imgUrl = info.imageLinks.thumbnail || info.imageLinks.smallThumbnail;
                        imgUrl = imgUrl.replace(/^http:\/\//i, 'https://');
                    }

                    const bookObj = { 
                        title, authors, publisher, pub_date: pubDate, page_count: pageCount, 
                        isbn, img_url: imgUrl, description, notes: '',
                        raw_image_links: info.imageLinks ? JSON.stringify(info.imageLinks) : null 
                    };
                    currentSearchResults.push(bookObj);

                    const card = document.createElement('article');
                    card.className = 'literary-card-row';

                    card.innerHTML = `
                        <img src="${imgUrl}" alt="${title}" class="row-cover">
                        <div class="row-info">
                            <div class="row-header">
                                <h3 class="row-title">${title}</h3>
                                <span class="row-isbn">ISBN: ${isbn}</span>
                            </div>
                            <p class="row-author">著：${authors}</p>
                            <div class="row-meta">
                                <span>${publisher}</span><span>·</span><span>${pubDate}</span><span>·</span><span>${pageCount}</span>
                            </div>
                            <p class="row-desc">${description}</p>
                            <button class="literary-btn-primary" style="align-self: flex-start; margin-top: 6px;" onclick="addToLibrary(${index})">＋ 收入雲端藏書閣</button>
                        </div>
                    `;
                    resultsDiv.appendChild(card);
                });

            } catch (error) {
                console.error(error);
                statusDiv.innerText = '💥 網路連結微恙，請稍後再試。';
            }
        }

        async function addToLibrary(index) {
            const bookToAdd = currentSearchResults[index];
            try {
                const { data: existingBooks, error: searchError } = await window.client
                    .from(window.TABLE_NAME).select('id').eq('isbn', bookToAdd.isbn).eq('title', bookToAdd.title);

                if (searchError) throw searchError;

                if (existingBooks && existingBooks.length > 0) {
                    alert(`⚠️ 「${bookToAdd.title}」已經存在於你的雲端藏書閣囉！`);
                    return;
                }

                const { error: insertError } = await window.client.from(window.TABLE_NAME).insert([bookToAdd]); 
                if (insertError) throw insertError;

                alert(`🎉 成功將「${bookToAdd.title}」收入雲端藏書閣！`);
            } catch (error) {
                console.error(error);
                alert('💥 收入藏書閣失敗，請檢查資料表權限。');
            }
        }
    </script>

    <style is:global>
        :root {
            --bg-paper: #f4f6f9;
            --card-surface: #fafbfd;
            --text-ink: #222b38;
            --text-muted: #6b778d;
            --accent-blue: #2c4a6f;
            --accent-blue-hover: #1f354f;
            --border-line: #d8e0ec;
            --shadow-subtle: 0 10px 30px rgba(44, 74, 111, 0.04);
        }

        body {
            background-color: var(--bg-paper);
            color: var(--text-ink);
            font-family: "Noto Serif TC", "Songti TC", Georgia, serif;
            margin: 0;
            padding: 0;
            line-height: 1.8;
        }

        .literary-container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 24px;
        }

        .literary-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .nav-links {
            font-size: 13px;
            letter-spacing: 0.1em;
            margin-bottom: 16px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }
        .nav-links a:hover { color: var(--accent-blue); }
        .nav-links .active { color: var(--accent-blue); font-weight: 500; }
        .nav-links .divider { color: var(--border-line); }

        .literary-header h1 {
            font-size: 28px;
            font-weight: 400;
            letter-spacing: 0.05em;
            color: var(--text-ink);
            margin: 0 0 8px 0;
        }

        .intro-text {
            font-size: 14px;
            color: var(--text-muted);
            font-style: italic;
            margin: 0;
        }

        .literary-panel {
            background: var(--card-surface);
            border: 1px solid var(--border-line);
            border-radius: 16px;
            padding: 32px;
            box-shadow: var(--shadow-subtle);
            min-height: 60vh;
        }

        .search-bar-wrapper {
            display: flex;
            gap: 12px;
            background: #fff;
            padding: 8px;
            border-radius: 50px;
            border: 1px solid var(--border-line);
            box-shadow: var(--shadow-subtle);
            margin-bottom: 20px;
        }

        #query {
            flex: 1;
            background: transparent;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            color: var(--text-ink);
            outline: none;
            font-family: inherit;
        }

        #query::placeholder { color: #a1b0c5; }

        .literary-btn-primary {
            background-color: var(--accent-blue);
            color: #fff;
            border: none;
            padding: 10px 24px;
            border-radius: 40px;
            font-size: 13px;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.2s;
            letter-spacing: 0.05em;
        }
        .literary-btn-primary:hover { background-color: var(--accent-blue-hover); }

        .status-msg {
            text-align: center;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 24px;
            letter-spacing: 0.05em;
        }

        .results-grid {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .literary-card-row {
            background: #fff;
            border: 1px solid var(--border-line);
            border-radius: 12px;
            padding: 24px;
            display: flex;
            gap: 20px;
            align-items: flex-start;
            box-shadow: 0 4px 12px rgba(44,74,111,0.02);
        }

        @media (max-width: 680px) {
            .literary-card-row { flex-direction: column; align-items: center; text-align: center; }
        }

        .row-cover {
            width: 90px;
            height: 130px;
            object-fit: cover;
            border-radius: 4px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
            background: #eee;
            flex-shrink: 0;
        }

        .row-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
        }

        .row-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 6px;
        }

        .row-title {
            font-size: 16px;
            font-weight: 500;
            color: var(--text-ink);
            margin: 0;
        }

        .row-isbn {
            font-size: 11px;
            color: var(--text-muted);
        }

        .row-author {
            font-size: 13px;
            color: var(--accent-blue);
            margin: 0;
            font-weight: 500;
        }

        .row-meta {
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: wrap;
        }

        .row-desc {
            font-size: 12px;
            color: #4f5a6b;
            line-height: 1.6;
            margin: 4px 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</BaseLayout>