---
import MobileLayout from '../layouts/PhoneLayout.astro';
import DesktopLayout from '../layouts/BaseLayout.astro';
import Shallwehelp from '../components/shallwehelp-code.astro';
import { supabase } from '../lib/supabase';
---

<!-- 1. 裝載動態切換內容的根容器 -->
<div id="dynamic-app-root">
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; color: #8c7a6b;">
        <p>✨ 空間客舍載入中...</p>
    </div>
</div>

<!-- 2. 手機版樣板（包在 template 內，初始不會被瀏覽器直接渲染與衝突） -->
<template id="mobile-layout-template">
    <div class="mobile-wrapper">
        <MobileLayout title="客舍萬事屋 Shall We Help">
            <Shallwehelp />
        </MobileLayout>
    </div>
</template>

<!-- 3. 電腦版樣板 -->
<template id="desktop-layout-template">
    <div class="desktop-wrapper">
        <DesktopLayout title="客舍萬事屋 Shall We Help">
            <Shallwehelp />
        </DesktopLayout>
    </div>
</template>

<!-- 4. 前端 JavaScript：根據螢幕寬度動態掛載對應的 Layout -->
<script>
    function renderDeviceLayout() {
        const root = document.getElementById('dynamic-app-root');
        if (!root) return;

        // 判斷螢幕寬度（768px 以上為電腦版）
        const isDesktop = window.innerWidth >= 768;

        root.innerHTML = ''; // 清空目前內容

        if (isDesktop) {
            const template = document.getElementById('desktop-layout-template');
            if (template) {
                root.appendChild(template.content.cloneNode(true));
            }
        } else {
            const template = document.getElementById('mobile-layout-template');
            if (template) {
                root.appendChild(template.content.cloneNode(true));
            }
        }
    }

    // 頁面載入完成後執行
    window.addEventListener('DOMContentLoaded', renderDeviceLayout);

    // 視窗大小改變或旋轉時自動切換
    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(renderDeviceLayout, 150);
    });
</script>