---
import MobileLayout from '../layouts/PhoneLayout.astro';   // 你的手機版 Layout
import DesktopLayout from '../layouts/BaseLayout.astro';     // 你的電腦版 Layout
import Shallwehelp from '../components/shallwehelp-code.astro';
---

<!-- 手機版容器 -->
<div class="mobile-view">
    <MobileLayout />
        <Fragment slot="head">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    </Fragment>
    <Shallwehelp />
</div>

<!-- 電腦版容器 -->
<div class="desktop-view">
    <DesktopLayout />
        <Fragment slot="head">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    </Fragment>
    <Shallwehelp />
</div>

<style>
    /* 預設（手機）：顯示手機版，隱藏電腦版 */
    .desktop-view {
        display: none;
    }
    .mobile-view {
        display: block;
    }

    /* 當螢幕寬度大於 768px（電腦）：顯示電腦版，隱藏手機版 */
    @media (min-width: 768px) {
        .mobile-view {
            display: none;
        }
        .desktop-view {
            display: block;
        }
    }
</style>