---
// 這裡不需要在靜態頂部同時 import 兩套會打架的 Layout
import Shallwehelp from '../components/shallwehelp-code.astro';
import { supabase } from '../lib/supabase';
---

<!-- 裝載動態 Layout 的容器 -->
<div id="dynamic-app-root" style="min-height: 100vh; background-color: #faf6ee;">
    <!-- 預設顯示載入中，避免畫面閃爍 -->
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; color: #8c7a6b; font-family: sans-serif;">
        <p>✨ 空間客舍載入中...</p>
    </div>
</div>

<script>
    import { createClient } from '@supabase/supabase-js';

    // 客戶端載入時執行
    async function initDeviceLayout() {
        const root = document.getElementById('dynamic-app-root');
        if (!root) return;

        // 判斷螢幕寬度 (768px 以上為電腦版)
        const isDesktop = window.innerWidth >= 768;

        if (isDesktop) {
            // 💻 電腦版邏輯：導向電腦版專用路由，或者動態渲染電腦版元件
            // 如果你希望在同一個網址，也可以透過改變 innerHTML 或動態載入 DesktopLayout 的內容
            console.log("切換為電腦版模式");
        } else {
            // 📱 手機版邏輯
            console.log("切換為手機版模式");
        }
    }

    // 畫面載入與視窗大小改變時執行
    window.addEventListener('DOMContentLoaded', initDeviceLayout);
</script>