---
import MobileLayout from '../layouts/PhoneLayout.astro';       // 手機版 Layout
import DesktopLayout from '../layouts/BaseLayout.astro';    // 電腦版 Layout
import Shallwehelp from '../components/shallwehelp-code.astro';
---

<!-- 📱 手機版容器 -->
<div id="mobile-view-wrapper" class="device-view-container">
    <MobileLayout title="客舍萬事屋 Shall We Help">
        <Fragment slot="head">
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <script src="https://unpkg.com/lucide@latest"></script>
        </Fragment>
        <Shallwehelp />
    </MobileLayout>
</div>

<!-- 💻 電腦版容器（我們可以為它加上專屬的電腦版外框樣式） -->
<div id="desktop-view-wrapper" class="device-view-container" style="display: none;">
    <DesktopLayout title="客舍萬事屋 Shall We Help">
        <Fragment slot="head">
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <script src="https://unpkg.com/lucide@latest"></script>
        </Fragment>
        
        <!-- 💡 讓內容在電腦版時擁有適當的最大寬度與置中，避免被拉得太寬而走樣 -->
        <div style="max-width: 1000px; margin: 0 auto; padding: 20px;">
            <Shallwehelp />
        </div>
    </DesktopLayout>
</div>

<script>
    // 在頁面載入的「第一瞬間」，根據寬度直接把沒用到的那套 Layout 整個從 DOM 拔除！
    // 這樣就能 100% 避免 ID 衝突、CORS 或 JS 抓錯對象的問題
    const isDesktop = window.innerWidth >= 768;
    
    if (isDesktop) {
        const mobileEl = document.getElementById('mobile-view-wrapper');
        if (mobileEl) mobileEl.remove(); // 直接移除手機版，釋放所有 ID 與記憶體衝突
        const desktopEl = document.getElementById('desktop-view-wrapper');
        if (desktopEl) desktopEl.style.display = 'block';
    } else {
        const desktopEl = document.getElementById('desktop-view-wrapper');
        if (desktopEl) desktopEl.remove(); // 直接移除電腦版
        const mobileEl = document.getElementById('mobile-view-wrapper');
        if (mobileEl) mobileEl.style.display = 'block';
    }
</script>