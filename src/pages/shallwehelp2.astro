---
import MobileLayout from '../layouts/PhoneLayout.astro';   // 你的手機版 Layout
import DesktopLayout from '../layouts/BaseLayout.astro';     // 你的電腦版 Layout
import Shallwehelp from '../components/shallwehelp-code.astro';
---

<!-- 裝載容器 -->
<div id="app-container">
    <!-- 預設先放手機版內容防閃爍 -->
    <div class="mobile-only">
        <MobileLayout title="客舍萬事屋 Shall We Help">
                <Fragment slot="head">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    </Fragment>
            <Shallwehelp />
        </MobileLayout>
    </div>
</div>

<script>
    import MobileLayout from '../layouts/BaseLayout.astro';
    
    // 在客戶端執行時，根據螢幕寬度動態切換載入的 Layout
    function checkDeviceLayout() {
        const container = document.getElementById('app-container');
        if (!container) return;

        const isDesktop = window.innerWidth >= 768; // 768px 以上為電腦版

        // 如果你想在電腦版直接顯示 DesktopLayout，可以透過動態跳轉或重載，
        // 或者最快的方法：直接在 CSS 決定要顯示哪一個就好：
    }
</script>

<style>
    /* 透過純 CSS 媒體查詢，確保同一時間只有一個 Layout 在運作且不會互相污染 */
    .desktop-layout-wrapper {
        display: none;
    }
    .mobile-layout-wrapper {
        display: block;
    }

    @media (min-width: 768px) {
        .mobile-layout-wrapper {
            display: none !important;
        }
        .desktop-layout-wrapper {
            display: block !important;
        }
    }
</style>