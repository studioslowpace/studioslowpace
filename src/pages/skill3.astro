---
// 匯入 Layout
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="客舍萬事屋 Slow Pace Skill Supermarket">
    <Fragment slot="head">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    </Fragment>
    
<style is:global>
        /* ==========================================
           1. 全域與基礎排版樣式 (Global & Base)
           ========================================== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        /* 修正：配合 Layout 外框設定，確保不會將手機模式撐開 */
        body {
            font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
            color: #3A2E2B;
            width: 100%;
        }
        .hidden {
            display: none !important;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* ==========================================
           2. 提示彈窗樣式 (Toast)
           ========================================== */
        .toast-notification {
            position: fixed;
            bottom: 2.5rem;
            left: 50%;
            transform: translateX(-50%);
            background-color: rgba(28, 25, 23, 0.9);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.75rem 1.25rem;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            z-index: 50;
            text-align: center;
            border: 1px solid rgba(68, 64, 60, 0.5);
            width: 90%;
            max-width: 360px;
        }

        /* ==========================================
           3. 最高權限管理端樣式 (Admin Navbar)
           ========================================== */
        .admin-nav {
            background-color: #ffffff;
            border-bottom: 1px solid #fef3c7;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            width: 100%;
            z-index: 50;
        }
        .admin-nav-container {
            width: 100%;
            margin: 0 auto;
            padding: 1rem;
            box-sizing: border-box;
        }
        .admin-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid #f3f4f6;
            margin-bottom: 1rem;
        }
        .admin-title-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .admin-title-icon {
            color: #d97706;
            width: 1.25rem;
            height: 1.25rem;
        }
        .admin-main-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: #1f2937;
        }
        .btn-admin-close-nav {
            color: #9ca3af;
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .btn-admin-close-nav:hover { color: #4b5563; }
        .admin-close-icon { width: 1.25rem; height: 1.25rem; }
        
        .admin-logout-row {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            width: 100%;
        }
        .admin-hint-text {
            font-size: 0.75rem;
            color: #9ca3af;
        }
        .admin-password-code {
            background-color: #f3f4f6;
            padding: 0.125rem 0.25rem;
            border-radius: 0.25rem;
            color: #b45309;
        }
        .admin-input-group-wrapper {
            display: flex;
            gap: 0.5rem;
            flex: 1 1 0%;
            width: 100%;
        }
        .admin-password-input {
            width: 100%;
            padding: 0.5rem 0.75rem;
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            font-size: 0.75rem;
            letter-spacing: 0.1em;
        }
        .admin-password-input:focus { outline: none; border-color: #f59e0b; }
        
        .btn-admin-login {
            padding: 0.5rem 1rem;
            background-color: #d97706;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.75rem;
            border-radius: 0.75rem;
            white-space: nowrap;
            border: none;
            cursor: pointer;
        }
        .btn-admin-login:hover { background-color: #b45309; }
        
        .admin-login-row {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
        }
        .admin-success-badge {
            background-color: #ecfdf5;
            color: #065f46;
            font-size: 0.75rem;
            padding: 0.75rem;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .admin-success-text { font-weight: 700; }
        .admin-success-icon { width: 1rem; height: 1rem; flex-shrink: 0; }
        
        .admin-logout-wrapper {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.5rem;
            background-color: #f9fafb;
            padding: 0.75rem;
            border-radius: 1rem;
            border: 1px solid #f3f4f6;
            width: 100%;
        }
        
        .btn-admin-logout {
            padding: 0.5rem 0.75rem;
            background-color: #fef2f2;
            color: #dc2626;
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 0.75rem;
            border: none;
            cursor: pointer;
        }
        .btn-admin-logout:hover { background-color: #dc2626; color: #ffffff; }

        /* ==========================================
           4. 頁首與導覽區塊 (Header)
           ========================================== */
        .banner-logo-group {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            user-select: none;
        }
        .banner-logo-img {
            width: 44px;
            height: 44px;
            object-fit: cover;
            transition: opacity 0.2s;
        }

        .banner-logo-group:hover .banner-logo-img { opacity: 0.8; }
        .banner-title-main {
            font-size: 0.875rem;
            font-weight: 700;
            color: #1f2937;
            letter-spacing: 0.05em;
            display: block;
        }

        .hero-banner {
            text-align: center;
        }

        .hero-banner h1 {
            font-size: 28px;
            color: #4d361d;
            display: block;
            font-weight: bold;
            letter-spacing: 6px;
        }

        .hero-title-sub {
            font-size: 16px;
            color: #4d361d;
            display: block;
            font-weight: bold;
            margin-top: -0.5rem;
        }

        /* ==========================================
           5. 按鈕基本樣式 (Buttons)
           ========================================== */
        .btn-base {
            font-size: 0.725rem;
            font-weight: 700;
            padding: 0.45rem 0.85rem;
            border-radius: 0.75rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-stone { background-color: #1c1917; color: #ffffff; }
        .btn-stone:hover { background-color: #0c0a09; }
        .btn-orange { background-color: #ea580c; color: #ffffff; }
        .btn-orange:hover { background-color: #c2410c; }
        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            font-weight: 700;
            color: #ea580c;
            background-color: #ffffff;
            padding: 0.5rem 1rem;
            border-radius: 0.75rem;
            border: 1px solid #fef3c7;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-back:hover { color: #c2410c; }
        .btn-back-icon { width: 1rem; height: 1rem; }

        /* ==========================================
           6. 主要版面結構與主橫幅 (Layout & Banner - 手機寬度適應)
           ========================================== */
        .main-layout {
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
            padding: 1rem 0.75rem;
            box-sizing: border-box;
        }
        
        .single-layout {
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
            padding: 1rem 0.75rem;
            box-sizing: border-box;
        }
        .layout-spacing {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            width: 100%;
        }
        .admin-status-badge {
            text-align: center;
            background-color: #fef3c7;
            border: 1px solid #fde68a;
            color: #92400e;
            font-size: 0.75rem;
            padding: 0.5rem;
            border-radius: 0.75rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }
        
        .hero-banner {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-start;
            gap: 1rem;
            padding: 1.25rem 1rem;
            border-radius: 1.25rem;
            background: linear-gradient(to bottom right, #fde68a, #ffedd5);
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            width: 100%;
        }
        
        .hero-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            letter-spacing: 0.05rem;
            color: #451a03;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .hero-desc-wrapper {
            font-size: 0.85rem;
            color: #78350f;
            line-height: 1.6;
            letter-spacing: 0.08em;
            width: 100%;
            text-align: left;
        }

        .hero-desc-wrapper p2 {
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            display: block;
            margin-top: 0.5rem;
        }

        /* ==========================================
           7. 標籤分頁與資訊看板 (Tabs & Leaderboard)
           ========================================== */
        .tabs-row {
            display: flex;
            border-bottom: 1px solid #fde68a;
            font-size: 0.75rem;
            font-weight: 700;
            overflow-x: auto;
            white-space: nowrap;
            width: 100%;
        }
        .tab-btn {
            padding: 0.5rem 0.75rem;
            color: #9ca3af;
            border: none;
            background: transparent;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.2s;
            flex-shrink: 0;
        }
        .tab-btn:hover { color: #4b5563; }
        .tab-active-orange {
            color: #ea580c;
            border-bottom: 2px solid #f97316;
        }
        .tab-btn-flex {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .leaderboard-panel {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            background-color: rgba(254, 243, 199, 0.6);
            padding: 1rem;
            border-radius: 1rem;
            border: 1px solid #fde68a;
            width: 100%;
        }
        
        .search-box-card {
            background-color: #ffffff;
            padding: 0.85rem;
            border-radius: 0.75rem;
            border: 1px solid #fde68a;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            width: 100%;
        }
        
        .search-title {
            font-size: 0.75rem;
            font-weight: 700;
            color: #92400e;
            margin-bottom: 0.25rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }
        .search-icon { width: 0.875rem; height: 0.875rem; }
        .search-hint { font-size: 11px; color: #9ca3af; margin-bottom: 0.5rem; }
        .search-input {
            width: 100%;
            padding: 0.45rem;
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            font-size: 0.75rem;
        }
        .search-input:focus { outline: none; border-color: #b45309; }
        .btn-search {
            width: 100%;
            margin-top: 0.5rem;
            padding: 0.375rem 0;
            background-color: #b45309;
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 0.5rem;
            border: none;
            cursor: pointer;
        }
        .btn-search:hover { background-color: #92400e; }

        .leaderboard-list-card {
            background-color: #ffffff;
            padding: 0.85rem;
            border-radius: 0.75rem;
            border: 1px solid #fde68a;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            width: 100%;
        }
        .leaderboard-title {
            font-size: 0.75rem;
            font-weight: 700;
            color: #78350f;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }
        .leaderboard-container {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            font-size: 0.75rem;
        }

        /* ==========================================
           8. 卡片網格與元件 (Cards Grid - 單欄適應手機)
           ========================================== */
        .card-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
        }

        /* ==========================================
           9. 彈窗模組通用樣式 (Modals)
           ========================================== */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background-color: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(4px);
            z-index: 50;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
        }
        .modal-content {
            background-color: #ffffff;
            width: 100%;
            max-width: 380px;
            border-radius: 1.25rem;
            padding: 1.25rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
            box-sizing: border-box;
        }
        .max-w-sm { max-width: 380px; }
        .max-w-md { max-width: 380px; }
        .max-h-scroll { max-height: 82vh; overflow-y: auto; }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #f3f4f6;
        }
        .modal-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: #1f2937;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .modal-title-emerald { color: #065f46; }
        .modal-title-icon { width: 1rem; height: 1rem; color: #ea580c; }
        .btn-modal-close {
            color: #9ca3af;
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .btn-modal-close:hover { color: #4b5563; }
        .modal-close-icon { width: 1.25rem; height: 1.25rem; }

        .form-spacing {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .form-spacing-lg {
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }
        .form-row-grid {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }
        @media (min-width: 380px) {
            .form-row-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
        .input-block-bg {
            background-color: rgba(254, 243, 199, 0.5);
            padding: 0.75rem;
            border-radius: 1rem;
            border: 1px solid #fde68a;
        }
        .input-block-stone {
            background-color: #f9fafb;
            padding: 0.75rem;
            border-radius: 1rem;
            border: 1px solid #e5e7eb;
        }
        .input-block-orange {
            background-color: #fff7ed;
            padding: 0.75rem;
            border-radius: 1rem;
            border: 1px solid #ffedd5;
        }
        .input-label {
            display: block;
            font-size: 0.7rem;
            font-weight: 700;
            color: #6b7280;
            margin-bottom: 0.25rem;
        }
        .input-label-orange { color: #9a3412; }
        .avatar-preview-circle {
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 50%;
            background-color: #fff7ed;
            border: 2px solid #fbe58a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            cursor: pointer;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .avatar-preview-stone {
            background-color: #ffffff;
            border-color: #a8a29e;
        }
        
        .input-field {
            width: 100%;
            padding: 0.5rem;
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            font-size: 0.8rem;
        }
        .input-field:focus { outline: none; border-color: #ea580c; }
        .input-field-stone:focus { outline: none; border-color: #1c1917; }
        .input-field-textarea { resize: none; }
        
        .input-password-special {
            width: 100%;
            padding: 0.5rem;
            background-color: #ffffff;
            border: 1px solid #fed7aa;
            border-radius: 0.75rem;
            font-size: 0.75rem;
        }
        .input-password-special:focus { outline: none; border-color: #ea580c; }

        .modal-text-desc { font-size: 0.7rem; color: #6b7280; }
        .modal-list-container {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-height: 10rem;
            overflow-y: auto;
            padding: 0.25rem 0;
        }
        .modal-footer-actions {
            padding-top: 0.5rem;
            border-top: 1px solid #f3f4f6;
            display: flex;
            gap: 0.5rem;
        }
        .btn-modal-cancel {
            flex: 1 1 0%;
            padding: 0.45rem 0;
            background-color: #f3f4f6;
            color: #4b5563;
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 0.75rem;
            border: none;
            cursor: pointer;
        }
        .btn-modal-confirm-emerald {
            flex: 1 1 0%;
            padding: 0.45rem 0;
            background-color: #059669;
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 0.75rem;
            border: none;
            cursor: pointer;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .btn-modal-confirm-emerald:hover { background-color: #047857; }
        
        .btn-form-submit-orange {
            width: 100%;
            padding: 0.55rem 0;
            background-color: #ea580c;
            color: #ffffff;
            font-weight: 700;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            border: none;
            cursor: pointer;
        }
        .btn-form-submit-orange:hover { background-color: #c2410c; }
        
        .btn-form-submit-stone {
            width: 100%;
            padding: 0.55rem 0;
            background-color: #1c1917;
            color: #ffffff;
            font-weight: 700;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            border: none;
            cursor: pointer;
        }
        .btn-form-submit-stone:hover { background-color: #0c0a09; }

        /* ==========================================
           11. 卡片樣式
           ========================================== */
        .task-card {
            background-color: #ffffff;
            border: 1.5px solid #fffbeb;
            border-radius: 1.25rem;
            padding: 1.15rem;
            box-shadow: 0 4px 12px -2px rgba(251, 191, 36, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 0.85rem;
            position: relative;
            width: 100%;
            box-sizing: border-box;
        }

        .task-card-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            width: 100%;
        }

        .title-with-badge {
            display: flex;
            gap: 0.75rem;
            align-items: center;
            flex: 1;
            font-size: 0.75rem;
        }

        .avatar-circle-orange {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            background-color: #fffbeb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .task-card-title {
            font-size: 0.9rem;
            font-weight: 800;
            color: #1e293b;
            margin: 0;
            line-height: 1.3;
        }
        .task-card-subtitle {
            font-size: 0.6rem;
            color: #94a3b8;
            margin-top: 0.15rem;
        }

        .tag-orange {
            display: inline-block;
            font-size: 0.58rem;
            font-weight: 700;
            color: #c2410c;
            background-color: #fff7ed;
            padding: 0.25rem 0.6rem;
            border-radius: 9999px;
        }

        .task-card-description {
            font-size: 0.75rem;
            font-weight: 500;
            color: #334155;
            line-height: 1.5;
            margin: 0.25rem 0;
            white-space: pre-line;
            word-break: break-all;
        }

        .task-card-footer {
            font-size: 0.65rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 0.5rem;
            border-top: 1px dashed #f1f5f9;
        }

        .reward-info-text {
            font-size: 0.65rem;
            color: #94a3b8;
            font-weight: 500;
            flex: 1;
            padding-right: 0.25rem;
        }
        .reward-highlight {
            color: #c2410c;
            font-weight: 700;
        }

        .badge-status-success {
            font-size: 0.75rem;
            font-weight: 700;
            color: #047857;
            background-color: #ecfdf5;
            padding: 0.35rem 0.6rem;
            border-radius: 0.75rem;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }
        .status-success-subtitle {
            font-size: 0.6rem;
            color: #059669;
            font-weight: 500;
        }

        .card-admin-tools {
            position: absolute;
            top: 0.85rem;
            right: 0.85rem;
            z-index: 10;
        }

        input::placeholder,
        textarea::placeholder {
            font-size: 0.7rem;
            color: #99ca9a;
        }

        .text-ellipsis-2line {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .text-ellipsis-5line {
            display: -webkit-box;
            -webkit-line-clamp: 5;
