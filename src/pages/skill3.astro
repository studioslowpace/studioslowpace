                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- ⚖️ 免責聲明文青風彈窗 -->
    <div id="modal-disclaimer" class="hidden modal-overlay">
        <div class="modal-content" style="background-color: #fdfbf7; border: 1px solid #fde68a; max-height: 82vh; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f3f4f6; padding-bottom: 0.5rem;">
                <h3 style="font-size: 0.95rem; font-weight: 700; color: #451a03; display: flex; align-items: center; gap: 0.5rem;">
                    ⚖️ 客舍萬事屋｜免責聲明
                </h3>
                <button id="btn-close-disclaimer" style="color: #9ca3af; background: transparent; border: none; cursor: pointer; font-size: 1.1rem;">✕</button>
            </div>
            <div style="font-size: 0.75rem; color: #57534e; line-height: 1.7; display: flex; flex-direction: column; gap: 0.6rem; text-align: left;">
                <p>歡迎使用「客舍萬事屋」。為了維護社群秩序與保障參與者權益，請在參與前詳閱以下聲明：</p>
                <ul style="margin-left: 1.25rem; list-style-type: disc; display: flex; flex-direction: column; gap: 0.4rem;">
                    <li><strong>平台定位</strong>：本平台僅提供基於互助精神的技能交換與生活資訊的交流空間，並以「萬事分」作為信賴憑證。空間客舍並非各項服務的僱主或代理人。</li>
                    <li><strong>責任歸屬</strong>：雙方之私下聯繫、線下面交、勞務提供或交易均屬自主行為。因互動產生的糾紛、損失或安全疑慮，客舍萬事屋及主理人不負直接或連帶賠償責任。</li>
                    <li><strong>資訊真實性</strong>：所有委託內容、聯絡管道與技能專長均由使用者自行填寫。使用者應審慎評估隱私風險。</li>
                    <li><strong>點數與資格權利</strong>：萬事分僅為社群內部使用的代幣，不具備法定貨幣價值。主理人保留審查、調整點數，以及取消「鄰里人名冊」資格與紀錄的最終權利。</li>
                </ul>
                <p style="font-style: italic; font-size: 0.7rem; color: #78716c; margin-top: 0.25rem;">當您開始使用客舍萬事屋時，即視為您已充分閱讀並同意接受本免責聲明的所有條款。</p>
            </div>
        </div>
    </div>


<script>
    import { supabase } from '../lib/supabase';
    
    const TABLE_NAME = 'skills';
    const POSTS_TABLE = 'posts';
    const MEMBERS_TABLE = 'slowpace_members';
    const PROFILES_TABLE = 'profiles';
    
    let posts = [];
    let skills = [];
    let isAdmin = false;
    let isGuest = false;
    let currentTab = 'active';
    let allUserRecords = [];
    let currentTagFilter = 'all';

    window.onload = async function() {
        fetchPostsFromSupabase();
        fetchSkillsFromSupabase(); 
        fetchAllUserRecordsFromSupabase();
        setupRandomDefaultAvatar();

        initEventListeners();

        // 🌟 依照您提供的雙軌權限檢查函式
        try {
            const { data: { session } } = await supabase.auth.getSession();
            if (session?.user) {
                await checkAdminPermission(session.user.id);
            }
        } catch (err) {
            console.error("檢查初始登入狀態失敗:", err);
            isAdmin = false;
        }
        
        updateAdminUI();
        refreshView();

        supabase.auth.onAuthStateChange(async (event, session) => {
            if (session?.user) {
                await checkAdminPermission(session.user.id);
            } else {
                isAdmin = false;
            }
            updateAdminUI();
            refreshView();
        });
    };

    // 🔗 您指定的雙軌管理員權限檢查方法
    async function checkAdminPermission(userId) {
        if (!userId || isGuest) return;
        try {
            let { data, error } = await supabase
                .from(PROFILES_TABLE)
                .select('is_admin')
                .eq('id', userId)
                .maybeSingle();

            if (error || !data) {
                const memberRes = await supabase
                    .from(MEMBERS_TABLE)
                    .select('is_admin')
                    .eq('user_id', userId)
                    .maybeSingle();
                data = memberRes.data;
            }

            if (data && data.is_admin === true) {
                isAdmin = true;
            } else {
                isAdmin = false;
            }
        } catch (err) {
            console.error("檢查管理員權限失敗:", err);
            isAdmin = false;
        }
    }

    function initEventListeners() {
        document.getElementById('banner-logo-trigger')?.addEventListener('click', () => {
            if (isAdmin) {
                toggleAdminNavbar();
            } else {
                alert("🔒 此功能僅限客舍主理人使用。");
            }
        });
        document.getElementById('btn-admin-close-nav')?.addEventListener('click', toggleAdminNavbar);
        document.getElementById('btn-admin-point-plus')?.addEventListener('click', () => adminAdjustPoints(1));
        document.getElementById('btn-admin-point-minus')?.addEventListener('click', () => adminAdjustPoints(-1));

        document.getElementById('header-chatroom-btn')?.addEventListener('click', () => {
            window.open('https://studioslowpace.com/chat', '_blank');
        });
        document.getElementById('header-skill-btn')?.addEventListener('click', openSkillModal);
        document.getElementById('header-upload-btn')?.addEventListener('click', openUploadModal);

        document.querySelectorAll('.tabs-row .tab-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const tabName = e.currentTarget.getAttribute('data-tab');
                if (tabName) switchTab(tabName);
            });
        });

        document.getElementById('btn-query-points')?.addEventListener('click', queryPersonalPoints);

        document.getElementById('btn-close-join')?.addEventListener('click', closeJoinModal);
        document.getElementById('btn-close-complete')?.addEventListener('click', closeCompleteModal);
        document.getElementById('btn-cancel-complete')?.addEventListener('click', closeCompleteModal);
        document.getElementById('btn-confirm-complete')?.addEventListener('click', submitCompleteTask);
        document.getElementById('btn-close-upload')?.addEventListener('click', closeUploadModal);
        document.getElementById('btn-close-skill')?.addEventListener('click', closeSkillModal);

        document.getElementById('join-form')?.addEventListener('submit', handleJoinSubmit);
        document.getElementById('post-form')?.addEventListener('submit', handleFormSubmit);
        document.getElementById('skill-form')?.addEventListener('submit', handleSkillSubmit);

        document.getElementById('current-avatar-preview')?.addEventListener('click', () => toggleEmojiBank('post'));
        document.getElementById('skill-avatar-preview')?.addEventListener('click', () => toggleEmojiBank('skill'));

        document.querySelectorAll('.emoji-option').forEach(opt => {
            opt.addEventListener('click', (e) => {
                const emoji = e.currentTarget.getAttribute('data-emoji');
                const mode = e.currentTarget.getAttribute('data-mode');
                selectEmoji(emoji, mode);
            });
        });

        // 彈窗繫結
        document.getElementById('btn-open-origin')?.addEventListener('click', () => document.getElementById('modal-origin')?.classList.remove('hidden'));
        document.getElementById('btn-close-origin')?.addEventListener('click', () => document.getElementById('modal-origin')?.classList.add('hidden'));

        document.getElementById('btn-open-guide')?.addEventListener('click', () => document.getElementById('modal-guide')?.classList.remove('hidden'));
        document.getElementById('btn-close-guide')?.addEventListener('click', () => document.getElementById('modal-guide')?.classList.add('hidden'));

        document.getElementById('btn-open-disclaimer')?.addEventListener('click', () => document.getElementById('modal-disclaimer')?.classList.remove('hidden'));
        document.getElementById('btn-close-disclaimer')?.addEventListener('click', () => document.getElementById('modal-disclaimer')?.classList.add('hidden'));

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', (e) => {
                if (e.target === overlay) overlay.classList.add('hidden');
            });
        });
    }

    async function fetchPostsFromSupabase() {
        try {
            const { data, error } = await supabase.from(POSTS_TABLE).select('*').order('created_at', { ascending: false });
            if (error) throw error;
            posts = (data || []).map(post => ({ ...post, timeAgo: calculateTimeAgo(post.created_at) }));
            refreshView();
        } catch (err) { console.error("讀取委託失敗:", err.message); }
    }

    async function fetchSkillsFromSupabase() {
        try {
            const { data, error } = await supabase.from(TABLE_NAME).select('*').order('created_at', { ascending: false });
            if (error) throw error;
            skills = data || [];
            refreshView();
        } catch (err) { console.error("讀取技能名冊失敗:", err.message); }
    }

    function refreshView() { renderPosts(); }

    async function fetchAllUserRecordsFromSupabase() {
        try {
            const { data, error } = await supabase.from('alluser_record').select('*');
            if (error) throw error;
            allUserRecords = data || [];
            refreshView();
        } catch (err) { console.error("讀取用戶紀錄失敗:", err.message); }
    }

    function countAllPoints() {
        const scores = {};
        allUserRecords.forEach(record => {
            if (record.contact) {
                const cleanContact = record.contact.trim();
                scores[cleanContact] = {
                    name: record.name || '神祕鄰里人',
                    points: record.amount || 0
                };
            }
        });
        return scores;
    }

    async function updateUserPointsInSupabase(contact, name, pointChange, email) {
        if (!contact) return;
        const cleanContact = contact.trim();
        const cleanName = (name && name !== '神祕鄰里人') ? name : null;
        const cleanEmail = email ? email.trim() : null;

        try {
            const { data: existing, error: fetchError } = await supabase
                .from('alluser_record')
                .select('*')
                .eq('contact', cleanContact)
                .maybeSingle();

            if (fetchError) throw fetchError;

            if (existing) {
                const newAmount = (existing.amount || 0) + pointChange;
                const updateData = { amount: newAmount };
                if (cleanName) updateData.name = cleanName;
                if (cleanEmail) updateData.email = cleanEmail;

                const { error: updateError } = await supabase
                    .from('alluser_record')
                    .update(updateData)
                    .eq('id', existing.id);

                if (updateError) throw updateError;
            } else {
                const newRecord = {
                    contact: cleanContact,
                    name: cleanName || '神祕鄰里人',
                    amount: pointChange,
                    email: cleanEmail || ''
                };

                const { error: insertError } = await supabase
                    .from('alluser_record')
                    .insert([newRecord]);

                if (insertError) throw insertError;
            }

            await fetchAllUserRecordsFromSupabase();
        } catch (err) {
            console.error("更新用戶積分失敗:", err.message);
            alert("⚠️ 寫入 alluser_record 失敗: " + err.message);
        }
    }

    function queryPersonalPoints() {
        const input = document.getElementById('search-point-input').value.trim();
        if(!input) { alert("請輸入聯絡資訊再查詢喔！"); return; }
        const allScores = countAllPoints();
        const result = allScores[input];
        if(result) {
            alert(`🏮 查詢成功！\n鄰里人：${result.name}\n目前已累積： ${result.points} 點萬事分！\n太棒了，感謝您對客舍的付出！`);
        } else {
            alert(`目前查詢不到「${input}」的得點紀錄。快去接單幫忙賺取第一個萬事分吧！`);
        }
    }

    function switchTab(tabName) {
        currentTab = tabName;
        currentTagFilter = 'all';
        ['tab-active', 'tab-completed', 'tab-skills'].forEach(t => {
            const el = document.getElementById(t);
            if(el) el.className = "tab-btn";
        });
        
        if(tabName === 'active') document.getElementById('tab-active').className = "tab-btn tab-active-orange";
        if(tabName === 'completed') document.getElementById('tab-completed').className = "tab-btn tab-active-orange";
        if(tabName === 'skills') document.getElementById('tab-skills').className = "tab-btn tab-active-orange tab-btn-flex";
        
        const lbSection = document.getElementById('skills-leaderboard-section');
        if (tabName === 'skills') {
            lbSection?.classList.remove('hidden');
            if (isAdmin) {
                document.getElementById('header-skill-btn')?.classList.remove('hidden');
                document.getElementById('header-upload-btn')?.classList.add('hidden');
            }
        } else {
            lbSection?.classList.add('hidden');
            document.getElementById('header-skill-btn')?.classList.add('hidden');
            document.getElementById('header-upload-btn')?.classList.remove('hidden');
        }
        renderPosts();
    }

    function formatHashtags(tagString) {
        if (!tagString || tagString === '/') return '';
        return tagString
            .trim()                        
            .split(/\s+/)                  
            .map(tag => {
                const cleanTag = tag.startsWith('#') ? tag : `#${tag}`;
                return `<span class="tag-click-trigger" data-tag="${cleanTag}" style="cursor: pointer; display: inline-block; margin-right: 4px;">${cleanTag}</span>`;
            }) 
            .join(' ');                    
    }

    function filterByTag(tag) {
        currentTagFilter = tag;
        renderPosts();
    }

    function renderPosts() {
        const container = document.getElementById('posts-container');
        if(!container) return;
        container.innerHTML = '';

        const allScores = countAllPoints();

        if (currentTab === 'skills') {
            const leaderboardTarget = document.getElementById('leaderboard-target');
            if(leaderboardTarget) {
                const sortedHeroes = Object.keys(allScores)
                    .map(k => ({ contact: k, ...allScores[k] }))
                    .sort((a,b) => b.points - a.points)
                    .slice(0, 3);
                
                if(sortedHeroes.length === 0) {
                    leaderboardTarget.innerHTML = `<p class="leaderboard-empty-text">尚無得點紀錄，等待第一位英雄誕生！</p>`;
                } else {
                    const medals = ['🥇', '🥈', '🥉'];
                    leaderboardTarget.innerHTML = sortedHeroes.map((h, i) => `
                        <div class="leaderboard-item" style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="leaderboard-item-info">${medals[i]} <strong>${h.name}</strong> </span>
                            <span class="leaderboard-item-points">🪙 ${h.points} 分</span>
                        </div>
                    `).join('');
                }
            }
        }

        const filterBarContainer = document.getElementById('skill-filter-bar-container');

        if (currentTab === 'skills') {
            if (skills.length === 0) {
                if(filterBarContainer) filterBarContainer.innerHTML = '';
                container.innerHTML = '<p class="container-empty-hint">目前尚無登記鄰里人技能。</p>';
                return;
            }

            let allTagsSet = new Set();
            skills.forEach(skill => {
                if (skill.skilltag) {
                    skill.skilltag.trim().split(/\s+/).forEach(t => allTagsSet.add(t.startsWith('#') ? t : `#${t}`));
                }
                if (skill.learning && skill.learning !== '/') {
                    skill.learning.trim().split(/\s+/).forEach(t => allTagsSet.add(t.startsWith('#') ? t : `#${t}`));
                }
            });

            if(filterBarContainer) {
                filterBarContainer.classList.remove('hidden');
                let filterHtml = `
                    <div style="width: 100%; display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; white-space: nowrap;">
                        <button class="filter-tag-btn" data-tag="all" style="padding: 4px 12px; font-size: 0.75rem; border-radius: 12px; border: 1px solid #ddd; background: ${currentTagFilter === 'all' ? '#333' : '#fff'}; color: ${currentTagFilter === 'all' ? '#fff' : '#333'}; cursor: pointer;">全部</button>
                `;
                allTagsSet.forEach(tag => {
                    const isActive = currentTagFilter === tag;
                    filterHtml += `<button class="filter-tag-btn" data-tag="${tag}" style="padding: 4px 12px; font-size: 0.75rem; border-radius: 12px; border: 1px solid #ddd; background: ${isActive ? '#333' : '#fff'}; color: ${isActive ? '#fff' : '#333'}; cursor: pointer;">${tag}</button>`;
                });
                filterHtml += `</div>`;
                filterBarContainer.innerHTML = filterHtml;
            }

            const filteredSkills = skills.filter(skill => {
                if (currentTagFilter === 'all') return true;
                const tText = (skill.skilltag || '') + ' ' + (skill.learning || '');
                return tText.includes(currentTagFilter.replace('#', ''));
            });

            if (filteredSkills.length === 0) {
                container.innerHTML = '<p class="container-empty-hint">沒有找到符合此標籤的鄰里人。</p>';
                return;
            }

            filteredSkills.forEach(skill => {
                const card = document.createElement('div');
                card.className = "task-card";
                
                const adminTools = isAdmin ? `
                    <div class="card-admin-tools">
                        <button class="btn-card-delete" data-skill-id="${skill.id}" style="border:none; background:none; cursor:pointer;">🗑️</button>
                    </div>` : '';
                
                const myPoint = allScores[skill.contact?.trim()]?.points || 0;

                const formattedTags = formatHashtags(skill.skilltag);
                const formattedLearning = formatHashtags(skill.learning);
     
                const skillTagBadge = skill.skilltag && skill.skilltag !== '/' ? 
                    `<span style="background: #fef3c7; color: #92400e; padding: 2px 6px; border-radius: 4px; font-size: 0.75rem; display: inline-block; margin-top: 0.25rem;">📜 應用中：${formattedTags}</span>` : '';
                const learningBadge = skill.learning && skill.learning !== '/' ? 
                    `<span style="background: #f3f4f6; color: #4b5563; padding: 2px 6px; border-radius: 4px; font-size: 0.75rem; display: inline-block; margin-top: 0.25rem;">📚 研習中：${formattedLearning}</span>` : '';

                card.innerHTML = `
                    <div>
                        <div class="task-card-header">
                            <div class="avatar-circle-stone">${skill.emoji || '🧑‍🎨'}</div>
                            <div style="flex: 1;">
                                <div class="title-with-badge">
                                    <h3 class="task-card-title">${skill.name}</h3> 
                                    <span style="font-size: 0.7rem; color: #c2410c; font-weight: bold;">🪙 ${myPoint} 分</span>
                                </div>
                            </div>
                        </div>
                        ${adminTools}
                        ${skillTagBadge}
                        <br>
                        ${learningBadge}
                    </div>
                    <div class="task-card-footer" style="display: flex; flex-wrap: wrap; gap: 4px; align-items: center;">
                        <p class="task-card-description">${skill.description}</p>
                    </div>
                `;
                container.appendChild(card);
            });
        } else {
            const isCompletedTarget = (currentTab === 'completed');
            
            const baseFilteredPosts = posts.filter(post => {
                const compVal = post.iscompleted !== undefined ? post.iscompleted : post.isCompleted;
                return !!compVal === isCompletedTarget;
            });

            let postTagsSet = new Set();
            baseFilteredPosts.forEach(post => {
                if (post.tasktag) {
                    post.tasktag.trim().split(/\s+/).forEach(t => postTagsSet.add(t.startsWith('#') ? t : `#${t}`));
                }
            });

            if (filterBarContainer && baseFilteredPosts.length > 0) {
                filterBarContainer.classList.remove('hidden');
                let filterHtml = `
                    <div style="width: 100%; display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; white-space: nowrap;">
                        <button class="filter-tag-btn" data-tag="all" style="padding: 4px 12px; font-size: 0.75rem; border-radius: 12px; border: 1px solid #ddd; background: ${currentTagFilter === 'all' ? '#333' : '#fff'}; color: ${currentTagFilter === 'all' ? '#fff' : '#333'}; cursor: pointer;">全部</button>
                `;
                postTagsSet.forEach(tag => {
                    const isActive = currentTagFilter === tag;
                    filterHtml += `<button class="filter-tag-btn" data-tag="${tag}" style="padding: 4px 12px; font-size: 0.75rem; border-radius: 12px; border: 1px solid #ddd; background: ${isActive ? '#333' : '#fff'}; color: ${isActive ? '#fff' : '#333'}; cursor: pointer;">${tag}</button>`;
                });
                filterHtml += `</div>`;
                filterBarContainer.innerHTML = filterHtml;
            } else if (filterBarContainer) {
                filterBarContainer.classList.add('hidden');
            }

            const filteredPosts = baseFilteredPosts.filter(post => {
                if (currentTagFilter === 'all') return true;
                const tText = post.tasktag || '';
                return tText.includes(currentTagFilter.replace('#', ''));
            });

            if (filteredPosts.length === 0) {
                container.innerHTML = '<p class="container-empty-hint" style="font-size: 0.75rem; color: #888;">此分類目前沒有符合此標籤的委託案件。</p>';
                return;
            }

            filteredPosts.forEach(post => {
                const hList = post.heroeslist || [];
                const count = hList.length;
                const card = document.createElement('div');
                
                const cEmoji = post.clientemoji || '🙋‍♂️';
                const tTitle = post.tasktitle || '';
                const cName = post.clientname || '';
                const tTag = formatHashtags(post.tasktag);
                const tDetails = post.taskdetails || '';
                const rwd = post.reward || '';
                const isComp = post.iscompleted !== undefined ? post.iscompleted : post.isCompleted;

                card.className = "task-card clickable-group card-post-item";
                card.setAttribute('data-post-id', post.id);

                let adminActionHtml = '';
                if (isAdmin) {
                    adminActionHtml += `<button class="btn-card-delete" data-delete-post-id="${post.id}" style="border:none; background:none; cursor:pointer;">🗑️</button>`;
                }

                card.innerHTML = `
                    <div>
                        <div class="task-card-header">
                            <div class="avatar-circle-orange">${cEmoji}</div>
                            <div style="flex: 1; min-width: 0;">
                                <h3 class="task-card-title text-ellipsis-2line">${tTitle}</h3>
                                <p class="task-card-subtitle">委託人：${cName} • ${count}人已接單</p>
                            </div>
                        </div>
                        <div class="card-admin-tools">${adminActionHtml}</div>
                        <div style="margin-bottom: 0.25rem;">
                            <span class="tag-orange">${tTag}</span>
                        </div>
                        <p class="task-card-description text-ellipsis-5line">${tDetails}</p>
                    </div>
                    <div class="task-card-footer">
                        <div class="reward-info-text">
                            <span class="reward-highlight">💰 報酬：${rwd}</span> • <span>${post.timeAgo}</span>
                        </div>
                        ${isComp 
                            ? `<span class="badge-status-success">
                                <span class="status-success-title">圓滿解決 🏮</span>
                                <span class="status-success-subtitle">貢獻者: ${post.completed_by_name || '無'}</span>
                               </span>`
                            : `<button class="btn-base btn-orange btn-join-action" data-join-post-id="${post.id}">接受委託</button>`
                        }
                    </div>
                `;
                container.appendChild(card);
            });
        }

        bindDynamicElementEvents();
        setTimeout(() => { if (window.lucide) lucide.createIcons(); }, 100);

        document.querySelectorAll('.card-post-item').forEach(card => {
            card.addEventListener('click', (e) => {
                if (e.target.closest('button') || e.target.closest('a') || e.target.closest('.tag-click-trigger')) {
                    return;
                }
                const postId = card.getAttribute('data-post-id');
                if (postId) {
                    window.location.href = `/posts/${postId}`;
                }
            });
        });
    }

    function bindDynamicElementEvents() {
        document.querySelectorAll('.tag-click-trigger').forEach(el => {
            el.onclick = (e) => {
                e.stopPropagation();
                filterByTag(e.currentTarget.getAttribute('data-tag'));
            };
        });

        document.querySelectorAll('.filter-tag-btn').forEach(btn => {
            btn.onclick = (e) => {
                filterByTag(e.currentTarget.getAttribute('data-tag'));
            };
        });

        document.querySelectorAll('.btn-join-action').forEach(btn => {
            btn.onclick = (e) => {
                e.stopPropagation();
                openJoinModal(e.currentTarget.getAttribute('data-join-post-id'));
            };
        });

        document.querySelectorAll('[data-skill-id]').forEach(btn => {
            btn.onclick = (e) => {
                deleteSkill(e.currentTarget.getAttribute('data-skill-id'));
            };
        });

        document.querySelectorAll('[data-delete-post-id]').forEach(btn => {
            btn.onclick = (e) => {
                deletePost(e.currentTarget.getAttribute('data-delete-post-id'));
            };
        });
    }

    async function handleJoinSubmit(event) {
        event.preventDefault();
        const postId = document.getElementById('join-post-id').value;
        const newHero = {
            name: document.getElementById('join-name').value.trim(),
            contact: document.getElementById('join-ig').value.trim()
        };

        const post = posts.find(p => String(p.id) === String(postId));
        if (!post) return;

        const updatedHeroes = [...(post.heroeslist || []), newHero];

        try {
            const { error } = await supabase.from(POSTS_TABLE).update({ heroeslist: updatedHeroes }).eq('id', postId);
            if (error) throw error;

            if (post.clientemail) {
                try {
                    await fetch('/api/send-email', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            toEmail: post.clientemail,
                            toName: post.clientname || "任務發起人",
                            taskTitle: post.tasktitle || post.title || "鄰里任務",
                            heroName: newHero.name,
                            heroContact: newHero.contact
                        })
                    });
                } catch (emailErr) {
                    console.error("背景發信失敗：", emailErr);
                }
            }

            closeJoinModal();
            await fetchPostsFromSupabase();
            alert("🎉 恭喜！您已成功接單，已自動發送通知信給發布者！");
        } catch (err) { 
            alert("接受委託失敗: " + err.message); 
        }
    }

    async function handleFormSubmit(event) {
        event.preventDefault();
        
        const clientContact = document.getElementById('clientContactInput').value.trim();
        const clientName = document.getElementById('clientNameInput').value.trim();
        const clientEmail = document.getElementById('clientEmailInput').value.trim();
        
        const allScores = countAllPoints();
        const userScore = allScores[clientContact]?.points || 0;
        
        if (userScore <= -2) {
            alert(`⚠️ 您的萬事分目前為 ${userScore} 分。每個聯絡方式最多負 2 點萬事分，請先幫手完成其他委託賺取積分，再來發布新委託！`);
            return;
        }

        const rawTagInput = document.getElementById('taskTagInput').value.trim();
        const formattedTaskTag = rawTagInput
            ? rawTagInput.split(/\s+/).map(t => (t.startsWith('#') ? t : `#${t}`)).join(' ')
            : '#一般委託';

        const bgColors = ['bg-amber-50', 'bg-orange-50', 'bg-yellow-50', 'bg-stone-100'];
        const newPost = {
            tasktitle: document.getElementById('taskTitleInput').value.trim(), 
            clientname: clientName || '神祕鄰里人',
            clientcontact: clientContact,
            tasktag: formattedTaskTag,
            taskdetails: document.getElementById('taskDetailsInput').value.trim(),
            reward: document.getElementById('rewardInput').value.trim(),
            clientemoji: document.getElementById('selected-emoji').value,
            cardbgcolor: bgColors[Math.floor(Math.random() * bgColors.length)],
            iscompleted: false,
            heroeslist: [],
            password: document.getElementById('postPasswordInput').value.trim(),
            clientemail: clientEmail
        };

        try {
            const { error } = await supabase.from(POSTS_TABLE).insert([newPost]);
            if (error) throw error;

            await updateUserPointsInSupabase(clientContact, clientName, -1, clientEmail);

            closeUploadModal();
            setupRandomDefaultAvatar();
            await fetchPostsFromSupabase();

            alert(`✨ 委託發布成功！已為您扣除 1 點萬事分（您目前的萬事分為 ${userScore - 1} 分）。`);
        } catch (err) { 
            alert("發布新委託失敗: " + err.message); 
        }
    }

    async function handleSkillSubmit(event) {
        event.preventDefault();
        
        const data = {
            name: document.getElementById('skillNameInput').value.trim(),
            skilltag: document.getElementById('skillTagInput').value.trim(),
            learning: document.getElementById('skillLearningInput').value.trim(),
            contact: document.getElementById('skillContactInput').value.trim(),
            description: document.getElementById('skillDescInput').value.trim(),
            emoji: document.getElementById('skill-selected-emoji').value.trim(),
            email: document.getElementById('skillEmailInput').value
        };

        if (!data.name || !data.contact) {
            alert("請填寫您的稱呼與聯絡管道！");
            return;
        }

        try {
            const { error } = await supabase.from(TABLE_NAME).insert([data]);
            if (error) throw error;
            
            await updateUserPointsInSupabase(data.contact, data.name, +1, data.email);

            closeSkillModal();
            await fetchSkillsFromSupabase();
            await fetchAllUserRecordsFromSupabase();

            alert(`✨ 成功登記技能名冊！已同步您的資料並為您增加 1 點萬事分！`);
        } catch (err) { 
            alert("儲存技能失敗: " + err.message); 
        }
    }

    async function deletePost(postId) { 
        if (confirm("確定要從資料庫中永久刪除此委託嗎？")) { 
            try {
                const { error } = await supabase.from(POSTS_TABLE).delete().eq('id', postId);
                if (error) throw error;
                await fetchPostsFromSupabase();
            } catch (err) { alert("刪除委託失敗: " + err.message); }
        } 
    }

    async function deleteSkill(skillId) { 
        if (confirm("確定要移除此鄰里人技能檔案嗎？")) { 
            try {
                const { error } = await supabase.from(TABLE_NAME).delete().eq('id', skillId);
                if (error) throw error;
                await fetchSkillsFromSupabase();
            } catch (err) { alert("移除技能失敗: " + err.message); }
        } 
    }

    function toggleEmojiBank(mode) { 
        document.getElementById(mode === 'post' ? 'emoji-bank-post' : 'emoji-bank-skill').classList.toggle('hidden'); 
    }

    function selectEmoji(emoji, mode) {
        if (mode === 'post') {
            document.getElementById('selected-emoji').value = emoji;
            document.getElementById('current-avatar-preview').innerText = emoji;
        } else {
            document.getElementById('skill-selected-emoji').value = emoji;
            document.getElementById('skill-avatar-preview').innerText = emoji;
        }
        toggleEmojiBank(mode);
    }

    function setupRandomDefaultAvatar() {
        const initialEmojis = ['🙋‍♂️', '🙋‍♀️', '🧑‍💻', '👩‍🎨', '🐱', '🦊'];
        const randomEmoji = initialEmojis[Math.floor(Math.random() * initialEmojis.length)];
        if(document.getElementById('selected-emoji')) document.getElementById('selected-emoji').value = randomEmoji;
        if(document.getElementById('current-avatar-preview')) document.getElementById('current-avatar-preview').innerText = randomEmoji;
    }
    
    function toggleAdminNavbar() { 
        document.getElementById('admin-navbar')?.classList.toggle('hidden'); 
    }

    function updateAdminUI() {
        const globalBadge = document.getElementById('global-admin-badge');
        const adminNavbar = document.getElementById('admin-navbar');

        if (isAdmin) { 
            globalBadge?.classList.remove('hidden'); 
        } else { 
            globalBadge?.classList.add('hidden'); 
            adminNavbar?.classList.add('hidden');
        }
    }
    
    function openJoinModal(postId) { document.getElementById('join-post-id').value = postId; document.getElementById('join-modal').classList.remove('hidden'); }
    function closeJoinModal() { document.getElementById('join-modal').classList.add('hidden'); document.getElementById('join-form').reset(); }
    function openUploadModal() { document.getElementById('upload-modal').classList.remove('hidden'); }
    function closeUploadModal() { document.getElementById('post-form').reset(); document.getElementById('upload-modal').classList.add('hidden'); }
    function openSkillModal() { document.getElementById('skill-modal').classList.remove('hidden'); }
    function closeSkillModal() { document.getElementById('skill-form').reset(); document.getElementById('skill-modal').classList.add('hidden'); }

    function calculateTimeAgo(timestamp) {
        if (!timestamp) return "剛剛";
        const diffMs = new Date() - new Date(timestamp);
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMins / 60);
        const diffDays = Math.floor(diffHours / 24);
        if (diffMins < 1) return "剛剛";
        if (diffMins < 60) return `${diffMins} 分鐘前`;
        if (diffHours < 24) return `${diffHours} 小時前`;
        return `${diffDays} 天前`;
    }

    async function adminAdjustPoints(change) {
        if (!isAdmin) {
            alert("🔒 只有管理員可以調整萬事分！");
            return;
        }

        const contact = document.getElementById('admin-target-contact').value.trim();
        const name = document.getElementById('admin-target-name').value.trim();

        if (!contact) {
            alert("請輸入目標聯絡方式 (IG/電話)！");
            return;
        }

        try {
            await updateUserPointsInSupabase(contact, name, change);
            alert(`✅ 成功為【${contact}】${change > 0 ? '增加' : '扣除'} 1 點萬事分！`);
            document.getElementById('admin-target-contact').value = '';
            document.getElementById('admin-target-name').value = '';
        } catch (err) {
            alert("調整萬事分失敗: " + err.message);
        }
    }
</script>
</BaseLayout>