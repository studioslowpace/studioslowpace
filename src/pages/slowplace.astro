      uniqueItemsMap.forEach((item, label) => {
        const isTable = item.type === 'table';
        html += `
          <div style="display:flex; gap:10px; align-items:center; background:var(--bg-input); border:1px solid var(--border-color); padding:8px 10px; border-radius:12px; margin-bottom:6px;">
