---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 自由佈置空間">
  <!-- 1. 登入與身份選擇 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 身份登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">午後的長沙灣天空湛藍。請選擇你的分身造型、稱號與客舍身份：</p>
        
        <div class="avatar-selector-label">選擇分身造型：</div>
        <div class="avatar-selector-group">
          <label class="avatar-card">
            <input type="radio" name="player-avatar" value="/assets/player1.png" checked />
            <img src="/assets/player1.png" alt="P1" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="avatar-fallback" style="display:none;">👤 P1</span>
            <span class="avatar-name">分身一號</span>
          </label>
          <label class="avatar-card">
            <input type="radio" name="player-avatar" value="/assets/player2.png" />
            <img src="/assets/player2.png" alt="P2" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="avatar-fallback" style="display:none;">👤 P2</span>
            <span class="avatar-name">分身二號</span>
          </label>
        </div>

        <input type="text" id="rpg-name-input" placeholder="輸入你的獨一無二稱號" maxlength="12" autofocus />
        
        <div class="avatar-selector-label">選擇身份階層：</div>
        <select id="rpg-tier-select" class="theme-select-dropdown" style="width:100%; padding:10px; margin-bottom:12px; border-radius:8px;">
          <option value="鄰里人">🌱 鄰里人 (一般書友)</option>
          <option value="客舍人">☕ 客舍人 (常駐會員)</option>
          <option value="空間友">🤝 空間友 (共創夥伴)</option>
          <option value="店主">👑 店主 (擁有完全自由佈置與新增傢俱權限)</option>
        </select>

        <div class="role-selector-group">
          <label class="role-chip"><input type="radio" name="user-role" value="晴空選書" checked /> ☁️ 晴空選書</label>
          <label class="role-chip"><input type="radio" name="user-role" value="散文漫遊" /> 🍃 散文漫遊</label>
          <label class="role-chip"><input type="radio" name="user-role" value="靜心寫作" /> ✍️ 靜心寫作</label>
        </div>

        <button id="rpg-start-btn" class="rpg-btn">▶ 進入客舍空間</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座與詳細閱讀設定 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 閱讀與專心設定 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處安坐。請輸入詳細的閱讀進度與筆記：</p>
        <input type="text" id="rpg-book-input" placeholder="書名（例：《希臘語課》）" maxlength="25" style="margin-bottom:6px;" />
        <input type="text" id="rpg-author-input" placeholder="作者名" maxlength="20" style="margin-bottom:6px;" />
        <div style="display:flex; gap:6px; margin-bottom:6px;">
          <input type="number" id="rpg-current-page" placeholder="目前頁數" min="0" max="9999" style="flex:1; margin-bottom:0;" />
          <input type="number" id="rpg-total-page" placeholder="總頁數" min="1" max="9999" style="flex:1; margin-bottom:0;" />
        </div>
        <textarea id="rpg-quote-input" placeholder="書摘句子..." style="width:100%; height:45px; background:var(--bg-main); color:#f8fafc; border:1px solid var(--border-color); border-radius:6px; padding:6px; font-size:11px; resize:none; outline:none; box-sizing:border-box; margin-bottom:6px;"></textarea>
        <textarea id="rpg-review-input" placeholder="讀後感與心得..." style="width:100%; height:55px; background:var(--bg-main); color:#f8fafc; border:1px solid var(--border-color); border-radius:6px; padding:6px; font-size:11px; resize:none; outline:none; box-sizing:border-box; margin-bottom:10px;"></textarea>
        
        <div class="rpg-btn-group">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">☁️ 開啟專心 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 圖書館藏 Modal -->
  <div id="library-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>📚 客舍館藏書單 (Library)</span>
        <button id="library-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe src="/library" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- 4. 共讀桌 Modal -->
  <div id="table-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span id="table-modal-title">📖 共讀桌活動</span></div>
      <div class="rpg-content">
        <div id="table-form-view" style="display:none;">
          <p class="rpg-text">此桌目前為空桌，由你來發起一場新的共讀活動：</p>
          <input type="text" id="table-book" placeholder="共讀書名" style="margin-bottom:6px;" />
          <input type="text" id="table-author" placeholder="作者" style="margin-bottom:6px;" />
          <div style="font-size:11px; color:#94a3b8; margin-bottom:4px;">限制參加人數：</div>
          <input type="number" id="table-max" value="3" min="1" max="10" style="margin-bottom:6px;" />
          <div style="font-size:11px; color:#94a3b8; margin-bottom:4px;">預定完讀日期：</div>
          <input type="date" id="table-date" style="width:100%; background:var(--bg-main); border:1px solid var(--border-color); color:#fff; padding:8px; border-radius:8px; margin-bottom:12px;" />
          <div class="rpg-btn-group">
            <button id="table-cancel-btn" class="rpg-btn-ghost">取消</button>
            <button id="table-create-btn" class="rpg-btn">✨ 發起共讀</button>
          </div>
        </div>

        <div id="table-info-view">
          <div id="table-details" style="font-size:12px; line-height:1.6; color:#f8fafc; margin-bottom:12px;"></div>
          <div class="rpg-btn-group" style="flex-direction:column; gap:6px;">
            <button id="table-join-btn" class="rpg-btn" style="background:#10b981;">🤝 加入共讀</button>
            <button id="table-end-btn" class="rpg-btn" style="background:#ef4444; display:none;">🛑 結束共讀</button>
            <button id="table-info-close" class="rpg-btn-ghost">關閉</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. 🆕 新增自訂傢俱 Modal (店主專用) -->
  <div id="custom-furniture-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>🛠️ 新增自訂空間傢俱</span></div>
      <div class="rpg-content">
        <p class="rpg-text">店主可在這裡新增全新的傢俱種類（例如盆栽、燈飾等）：</p>
        <input type="text" id="cf-name" placeholder="傢俱名稱（例：綠意盆栽）" maxlength="12" style="margin-bottom:8px;" />
        <input type="text" id="cf-img" placeholder="圖片路徑（例：/assets/plant.png）" style="margin-bottom:8px;" />
        <div style="display:flex; gap:6px; margin-bottom:8px;">
          <input type="number" id="cf-w" placeholder="寬度 (格)" value="1" min="1" max="4" style="flex:1; margin-bottom:0;" />
          <input type="number" id="cf-h" placeholder="高度 (格)" value="1" min="1" max="4" style="flex:1; margin-bottom:0;" />
        </div>
        <div class="rpg-btn-group" style="margin-top:12px;">
          <button id="cf-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="cf-confirm-btn" class="rpg-btn">✨ 新增至工具列</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. 閱讀記錄詳情 Modal -->
  <div id="log-detail-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 360px;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="detail-title">📖 記錄詳情</span>
        <button id="detail-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="rpg-content">
        <div id="detail-content" style="font-size:12px; line-height:1.6; color:#f8fafc; word-break:break-all;"></div>
      </div>
    </div>
  </div>

  <!-- 7. 查看其他玩家閱讀記錄 Modal -->
  <div id="peer-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 360px; max-height: 80vh; display: flex; flex-direction: column;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="peer-modal-title">👤 書友的閱讀記錄</span>
        <button id="peer-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="rpg-content" id="peer-content-box" style="overflow-y: auto; flex: 1; font-size: 12px;"></div>
    </div>
  </div>

  <!-- 主介面 -->
  <div class="app-viewport">
    <main class="rpg-container">
      <header class="rpg-hud">
        <div class="hud-top-row">
          <span class="hud-brand">☁️ 空間客舍 (自由佈置)</span>
          <div class="hud-right">
            <span class="online-indicator">🟢 在線: <strong id="online-count">1</strong></span>
            <span class="user-tag" id="hud-tier-tag">🌱 鄰里人</span>
            <strong id="hud-name" style="color: var(--accent-light, #e0f2fe);">旅人</strong>
            <button id="logout-btn" class="rpg-btn-sm" style="background:#ef4444; color:#fff; border:none;">🚪 登出</button>
          </div>
        </div>

        <div class="hud-mid-row">
          <div class="channel-tabs">
            <button class="channel-tab active" data-room="study">📖 自修室</button>
            <button class="channel-tab" data-room="chat">☕ 書話間</button>
            <button class="channel-tab" data-room="salon">🏛️ 沙龍</button>
          </div>
          <div class="theme-picker">
            <select id="theme-select" class="theme-select-dropdown">
              <option value="blue">☁️ 晴空藍</option>
              <option value="green">🍃 森林綠</option>
              <option value="purple">🔮 暮光紫</option>
            </select>
          </div>
        </div>
      </header>

      <div class="canvas-wrapper">
        <canvas id="rpg-canvas" width="384" height="384"></canvas>
      </div>

      <section class="split-panel">
        <div class="panel-tabs-bar">
          <button class="panel-tab-btn active" data-tab="chat">💬 聊天交誼廳</button>
          <button class="panel-tab-btn" data-tab="logs">📚 我的閱讀記錄</button>
        </div>

        <div id="pane-chat" class="pane-content active">
          <div class="chat-header-sub">
            <span id="chat-mode-indicator" class="chat-mode-tag">📢 公開發言中</span>
            <button id="switch-public-btn" class="rpg-btn-sm" style="display:none; font-size:9px;">切換公開</button>
          </div>
          <div id="chat-messages" class="chat-messages-box">
            <div class="chat-welcome">✨ 點擊線上玩家頭像可檢視閱讀記錄或私訊！</div>
          </div>
          <form id="chat-form" class="chat-input-row">
            <input type="text" id="chat-input" placeholder="說點什麼..." maxlength="80" autocomplete="off" />
            <button type="submit" class="chat-send-btn">發送</button>
          </form>
        </div>

        <div id="pane-logs" class="pane-content" style="display:none;">
          <div class="logs-header-sub">
            <span>📖 個人閱讀清單與書摘</span>
            <button id="log-quick-add-btn" class="rpg-btn-sm" style="background:var(--accent-hover); color:#fff;">➕ 新增記錄</button>
          </div>
          <div id="log-list-container" class="logs-list-box"></div>
        </div>
      </section>

      <!-- 底部操作列與按鈕 (含新增傢俱按鈕) -->
      <footer class="rpg-footer">
        <div id="build-palette" class="build-palette" style="display:none; flex-wrap: wrap; gap: 4px;">
          <button class="tool-btn active" data-tool="move">🚶 移動</button>
          <button class="tool-btn" data-tool="seat">🪑 木椅</button>
          <button class="tool-btn" data-tool="shelf">📚 書架</button>
          <button class="tool-btn" data-tool="table">🪵 共讀桌</button>
          <!-- 動態自訂傢俱會顯示在這裡 -->
          <div id="custom-tools-container" style="display:inline-flex; gap:4px;"></div>
          <button id="open-cf-modal-btn" class="rpg-btn-sm" style="background:var(--accent-hover); color:#fff; font-size:10px;">➕ 新傢俱</button>
        </div>
        <div id="default-palette" class="build-palette">
          <button class="tool-btn active" data-tool="move">🚶 移動模式</button>
        </div>

        <div class="action-dock">
          <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background: var(--accent-color, #38bdf8); color:#0f172a; font-weight:bold;">🚶 起立</button>
        </div>
      </footer>
    </main>
  </div>

  <style is:global>
    :root {
      --bg-main: #0f172a;
      --bg-card: #1e293b;
      --border-color: #334155;
      --accent-color: #38bdf8;
      --accent-hover: #0284c7;
      --accent-light: #e0f2fe;
    }

    [data-theme="green"] {
      --bg-main: #064e3b;
      --bg-card: #065f46;
      --border-color: #047857;
      --accent-color: #34d399;
      --accent-hover: #059669;
      --accent-light: #d1fae5;
    }

    [data-theme="purple"] {
      --bg-main: #3b0764;
      --bg-card: #581c87;
      --border-color: #7e22ce;
      --accent-color: #c084fc;
      --accent-hover: #9333ea;
      --accent-light: #f3e8ff;
    }

    * { -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; user-select: none; }

    html, body {
      background-color: #020617;
      color: #cbd5e1;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0; padding: 0; width: 100vw; height: 100vh; height: 100dvh; overflow: hidden; touch-action: manipulation;
    }

    .app-viewport { width: 100vw; height: 100vh; height: 100dvh; display: flex; justify-content: center; align-items: center; background: #020617; }
    .rpg-container {
      width: 100vw; max-width: 414px; height: 100vh; height: 100dvh;
      display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; box-sizing: border-box;
      background-color: var(--bg-main); border-left: 1px solid var(--border-color); border-right: 1px solid var(--border-color);
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.8); transition: background-color 0.3s ease;
    }

    .rpg-modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .rpg-window { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; width: 90%; max-width: 360px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
    
    .embed-window { max-width: 390px; height: 80vh; display: flex; flex-direction: column; overflow: hidden; }
    .embed-frame-wrapper { flex: 1; width: 100%; background: #ffffff; }
    .embed-iframe { width: 100%; height: 100%; border: none; }

    .split-panel { flex: 0 0 28vh; display: flex; flex-direction: column; background: var(--bg-card); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); min-height: 0; }
    .panel-tabs-bar { display: flex; background: var(--bg-main); border-bottom: 1px solid var(--border-color); flex-shrink: 0; }
    .panel-tab-btn { flex: 1; background: transparent; border: none; color: #94a3b8; padding: 6px; font-size: 11px; cursor: pointer; font-weight: 500; text-align: center; }
    .panel-tab-btn.active { color: var(--accent-color); background: var(--bg-card); border-bottom: 2px solid var(--accent-color); }

    .pane-content { flex: 1; display: flex; flex-direction: column; padding: 6px 10px; min-height: 0; overflow: hidden; }
    .pane-content.active { display: flex; }

    .chat-header-sub { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 10px; flex-shrink: 0; }
    .chat-mode-tag { color: var(--accent-color); font-weight: bold; }
    .chat-messages-box { flex: 1; padding: 4px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; font-size: 11px; background: var(--bg-main); border-radius: 6px; border: 1px solid var(--border-color); margin-bottom: 4px; }
    .chat-welcome { color: #94a3b8; text-align: center; font-size: 10px; padding: 2px; }
    .chat-msg { background: var(--bg-card); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border-color); word-break: break-all; line-height: 1.4; }
    .chat-msg.pm { background: rgba(192, 132, 252, 0.15); border-color: #c084fc; }
    .chat-msg-author { color: var(--accent-color); font-weight: bold; margin-right: 4px; cursor: pointer; }
    .chat-msg-text { color: #f8fafc; }
    .chat-input-row { display: flex; gap: 6px; flex-shrink: 0; }
    .chat-input-row input { flex: 1; background: var(--bg-main); border: 1px solid var(--border-color); color: #f8fafc; padding: 6px 8px; font-size: 11px; border-radius: 4px; outline: none; }
    .chat-send-btn { background: var(--accent-hover); color: #f8fafc; border: none; padding: 0 10px; font-size: 11px; border-radius: 4px; cursor: pointer; font-weight: 500; }

    .logs-header-sub { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 11px; color: #94a3b8; font-weight: bold; flex-shrink: 0; }
    .logs-list-box { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }

    .rpg-title-bar { background: var(--bg-main); color: var(--accent-color); padding: 12px 16px; font-size: 13px; font-weight: 500; border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom: 1px solid var(--border-color); }
    .rpg-content { padding: 18px; }
    .rpg-text { font-size: 13px; color: #94a3b8; margin-bottom: 14px; line-height: 1.5; }
    
    .avatar-selector-label { font-size: 12px; color: #94a3b8; margin-bottom: 6px; }
    .avatar-selector-group { display: flex; gap: 10px; margin-bottom: 14px; }
    .avatar-card { flex: 1; background: var(--bg-main); border: 2px solid var(--border-color); border-radius: 8px; padding: 8px; text-align: center; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .avatar-card input { display: none; }
    .avatar-card input:checked + img, .avatar-card input:checked ~ .avatar-fallback { border-color: var(--accent-color); }
    .avatar-card input:checked ~ .avatar-name { color: var(--accent-color); font-weight: bold; }
    .avatar-card img { width: 40px; height: 40px; object-fit: contain; image-rendering: pixelated; border-radius: 4px; background: var(--bg-card); padding: 2px; }
    .avatar-fallback { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--bg-card); border-radius: 4px; font-size: 12px; color: var(--accent-color); }
    .avatar-name { font-size: 11px; color: #cbd5e1; }

    .rpg-window input[type="text"], .rpg-window input[type="number"] { width: 100%; background: var(--bg-main); border: 1px solid var(--border-color); color: #f8fafc; padding: 10px; font-size: 13px; box-sizing: border-box; margin-bottom: 12px; outline: none; border-radius: 8px; }
    .role-selector-group { display: flex; gap: 6px; margin-bottom: 14px; }
    .role-chip { background: var(--bg-main); border: 1px solid var(--border-color); padding: 6px 10px; border-radius: 16px; font-size: 11px; cursor: pointer; color: #cbd5e1; }
    .role-chip input { margin-right: 4px; accent-color: var(--accent-color); }
    .rpg-btn { background: var(--accent-hover); color: #f8fafc; border: none; padding: 10px; font-size: 13px; cursor: pointer; width: 100%; font-weight: 500; border-radius: 8px; }
    .rpg-btn-ghost { background: transparent; color: #94a3b8; border: 1px solid var(--border-color); padding: 10px; font-size: 13px; cursor: pointer; width: 100%; border-radius: 8px; }
    .rpg-btn-group { display: flex; gap: 8px; }

    .rpg-hud { background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 6px 10px; font-size: 12px; flex-shrink: 0; }
    .hud-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
    .hud-brand { font-weight: 600; color: var(--accent-color); }
    .hud-right { display: flex; align-items: center; gap: 6px; }
    .online-indicator { color: #34d399; }
    .user-tag { background: var(--bg-main); border: 1px solid var(--border-color); padding: 2px 6px; border-radius: 8px; font-size: 10px; color: var(--accent-color); }
    
