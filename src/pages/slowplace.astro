    canvas?.addEventListener('click', async (e) => {
      if (isDND) return;

      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      const tileSize = canvas.width / currentGridSize;
      const targetGx = Math.floor(clickX / tileSize);
      const targetGy = Math.floor(clickY / tileSize);

      const hitPlayer = getPlayerAtCell(targetGx, targetGy);
      if (hitPlayer) {
        activePlayerCardData = hitPlayer;
        if (pcName) pcName.textContent = hitPlayer.name;
        if (pcTier) pcTier.textContent = hitPlayer.tier === '鄰里人' ? '🌱 鄰里人' : '☁️ 訪客';
        if (pcAvatar) pcAvatar.src = hitPlayer.avatar || '/assets/player1.png';

        let currentReadingBookText = '目前未在木椅閱讀';
        const seatedItem = roomItems.find(item => item.type === 'seat' && item.host_id === hitPlayer.user_id);
        if (seatedItem && seatedItem.book_title) {
          currentReadingBookText = `《${seatedItem.book_title}》`;
        }

        let participatingTableText = '目前未參與共讀';
        const tableItem = roomItems.find(item => item.type === 'table' && item.members && item.members.some((m: any) => m.user_id === hitPlayer.user_id));
        if (tableItem && tableItem.book_title) {
          participatingTableText = `《${tableItem.book_title}》 (${tableItem.author || '佚名'})`;
        }

        if (pcCurrentBook) pcCurrentBook.textContent = currentReadingBookText;
        if (pcTableBook) pcTableBook.textContent = participatingTableText;

        if (playerCardModal) playerCardModal.style.display = 'flex';
        return;
      }

      if (currentTool === 'delete') {
        if (!isAdmin) { alert('只有店主才能刪除物件！'); return; }
        const hitItem = roomItems.find(item => targetGx >= item.gx && targetGx < item.gx + (item.w || 1) && targetGy >= item.gy && targetGy < item.gy + (item.h || 1));
        if (hitItem) {
          if (confirm(`確定要從畫布中刪除「${hitItem.label}」嗎？`)) {
            await supabase.from(ITEMS_TABLE).delete().eq('id', hitItem.id);
            await fetchRoomItems();
          }
        } else {
          alert('該處沒有可刪除的物件');
        }
        return;
      }

      if (currentTool !== 'move') {
        if (!isAdmin) { alert('只有店主（具備管理員權限）才能進行空間佈置！'); return; }

        if (isCellSolidBlocked(targetGx, targetGy)) {
          alert('該位置已有物件或無法放置！');
          return;
        }

        let itemType = currentTool;
        let itemLabel = currentTool;
        let imgSrc = '';
        let link = '';
        let openType = 'current';
        let description = '';
        let w = 1;
        let h = 1;

        if (currentTool === 'seat') {
          itemLabel = '木椅';
          imgSrc = '/assets/seat.png';
          description = '供旅人安坐專心的木椅';
        } else if (currentTool === 'shelf') {
          itemLabel = '書架';
          imgSrc = '/assets/shelf.png';
          description = '收藏客舍館藏書單的書架';
          link = '/library';
          openType = 'modal';
        } else if (currentTool === 'table') {
          itemLabel = '共讀桌';
          imgSrc = '/assets/table.png';
          description = '供多人共讀交流的共讀桌';
          w = 2; h = 2;
        } else {
          const customItem = roomItems.find(ri => ri.type === currentTool);
          if (customItem) {
            itemLabel = customItem.label;
            imgSrc = customItem.img_src;
            link = customItem.link;
            openType = customItem.open_type;
            description = customItem.description;
            w = customItem.w || 1;
            h = customItem.h || 1;
          }
        }

        const { error } = await supabase.from(ITEMS_TABLE).insert([{
          room: currentRoom,
          type: itemType,
          label: itemLabel,
          img_src: imgSrc,
          link: link,
          open_type: openType,
          description: description,
          gx: targetGx,
          gy: targetGy,
          w: w,
          h: h,
          book_title: itemType === 'table' || itemType === 'seat' ? '' : null,
          author: '',
          max_members: 3,
          members: []
        }]);

        if (error) {
          console.error('放置物件失敗:', error);
          alert('放置物件失敗，請稍後再試');
        } else {
          await fetchRoomItems();
        }
        return;
      }

      if (currentTool === 'move') {
        const hitItem = roomItems.find(item => targetGx >= item.gx && targetGx < item.gx + (item.w || 1) && targetGy >= item.gy && targetGy < item.gy + (item.h || 1));
        
        if (hitItem) {
          if (hitItem.type === 'seat') {
            if (isGuest) {
              alert('訪客無法使用木椅閱讀功能，請註冊或登入完整會員！');
              return;
            }
            activeSeatData = hitItem;
            playerGx = hitItem.gx;
            playerGy = hitItem.gy;
            await syncMyStateToDB();

            if (hitItem.host_id && hitItem.host_id !== '' && hitItem.host_id !== userId) {
              if (seatModalTitle) seatModalTitle.textContent = '🪑 木椅閱讀角';
              if (seatFormView) seatFormView.style.display = 'none';
              if (seatInfoView) seatInfoView.style.display = 'block';
              if (seatUpdateView) seatUpdateView.style.display = 'none';
              if (seatDetails) {
                const cur = hitItem.current_page || 1;
                const tot = hitItem.total_pages || 100;
                const pct = tot > 0 ? Math.round((cur / tot) * 100) : 0;
                seatDetails.innerHTML = `
                  <p style="color:var(--danger-color); font-weight:bold;">此座位目前已有旅人入座，無法乘坐！</p>
                  <p><strong>坐下讀者：</strong>${hitItem.host_name || '某位旅人'}</p>
                  <p><strong>正在閱讀：</strong>《${hitItem.book_title || '沈思中'}》</p>
                  <p><strong>閱讀進度：</strong>第 ${cur} / ${tot} 頁 (${pct}%)</p>
                `;
              }
              if (seatModal) seatModal.style.display = 'flex';
              return;
            }

            if (!hitItem.host_id || hitItem.host_id === '') {
              await fetchUserReadingRecords();
              currentReadingRecordId = null;
              if (seatRecordSelect) seatRecordSelect.value = '';
              if (seatBookInput) seatBookInput.value = '';
              if (seatAuthorInput) seatAuthorInput.value = '';
              if (seatCurrentPage) seatCurrentPage.value = '1';
              if (seatTotalPage) seatTotalPage.value = '100';

              if (seatModalTitle) seatModalTitle.textContent = '🪑 木椅閱讀角';
              if (seatFormView) seatFormView.style.display = 'block';
              if (seatInfoView) seatInfoView.style.display = 'none';
              if (seatUpdateView) seatUpdateView.style.display = 'none';
              if (seatModal) seatModal.style.display = 'flex';
              return;
            } else {
              if (seatModalTitle) seatModalTitle.textContent = '🪑 木椅閱讀角';
              if (seatFormView) seatFormView.style.display = 'none';
              if (seatInfoView) seatInfoView.style.display = 'block';
              if (seatUpdateView) seatUpdateView.style.display = 'none';
              if (seatDetails) {
                const cur = hitItem.current_page || 1;
                const tot = hitItem.total_pages || 100;
                const pct = tot > 0 ? Math.round((cur / tot) * 100) : 0;
                seatDetails.innerHTML = `
                  <p><strong>您正在此處閱讀：</strong>《${hitItem.book_title || '沈思中'}》</p>
                  <p><strong>閱讀進度：</strong>第 ${cur} / ${tot} 頁 (${pct}%)</p>
                `;
              }
              if (seatModal) seatModal.style.display = 'flex';
              return;
            }
          }

          if (hitItem.type === 'table') {
            if (isGuest) {
              alert('訪客無法使用共讀桌功能，請註冊或登入完整會員！');
              return;
            }
            activeTableData = hitItem;
            if (!hitItem.book_title || hitItem.book_title === '') {
              if (tableModalTitle) tableModalTitle.textContent = '✨ 發起共讀活動';
              if (tableFormView) tableFormView.style.display = 'block';
              if (tableInfoView) tableInfoView.style.display = 'none';
              if (tableModal) tableModal.style.display = 'flex';
              return;
            }
            if (tableModalTitle) tableModalTitle.textContent = `📖 共讀桌活動：《${hitItem.book_title}》`;
            if (tableFormView) tableFormView.style.display = 'none';
            if (tableInfoView) tableInfoView.style.display = 'block';
            
            if (tableDetails) {
              let membersList = (hitItem.members || []).map((m: any) => m.name).join('、');
              tableDetails.innerHTML = `
                <p><strong>書名：</strong>《${hitItem.book_title}》</p>
                <p><strong>作者：</strong>${hitItem.author || '佚名'}</p>
                <p><strong>發起人：</strong>${hitItem.host_name || '未知'}</p>
                <p><strong>預定完讀：</strong>${hitItem.finish_date || '未設定'}</p>
                <p><strong>成員 (${(hitItem.members || []).length}/${hitItem.max_members})：</strong>${membersList}</p>
              `;
              if (hitItem.host_id === userId || isAdmin) {
                if (tableEndBtn) tableEndBtn.style.display = 'block';
              } else {
                if (tableEndBtn) tableEndBtn.style.display = 'none';
              }
            }
            if (tableModal) tableModal.style.display = 'flex';
            return;
          }

          if (hitItem.type === 'shelf') {
            if (libraryModal) libraryModal.style.display = 'flex';
            return;
          }

          if (hitItem.link && hitItem.link.trim() !== '') {
            const oType = hitItem.open_type || 'current';
            const customModalFrame = document.getElementById('custom-modal-frame');
            const customModalTitle = document.getElementById('custom-modal-title');
            const customModalIframe = document.getElementById('custom-modal-iframe') as HTMLIFrameElement;

            if (oType === 'blank') { 
              window.open(hitItem.link, '_blank'); 
            } else if (oType === 'modal') {
              if (customModalTitle) customModalTitle.textContent = `📄 ${hitItem.label || '內容預覽'}`;
              if (customModalIframe) customModalIframe.src = hitItem.link;
              if (customModalFrame) customModalFrame.style.display = 'flex';
            } else { 
              window.location.href = hitItem.link; 
            }
            return;
          }
        }

        if (!isCellSolidBlocked(targetGx, targetGy)) {
          moveQueue = [];
          let currX = playerGx; let currY = playerGy;
          while (currX !== targetGx) { currX += currX < targetGx ? 1 : -1; moveQueue.push({ gx: currX, gy: currY }); }
          while (currY !== targetGy) { currY += currY < targetGy ? 1 : -1; moveQueue.push({ gx: currX, gy: currY }); }
        }
      }
    });

    const customModalClose = document.getElementById('custom-modal-close');
    customModalClose?.addEventListener('click', () => {
      const customModalFrame = document.getElementById('custom-modal-frame');
      if (customModalFrame) customModalFrame.style.display = 'none';
    });

    seatSitBtn?.addEventListener('click', async () => {
      const bookTitle = seatBookInput?.value.trim();
      const author = seatAuthorInput?.value.trim() || '佚名';
      const curPage = parseInt(seatCurrentPage?.value) || 1;
      const totPage = parseInt(seatTotalPage?.value) || 100;

      if (!bookTitle) { alert('請輸入或選擇你想閱讀的書名！'); return; }

      if (activeSeatData && userId) {
        isDND = true;
        if (rpgContainer) rpgContainer.classList.add('dnd-focus-mode');
        playerGx = activeSeatData.gx;
        playerGy = activeSeatData.gy;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        await syncMyStateToDB();

        const { error } = await supabase.from(ITEMS_TABLE).update({
          host_id: userId,
          host_name: playerName,
          book_title: bookTitle
        }).eq('id', activeSeatData.id);

        if (error) {
          console.error('坐下更新失敗:', error);
          alert('坐下失敗，請稍後再試');
          return;
        }

        if (currentReadingRecordId) {
          await supabase.from(LOGS_TABLE).update({
            book_title: bookTitle,
            author: author,
            current_page: curPage,
            total_pages: totPage
          }).eq('id', currentReadingRecordId);
        } else {
          const { data: newRec } = await supabase.from(LOGS_TABLE).insert([{
            user_id: userId,
            book_title: bookTitle,
            author: author,
            current_page: curPage,
            total_pages: totPage
          }]).select().single();
          if (newRec) {
            currentReadingRecordId = newRec.id;
          }
        }
      }

      if (seatModal) seatModal.style.display = 'none';
      await fetchRoomItems();
      await fetchUserReadingRecords();
    });

    seatCancelBtn?.addEventListener('click', () => { if (seatModal) seatModal.style.display = 'none'; });
    seatInfoClose?.addEventListener('click', () => { if (seatModal) seatModal.style.display = 'none'; });

    leaveSeatBtn?.addEventListener('click', () => {
      const seatedSeat = roomItems.find(item => item.type === 'seat' && item.host_id === userId);
      if (seatedSeat) {
        if (currentReadingRecordId) {
          const matchedRec = userReadingRecords.find(r => r.id === currentReadingRecordId);
          if (matchedRec) {
            if (leaveCurrentPage) leaveCurrentPage.value = matchedRec.current_page || 1;
            if (leaveTotalPage) leaveTotalPage.value = matchedRec.total_pages || 100;
          }
        }
      }

      if (seatModalTitle) seatModalTitle.textContent = '🚶 準備起立';
      if (seatFormView) seatFormView.style.display = 'none';
      if (seatInfoView) seatInfoView.style.display = 'none';
      if (seatUpdateView) seatUpdateView.style.display = 'block';
      if (seatModal) seatModal.style.display = 'flex';
    });

    leaveConfirmBtn?.addEventListener('click', async () => {
      const curPage = parseInt(leaveCurrentPage?.value) || 1;
      const totPage = parseInt(leaveTotalPage?.value) || 100;

      isDND = false;
      if (rpgContainer) rpgContainer.classList.remove('dnd-focus-mode');
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      if (seatModal) seatModal.style.display = 'none';
      
      const seatedSeat = roomItems.find(item => item.type === 'seat' && item.host_id === userId);
      if (seatedSeat) {
        if (currentReadingRecordId) {
          await supabase.from(LOGS_TABLE).update({
            current_page: curPage,
            total_pages: totPage
          }).eq('id', currentReadingRecordId);
        }

        await supabase.from(ITEMS_TABLE).update({
          host_id: '',
          host_name: '',
          book_title: ''
        }).eq('id', seatedSeat.id);
      }

      currentReadingRecordId = null;

      if (playerGy + 1 < currentGridSize && !isCellSolidBlocked(playerGx, playerGy + 1)) {
        playerGy += 1;
      }
      
      await syncMyStateToDB();
      await fetchRoomItems();
      await fetchUserReadingRecords();
    });

    initAuthCheck();
  </script>
</Layout>