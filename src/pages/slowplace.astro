    function openDirectMessage(targetUserId: string, targetUserName: string) {
      if (!userId) { 
        alert('請先登入會員！'); 
        return; 
      }
      window.location.href = `/chatroom?dm=${targetUserId}&name=${encodeURIComponent(targetUserName)}`;
    }

    async function fetchDirectMessages() {
      if (!userId || !activeDmTargetId) return;

      const { data } = await supabase
        .from('chatroom_messages')
        .select('*')
        .or(`and(user_id.eq.${userId},target_id.eq.${activeDmTargetId}),and(user_id.eq.${activeDmTargetId},target_id.eq.${userId})`)
        .order('created_at', { ascending: true });

      if (dmMessagesBox) {
        if (data && data.length > 0) {
          let html = '';
          data.forEach((msg: any) => {
            const isMe = msg.user_id === userId;
            html += `
              <div style="display: flex; flex-direction: column; align-items: ${isMe ? 'flex-end' : 'flex-start'};">
                <div style="font-size: 10px; color: var(--text-muted); margin-bottom: 2px;">${msg.name || '旅人'}</div>
                <div style="background: ${isMe ? 'var(--accent-hover)' : 'var(--bg-card)'}; color: ${isMe ? '#fff' : 'var(--text-color)'}; padding: 8px 12px; border-radius: 12px; max-width: 80%; word-break: break-all; border: 1px solid var(--border-color);">
                  ${msg.content}
                </div>
              </div>
            `;
          });
          dmMessagesBox.innerHTML = html;
          dmMessagesBox.scrollTop = dmMessagesBox.scrollHeight;
        } else {
          dmMessagesBox.innerHTML = `<div style="text-align:center; color:var(--text-muted); padding:20px;">你們還沒有開始私訊對話，發送第一句話吧！</div>`;
        }
      }
    }

