        const selected = rc.key === currentRoom ? 'selected' : '';
        html += `<option value="${rc.key}" ${selected}>${rc.name}</option>`;
      });
      roomSelectDropdown.innerHTML = html;

      // 如果是店主且在自訂房間，顯示刪除按鈕
      if (playerTier === '店主' && currentRoom !== 'study' && currentRoom !== 'chat' && currentRoom !== 'salon') {
        if (deleteRoomBtn) deleteRoomBtn.style.display = 'inline-block';
      } else {
        if (deleteRoomBtn) deleteRoomBtn.style.display = 'none';
      }
    }

