      if (!logListContainer) return;
      if (myReadingLogs.length === 0) {
        logListContainer.innerHTML = '<div style="color:#64748b; font-size:12px; text-align:center; padding:15px;">目前尚無閱讀記錄</div>';
        return;
      }
      let html = '';
      myReadingLogs.forEach((item, index) => {
        html += `
          <div class="log-item-card" data-index="${index}" style="background:var(--bg-main); border:1px solid var(--border-color); padding:10px 12px; border-radius:8px; cursor:pointer; margin-bottom:6px;">
            <div style="display:flex; flex-wrap:wrap; align-items:baseline; gap:8px;">
              <span style="font-weight:bold; color:var(--accent-color); font-size:14px;">《${item.book}》</span>
              <span style="font-size:12px; color:#cbd5e1;">作者：${item.author}</span>
            </div>
          </div>
        `;
      });
      logListContainer.innerHTML = html;

      document.querySelectorAll('.log-item-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const idx = Number((e.currentTarget as HTMLElement).dataset.index);
          const log = myReadingLogs[idx];
          if (detailContent) {
            detailContent.innerHTML = `
              <p style="font-size:14px;"><strong>書名：</strong>《${log.book}》</p>
              <p style="font-size:13px;"><strong>作者：</strong>${log.author}</p>
              <p style="font-size:13px;"><strong>閱讀進度：</strong>第 ${log.current} / ${log.total} 頁</p>
              <p style="font-size:13px;"><strong>書摘：</strong><br><span style="color:#38bdf8;">“ ${log.quote || '無'} ”</span></p>
              <p style="font-size:13px;"><strong>讀後感：</strong><br>${log.review || '無心得'}</p>
              <p style="font-size:11px; color:#64748b; text-align:right;">記錄日期：${log.date}</p>
            `;
          }
          if (detailModal) detailModal.style.display = 'flex';
        });
      });
    }

    detailCloseBtn?.addEventListener('click', () => { if (detailModal) detailModal.style.display = 'none'; });
    peerCloseBtn?.addEventListener('click', () => { if (peerModal) peerModal.style.display = 'none'; });
    customModalClose?.addEventListener('click', () => { if (customModalFrame) customModalFrame.style.display = 'none'; });

    pamCancelBtn?.addEventListener('click', () => { if (playerActionModal) playerActionModal.style.display = 'none'; });

    pamChatBtn?.addEventListener('click', () => {
      if (selectedPeer) {
        privateTargetId = selectedPeer.user_id;
        privateTargetName = selectedPeer.name;
        if (chatModeIndicator) chatModeIndicator.textContent = `🔒 私訊對象: ${selectedPeer.name}`;
        if (switchPublicBtn) switchPublicBtn.style.display = 'inline-block';
        if (playerActionModal) playerActionModal.style.display = 'none';
        
        panelTabBtns.forEach(b => b.classList.remove('active'));
        document.querySelector('[data-tab="chat"]')?.classList.add('active');
        if (paneChat) paneChat.style.display = 'flex';
        if (paneLogs) paneLogs.style.display = 'none';
        if (paneGuide) paneGuide.style.display = 'none';
        if (paneBuild) paneBuild.style.display = 'none';
      }
    });

    pamLogsBtn?.addEventListener('click', () => {
      if (selectedPeer) {
        if (playerActionModal) playerActionModal.style.display = 'none';
        openPeerLogs(selectedPeer.name, selectedPeer.role, selectedPeer.reading_log || []);
      }
    });

    function openPeerLogs(peerName: string, peerRole: string, peerLogs: any[]) {
      if (peerModalTitle) peerModalTitle.textContent = `📖 ${peerName} (${peerRole}) 的閱讀記錄`;
      if (peerContentBox) {
        if (!peerLogs || peerLogs.length === 0) {
          peerContentBox.innerHTML = '<div style="color:#94a3b8; text-align:center; padding:20px;">這位書友目前還沒有新增閱讀記錄。</div>';
        } else {
          let html = '';
          peerLogs.forEach((item: any) => {
            html += `
              <div style="background:var(--bg-main); border:1px solid var(--border-color); padding:8px; border-radius:6px; margin-bottom:6px;">
                <div style="font-weight:bold; color:var(--accent-color);">《${item.book}》 / ${item.author}</div>
                <div style="font-size:11px; color:#cbd5e1; margin-top:2px;">進度：第 ${item.current}/${item.total} 頁</div>
                <div style="font-size:11px; color:#cbd5e1; margin-top:2px;">摘：${item.quote}</div>
                <div style="font-size:11px; color:#94a3b8; margin-top:2px;">感：${item.review}</div>
              </div>
            `;
          });
          peerContentBox.innerHTML = html;
        }
      }
      if (peerModal) peerModal.style.display = 'flex';
    }

    const savedTheme = localStorage.getItem('rpg_theme') || 'blue';
    if (themeSelect) {
      themeSelect.value = savedTheme;
      document.documentElement.setAttribute('data-theme', savedTheme);
    }
    themeSelect?.addEventListener('change', (e) => {
      const selected = (e.target as HTMLSelectElement).value;
      document.documentElement.setAttribute('data-theme', selected);
      localStorage.setItem('rpg_theme', selected);
    });

    libraryCloseBtn?.addEventListener('click', () => { if (libraryModal) libraryModal.style.display = 'none'; });

    async function syncMyStateToDB() {
      await supabase.from(TABLE_NAME).upsert({
        user_id: userId,
        name: playerName,
        role: playerRole,
        tier: playerTier,
        avatar: playerAvatar,
        room: currentRoom,
        gx: playerGx,
        gy: playerGy,
        is_dnd: isDND,
        task: currentTask,
        reading_log: myReadingLogs,
        updated_at: new Date()
      }, { onConflict: 'user_id' });
    }

    async function fetchOnlinePlayers() {
      const { data } = await supabase.from(TABLE_NAME).select('*').eq('room', currentRoom);
      if (data) {
        onlinePlayers = {};
        let count = 0;
        data.forEach((p: any) => {
          if (p.user_id !== userId) onlinePlayers[p.user_id] = p;
          count++;
        });
        if (onlineCountSpan) onlineCountSpan.textContent = String(count);
      }
    }

    async function fetchRoomItems() {
      const { data } = await supabase.from(ITEMS_TABLE).select('*').eq('room', currentRoom);
      roomItems = data || [];
    }

    async function fetchMessages() {
      const { data } = await supabase
        .from(MSG_TABLE_NAME)
        .select('*')
        .eq('room', currentRoom)
        .order('created_at', { ascending: true })
        .limit(30);

      if (data && chatMessagesBox) {
        let html = '';
        data.forEach(m => {
          const isPM = m.target_id !== null;
          const isMyPM = m.sender_id === userId || m.target_id === userId;
          if (!isPM || isMyPM) {
            const pmTag = isPM ? `[🔒 私訊]` : '';
            html += `<div class="chat-msg ${isPM ? 'pm' : ''}"><span class="chat-msg-author" data-sender-id="${m.sender_id}" data-sender-name="${m.sender_name}">${m.sender_name} ${pmTag}:</span><span class="chat-msg-text">${m.message}</span></div>`;
          }
        });
        chatMessagesBox.innerHTML = html;
        chatMessagesBox.scrollTop = chatMessagesBox.scrollHeight;
      }
    }

    function initDatabaseRealtime() {
      supabase.channel('db-changes').on('postgres_changes', { event: '*', schema: 'public', table: TABLE_NAME }, () => {
        fetchOnlinePlayers();
      }).subscribe();

      supabase.channel('item-changes').on('postgres_changes', { event: '*', schema: 'public', table: ITEMS_TABLE }, () => {
        fetchRoomItems();
      }).subscribe();

      supabase.channel('room-changes').on('postgres_changes', { event: '*', schema: 'public', table: ROOMS_TABLE }, () => {
        fetchRooms();
      }).subscribe();

      supabase.channel('chat-changes').on('postgres_changes', { event: 'INSERT', schema: 'public', table: MSG_TABLE_NAME }, (payload) => {
        if (payload.new && payload.new.room === currentRoom && chatMessagesBox) {
          const m = payload.new;
          const isPM = m.target_id !== null;
          const isMyPM = m.sender_id === userId || m.target_id === userId;
          if (!isPM || isMyPM) {
            const pmTag = isPM ? `[🔒 私訊]` : '';
            const div = document.createElement('div');
            div.className = `chat-msg ${isPM ? 'pm' : ''}`;
            div.innerHTML = `<span class="chat-msg-author" data-sender-id="${m.sender_id}" data-sender-name="${m.sender_name}">${m.sender_name} ${pmTag}:</span><span class="chat-msg-text">${m.message}</span>`;
            chatMessagesBox.appendChild(div);
            chatMessagesBox.scrollTop = chatMessagesBox.scrollHeight;
          }
        }
      }).subscribe();

      setInterval(() => { syncMyStateToDB(); fetchOnlinePlayers(); fetchRoomItems(); }, 5000);
    }

    chatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = chatInput?.value.trim();
      if (!text) return;

      await supabase.from(MSG_TABLE_NAME).insert({
        room: currentRoom,
        sender_id: userId,
        sender_name: playerName,
        target_id: privateTargetId,
        target_name: privateTargetName,
        message: text
      });

      if (chatInput) chatInput.value = '';
    });

    switchPublicBtn?.addEventListener('click', () => {
      privateTargetId = null;
      privateTargetName = null;
      if (chatModeIndicator) chatModeIndicator.textContent = '📢 公開發言中';
      if (switchPublicBtn) switchPublicBtn.style.display = 'none';
    });

    function getPlayerAtCell(gx: number, gy: number) {
      return Object.values(onlinePlayers).find((p: any) => p.gx === gx && p.gy === gy);
    }

    function isCellSolidBlocked(gx: number, gy: number): boolean {
      if (gx < 0 || gx >= currentGridSize || gy < 0 || gy >= currentGridSize) return true;

      for (const item of roomItems) {
        const iw = item.w || 1;
        const ih = item.h || 1;
        if (gx >= item.gx && gx < item.gx + iw && gy >= item.gy && gy < item.gy + ih) return true;
      }

      return false;
    }

    if (savedName) {
      playerName = savedName;
      playerTier = savedTier;
      if (hudName) hudName.textContent = playerName;
      if (hudTierTag) hudTierTag.textContent = playerTier === '店主' ? '👑 店主' : '🌱 鄰里人';
      if (modal) modal.style.display = 'none';

      if (playerTier === '店主') {
        if (shopkeeperTab) shopkeeperTab.style.display = 'block';
        shopkeeperBtns.forEach(b => (b as HTMLElement).style.display = 'inline-block');
        renderCustomToolsUI();
      }

      isGameStarted = true;
      fetchRooms().then(async () => {
        await syncMyStateToDB();
        await fetchOnlinePlayers();
        await fetchRoomItems();
        await fetchMessages();
        renderMyLogs();
        initDatabaseRealtime();
        gameLoop();
      });
    }

    startBtn?.addEventListener('click', async () => {
      const val = nameInput?.value.trim();
      if (!val) { alert('請輸入有效的稱號'); return; }

      const { data: existingUser } = await supabase.from(TABLE_NAME).select('*').eq('name', val).maybeSingle();
      if (existingUser && existingUser.user_id !== userId) {
        alert(`「${val}」這個稱號已經被其他書友使用了！`);
        return;
      }

      playerName = val;
      const isOwner = playerName === 'Mi' || playerName === '店主';
      playerTier = isOwner ? '店主' : '鄰里人';

      const selectedAvatar = document.querySelector('input[name="player-avatar"]:checked') as HTMLInputElement;
      if (selectedAvatar) playerAvatar = selectedAvatar.value;
      const selectedRole = document.querySelector('input[name="user-role"]:checked') as HTMLInputElement;
      if (selectedRole) playerRole = selectedRole.value;

      localStorage.setItem('rpg_player_name', playerName);
      localStorage.setItem('rpg_player_avatar', playerAvatar);
      localStorage.setItem('rpg_player_role', playerRole);
      localStorage.setItem('rpg_player_tier', playerTier);

      if (hudName) hudName.textContent = playerName;
      if (hudTierTag) hudTierTag.textContent = playerTier === '店主' ? '👑 店主' : '🌱 鄰里人';
      if (modal) modal.style.display = 'none';

      if (playerTier === '店主') {
        if (shopkeeperTab) shopkeeperTab.style.display = 'block';
        shopkeeperBtns.forEach(b => (b as HTMLElement).style.display = 'inline-block');
        renderCustomToolsUI();
      }

      if (!isGameStarted) {
        isGameStarted = true;
        await fetchRooms();
        await syncMyStateToDB();
        await fetchOnlinePlayers();
        await fetchRoomItems();
        await fetchMessages();
        renderMyLogs();
        initDatabaseRealtime();
        gameLoop();
      }
    });

    logoutBtn?.addEventListener('click', async () => {
      await supabase.from(TABLE_NAME).delete().eq('user_id', userId);
      localStorage.clear();
      window.location.reload();
    });

    bindToolButtons();

    canvas?.addEventListener('click', async (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      const tileSize = canvas.width / currentGridSize;
      const targetGx = Math.floor(clickX / tileSize);
      const targetGy = Math.floor(clickY / tileSize);

      if (currentTool === 'move') {
        const hitTable = roomItems.find(item => item.type === 'table' && targetGx >= item.gx && targetGx < item.gx + item.w && targetGy >= item.gy && targetGy < item.gy + item.h);
        if (hitTable) {
          activeTableData = hitTable;
          pendingTableItem = hitTable;

          if (!hitTable.book_title || hitTable.book_title === '') {
            if (playerTier !== '店主') {
              alert('此共讀桌目前尚未發起活動，請等待店主設定！');
              return;
            }
            if (tableModalTitle) tableModalTitle.textContent = '✨ 發起共讀活動';
            if (tableFormView) tableFormView.style.display = 'block';
            if (tableInfoView) tableInfoView.style.display = 'none';
            if (tableModal) tableModal.style.display = 'flex';
            return;
          }

          if (tableModalTitle) tableModalTitle.textContent = `📖 共讀桌活動：《${hitTable.book_title}》`;
          if (tableFormView) tableFormView.style.display = 'none';
          if (tableInfoView) tableInfoView.style.display = 'block';

          const finishDate = new Date(hitTable.finish_date);
          const now = new Date();
          const oneDayAfter = new Date(finishDate.getTime() + 24 * 60 * 60 * 1000);
          const isExpired = now > oneDayAfter;
          const isHost = hitTable.host_id === userId || playerTier === '店主';

          if (isExpired || isHost) {
            if (tableEndBtn) tableEndBtn.style.display = 'block';
          } else {
            if (tableEndBtn) tableEndBtn.style.display = 'none';
          }

          let membersList = (hitTable.members || []).map((m: any) => m.name).join(', ') || '尚無';
          if (tableDetails) {
            tableDetails.innerHTML = `
              <p><strong>書名：</strong>《${hitTable.book_title}》</p>
              <p><strong>作者：</strong>${hitTable.author}</p>
              <p><strong>發起人：</strong>${hitTable.host_name}</p>
              <p><strong>預定完讀日期：</strong>${hitTable.finish_date}</p>
              <p><strong>參與成員 (${(hitTable.members || []).length}/${hitTable.max_members || 3})：</strong>${membersList}</p>
              ${isExpired ? '<p style="color:#ef4444; font-weight:bold;">⚠️ 此共讀已逾期超過一天可進行結算清空</p>' : ''}
            `;
          }
          if (tableModal) tableModal.style.display = 'flex';
          return;
        }

        const hitLinkedItem = roomItems.find(item => targetGx >= item.gx && targetGx < item.gx + (item.w || 1) && targetGy >= item.gy && targetGy < item.gy + (item.h || 1) && item.link && item.link.trim() !== '');
        if (hitLinkedItem) {
          if (hitLinkedItem.open_type === 'blank') {
            window.open(hitLinkedItem.link, '_blank');
          } else if (hitLinkedItem.open_type === 'modal') {
            if (customModalIframe) customModalIframe.src = hitLinkedItem.link;
            if (customModalTitle) customModalTitle.textContent = hitLinkedItem.label;
            if (customModalFrame) customModalFrame.style.display = 'flex';
          } else {
            window.location.href = hitLinkedItem.link;
          }
          return;
        }

        const hitPlayer = getPlayerAtCell(targetGx, targetGy);
        if (hitPlayer) {
          selectedPeer = hitPlayer;
          if (pamTitle) pamTitle.textContent = `👤 ${hitPlayer.name} (${hitPlayer.role})`;
          if (playerActionModal) playerActionModal.style.display = 'flex';
          return;
        }

        const hitShelf = roomItems.find(item => targetGx >= item.gx && targetGx < item.gx + (item.w || 1) && targetGy >= item.gy && targetGy < item.gy + (item.h || 1) && item.type === 'shelf');
        if (hitShelf) { if (libraryModal) libraryModal.style.display = 'flex'; return; }

        const hitSeat = roomItems.find(item => item.type === 'seat' && item.gx === targetGx && item.gy === targetGy);
        if (hitSeat) {
          const isSeatTakenByOther = Object.values(onlinePlayers).some((p: any) => p.gx === hitSeat.gx && p.gy === hitSeat.gy && p.is_dnd);
          if (isSeatTakenByOther) { alert('這張椅子已經有其他書友入座囉！'); return; }

          pendingSeat = { gx: hitSeat.gx, gy: hitSeat.gy, label: hitSeat.label };
          if (seatModal) seatModal.style.display = 'flex';
        } else {
          if (!isCellSolidBlocked(targetGx, targetGy)) {
            moveQueue = [];
            let currX = playerGx;
            let currY = playerGy;
            while (currX !== targetGx) { currX += currX < targetGx ? 1 : -1; moveQueue.push({ gx: currX, gy: currY }); }
            while (currY !== targetGy) { currY += currY < targetGy ? 1 : -1; moveQueue.push({ gx: currX, gy: currY }); }
            if (isDND) { isDND = false; if (leaveSeatBtn) leaveSeatBtn.style.display = 'none'; }
          }
        }
      } else {
        if (playerTier !== '店主') {
          alert('權限不足：只有「店主」階層才可編輯館內物件與共讀桌！');
          return;
        }

        const existingItem = roomItems.find(item => targetGx >= item.gx && targetGx < item.gx + (item.w || 1) && targetGy >= item.gy && targetGy < item.gy + (item.h || 1));
        if (existingItem) {
          if (confirm('確定要刪除此處的物件嗎？')) {
            await supabase.from(ITEMS_TABLE).delete().eq('id', existingItem.id);
            fetchRoomItems();
          }
          return;
        }

        let w = 1, h = 1, label = '物件', imgSrc = '/assets/chair.png', description = '無說明', link = '', openType = 'current';
        if (currentTool === 'shelf') {
          w = 3; h = 1; label = '書櫃'; imgSrc = '/assets/shelf.png'; description = '客舍館藏書櫃';
        } else if (currentTool === 'seat') {
          w = 1; h = 1; label = '木椅'; imgSrc = '/assets/chair.png'; description = '供書友安坐閱讀的椅子';
        } else if (currentTool === 'table') {
          w = 2; h = 2; label = '共讀桌'; imgSrc = '/assets/table.png'; description = '書友發起共讀活動的交流桌';
        } else {
          const custom = customFurnitureTypes.find(c => c.type === currentTool);
          if (custom) {
            w = custom.w;
            h = custom.h;
            label = custom.label;
            imgSrc = custom.imgSrc;
            description = custom.description;
            link = custom.link;
            openType = custom.openType || 'current';
          }
        }

        if (targetGx + w > currentGridSize || targetGy + h > currentGridSize) {
          alert(`物件超出 ${currentGridSize}x${currentGridSize} 範圍！`);
          return;
        }

        let hasOverlap = false;
        for (let x = targetGx; x < targetGx + w; x++) {
          for (let y = targetGy; y < targetGy + h; y++) {
            if (isCellSolidBlocked(x, y)) hasOverlap = true;
          }
        }

        if (hasOverlap) {
          alert('此處已有其他傢俱或物件，不可重疊放置！');
          return;
        }

        await supabase.from(ITEMS_TABLE).insert({
          room: currentRoom,
          type: currentTool,
          gx: targetGx,
          gy: targetGy,
          w,
          h,
          label,
          img_src: imgSrc,
          description,
          link,
          open_type: openType,
          book_title: '',
          author: '',
          finish_date: '',
          max_members: 3,
          host_id: '',
          host_name: '',
          members: []
        });
        fetchRoomItems();
        alert('物件已放置並同步至雲端！');
      }
    });

    tableCreateBtn?.addEventListener('click', async () => {
      const book = tableBook?.value.trim();
      const author = tableAuthor?.value.trim();
      const maxM = parseInt(tableMax?.value) || 3;
      const date = tableDate?.value;

      if (!book || !date) { alert('請完整填寫書名與完讀日期'); return; }

      if (pendingTableItem) {
        await supabase.from(ITEMS_TABLE).update({
          book_title: book,
          author: author || '佚名',
          finish_date: date,
          max_members: maxM,
          host_id: userId,
          host_name: playerName,
          members: [{ id: userId, name: playerName }]
        }).eq('id', pendingTableItem.id);
      }

      if (tableModal) tableModal.style.display = 'none';
      if (tableBook) tableBook.value = '';
      if (tableAuthor) tableAuthor.value = '';
      fetchRoomItems();
      alert('共讀活動已成功發起！');
    });

    tableJoinBtn?.addEventListener('click', async () => {
      if (!activeTableData) return;
      const members = activeTableData.members || [];
      const maxLimit = activeTableData.max_members || 3;
      if (members.length >= maxLimit) { alert(`此共讀桌人數已滿（上限 ${maxLimit} 人）！`); return; }
      if (members.some((m: any) => m.id === userId)) { alert('你已經加入過這個共讀桌了！'); return; }

      members.push({ id: userId, name: playerName });
      await supabase.from(ITEMS_TABLE).update({ members }).eq('id', activeTableData.id);

      if (tableModal) tableModal.style.display = 'none';
      fetchRoomItems();
      alert('成功加入共讀行列！');
    });

    tableEndBtn?.addEventListener('click', async () => {
      if (!activeTableData) return;
      await supabase.from(ITEMS_TABLE).update({
        book_title: '',
        author: '',
        finish_date: '',
        max_members: 3,
        host_id: '',
        host_name: '',
        members: []
      }).eq('id', activeTableData.id);

      if (tableModal) tableModal.style.display = 'none';
      fetchRoomItems();
      alert('共讀已結束並清空！');
    });

    tableCancelBtn?.addEventListener('click', () => { if (tableModal) tableModal.style.display = 'none'; });
    tableInfoClose?.addEventListener('click', () => { if (tableModal) tableModal.style.display = 'none'; });

    confirmSeatBtn?.addEventListener('click', async () => {
      if (pendingSeat) {
        playerGx = pendingSeat.gx;
        playerGy = pendingSeat.gy;
        moveQueue = [];
        const bookName = bookInput?.value.trim() || '閱讀中';
        const authorName = authorInput?.value.trim() || '佚名';
        const currentP = parseInt(currentPageInput?.value) || 1;
        const totalP = parseInt(totalPageInput?.value) || 100;
        const quote = quoteInput?.value.trim() || '';
        const review = reviewInput?.value.trim() || '';

        currentTask = `《${bookName}》 p.${currentP}/${totalP}`;
        isDND = true;

        myReadingLogs.unshift({
          book: bookName,
          author: authorName,
          quote,
          review,
          current: currentP,
          total: totalP,
          date: new Date().toLocaleDateString()
        });
        localStorage.setItem('rpg_my_logs', JSON.stringify(myReadingLogs));
        renderMyLogs();

        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        if (seatModal) seatModal.style.display = 'none';
        await syncMyStateToDB();
      }
    });

    cancelSeatBtn?.addEventListener('click', () => { if (seatModal) seatModal.style.display = 'none'; });

    leaveSeatBtn?.addEventListener('click', async () => {
      isDND = false;
      if (playerGy + 1 < currentGridSize && !isCellSolidBlocked(playerGx, playerGy + 1)) {
        playerGy += 1;
      }
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      await syncMyStateToDB();
    });

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      const tileSize = canvas.width / currentGridSize;

      const bgImgObj = getLoadedImage(currentBgImg);
      if (bgImgObj && bgImgObj.complete && bgImgObj.naturalWidth !== 0) {
        ctx.drawImage(bgImgObj, 0, 0, canvas.width, canvas.height);
      } else {
        const theme = document.documentElement.getAttribute('data-theme') || 'blue';
        const bgMap: Record<string, string> = { blue: '#0f172a', green: '#064e3b', purple: '#3b0764' };
        ctx.fillStyle = bgMap[theme] || '#0f172a';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += tileSize) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
      for (let y = 0; y < canvas.height; y += tileSize) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }

      moveTimer++;
      if (moveQueue.length > 0 && moveTimer % 8 === 0) {
        const nextStep = moveQueue.shift()!;
        if (!isCellSolidBlocked(nextStep.gx, nextStep.gy)) {
          playerGx = nextStep.gx;
          playerGy = nextStep.gy;
          syncMyStateToDB();
        } else { moveQueue = []; }
      }

      roomItems.forEach(item => {
        const px = item.gx * tileSize;
        const py = item.gy * tileSize;
        const iw = (item.w || 1) * tileSize;
        const ih = (item.h || 1) * tileSize;

        const img = getLoadedImage(item.img_src);
        if (img && img.complete && img.naturalWidth !== 0) {
          ctx.drawImage(img, px, py, iw, ih);
        } else {
          ctx.fillStyle = item.type === 'table' ? '#b45309' : '#334155';
          ctx.fillRect(px + 2, py + 2, iw - 4, ih - 4);
        }
      });

      Object.values(onlinePlayers).forEach((op: any) => {
        const px = op.gx * tileSize + tileSize / 2;
        const py = op.gy * tileSize + tileSize / 2;
        const opImg = getLoadedImage(op.avatar || '/assets/player2.png');
        if (opImg && opImg.complete && opImg.naturalWidth !== 0) {
          ctx.drawImage(opImg, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#10b981';
          ctx.fillRect(px - 12, py - 12, 24, 24);
        }
        ctx.fillStyle = '#34d399';
        ctx.font = '10px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(op.name, px, py + 26);
        ctx.textAlign = 'left';
      });

      const pScreenX = playerGx * tileSize + tileSize / 2;
      const pScreenY = playerGy * tileSize + tileSize / 2;
      const playerImg = getLoadedImage(playerAvatar);
      if (playerImg && playerImg.complete && playerImg.naturalWidth !== 0) {
        ctx.drawImage(playerImg, pScreenX - 16, pScreenY - 16, 32, 32);
      } else {
        ctx.fillStyle = isDND ? '#10b981' : '#38bdf8';
        ctx.fillRect(pScreenX - 12, pScreenY - 12, 24, 24);
      }
      ctx.fillStyle = '#f8fafc';
      ctx.font = '10px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(playerName, pScreenX, pScreenY + 26);
      ctx.textAlign = 'left';
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }
  </script>
</Layout>