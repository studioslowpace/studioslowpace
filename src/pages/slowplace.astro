      document.documentElement.style.setProperty('--bg-input', hex === '#faf6ee' ? '#f4efe6' : 'rgba(0,0,0,0.04)');
      document.documentElement.style.setProperty('--border-color', '#e6dcc8');
      
      localStorage.setItem('rpg_custom_bg', hex);
