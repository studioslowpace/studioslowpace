      const target = e.target as HTMLSelectElement;
      currentRoom = target.value;
      updateCurrentRoomConfig();
      isDND = false;
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      playerGx = 1; playerGy = 1;
      moveQueue = [];
      renderRoomDropdown();
      await syncMyStateToDB();
