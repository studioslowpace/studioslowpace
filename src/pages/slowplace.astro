    const imageCache: Record<string, HTMLImageElement> = {};
    const imageFailed: Record<string, boolean> = {};

    function getLoadedImage(src: string): HTMLImageElement | null {
      if (!src || src.trim() === '') return null;
      if (imageFailed[src]) return null;
      if (!imageCache[src]) {
        const img = new Image();
        img.onerror = () => { imageFailed[src] = true; };
        img.src = src;
        imageCache[src] = img;
      }
      return imageFailed[src] ? null : imageCache[src];
    }

    // 🔄 從 Supabase 同步房間列表
    async function fetchRooms() {
      const { data } = await supabase.from(ROOMS_TABLE).select('*');
      if (data && data.length > 0) {
        customRooms = data.map((r: any) => ({
          key: r.room_key,
          name: r.room_name,
          bgImg: r.bg_img || '',
          gridSize: r.grid_size || 12
        }));
      } else {
        // 預設房間初始化
        const defaults = [
          { key: 'study', name: '📖 自修室', bgImg: '', gridSize: 12 },
          { key: 'chat', name: '☕ 書話間', bgImg: '', gridSize: 12 },
          { key: 'salon', name: '🏛️ 沙龍', bgImg: '', gridSize: 12 }
        ];
        for (const dr of defaults) {
          await supabase.from(ROOMS_TABLE).upsert({
            room_key: dr.key,
            room_name: dr.name,
            bg_img: dr.bgImg,
            grid_size: dr.gridSize
          }, { onConflict: 'room_key' });
        }
        customRooms = defaults;
      }
      renderRoomDropdown();
      updateCurrentRoomConfig();
    }

