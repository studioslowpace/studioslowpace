---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 手機沉浸共讀空間">
  <!-- 1. 登入與身份選擇 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 身份登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">午後的長沙灣天空湛藍。請選擇你的分身造型、稱號與客舍身份：</p>
        
        <div class="avatar-selector-label">選擇分身造型：</div>
        <div class="avatar-selector-group">
          <label class="avatar-card">
            <input type="radio" name="player-avatar" value="/assets/player1.png" checked />
            <img src="/assets/player1.png" alt="P1" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="avatar-fallback" style="display:none;">👤 P1</span>
            <span class="avatar-name">分身一號</span>
          </label>
          <label class="avatar-card">
            <input type="radio" name="player-avatar" value="/assets/player2.png" />
            <img src="/assets/player2.png" alt="P2" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="avatar-fallback" style="display:none;">👤 P2</span>
            <span class="avatar-name">分身二號</span>
          </label>
        </div>

        <input type="text" id="rpg-name-input" placeholder="輸入你的獨一無二稱號" maxlength="12" autofocus />
        
        <div class="avatar-selector-label">選擇身份階層：</div>
        <select id="rpg-tier-select" class="theme-select-dropdown" style="width:100%; padding:10px; margin-bottom:12px; border-radius:8px;">
          <option value="鄰里人">🌱 鄰里人 (一般書友)</option>
          <option value="客舍人">☕ 客舍人 (常駐會員)</option>
          <option value="空間友">🤝 空間友 (共創夥伴)</option>
          <option value="店主">👑 店主 (擁有傢俱建造權限)</option>
        </select>

        <div class="role-selector-group">
          <label class="role-chip"><input type="radio" name="user-role" value="晴空選書" checked /> ☁️ 晴空選書</label>
          <label class="role-chip"><input type="radio" name="user-role" value="散文漫遊" /> 🍃 散文漫遊</label>
          <label class="role-chip"><input type="radio" name="user-role" value="靜心寫作" /> ✍️ 靜心寫作</label>
        </div>

        <button id="rpg-start-btn" class="rpg-btn">▶ 進入客舍空間</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 閱讀與專心設定 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處安坐。請輸入書名與目前的閱讀章節：</p>
        <input type="text" id="rpg-book-input" placeholder="書名（例：《希臘語課》）" maxlength="20" />
        <div class="progress-input-group">
          <span>進度：第</span>
          <input type="number" id="rpg-chapter-input" value="1" min="1" max="99" style="width: 60px; text-align:center;" />
          <span>章</span>
        </div>
        <div class="rpg-btn-group" style="margin-top: 14px;">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">☁️ 開啟專心 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 圖書館藏 Modal (點擊書櫃彈出) -->
  <div id="library-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>📚 客舍館藏書單 (Library)</span>
        <button id="library-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe src="/library" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- 4. 閱讀記錄與書摘收藏 Modal -->
  <div id="reading-log-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 380px; max-height: 85vh; display: flex; flex-direction: column;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>📖 個人閱讀記錄與書摘</span>
        <button id="log-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="rpg-content" style="overflow-y: auto; flex: 1;">
        <div style="background:var(--bg-main); padding:10px; border-radius:8px; margin-bottom:12px; border:1px solid var(--border-color);">
          <div style="font-size:11px; color:var(--accent-color); margin-bottom:6px; font-weight:bold;">✍️ 新增一筆記錄</div>
          <input type="text" id="log-book-name" placeholder="書名" style="margin-bottom:6px;" />
          <input type="text" id="log-author-name" placeholder="作者名" style="margin-bottom:6px;" />
          <textarea id="log-quote" placeholder="書摘句子..." style="width:100%; height:50px; background:var(--bg-card); color:#f8fafc; border:1px solid var(--border-color); border-radius:6px; padding:6px; font-size:11px; resize:none; outline:none; box-sizing:border-box; margin-bottom:6px;"></textarea>
          <textarea id="log-review" placeholder="讀後感與心得..." style="width:100%; height:60px; background:var(--bg-card); color:#f8fafc; border:1px solid var(--border-color); border-radius:6px; padding:6px; font-size:11px; resize:none; outline:none; box-sizing:border-box; margin-bottom:8px;"></textarea>
          <button id="log-add-btn" class="rpg-btn" style="padding:8px;">➕ 新增至我的書單</button>
        </div>

        <div style="font-size:11px; color:#94a3b8; margin-bottom:6px;">📚 記錄列表（點擊可看詳情）：</div>
        <div id="log-list-container" style="display:flex; flex-direction:column; gap:6px;"></div>
      </div>
    </div>
  </div>

  <!-- 5. 閱讀記錄詳情 Modal -->
  <div id="log-detail-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 360px;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="detail-title">📖 記錄詳情</span>
        <button id="detail-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="rpg-content">
        <div id="detail-content" style="font-size:12px; line-height:1.6; color:#f8fafc; word-break:break-all;"></div>
      </div>
    </div>
  </div>

  <!-- 6. 查看其他玩家閱讀記錄 Modal -->
  <div id="peer-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 360px; max-height: 80vh; display: flex; flex-direction: column;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="peer-modal-title">👤 書友的閱讀記錄</span>
        <button id="peer-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="rpg-content" id="peer-content-box" style="overflow-y: auto; flex: 1; font-size: 12px;"></div>
    </div>
  </div>

  <!-- 7. 💬 彈出式聊天視窗 (Floating Chat Modal) -->
  <div id="chat-popup-modal" class="rpg-modal-overlay" style="display: none; align-items:flex-end; justify-content:flex-end; padding:16px;">
    <div class="rpg-window chat-popup-box">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="chat-popup-title">💬 客舍即時交誼廳</span>
        <button id="chat-popup-close" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="chat-popup-body">
        <div id="chat-mode-indicator" class="chat-mode-tag">📢 公開發言中</div>
        <button id="switch-public-btn" class="rpg-btn-sm" style="display:none; font-size:9px; margin-bottom:4px;">切換回公開頻道</button>
        <div id="chat-messages" class="chat-messages-box">
          <div class="chat-welcome">✨ 點擊線上玩家頭像可檢視其閱讀記錄或發起私訊！</div>
        </div>
        <form id="chat-form" class="chat-input-row">
          <input type="text" id="chat-input" placeholder="說點什麼..." maxlength="80" autocomplete="off" />
          <button type="submit" class="chat-send-btn">發送</button>
        </form>
      </div>
    </div>
  </div>

  <!-- 8. 主介面 (完整手機/桌面直式設計) -->
  <div class="app-viewport">
    <main class="rpg-container">
      <header class="rpg-hud">
        <div class="hud-top-row">
          <span class="hud-brand">☁️ 空間客舍</span>
          <div class="hud-right">
            <span class="online-indicator">🟢 在線: <strong id="online-count">1</strong></span>
            <span class="user-tag" id="hud-tier-tag">🌱 鄰里人</span>
            <strong id="hud-name" style="color: var(--accent-light, #e0f2fe);">旅人</strong>
            <button id="logout-btn" class="rpg-btn-sm" style="background:#ef4444; color:#fff; border:none;">🚪 登出</button>
          </div>
        </div>

        <div class="hud-mid-row">
          <div class="channel-tabs">
            <button class="channel-tab active" data-room="study">📖 自修室</button>
            <button class="channel-tab" data-room="chat">☕ 書話間</button>
            <button class="channel-tab" data-room="salon">🏛️ 沙龍</button>
          </div>
          <div class="theme-picker">
            <select id="theme-select" class="theme-select-dropdown">
              <option value="blue">☁️ 晴空藍</option>
              <option value="green">🍃 森林綠</option>
              <option value="purple">🔮 暮光紫</option>
            </select>
          </div>
        </div>
      </header>

      <!-- 畫布區塊 -->
      <div class="canvas-wrapper">
        <canvas id="rpg-canvas" width="384" height="340"></canvas>
      </div>

      <!-- 底部操作列與按鈕 -->
      <footer class="rpg-footer">
        <div id="build-palette" class="build-palette" style="display:none;">
          <button class="tool-btn active" data-tool="move">🚶 移動</button>
          <button class="tool-btn" data-tool="seat">🪑 椅子</button>
          <button class="tool-btn" data-tool="shelf">📚 書架</button>
        </div>
        <div id="default-palette" class="build-palette">
          <button class="tool-btn active" data-tool="move">🚶 移動模式</button>
        </div>

        <div class="action-dock">
          <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background: var(--accent-color, #38bdf8); color:#0f172a; font-weight:bold;">🚶 起立</button>
          <button id="btn-reading-log" class="rpg-btn-sm">📖 閱讀記錄</button>
          <button id="btn-open-chat" class="rpg-btn-sm" style="background:var(--accent-hover); color:#fff;">💬 聊天</button>
        </div>
      </footer>
    </main>
  </div>

  <style is:global>
    :root {
      --bg-main: #0f172a;
      --bg-card: #1e293b;
      --border-color: #334155;
      --accent-color: #38bdf8;
      --accent-hover: #0284c7;
      --accent-light: #e0f2fe;
    }

    [data-theme="green"] {
      --bg-main: #064e3b;
      --bg-card: #065f46;
      --border-color: #047857;
      --accent-color: #34d399;
      --accent-hover: #059669;
      --accent-light: #d1fae5;
    }

    [data-theme="purple"] {
      --bg-main: #3b0764;
      --bg-card: #581c87;
      --border-color: #7e22ce;
      --accent-color: #c084fc;
      --accent-hover: #9333ea;
      --accent-light: #f3e8ff;
    }

    * { -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; user-select: none; }

    html, body {
      background-color: #020617;
      color: #cbd5e1;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0; padding: 0; width: 100vw; height: 100vh; overflow: hidden; touch-action: manipulation;
    }

    .app-viewport { width: 100vw; height: 100vh; height: 100dvh; display: flex; justify-content: center; align-items: center; background: #020617; }
    .rpg-container {
      width: 100vw; max-width: 414px; height: 100vh; height: 100dvh; max-height: 896px;
      display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; box-sizing: border-box;
      background-color: var(--bg-main); border-left: 1px solid var(--border-color); border-right: 1px solid var(--border-color);
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.8); transition: background-color 0.3s ease;
    }

    .rpg-modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .rpg-window { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; width: 90%; max-width: 360px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
    
    .embed-window { max-width: 390px; height: 80vh; display: flex; flex-direction: column; overflow: hidden; }
    .embed-frame-wrapper { flex: 1; width: 100%; background: #ffffff; }
    .embed-iframe { width: 100%; height: 100%; border: none; }

    /* 💬 彈出式聊天視窗樣式 */
    .chat-popup-box { width: 90vw; max-width: 360px; height: 420px; display: flex; flex-direction: column; overflow: hidden; border-radius: 12px; }
    .chat-popup-body { flex: 1; display: flex; flex-direction: column; padding: 10px; background: var(--bg-card); min-height: 0; }
    .chat-mode-tag { color: var(--accent-color); font-size: 10px; font-weight: bold; margin-bottom: 4px; }
    .chat-messages-box { flex: 1; padding: 6px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; font-size: 11px; background: var(--bg-main); border-radius: 6px; border: 1px solid var(--border-color); margin-bottom: 6px; }
    .chat-welcome { color: #94a3b8; text-align: center; font-size: 10px; padding: 4px; }
    .chat-msg { background: var(--bg-card); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border-color); word-break: break-all; line-height: 1.4; }
    .chat-msg.pm { background: rgba(192, 132, 252, 0.15); border-color: #c084fc; }
    .chat-msg-author { color: var(--accent-color); font-weight: bold; margin-right: 4px; cursor: pointer; }
    .chat-msg-text { color: #f8fafc; }
    .chat-input-row { display: flex; gap: 6px; flex-shrink: 0; }
    .chat-input-row input { flex: 1; background: var(--bg-main); border: 1px solid var(--border-color); color: #f8fafc; padding: 6px 8px; font-size: 11px; border-radius: 4px; outline: none; }
    .chat-send-btn { background: var(--accent-hover); color: #f8fafc; border: none; padding: 0 12px; font-size: 11px; border-radius: 4px; cursor: pointer; font-weight: 500; }

    .rpg-title-bar { background: var(--bg-main); color: var(--accent-color); padding: 12px 16px; font-size: 13px; font-weight: 500; border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom: 1px solid var(--border-color); }
    .rpg-content { padding: 18px; }
    .rpg-text { font-size: 13px; color: #94a3b8; margin-bottom: 14px; line-height: 1.5; }
    
    .avatar-selector-label { font-size: 12px; color: #94a3b8; margin-bottom: 6px; }
    .avatar-selector-group { display: flex; gap: 10px; margin-bottom: 14px; }
    .avatar-card { flex: 1; background: var(--bg-main); border: 2px solid var(--border-color); border-radius: 8px; padding: 8px; text-align: center; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .avatar-card input { display: none; }
    .avatar-card input:checked + img, .avatar-card input:checked ~ .avatar-fallback { border-color: var(--accent-color); }
    .avatar-card input:checked ~ .avatar-name { color: var(--accent-color); font-weight: bold; }
    .avatar-card img { width: 40px; height: 40px; object-fit: contain; image-rendering: pixelated; border-radius: 4px; background: var(--bg-card); padding: 2px; }
    .avatar-fallback { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--bg-card); border-radius: 4px; font-size: 12px; color: var(--accent-color); }
    .avatar-name { font-size: 11px; color: #cbd5e1; }

    .rpg-window input[type="text"], .rpg-window input[type="number"] { width: 100%; background: var(--bg-main); border: 1px solid var(--border-color); color: #f8fafc; padding: 10px; font-size: 13px; box-sizing: border-box; margin-bottom: 12px; outline: none; border-radius: 8px; }
    .role-selector-group { display: flex; gap: 6px; margin-bottom: 14px; }
    .role-chip { background: var(--bg-main); border: 1px solid var(--border-color); padding: 6px 10px; border-radius: 16px; font-size: 11px; cursor: pointer; color: #cbd5e1; }
    .role-chip input { margin-right: 4px; accent-color: var(--accent-color); }
    .progress-input-group { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #94a3b8; }
    .rpg-btn { background: var(--accent-hover); color: #f8fafc; border: none; padding: 10px; font-size: 13px; cursor: pointer; width: 100%; font-weight: 500; border-radius: 8px; }
    .rpg-btn-ghost { background: transparent; color: #94a3b8; border: 1px solid var(--border-color); padding: 10px; font-size: 13px; cursor: pointer; width: 100%; border-radius: 8px; }
    .rpg-btn-group { display: flex; gap: 8px; }

    .rpg-hud { background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 8px 12px; font-size: 12px; flex-shrink: 0; }
    .hud-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .hud-brand { font-weight: 600; color: var(--accent-color); }
    .hud-right { display: flex; align-items: center; gap: 6px; }
    .online-indicator { color: #34d399; }
    .user-tag { background: var(--bg-main); border: 1px solid var(--border-color); padding: 2px 6px; border-radius: 8px; font-size: 10px; color: var(--accent-color); }
    
    .hud-mid-row { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .channel-tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; }
    .channel-tab { background: var(--bg-main); color: #94a3b8; border: 1px solid var(--border-color); padding: 4px 10px; font-size: 11px; cursor: pointer; border-radius: 14px; white-space: nowrap; }
    .channel-tab.active { background: var(--accent-hover); color: #f8fafc; border-color: var(--accent-hover); font-weight: 500; }
    
    .theme-select-dropdown { background: var(--bg-main); color: var(--accent-color); border: 1px solid var(--border-color); padding: 3px 6px; font-size: 11px; border-radius: 8px; outline: none; cursor: pointer; }
    .rpg-btn-sm { background: var(--bg-main); color: #cbd5e1; border: 1px solid var(--border-color); padding: 4px 8px; font-size: 11px; cursor: pointer; border-radius: 6px; }
    
    .canvas-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; background: #020617; padding: 4px; overflow: hidden; min-height: 0; }
    #rpg-canvas { border: 1px solid var(--border-color); background: var(--bg-main); cursor: pointer; image-rendering: pixelated; border-radius: 8px; width: 100%; max-width: 384px; height: 100%; max-height: 340px; object-fit: contain; }

    .rpg-footer { background: var(--bg-card); border-top: 1px solid var(--border-color); padding: 8px 12px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
    .build-palette { display: flex; gap: 6px; }
    .tool-btn { background: var(--bg-main); color: #94a3b8; border: 1px solid var(--border-color); padding: 6px 10px; font-size: 11px; cursor: pointer; border-radius: 6px; }
    .tool-btn.active { background: var(--accent-hover); color: #f8fafc; border-color: var(--accent-hover); font-weight: 500; }
    .action-dock { display: flex; align-items: center; gap: 6px; }
  </style>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const SUPABASE_URL = 'https://blqlrxqckiuvgevmakbu.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
    const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const TABLE_NAME = 'slowsplace_member';
    const MSG_TABLE_NAME = 'slowsplace_messages';
    const TILE_SIZE = 32;

    const userId = localStorage.getItem('rpg_user_id') || ('user_' + Math.random().toString(36).substring(2, 9));
    localStorage.setItem('rpg_user_id', userId);

    const savedName = localStorage.getItem('rpg_player_name');
    const savedAvatar = localStorage.getItem('rpg_player_avatar');
    const savedRole = localStorage.getItem('rpg_player_role');
    const savedTier = localStorage.getItem('rpg_player_tier') || '鄰里人';

    let playerName = savedName || '冒險者';
    let playerRole = savedRole || '☁️ 讀者';
    let playerAvatar = savedAvatar || '/assets/player1.png';
    let playerTier = savedTier;
    let playerGx = 4;
    let playerGy = 7;
    let currentTool = 'move';
    let currentRoom = 'study';
    let isDND = false;
    let currentTask = '';

    // 個人閱讀記錄陣列
    let myReadingLogs: { book: string; author: string; quote: string; review: string; date: string }[] = JSON.parse(localStorage.getItem('rpg_my_logs') || '[]');

    let privateTargetId: string | null = null;
    let privateTargetName: string | null = null;

    let moveQueue: { gx: number; gy: number }[] = [];
    let moveTimer = 0;
    let onlinePlayers: Record<string, any> = {};

    const imageCache: Record<string, HTMLImageElement> = {};
    const imageFailed: Record<string, boolean> = {};

    function getLoadedImage(src: string): HTMLImageElement | null {
      if (imageFailed[src]) return null;
      if (!imageCache[src]) {
        const img = new Image();
        img.onerror = () => { imageFailed[src] = true; };
        img.src = src;
        imageCache[src] = img;
      }
      return imageFailed[src] ? null : imageCache[src];
    }

    const rooms: Record<string, { 
      name: string; 
      items: { type: string; gx: number; gy: number; label: string; imgSrc: string }[];
      npcs: { name: string; task: string; gx: number; gy: number; imgSrc: string }[];
    }> = {
      study: {
        name: '自修室',
        items: [
          { type: 'seat', gx: 3, gy: 3, label: '木椅 A', imgSrc: '/assets/chair.png' },
          { type: 'seat', gx: 8, gy: 3, label: '木椅 B', imgSrc: '/assets/chair.png' },
          { type: 'shelf', gx: 5, gy: 1, label: '書櫃', imgSrc: '/assets/shelf.png' }
        ],
        npcs: [
          { name: 'Mi', task: '整理筆記', gx: 10, gy: 2, imgSrc: '/assets/npc_mi.png' }
        ]
      },
      chat: {
        name: '書話間',
        items: [
          { type: 'seat', gx: 3, gy: 4, label: '沙發', imgSrc: '/assets/chair.png' },
          { type: 'shelf', gx: 10, gy: 1, label: '熱門書架', imgSrc: '/assets/shelf.png' }
        ],
        npcs: [
          { name: '實習生', task: '澆花', gx: 8, gy: 6, imgSrc: '/assets/intern.png' }
        ]
      },
      salon: {
        name: '沙龍',
        items: [
          { type: 'seat', gx: 6, gy: 3, label: '講者席', imgSrc: '/assets/chair.png' },
          { type: 'shelf', gx: 2, gy: 1, label: '沙龍選書', imgSrc: '/assets/shelf.png' }
        ],
        npcs: []
      }
    };

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const libraryModal = document.getElementById('library-modal');
    const libraryCloseBtn = document.getElementById('library-close-btn');

    // 閱讀記錄 MODAL DOM
    const readingLogModal = document.getElementById('reading-log-modal');
    const logCloseBtn = document.getElementById('log-close-btn');
    const logAddBtn = document.getElementById('log-add-btn');
    const logBookInput = document.getElementById('log-book-name') as HTMLInputElement;
    const logAuthorInput = document.getElementById('log-author-name') as HTMLInputElement;
    const logQuoteInput = document.getElementById('log-quote') as HTMLTextAreaElement;
    const logReviewInput = document.getElementById('log-review') as HTMLTextAreaElement;
    const logListContainer = document.getElementById('log-list-container');
    const detailModal = document.getElementById('log-detail-modal');
    const detailCloseBtn = document.getElementById('detail-close-btn');
    const detailContent = document.getElementById('detail-content');

    // 他人閱讀記錄查看 MODAL
    const peerModal = document.getElementById('peer-modal');
    const peerCloseBtn = document.getElementById('peer-close-btn');
    const peerModalTitle = document.getElementById('peer-modal-title');
    const peerContentBox = document.getElementById('peer-content-box');

    // 💬 彈出聊天 MODAL DOM
    const chatPopupModal = document.getElementById('chat-popup-modal');
    const chatPopupClose = document.getElementById('chat-popup-close');
    const openChatBtn = document.getElementById('btn-open-chat');
    const chatMessagesBox = document.getElementById('chat-messages');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const chatModeIndicator = document.getElementById('chat-mode-indicator');
    const switchPublicBtn = document.getElementById('switch-public-btn');

    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const tierSelect = document.getElementById('rpg-tier-select') as HTMLSelectElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const chapterInput = document.getElementById('rpg-chapter-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const logoutBtn = document.getElementById('logout-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const hudTierTag = document.getElementById('hud-tier-tag');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const readingLogBtn = document.getElementById('btn-reading-log');
    const onlineCountSpan = document.getElementById('online-count');
    const themeSelect = document.getElementById('theme-select') as HTMLSelectElement;
    const buildPalette = document.getElementById('build-palette');
    const defaultPalette = document.getElementById('default-palette');

    let pendingSeat: { gx: number; gy: number; label: string } | null = null;
    let isGameStarted = false;

    // 渲染閱讀記錄清單
    function renderMyLogs() {
      if (!logListContainer) return;
      if (myReadingLogs.length === 0) {
        logListContainer.innerHTML = '<div style="color:#64748b; font-size:10px; text-align:center; padding:10px;">目前尚無閱讀記錄</div>';
        return;
      }
      let html = '';
      myReadingLogs.forEach((item, index) => {
        html += `
          <div class="log-item-card" data-index="${index}" style="background:var(--bg-main); border:1px solid var(--border-color); padding:8px; border-radius:6px; cursor:pointer;">
            <div style="font-weight:bold; color:var(--accent-color); font-size:12px;">《${item.book}》 <span style="font-size:10px; color:#94a3b8;">/ ${item.author}</span></div>
            <div style="font-size:10px; color:#cbd5e1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px;">摘：${item.quote}</div>
          </div>
        `;
      });
      logListContainer.innerHTML = html;

      document.querySelectorAll('.log-item-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const idx = Number((e.currentTarget as HTMLElement).dataset.index);
          const log = myReadingLogs[idx];
          if (detailContent) {
            detailContent.innerHTML = `
              <p><strong>書名：</strong>《${log.book}》</p>
              <p><strong>作者：</strong>${log.author}</p>
              <p><strong>書摘：</strong><br><span style="color:#38bdf8;">“ ${log.quote} ”</span></p>
              <p><strong>讀後感：</strong><br>${log.review || '無心得'}</p>
              <p style="font-size:10px; color:#64748b; text-align:right;">記錄時間：${log.date}</p>
            `;
          }
          if (detailModal) detailModal.style.display = 'flex';
        });
      });
    }

    readingLogBtn?.addEventListener('click', () => {
      renderMyLogs();
      if (readingLogModal) readingLogModal.style.display = 'flex';
    });
    logCloseBtn?.addEventListener('click', () => { if (readingLogModal) readingLogModal.style.display = 'none'; });
    detailCloseBtn?.addEventListener('click', () => { if (detailModal) detailModal.style.display = 'none'; });

    logAddBtn?.addEventListener('click', async () => {
      const book = logBookInput?.value.trim();
      const author = logAuthorInput?.value.trim();
      const quote = logQuoteInput?.value.trim();
      const review = logReviewInput?.value.trim();

      if (!book) { alert('請填寫書名'); return; }

      myReadingLogs.unshift({
        book,
        author: author || '佚名',
        quote: quote || '暫無書摘',
        review: review || '',
        date: new Date().toLocaleDateString()
      });

      localStorage.setItem('rpg_my_logs', JSON.stringify(myReadingLogs));
      logBookInput.value = '';
      logAuthorInput.value = '';
      logQuoteInput.value = '';
      logReviewInput.value = '';
      renderMyLogs();
      await syncMyStateToDB();
      alert('閱讀記錄已成功新增！');
    });

    // 💬 彈出聊天視窗控制
    openChatBtn?.addEventListener('click', () => { if (chatPopupModal) chatPopupModal.style.display = 'flex'; });
    chatPopupClose?.addEventListener('click', () => { if (chatPopupModal) chatPopupModal.style.display = 'none'; });

    peerCloseBtn?.addEventListener('click', () => { if (peerModal) peerModal.style.display = 'none'; });

    // 檢視特定玩家的閱讀記錄
    function openPeerLogs(peerName: string, peerRole: string, peerLogs: any[]) {
      if (peerModalTitle) peerModalTitle.textContent = `📖 ${peerName} (${peerRole}) 的閱讀記錄`;
      if (peerContentBox) {
        if (!peerLogs || peerLogs.length === 0) {
          peerContentBox.innerHTML = '<div style="color:#94a3b8; text-align:center; padding:20px;">這位書友目前還沒有新增閱讀記錄。</div>';
        } else {
          let html = '';
          peerLogs.forEach((item: any) => {
            html += `
              <div style="background:var(--bg-main); border:1px solid var(--border-color); padding:8px; border-radius:6px; margin-bottom:6px;">
                <div style="font-weight:bold; color:var(--accent-color);">《${item.book}》 / ${item.author}</div>
                <div style="font-size:11px; color:#cbd5e1; margin-top:2px;">摘：${item.quote}</div>
                <div style="font-size:11px; color:#94a3b8; margin-top:2px;">感：${item.review}</div>
              </div>
            `;
          });
          peerContentBox.innerHTML = html;
        }
      }
      if (peerModal) peerModal.style.display = 'flex';
    }

    const savedTheme = localStorage.getItem('rpg_theme') || 'blue';
    if (themeSelect) {
      themeSelect.value = savedTheme;
      document.documentElement.setAttribute('data-theme', savedTheme);
    }
    themeSelect?.addEventListener('change', (e) => {
      const selected = (e.target as HTMLSelectElement).value;
      document.documentElement.setAttribute('data-theme', selected);
      localStorage.setItem('rpg_theme', selected);
    });

    libraryCloseBtn?.addEventListener('click', () => { if (libraryModal) libraryModal.style.display = 'none'; });

    async function syncMyStateToDB() {
      await supabase.from(TABLE_NAME).upsert({
        user_id: userId,
        name: playerName,
        role: playerRole,
        tier: playerTier,
        avatar: playerAvatar,
        room: currentRoom,
        gx: playerGx,
        gy: playerGy,
        is_dnd: isDND,
        task: currentTask,
        reading_log: myReadingLogs,
        updated_at: new Date()
      }, { onConflict: 'user_id' });
    }

    async function fetchOnlinePlayers() {
      const { data } = await supabase.from(TABLE_NAME).select('*').eq('room', currentRoom);
      if (data) {
        onlinePlayers = {};
        let count = 0;
        data.forEach((p: any) => {
          if (p.user_id !== userId) onlinePlayers[p.user_id] = p;
          count++;
        });
        if (onlineCountSpan) onlineCountSpan.textContent = String(count);
      }
    }

    async function fetchMessages() {
      const { data } = await supabase
        .from(MSG_TABLE_NAME)
        .select('*')
        .eq('room', currentRoom)
        .order('created_at', { ascending: true })
        .limit(30);

      if (data && chatMessagesBox) {
        let html = '';
        data.forEach(m => {
          const isPM = m.target_id !== null;
          const isMyPM = m.sender_id === userId || m.target_id === userId;
          if (!isPM || isMyPM) {
            const pmTag = isPM ? `[🔒 私訊]` : '';
            html += `<div class="chat-msg ${isPM ? 'pm' : ''}"><span class="chat-msg-author" data-sender-id="${m.sender_id}" data-sender-name="${m.sender_name}">${m.sender_name} ${pmTag}:</span><span class="chat-msg-text">${m.message}</span></div>`;
          }
        });
        chatMessagesBox.innerHTML = html;
        chatMessagesBox.scrollTop = chatMessagesBox.scrollHeight;
        bindChatAuthorClicks();
      }
    }

    function bindChatAuthorClicks() {
      document.querySelectorAll('.chat-msg-author').forEach(span => {
        span.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const sId = target.dataset.senderId;
          const sName = target.dataset.senderName;
          if (sId === userId) return;

          // 點擊聊天訊息中的名字：彈出選單（私訊 或 看記錄）
          if (sId && sName) {
            const action = confirm(`你想對書友「${sName}」做什麼？\n\n【確定】發起私人對話 (PM)\n【取消】查看其閱讀記錄`);
            if (action) {
              privateTargetId = sId;
              privateTargetName = sName;
              if (chatModeIndicator) chatModeIndicator.textContent = `🔒 私訊對象: ${sName}`;
              if (switchPublicBtn) switchPublicBtn.style.display = 'inline-block';
              if (chatPopupModal) chatPopupModal.style.display = 'flex';
            } else {
              // 找尋該玩家的閱讀記錄
              const peer = Object.values(onlinePlayers).find((p: any) => p.user_id === sId);
              if (peer) {
                openPeerLogs(peer.name, peer.role, peer.reading_log || []);
              } else {
                alert('暫時無法獲取該玩家的詳細記錄');
              }
            }
          }
        });
      });
    }

    function initDatabaseRealtime() {
      supabase.channel('db-changes').on('postgres_changes', { event: '*', schema: 'public', table: TABLE_NAME }, () => {
        fetchOnlinePlayers();
      }).subscribe();

      supabase.channel('chat-changes').on('postgres_changes', { event: 'INSERT', schema: 'public', table: MSG_TABLE_NAME }, (payload) => {
        if (payload.new && payload.new.room === currentRoom && chatMessagesBox) {
          const m = payload.new;
          const isPM = m.target_id !== null;
          const isMyPM = m.sender_id === userId || m.target_id === userId;
          if (!isPM || isMyPM) {
            const pmTag = isPM ? `[🔒 私訊]` : '';
            const div = document.createElement('div');
            div.className = `chat-msg ${isPM ? 'pm' : ''}`;
            div.innerHTML = `<span class="chat-msg-author" data-sender-id="${m.sender_id}" data-sender-name="${m.sender_name}">${m.sender_name} ${pmTag}:</span><span class="chat-msg-text">${m.message}</span>`;
            chatMessagesBox.appendChild(div);
            chatMessagesBox.scrollTop = chatMessagesBox.scrollHeight;
            bindChatAuthorClicks();
          }
        }
      }).subscribe();

      setInterval(() => { syncMyStateToDB(); fetchOnlinePlayers(); }, 5000);
    }

    chatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = chatInput?.value.trim();
      if (!text) return;

      await supabase.from(MSG_TABLE_NAME).insert({
        room: currentRoom,
        sender_id: userId,
        sender_name: playerName,
        target_id: privateTargetId,
        target_name: privateTargetName,
        message: text
      });

      if (chatInput) chatInput.value = '';
    });

    switchPublicBtn?.addEventListener('click', () => {
      privateTargetId = null;
      privateTargetName = null;
      if (chatModeIndicator) chatModeIndicator.textContent = '📢 公開發言中';
      if (switchPublicBtn) switchPublicBtn.style.display = 'none';
    });

    function getPlayerAtCell(gx: number, gy: number) {
      return Object.values(onlinePlayers).find((p: any) => p.gx === gx && p.gy === gy);
    }

    function isCellSolidBlocked(gx: number, gy: number): boolean {
      const maxCols = Math.floor(canvas.width / TILE_SIZE);
      const maxRows = Math.floor(canvas.height / TILE_SIZE);
      if (gx < 0 || gx >= maxCols || gy < 0 || gy >= maxRows) return true;

      const roomData = rooms[currentRoom];
      const hasItem = roomData.items.some(item => item.gx === gx && item.gy === gy);
      const hasNpc = roomData.npcs.some(npc => npc.gx === gx && npc.gy === gy);
      return hasItem || hasNpc;
    }

    if (savedName) {
      playerName = savedName;
      playerTier = savedTier;
      if (hudName) hudName.textContent = playerName;
      if (hudTierTag) hudTierTag.textContent = `👑 ${playerTier}`;
      if (modal) modal.style.display = 'none';

      // 👑 如果是店主，顯示椅子與書架按鈕
      if (playerTier === '店主') {
        if (buildPalette) buildPalette.style.display = 'flex';
        if (defaultPalette) defaultPalette.style.display = 'none';
      }

      isGameStarted = true;
      syncMyStateToDB().then(() => { fetchOnlinePlayers(); fetchMessages(); });
      initDatabaseRealtime();
      gameLoop();
    }

    startBtn?.addEventListener('click', async () => {
      const val = nameInput?.value.trim();
      if (!val) { alert('請輸入有效的稱號'); return; }

      const { data: existingUser } = await supabase.from(TABLE_NAME).select('*').eq('name', val).maybeSingle();
      if (existingUser && existingUser.user_id !== userId) {
        alert(`「${val}」這個稱號已經被其他書友使用了！`);
        return;
      }

      playerName = val;
      playerTier = tierSelect?.value || '鄰里人';

      const selectedAvatar = document.querySelector('input[name="player-avatar"]:checked') as HTMLInputElement;
      if (selectedAvatar) playerAvatar = selectedAvatar.value;
      const selectedRole = document.querySelector('input[name="user-role"]:checked') as HTMLInputElement;
      if (selectedRole) playerRole = selectedRole.value;

      localStorage.setItem('rpg_player_name', playerName);
      localStorage.setItem('rpg_player_avatar', playerAvatar);
      localStorage.setItem('rpg_player_role', playerRole);
      localStorage.setItem('rpg_player_tier', playerTier);

      if (hudName) hudName.textContent = playerName;
      if (hudTierTag) hudTierTag.textContent = `👑 ${playerTier}`;
      if (modal) modal.style.display = 'none';

      if (playerTier === '店主') {
        if (buildPalette) buildPalette.style.display = 'flex';
        if (defaultPalette) defaultPalette.style.display = 'none';
      }

      if (!isGameStarted) {
        isGameStarted = true;
        await syncMyStateToDB();
        await fetchOnlinePlayers();
        await fetchMessages();
        initDatabaseRealtime();
        gameLoop();
      }
    });

    logoutBtn?.addEventListener('click', async () => {
      await supabase.from(TABLE_NAME).delete().eq('user_id', userId);
      localStorage.clear();
      window.location.reload();
    });

    document.querySelectorAll('.channel-tab').forEach(tab => {
      tab.addEventListener('click', async (e) => {
        document.querySelectorAll('.channel-tab').forEach(t => t.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentRoom = target.dataset.room!;
        isDND = false;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
        playerGx = 4; playerGy = 7;
        moveQueue = [];
        await syncMyStateToDB();
        await fetchOnlinePlayers();
        await fetchMessages();
      });
    });

    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;
      });
    });

    canvas?.addEventListener('click', async (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      const targetGx = Math.floor(clickX / TILE_SIZE);
      const targetGy = Math.floor(clickY / TILE_SIZE);
      const roomData = rooms[currentRoom];

      if (currentTool === 'move') {
        // 👤 點擊其他線上玩家：查看其閱讀記錄
        const hitPlayer = getPlayerAtCell(targetGx, targetGy);
        if (hitPlayer) {
          openPeerLogs(hitPlayer.name, hitPlayer.role, hitPlayer.reading_log || []);
          return;
        }

        // 📚 點擊書櫃
        const hitShelf = roomData.items.find(item => item.type === 'shelf' && item.gx === targetGx && item.gy === targetGy);
        if (hitShelf) { if (libraryModal) libraryModal.style.display = 'flex'; return; }

        // 🪑 點擊椅子入座
        const hitSeat = roomData.items.find(item => item.type === 'seat' && item.gx === targetGx && item.gy === targetGy);
        if (hitSeat) {
          const isSeatTakenByOther = Object.values(onlinePlayers).some((p: any) => p.gx === hitSeat.gx && p.gy === hitSeat.gy && p.is_dnd);
          if (isSeatTakenByOther) { alert('這張椅子已經有其他書友入座囉！'); return; }

          pendingSeat = { gx: hitSeat.gx, gy: hitSeat.gy, label: hitSeat.label };
          if (seatModal) seatModal.style.display = 'flex';
        } else {
          if (!isCellSolidBlocked(targetGx, targetGy)) {
            moveQueue = [];
            let currX = playerGx;
            let currY = playerGy;
            while (currX !== targetGx) { currX += currX < targetGx ? 1 : -1; moveQueue.push({ gx: currX, gy: currY }); }
            while (currY !== targetGy) { currY += currY < targetGy ? 1 : -1; moveQueue.push({ gx: currX, gy: currY }); }
            if (isDND) { isDND = false; if (leaveSeatBtn) leaveSeatBtn.style.display = 'none'; }
          }
        }
      } else {
        // 👑 限制：只有店主才能建造與修改
        if (playerTier !== '店主') {
          alert('權限不足：只有「店主」階層才可編輯館內傢俱！');
          return;
        }

        const existingItemIndex = roomData.items.findIndex(item => item.gx === targetGx && item.gy === targetGy);
        if (existingItemIndex !== -1) {
          if (confirm('確定要移除此處的傢俱嗎？')) {
            roomData.items.splice(existingItemIndex, 1);
          }
        } else if (!isCellSolidBlocked(targetGx, targetGy) && !getPlayerAtCell(targetGx, targetGy) && !(playerGx === targetGx && playerGy === targetGy)) {
          const imgSrc = currentTool === 'shelf' ? '/assets/shelf.png' : '/assets/chair.png';
          roomData.items.push({ type: currentTool, gx: targetGx, gy: targetGy, label: currentTool === 'shelf' ? '新書架' : '新木椅', imgSrc });
        }
      }
    });

    confirmSeatBtn?.addEventListener('click', async () => {
      if (pendingSeat) {
        playerGx = pendingSeat.gx;
        playerGy = pendingSeat.gy;
        moveQueue = [];
        const bookName = bookInput?.value.trim() || '閱讀中';
        const chapter = parseInt(chapterInput?.value) || 1;
        currentTask = `${bookName} (第 ${chapter} 章)`;
        isDND = true;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        if (seatModal) seatModal.style.display = 'none';
        await syncMyStateToDB();
      }
    });

    cancelSeatBtn?.addEventListener('click', () => { if (seatModal) seatModal.style.display = 'none'; });

    leaveSeatBtn?.addEventListener('click', async () => {
      isDND = false;
      if (playerGy + 1 < Math.floor(canvas.height / TILE_SIZE) && !isCellSolidBlocked(playerGx, playerGy + 1)) {
        playerGy += 1;
      }
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      await syncMyStateToDB();
    });

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      const theme = document.documentElement.getAttribute('data-theme') || 'blue';
      const bgMap: Record<string, string> = { blue: '#0f172a', green: '#064e3b', purple: '#3b0764' };
      ctx.fillStyle = bgMap[theme] || '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += TILE_SIZE) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
      for (let y = 0; y < canvas.height; y += TILE_SIZE) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }

      const roomData = rooms[currentRoom];

      moveTimer++;
      if (moveQueue.length > 0 && moveTimer % 8 === 0) {
        const nextStep = moveQueue.shift()!;
        if (!isCellSolidBlocked(nextStep.gx, nextStep.gy)) {
          playerGx = nextStep.gx;
          playerGy = nextStep.gy;
          syncMyStateToDB();
        } else { moveQueue = []; }
      }

      roomData.items.forEach(item => {
        const px = item.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = item.gy * TILE_SIZE + TILE_SIZE / 2;
        const img = getLoadedImage(item.imgSrc);
        if (img && img.complete && img.naturalWidth !== 0) {
          ctx.drawImage(img, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = item.type === 'shelf' ? '#854d0e' : '#334155';
          ctx.fillRect(px - 14, py - 14, 28, 28);
        }
        ctx.fillStyle = '#f8fafc';
        ctx.font = '8px sans-serif';
        ctx.fillText(`${item.type === 'shelf' ? '📚' : '🪑'} ${item.label}`, px - 20, py - 18);
      });

      roomData.npcs.forEach(npc => {
        const px = npc.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = npc.gy * TILE_SIZE + TILE_SIZE / 2;
        const npcImg = getLoadedImage(npc.imgSrc);
        if (npcImg && npcImg.complete && npcImg.naturalWidth !== 0) {
          ctx.drawImage(npcImg, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#0284c7';
          ctx.fillRect(px - 12, py - 12, 24, 24);
        }
        ctx.fillStyle = '#f8fafc';
        ctx.font = '9px sans-serif';
        ctx.fillText(npc.name, px - 14, py - 18);
      });

      Object.values(onlinePlayers).forEach((op: any) => {
        const px = op.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = op.gy * TILE_SIZE + TILE_SIZE / 2;
        const opImg = getLoadedImage(op.avatar || '/assets/player2.png');
        if (opImg && opImg.complete && opImg.naturalWidth !== 0) {
          ctx.drawImage(opImg, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#10b981';
          ctx.fillRect(px - 12, py - 12, 24, 24);
        }
        ctx.fillStyle = '#34d399';
        ctx.font = '9px sans-serif';
        ctx.fillText(op.name, px - 20, py + 24);
      });

      const pScreenX = playerGx * TILE_SIZE + TILE_SIZE / 2;
      const pScreenY = playerGy * TILE_SIZE + TILE_SIZE / 2;
      const playerImg = getLoadedImage(playerAvatar);
      if (playerImg && playerImg.complete && playerImg.naturalWidth !== 0) {
        ctx.drawImage(playerImg, pScreenX - 16, pScreenY - 16, 32, 32);
      } else {
        ctx.fillStyle = isDND ? '#10b981' : '#38bdf8';
        ctx.fillRect(pScreenX - 12, pScreenY - 12, 24, 24);
      }
      ctx.fillStyle = '#f8fafc';
      ctx.font = '9px sans-serif';
      ctx.fillText(playerName, pScreenX - 20, pScreenY + 24);
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }
  </script>
</Layout>