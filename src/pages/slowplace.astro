---
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 晴空共讀空間">
  <!-- 1. 創角與頭像選擇 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 空間客舍 · 選擇稱號登入 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">午後的長沙灣天空湛藍。請選擇你的分身造型與獨一無二的書友稱號：</p>
        
        <div class="avatar-selector-label">選擇分身造型：</div>
        <div class="avatar-selector-group">
          <label class="avatar-card">
            <input type="radio" name="player-avatar" value="/assets/player1.png" checked />
            <img src="/assets/player1.png" alt="Player 1" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="avatar-fallback" style="display:none;">👤 P1</span>
            <span class="avatar-name">分身一號</span>
          </label>
          <label class="avatar-card">
            <input type="radio" name="player-avatar" value="/assets/player2.png" />
            <img src="/assets/player2.png" alt="Player 2" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <span class="avatar-fallback" style="display:none;">👤 P2</span>
            <span class="avatar-name">分身二號</span>
          </label>
        </div>

        <input type="text" id="rpg-name-input" placeholder="輸入你的稱號（例：尋書人）" maxlength="12" autofocus />
        
        <div class="role-selector-group">
          <label class="role-chip"><input type="radio" name="user-role" value="晴空選書" checked /> ☁️ 晴空選書</label>
          <label class="role-chip"><input type="radio" name="user-role" value="散文漫遊" /> 🍃 散文漫遊</label>
          <label class="role-chip"><input type="radio" name="user-role" value="靜心寫作" /> ✍️ 靜心寫作</label>
        </div>

        <button id="rpg-start-btn" class="rpg-btn">▶ 進入客舍空間</button>
      </div>
    </div>
  </div>

  <!-- 2. 入座 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>◆ 閱讀與專心設定 ◆</span></div>
      <div class="rpg-content">
        <p class="rpg-text">你在此處安坐。請輸入書名與目前的閱讀章節：</p>
        <input type="text" id="rpg-book-input" placeholder="書名（例：《少女核》）" maxlength="20" />
        <div class="progress-input-group">
          <span>進度：第</span>
          <input type="number" id="rpg-chapter-input" value="1" min="1" max="99" style="width: 60px; text-align:center;" />
          <span>章</span>
        </div>
        <div class="rpg-btn-group" style="margin-top: 14px;">
          <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="seat-confirm-btn" class="rpg-btn">☁️ 開啟專心 (DND)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 圖書館藏 Modal (點擊書櫃彈出 /library) -->
  <div id="library-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>📚 客舍館藏書單 (Library)</span>
        <button id="library-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe src="/library" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- 4. 玩家私訊對話 Modal (點擊玩家彈出 /chatroom) -->
  <div id="chat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="chat-modal-title">💬 與書友對話</span>
        <button id="chat-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe id="chat-iframe" src="/chatroom" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- 5. 主介面 (電腦版兼具手機直式框外包覆) -->
  <div class="app-viewport">
    <main class="rpg-container">
      <header class="rpg-hud">
        <div class="hud-top-row">
          <span class="hud-brand">☁️ 空間客舍</span>
          <div class="hud-right">
            <span class="online-indicator">🟢 在線: <strong id="online-count">1</strong></span>
            <span class="user-tag" id="hud-role-tag">☁️ 讀者</span>
            <strong id="hud-name" style="color: var(--accent-light, #e0f2fe);">旅人</strong>
            <a href="/" class="rpg-btn-sm" style="text-decoration:none;">🏠 離開</a>
          </div>
        </div>

        <div class="hud-mid-row">
          <div class="channel-tabs">
            <button class="channel-tab active" data-room="study">📖 自修室</button>
            <button class="channel-tab" data-room="chat">☕ 書話間</button>
            <button class="channel-tab" data-room="salon">🏛️ 沙龍</button>
          </div>
          <!-- 自選色調下拉選單 -->
          <div class="theme-picker">
            <select id="theme-select" class="theme-select-dropdown">
              <option value="blue">☁️ 晴空藍</option>
              <option value="green">🍃 森林綠</option>
              <option value="purple">🔮 暮光紫</option>
            </select>
          </div>
        </div>
      </header>

      <div class="canvas-wrapper">
        <canvas id="rpg-canvas" width="384" height="480"></canvas>
      </div>

      <footer class="rpg-footer">
        <div class="build-palette">
          <button class="tool-btn active" data-tool="move">🚶 移動</button>
          <button class="tool-btn" data-tool="seat">🪑 椅子</button>
          <button class="tool-btn" data-tool="shelf">📚 書架</button>
        </div>

        <div class="action-dock">
          <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background: var(--accent-color, #38bdf8); color:#0f172a; font-weight:bold;">🚶 起立</button>
          <button id="btn-moktak" class="rpg-btn-sm">🪵 木魚 (<span id="moktak-count">0</span>)</button>
        </div>
      </footer>
    </main>
  </div>

  <style is:global>
    /* CSS 動態主題變數 */
    :root {
      --bg-main: #0f172a;
      --bg-card: #1e293b;
      --border-color: #334155;
      --accent-color: #38bdf8;
      --accent-hover: #0284c7;
      --accent-light: #e0f2fe;
    }

    [data-theme="green"] {
      --bg-main: #064e3b;
      --bg-card: #065f46;
      --border-color: #047857;
      --accent-color: #34d399;
      --accent-hover: #059669;
      --accent-light: #d1fae5;
    }

    [data-theme="purple"] {
      --bg-main: #3b0764;
      --bg-card: #581c87;
      --border-color: #7e22ce;
      --accent-color: #c084fc;
      --accent-hover: #9333ea;
      --accent-light: #f3e8ff;
    }

    * {
      -webkit-tap-highlight-color: transparent;
      -webkit-touch-callout: none;
      user-select: none;
    }

    html, body {
      background-color: #020617;
      color: #cbd5e1;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      touch-action: manipulation;
    }

    /* 電腦版手機外框容器 */
    .app-viewport {
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #020617;
    }

    .rpg-container {
      width: 100vw;
      max-width: 414px;
      height: 100vh;
      height: 100dvh;
      max-height: 896px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      box-sizing: border-box;
      background-color: var(--bg-main);
      border-left: 1px solid var(--border-color);
      border-right: 1px solid var(--border-color);
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.8);
      transition: background-color 0.3s ease;
    }

    .rpg-modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .rpg-window { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; width: 90%; max-width: 360px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
    
    .embed-window { max-width: 390px; height: 80vh; display: flex; flex-direction: column; overflow: hidden; }
    .embed-frame-wrapper { flex: 1; width: 100%; background: #ffffff; }
    .embed-iframe { width: 100%; height: 100%; border: none; }

    .rpg-title-bar { background: var(--bg-main); color: var(--accent-color); padding: 12px 16px; font-size: 13px; font-weight: 500; border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom: 1px solid var(--border-color); }
    .rpg-content { padding: 18px; }
    .rpg-text { font-size: 13px; color: #94a3b8; margin-bottom: 14px; line-height: 1.5; }
    
    .avatar-selector-label { font-size: 12px; color: #94a3b8; margin-bottom: 6px; }
    .avatar-selector-group { display: flex; gap: 10px; margin-bottom: 14px; }
    .avatar-card { flex: 1; background: var(--bg-main); border: 2px solid var(--border-color); border-radius: 8px; padding: 8px; text-align: center; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .avatar-card input { display: none; }
    .avatar-card input:checked + img, .avatar-card input:checked ~ .avatar-fallback { border-color: var(--accent-color); }
    .avatar-card input:checked ~ .avatar-name { color: var(--accent-color); font-weight: bold; }
    .avatar-card img { width: 40px; height: 40px; object-fit: contain; image-rendering: pixelated; border-radius: 4px; background: var(--bg-card); padding: 2px; }
    .avatar-fallback { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--bg-card); border-radius: 4px; font-size: 12px; color: var(--accent-color); }
    .avatar-name { font-size: 11px; color: #cbd5e1; }

    .rpg-window input[type="text"], .rpg-window input[type="number"] { width: 100%; background: var(--bg-main); border: 1px solid var(--border-color); color: #f8fafc; padding: 10px; font-size: 13px; box-sizing: border-box; margin-bottom: 12px; outline: none; border-radius: 8px; }
    .role-selector-group { display: flex; gap: 6px; margin-bottom: 14px; }
    .role-chip { background: var(--bg-main); border: 1px solid var(--border-color); padding: 6px 10px; border-radius: 16px; font-size: 11px; cursor: pointer; color: #cbd5e1; }
    .role-chip input { margin-right: 4px; accent-color: var(--accent-color); }
    .progress-input-group { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #94a3b8; }
    .rpg-btn { background: var(--accent-hover); color: #f8fafc; border: none; padding: 10px; font-size: 13px; cursor: pointer; width: 100%; font-weight: 500; border-radius: 8px; }
    .rpg-btn-ghost { background: transparent; color: #94a3b8; border: 1px solid var(--border-color); padding: 10px; font-size: 13px; cursor: pointer; width: 100%; border-radius: 8px; }
    .rpg-btn-group { display: flex; gap: 8px; }

    .rpg-hud { background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 8px 12px; font-size: 12px; flex-shrink: 0; }
    .hud-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .hud-brand { font-weight: 600; color: var(--accent-color); }
    .hud-right { display: flex; align-items: center; gap: 8px; }
    .online-indicator { color: #34d399; }
    .user-tag { background: var(--bg-main); border: 1px solid var(--border-color); padding: 2px 6px; border-radius: 8px; font-size: 10px; color: var(--accent-color); }
    
    .hud-mid-row { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .channel-tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; }
    .channel-tab { background: var(--bg-main); color: #94a3b8; border: 1px solid var(--border-color); padding: 4px 10px; font-size: 11px; cursor: pointer; border-radius: 14px; white-space: nowrap; }
    .channel-tab.active { background: var(--accent-hover); color: #f8fafc; border-color: var(--accent-hover); font-weight: 500; }
    
    .theme-select-dropdown { background: var(--bg-main); color: var(--accent-color); border: 1px solid var(--border-color); padding: 3px 6px; font-size: 11px; border-radius: 8px; outline: none; cursor: pointer; }

    .rpg-btn-sm { background: var(--bg-main); color: #cbd5e1; border: 1px solid var(--border-color); padding: 4px 8px; font-size: 11px; cursor: pointer; border-radius: 6px; }
    
    .canvas-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; background: #020617; padding: 4px; overflow: hidden; min-height: 0; }
    #rpg-canvas { border: 1px solid var(--border-color); background: var(--bg-main); cursor: pointer; image-rendering: pixelated; border-radius: 8px; width: 100%; max-width: 384px; height: 100%; max-height: 480px; object-fit: contain; }
    
    .rpg-footer { background: var(--bg-card); border-top: 1px solid var(--border-color); padding: 8px 12px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
    .build-palette { display: flex; gap: 6px; }
    .tool-btn { background: var(--bg-main); color: #94a3b8; border: 1px solid var(--border-color); padding: 6px 10px; font-size: 11px; cursor: pointer; border-radius: 6px; }
    .tool-btn.active { background: var(--accent-hover); color: #f8fafc; border-color: var(--accent-hover); font-weight: 500; }
    .action-dock { display: flex; align-items: center; gap: 6px; }
  </style>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const SUPABASE_URL = 'https://blqlrxqckiuvgevmakbu.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
    const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const TABLE_NAME = 'slowsplace_member';
    const TILE_SIZE = 32;

    const userId = localStorage.getItem('rpg_user_id') || ('user_' + Math.random().toString(36).substring(2, 9));
    localStorage.setItem('rpg_user_id', userId);

    const savedName = localStorage.getItem('rpg_player_name');
    const savedAvatar = localStorage.getItem('rpg_player_avatar');
    const savedRole = localStorage.getItem('rpg_player_role');

    let playerName = savedName || '冒險者';
    let playerRole = savedRole || '☁️ 讀者';
    let playerAvatar = savedAvatar || '/assets/player1.png';
    let playerGx = 4;
    let playerGy = 12;
    let currentTool = 'move';
    let currentRoom = 'study';
    let isDND = false;
    let currentTask = '';
    let moktakCount = 0;

    let moveQueue: { gx: number; gy: number }[] = [];
    let moveTimer = 0;
    let onlinePlayers: Record<string, any> = {};

    const imageCache: Record<string, HTMLImageElement> = {};
    const imageFailed: Record<string, boolean> = {};

    function getLoadedImage(src: string): HTMLImageElement | null {
      if (imageFailed[src]) return null;
      if (!imageCache[src]) {
        const img = new Image();
        img.onerror = () => { imageFailed[src] = true; };
        img.src = src;
        imageCache[src] = img;
      }
      return imageFailed[src] ? null : imageCache[src];
    }

    const rooms: Record<string, { 
      name: string; 
      items: { type: string; gx: number; gy: number; label: string; imgSrc: string }[];
      npcs: { name: string; task: string; gx: number; gy: number; imgSrc: string }[];
    }> = {
      study: {
        name: '自修室',
        items: [
          { type: 'seat', gx: 3, gy: 5, label: '木椅 A', imgSrc: '/assets/chair.png' },
          { type: 'seat', gx: 8, gy: 5, label: '木椅 B', imgSrc: '/assets/chair.png' },
          { type: 'shelf', gx: 5, gy: 2, label: '書櫃', imgSrc: '/assets/shelf.png' }
        ],
        npcs: [
          { name: 'Mi', task: '整理筆記', gx: 10, gy: 3, imgSrc: '/assets/npc_mi.png' }
        ]
      },
      chat: {
        name: '書話間',
        items: [
          { type: 'seat', gx: 3, gy: 6, label: '沙發', imgSrc: '/assets/chair.png' },
          { type: 'shelf', gx: 10, gy: 2, label: '熱門書架', imgSrc: '/assets/shelf.png' }
        ],
        npcs: [
          { name: '實習生', task: '澆花', gx: 8, gy: 10, imgSrc: '/assets/intern.png' }
        ]
      },
      salon: {
        name: '沙龍',
        items: [
          { type: 'seat', gx: 6, gy: 4, label: '講者席', imgSrc: '/assets/chair.png' },
          { type: 'shelf', gx: 2, gy: 2, label: '沙龍選書', imgSrc: '/assets/shelf.png' }
        ],
        npcs: []
      }
    };

    const modal = document.getElementById('rpg-modal');
    const seatModal = document.getElementById('seat-modal');
    const libraryModal = document.getElementById('library-modal');
    const libraryCloseBtn = document.getElementById('library-close-btn');
    
    // 💬 對話彈窗 DOM 元素
    const chatModal = document.getElementById('chat-modal');
    const chatCloseBtn = document.getElementById('chat-close-btn');
    const chatIframe = document.getElementById('chat-iframe') as HTMLIFrameElement;
    const chatModalTitle = document.getElementById('chat-modal-title');

    const nameInput = document.getElementById('rpg-name-input') as HTMLInputElement;
    const bookInput = document.getElementById('rpg-book-input') as HTMLInputElement;
    const chapterInput = document.getElementById('rpg-chapter-input') as HTMLInputElement;
    const startBtn = document.getElementById('rpg-start-btn');
    const confirmSeatBtn = document.getElementById('seat-confirm-btn');
    const cancelSeatBtn = document.getElementById('seat-cancel-btn');
    const hudName = document.getElementById('hud-name');
    const hudRoleTag = document.getElementById('hud-role-tag');
    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');
    const moktakBtn = document.getElementById('btn-moktak');
    const moktakCountSpan = document.getElementById('moktak-count');
    const onlineCountSpan = document.getElementById('online-count');
    const themeSelect = document.getElementById('theme-select') as HTMLSelectElement;

    let pendingSeat: { gx: number; gy: number; label: string } | null = null;
    let isGameStarted = false;

    const savedTheme = localStorage.getItem('rpg_theme') || 'blue';
    if (themeSelect) {
      themeSelect.value = savedTheme;
      document.documentElement.setAttribute('data-theme', savedTheme);
    }
    themeSelect?.addEventListener('change', (e) => {
      const selected = (e.target as HTMLSelectElement).value;
      document.documentElement.setAttribute('data-theme', selected);
      localStorage.setItem('rpg_theme', selected);
    });

    libraryCloseBtn?.addEventListener('click', () => {
      if (libraryModal) libraryModal.style.display = 'none';
    });

    chatCloseBtn?.addEventListener('click', () => {
      if (chatModal) chatModal.style.display = 'none';
    });

    async function syncMyStateToDB() {
      await supabase.from(TABLE_NAME).upsert({
        user_id: userId,
        name: playerName,
        role: playerRole,
        avatar: playerAvatar,
        room: currentRoom,
        gx: playerGx,
        gy: playerGy,
        is_dnd: isDND,
        task: currentTask,
        updated_at: new Date()
      }, { onConflict: 'user_id' });
    }

    async function fetchOnlinePlayers() {
      const { data } = await supabase
        .from(TABLE_NAME)
        .select('*')
        .eq('room', currentRoom);

      if (data) {
        onlinePlayers = {};
        let count = 0;
        data.forEach((p: any) => {
          if (p.user_id !== userId) {
            onlinePlayers[p.user_id] = p;
          }
          count++;
        });
        if (onlineCountSpan) onlineCountSpan.textContent = String(count);
      }
    }

    function initDatabaseRealtime() {
      supabase
        .channel('db-changes')
        .on('postgres_changes', { event: '*', schema: 'public', table: TABLE_NAME }, () => {
          fetchOnlinePlayers();
        })
        .subscribe();

      setInterval(() => {
        syncMyStateToDB();
        fetchOnlinePlayers();
      }, 5000);
    }

    // 取得在該座標上的其他玩家物件
    function getPlayerAtCell(gx: number, gy: number) {
      return Object.values(onlinePlayers).find((p: any) => p.gx === gx && p.gy === gy);
    }

    function isCellOccupiedByOther(gx: number, gy: number): boolean {
      return !!getPlayerAtCell(gx, gy);
    }

    function isCellSolidBlocked(gx: number, gy: number): boolean {
      const maxCols = Math.floor(canvas.width / TILE_SIZE);
      const maxRows = Math.floor(canvas.height / TILE_SIZE);
      if (gx < 0 || gx >= maxCols || gy < 0 || gy >= maxRows) return true;

      const roomData = rooms[currentRoom];
      const hasItem = roomData.items.some(item => item.gx === gx && item.gy === gy);
      const hasNpc = roomData.npcs.some(npc => npc.gx === gx && npc.gy === gy);
      return hasItem || hasNpc;
    }

    if (savedName) {
      playerName = savedName;
      if (hudName) hudName.textContent = playerName;
      if (hudRoleTag) hudRoleTag.textContent = playerRole;
      if (modal) modal.style.display = 'none';
      isGameStarted = true;
      syncMyStateToDB().then(() => fetchOnlinePlayers());
      initDatabaseRealtime();
      gameLoop();
    }

    startBtn?.addEventListener('click', async () => {
      const val = nameInput?.value.trim();
      if (!val) {
        alert('請輸入有效的稱號');
        return;
      }

      const { data: existingUser } = await supabase
        .from(TABLE_NAME)
        .select('*')
        .eq('name', val)
        .maybeSingle();

      if (existingUser && existingUser.user_id !== userId) {
        alert(`「${val}」這個稱號已經被其他書友使用了！`);
        return;
      }

      playerName = val;

      const selectedAvatar = document.querySelector('input[name="player-avatar"]:checked') as HTMLInputElement;
      if (selectedAvatar) playerAvatar = selectedAvatar.value;

      const selectedRole = document.querySelector('input[name="user-role"]:checked') as HTMLInputElement;
      if (selectedRole) playerRole = selectedRole.value;

      localStorage.setItem('rpg_player_name', playerName);
      localStorage.setItem('rpg_player_avatar', playerAvatar);
      localStorage.setItem('rpg_player_role', playerRole);

      if (hudName) hudName.textContent = playerName;
      if (hudRoleTag) hudRoleTag.textContent = playerRole;
      if (modal) modal.style.display = 'none';

      if (!isGameStarted) {
        isGameStarted = true;
        await syncMyStateToDB();
        await fetchOnlinePlayers();
        initDatabaseRealtime();
        gameLoop();
      }
    });

    document.querySelectorAll('.channel-tab').forEach(tab => {
      tab.addEventListener('click', async (e) => {
        document.querySelectorAll('.channel-tab').forEach(t => t.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentRoom = target.dataset.room!;
        isDND = false;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
        playerGx = 4; playerGy = 12;
        moveQueue = [];
        await syncMyStateToDB();
        await fetchOnlinePlayers();
      });
    });

    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;
      });
    });

    canvas?.addEventListener('click', async (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      const targetGx = Math.floor(clickX / TILE_SIZE);
      const targetGy = Math.floor(clickY / TILE_SIZE);
      const roomData = rooms[currentRoom];

      if (currentTool === 'move') {
        // 💬 1. 檢查是否點擊了「其他線上玩家」：開啟聊天室 modal
        const hitPlayer = getPlayerAtCell(targetGx, targetGy);
        if (hitPlayer) {
          if (chatModalTitle) chatModalTitle.textContent = `💬 與書友「${hitPlayer.name}」對話`;
          if (chatIframe) {
            chatIframe.src = `/chatroom?targetUser=${encodeURIComponent(hitPlayer.user_id)}&targetName=${encodeURIComponent(hitPlayer.name)}`;
          }
          if (chatModal) chatModal.style.display = 'flex';
          return;
        }

        // 📚 2. 檢查點擊書櫃
        const hitShelf = roomData.items.find(item => item.type === 'shelf' && item.gx === targetGx && item.gy === targetGy);
        if (hitShelf) {
          if (libraryModal) libraryModal.style.display = 'flex';
          return;
        }

        // 🪑 3. 檢查點擊椅子
        const hitSeat = roomData.items.find(item => item.type === 'seat' && item.gx === targetGx && item.gy === targetGy);
        if (hitSeat) {
          const isSeatTakenByOther = Object.values(onlinePlayers).some((p: any) => p.gx === hitSeat.gx && p.gy === hitSeat.gy && p.is_dnd);
          if (isSeatTakenByOther) {
            alert('這張椅子已經有其他書友入座囉！');
            return;
          }

          pendingSeat = { gx: hitSeat.gx, gy: hitSeat.gy, label: hitSeat.label };
          if (seatModal) seatModal.style.display = 'flex';
        } else {
          // 🚶 4. 普通格子移動
          if (!isCellSolidBlocked(targetGx, targetGy)) {
            moveQueue = [];
            let currX = playerGx;
            let currY = playerGy;

            while (currX !== targetGx) {
              currX += currX < targetGx ? 1 : -1;
              moveQueue.push({ gx: currX, gy: currY });
            }
            while (currY !== targetGy) {
              currY += currY < targetGy ? 1 : -1;
              moveQueue.push({ gx: currX, gy: currY });
            }

            if (isDND) {
              isDND = false;
              if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
            }
          }
        }
      } else {
        if (!isCellSolidBlocked(targetGx, targetGy) && !isCellOccupiedByOther(targetGx, targetGy) && !(playerGx === targetGx && playerGy === targetGy)) {
          const imgSrc = currentTool === 'shelf' ? '/assets/shelf.png' : '/assets/chair.png';
          roomData.items.push({ type: currentTool, gx: targetGx, gy: targetGy, label: '傢俱', imgSrc });
        }
      }
    });

    confirmSeatBtn?.addEventListener('click', async () => {
      if (pendingSeat) {
        playerGx = pendingSeat.gx;
        playerGy = pendingSeat.gy;
        moveQueue = [];
        const bookName = bookInput?.value.trim() || '閱讀中';
        const chapter = parseInt(chapterInput?.value) || 1;
        currentTask = `${bookName} (第 ${chapter} 章)`;
        isDND = true;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        if (seatModal) seatModal.style.display = 'none';
        await syncMyStateToDB();
      }
    });

    cancelSeatBtn?.addEventListener('click', () => {
      if (seatModal) seatModal.style.display = 'none';
    });

    leaveSeatBtn?.addEventListener('click', async () => {
      isDND = false;
      if (playerGy + 1 < Math.floor(canvas.height / TILE_SIZE) && !isCellSolidBlocked(playerGx, playerGy + 1)) {
        playerGy += 1;
      }
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      await syncMyStateToDB();
    });

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      const theme = document.documentElement.getAttribute('data-theme') || 'blue';
      const bgMap: Record<string, string> = {
        blue: '#0f172a',
        green: '#064e3b',
        purple: '#3b0764'
      };
      
      ctx.fillStyle = bgMap[theme] || '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += TILE_SIZE) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
      }
      for (let y = 0; y < canvas.height; y += TILE_SIZE) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
      }

      const roomData = rooms[currentRoom];

      moveTimer++;
      if (moveQueue.length > 0 && moveTimer % 8 === 0) {
        const nextStep = moveQueue.shift()!;
        if (!isCellSolidBlocked(nextStep.gx, nextStep.gy)) {
          playerGx = nextStep.gx;
          playerGy = nextStep.gy;
          syncMyStateToDB();
        } else {
          moveQueue = [];
        }
      }

      // 1. 繪製傢俱
      roomData.items.forEach(item => {
        const px = item.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = item.gy * TILE_SIZE + TILE_SIZE / 2;
        const img = getLoadedImage(item.imgSrc);
        
        if (img && img.complete && img.naturalWidth !== 0) {
          ctx.drawImage(img, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = item.type === 'shelf' ? '#854d0e' : '#334155';
          ctx.fillRect(px - 14, py - 14, 28, 28);
        }
        ctx.fillStyle = '#f8fafc';
        ctx.font = '8px sans-serif';
        ctx.fillText(`${item.type === 'shelf' ? '📚' : '🪑'} ${item.label}`, px - 20, py - 18);
      });

      // 2. 繪製 NPC
      roomData.npcs.forEach(npc => {
        const px = npc.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = npc.gy * TILE_SIZE + TILE_SIZE / 2;
        const npcImg = getLoadedImage(npc.imgSrc);
        
        if (npcImg && npcImg.complete && npcImg.naturalWidth !== 0) {
          ctx.drawImage(npcImg, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#0284c7';
          ctx.fillRect(px - 12, py - 12, 24, 24);
        }
        ctx.fillStyle = '#f8fafc';
        ctx.font = '9px sans-serif';
        ctx.fillText(npc.name, px - 14, py - 18);
      });

      // 3. 繪製其他線上玩家
      Object.values(onlinePlayers).forEach((op: any) => {
        const px = op.gx * TILE_SIZE + TILE_SIZE / 2;
        const py = op.gy * TILE_SIZE + TILE_SIZE / 2;
        const opImg = getLoadedImage(op.avatar || '/assets/player2.png');

        if (opImg && opImg.complete && opImg.naturalWidth !== 0) {
          ctx.drawImage(opImg, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#10b981';
          ctx.fillRect(px - 12, py - 12, 24, 24);
        }

        ctx.fillStyle = '#34d399';
        ctx.font = '9px sans-serif';
        ctx.fillText(op.name, px - 20, py + 24);
      });

      // 4. 繪製自己
      const pScreenX = playerGx * TILE_SIZE + TILE_SIZE / 2;
      const pScreenY = playerGy * TILE_SIZE + TILE_SIZE / 2;
      const playerImg = getLoadedImage(playerAvatar);

      if (playerImg && playerImg.complete && playerImg.naturalWidth !== 0) {
        ctx.drawImage(playerImg, pScreenX - 16, pScreenY - 16, 32, 32);
      } else {
        ctx.fillStyle = isDND ? '#10b981' : '#38bdf8';
        ctx.fillRect(pScreenX - 12, pScreenY - 12, 24, 24);
      }

      ctx.fillStyle = '#f8fafc';
      ctx.font = '9px sans-serif';
      ctx.fillText(playerName, pScreenX - 20, pScreenY + 24);
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    moktakBtn?.addEventListener('click', () => {
      moktakCount++;
      if (moktakCountSpan) moktakCountSpan.textContent = String(moktakCount);
    });
  </script>
</Layout>