---
// src/pages/test.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="空間客舍 · 自由佈置空間">


  <!-- 2. 圖書館藏 Modal -->
  <div id="library-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>📚 客舍館藏書單 (Library)</span>
        <button id="library-close-btn" class="rpg-btn-sm" style="padding:4px 10px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe src="/library" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- 3. 共讀桌活動 Modal -->
  <div id="table-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span id="table-modal-title">📖 共讀桌活動</span></div>
      <div class="rpg-content">
        <div id="table-form-view" style="display:none;">
          <p class="rpg-text">此桌目前為空桌，由你來發起一場新的共讀活動：</p>
          <input type="text" id="table-book" placeholder="共讀書名" style="margin-bottom:8px;" />
          <input type="text" id="table-author" placeholder="作者" style="margin-bottom:8px;" />
          <div style="font-size:11px; color:var(--text-muted); margin-bottom:4px;">限制參加人數：</div>
          <input type="number" id="table-max" value="3" min="1" max="10" style="margin-bottom:8px;" />
          <div style="font-size:11px; color:var(--text-muted); margin-bottom:4px;">預定完讀日期：</div>
          <input type="date" id="table-date" style="width:100%; background:var(--bg-input); border:1px solid var(--border-color); color:var(--text-color); padding:10px; border-radius:12px; margin-bottom:14px;" />
          <div class="rpg-btn-group">
            <button id="table-cancel-btn" class="rpg-btn-ghost">取消</button>
            <button id="table-create-btn" class="rpg-btn">✨ 發起共讀</button>
          </div>
        </div>

        <div id="table-info-view" style="display:none;">
          <div id="table-details" style="font-size:12px; line-height:1.6; color:var(--text-color); margin-bottom:14px;"></div>
          <div class="rpg-btn-group" style="flex-direction:column; gap:8px;">
            <button id="table-join-btn" class="rpg-btn" style="background:var(--success-color); color:#fff;">🤝 加入共讀</button>
            <button id="table-end-btn" class="rpg-btn" style="background:var(--danger-color); color:#fff; display:none;">🛑 結束共讀</button>
            <button id="table-info-close" class="rpg-btn-ghost">關閉</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3.5 木椅閱讀角 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span id="seat-modal-title">🪑 木椅閱讀角</span></div>
      <div class="rpg-content">
        <div id="seat-form-view" style="display:none;">
          <p class="rpg-text">請選擇您的閱讀記錄或手動輸入新書：</p>
          
          <div style="font-size:11px; color:var(--text-muted); margin-bottom:4px;">從個人閱讀記錄選擇：</div>
          <select id="seat-record-select" style="width:100%; background:var(--bg-input); color:var(--text-color); border:1px solid var(--border-color); padding:10px; border-radius:12px; margin-bottom:10px;">
            <option value="">-- 手動輸入新書 --</option>
          </select>

          <input type="text" id="seat-book-input" placeholder="書名（例：少女核）" style="margin-bottom:8px;" />
          <input type="text" id="seat-author-input" placeholder="作者（選填）" style="margin-bottom:8px;" />
          
          <div style="display:flex; gap:8px; margin-bottom:14px;">
            <div style="flex:1;">
              <div style="font-size:10px; color:var(--text-muted); margin-bottom:2px;">目前頁數</div>
              <input type="number" id="seat-current-page" value="1" min="0" style="margin-bottom:0;" />
            </div>
            <div style="flex:1;">
              <div style="font-size:10px; color:var(--text-muted); margin-bottom:2px;">總頁數</div>
              <input type="number" id="seat-total-page" value="100" min="1" style="margin-bottom:0;" />
            </div>
          </div>

          <div class="rpg-btn-group">
            <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
            <button id="seat-sit-btn" class="rpg-btn" style="background:var(--success-color); color:#fff;">✨ 坐下閱讀</button>
          </div>
        </div>

        <div id="seat-info-view" style="display:none;">
          <div id="seat-details" style="font-size:12px; line-height:1.6; color:var(--text-color); margin-bottom:14px;"></div>
          <button id="seat-info-close" class="rpg-btn-ghost">關閉</button>
        </div>

        <div id="seat-update-view" style="display:none;">
          <p class="rpg-text">準備起立！要順便更新目前的閱讀進度嗎？</p>
          <div style="display:flex; gap:8px; margin-bottom:14px;">
            <div style="flex:1;">
              <div style="font-size:10px; color:var(--text-muted); margin-bottom:2px;">目前頁數</div>
              <input type="number" id="leave-current-page" value="1" min="0" style="margin-bottom:0;" />
            </div>
            <div style="flex:1;">
              <div style="font-size:10px; color:var(--text-muted); margin-bottom:2px;">總頁數</div>
              <input type="number" id="leave-total-page" value="100" min="1" style="margin-bottom:0;" />
            </div>
          </div>
          <div class="rpg-btn-group">
            <button id="leave-confirm-btn" class="rpg-btn" style="background:var(--success-color); color:#fff;">✅ 確認並起立</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3.6 讀者手帳名片與私訊 Modal -->
  <div id="player-card-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="pc-title">📖 讀者手帳名片</span>
        <button id="pc-close-btn" class="rpg-btn-sm" style="background:transparent; border:none; font-weight:bold; color:var(--text-color);">✕</button>
      </div>
      <div class="rpg-content">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px;">
          <img id="pc-avatar" src="/assets/player1.png" style="width:48px; height:48px; border-radius:50%; background:var(--bg-input); object-fit:cover;" />
          <div>
            <div id="pc-name" style="font-weight:700; font-size:15px; color:var(--text-color);">旅人</div>
            <div id="pc-tier" style="font-size:11px; color:var(--text-muted); margin-top:2px;">🌱 鄰里人</div>
          </div>
        </div>

        <div style="background:var(--bg-input); border:1px solid var(--border-color); padding:12px; border-radius:12px; font-size:12px; margin-bottom:14px; line-height:1.6; color:var(--text-color);">
          <div style="margin-bottom:8px;"><strong>📚 正在閱讀：</strong><span id="pc-current-book">尚無記錄</span></div>
          <div style="margin-bottom:4px;"><strong>🤝 參與共讀：</strong><span id="pc-table-book">目前未參與共讀</span></div>
        </div>

        <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:14px;">
          <button id="pc-view-records-btn" class="rpg-btn" style="background:var(--accent-hover); color:#fff;">📜 查看他的閱讀記錄</button>
        </div>

        <div style="border-top:1px dashed var(--border-color); padding-top:12px;">
          <div style="font-size:11px; color:var(--text-muted); margin-bottom:4px;">即時私訊對話：</div>
          <button id="pc-dm-btn" class="rpg-btn" style="background:var(--success-color); color:#fff;">💬 開啟私訊對話</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3.7 他人閱讀記錄列表 Modal -->
  <div id="other-records-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="orc-title">📜 讀者閱讀足跡</span>
        <button id="orc-close-btn" class="rpg-btn-sm" style="background:transparent; border:none; font-weight:bold; color:var(--text-color);">✕</button>
      </div>
      <div class="rpg-content">
        <div id="orc-list-box" style="max-height: 260px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
          載入中...
        </div>
        <button id="orc-close-footer" class="rpg-btn-ghost">關閉</button>
      </div>
    </div>
  </div>

  <!-- 3.8 即時私訊聊天室 Modal -->
  <div id="dm-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 380px; height: 480px; display: flex; flex-direction: column;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="dm-title">💬 與 旅人 的私訊對話</span>
        <button id="dm-close-btn" class="rpg-btn-sm" style="background:transparent; border:none; font-weight:bold; color:var(--text-color);">✕</button>
      </div>
      <div class="rpg-content" style="flex: 1; display: flex; flex-direction: column; padding: 12px; overflow: hidden;">
        <div id="dm-messages-box" style="flex: 1; background: var(--bg-input); border: 1px solid var(--border-color); border-radius: 12px; padding: 10px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; font-size: 12px;">
          載入對話中...
        </div>
        <div style="display: flex; gap: 6px;">
          <input type="text" id="dm-input" placeholder="輸入私訊內容..." style="margin-bottom: 0; flex: 1;" />
          <button id="dm-send-btn" class="rpg-btn" style="width: auto; padding: 0 14px; background: var(--success-color); color: #fff;">發送</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 彈出網頁視窗 -->
  <div id="custom-modal-frame" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="custom-modal-title">📄 內容預覽</span>
        <button id="custom-modal-close" class="rpg-btn-sm" style="padding:4px 10px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe id="custom-modal-iframe" src="" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- 5. 編輯/新增空間物件 Modal -->
  <div id="custom-furniture-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span id="cf-modal-title">✏️ 修改空間物件</span></div>
      <div class="rpg-content">
        <p class="rpg-text">設定物件名稱、圖片、說明及點擊後的連結行為：</p>
        <input type="hidden" id="cf-edit-id" value="" />
        <input type="text" id="cf-name" placeholder="名稱（例：自定書櫃）" maxlength="15" style="margin-bottom:8px;" />
        <input type="text" id="cf-img" placeholder="圖片路徑（例：/assets/shelf.png）" style="margin-bottom:8px;" />
        <input type="text" id="cf-link" placeholder="連結網址（無則留空）" style="margin-bottom:8px;" />
        
        <div style="font-size:11px; color:var(--text-muted); margin-bottom:4px;">連結開啟方式：</div>
        <select id="cf-open-type" style="width:100%; background:var(--bg-input); color:var(--text-color); border:1px solid var(--border-color); padding:10px; border-radius:12px; margin-bottom:8px;">
          <option value="current">🌐 在當前頁面跳轉 (預設)</option>
          <option value="blank">📑 在新分頁開啟 (_blank)</option>
          <option value="modal">🪟 以彈出視窗 (Modal) 顯示</option>
        </select>

        <textarea id="cf-desc" placeholder="物件說明文字..." style="width:100%; height:60px; background:var(--bg-input); color:var(--text-color); border:1px solid var(--border-color); border-radius:12px; padding:10px; font-size:12px; resize:none; outline:none; box-sizing:border-box; margin-bottom:8px;"></textarea>
        
        <div style="display:flex; gap:8px; margin-bottom:10px;">
          <input type="number" id="cf-w" placeholder="寬度 (格)" value="1" min="1" max="4" style="flex:1; margin-bottom:0;" />
          <input type="number" id="cf-h" placeholder="高度 (格)" value="1" min="1" max="4" style="flex:1; margin-bottom:0;" />
        </div>

        <div class="rpg-btn-group" style="margin-top:12px;">
          <button id="cf-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="cf-confirm-btn" class="rpg-btn">✨ 儲存變更</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. 店主新增房間/設定背景 Modal -->
  <div id="room-settings-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>🏠 房間與背景設定 (店主專用)</span></div>
      <div class="rpg-content">
        <p class="rpg-text">新增房間代碼、房間名稱、背景圖網址及格子數量：</p>
        <input type="text" id="rs-room-key" placeholder="房間代碼（例：reading_room）" style="margin-bottom:8px;" />
        <input type="text" id="rs-room-name" placeholder="房間顯示名稱（例：📖 靜心閱覽室）" style="margin-bottom:8px;" />
        <input type="text" id="rs-bg-img" placeholder="背景圖片網址（留空則使用純色背景）" style="margin-bottom:8px;" />
        <div style="font-size:11px; color:var(--text-muted); margin-bottom:4px;">格子大小 (預設 12x12)：</div>
        <input type="number" id="rs-grid-size" placeholder="格子數 (預設 12)" value="12" min="6" max="30" style="margin-bottom:14px;" />
        <div class="rpg-btn-group">
          <button id="rs-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="rs-confirm-btn" class="rpg-btn">✨ 建立並儲存房間</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 主介面 (沈浸式視口與大圓角容器) -->

    <main >
      <header class="rpg-hud" id="rpg-hud">
        <div class="hud-top-row">
          <span class="hud-brand">☁️ 空間客舍</span>
          <div class="hud-right">
            <span class="online-indicator">🟢 在線: <strong id="online-count">1</strong></span>
            <span class="user-tag" id="hud-tier-tag">🌱 鄰里人</span>
            <strong id="hud-name" style="color: var(--accent-hover);">旅人</strong>
            <button id="logout-btn" class="rpg-btn-sm" style="background:var(--danger-color); color:#fff; border:none;">🚪 登出</button>
          </div>
        </div>

        <div class="hud-mid-row">
          <div class="room-selector-wrapper">
            <select id="room-select-dropdown" class="theme-select-dropdown" style="padding:6px 10px; font-weight:600;">
              <option value="study">📖 自修室</option>
            </select>
          </div>

          <div style="display:flex; gap:6px; align-items:center;">
            <button id="open-room-modal-btn" class="shopkeeper-only-btn rpg-btn-sm" style="display:none; background:var(--accent-hover); color:#fff;">➕ 新房間</button>
            <button id="delete-room-btn" class="shopkeeper-only-btn rpg-btn-sm" style="display:none; background:var(--danger-color); color:#fff;">🗑️ 刪除</button>
            
            <!-- 動態配色選色盤 -->
            <div style="display:flex; align-items:center; gap:6px; background:var(--bg-input); border:1px solid var(--border-color); padding:4px 10px; border-radius:12px;">
              <span style="font-size:11px; font-weight:600; color:var(--text-color);">🎨 主題</span>
              <input type="color" id="custom-color-picker" value="#faf6ee" style="width:22px; height:22px; border:none; background:transparent; cursor:pointer; padding:0;" title="自選主要區域配色" />
            </div>
          </div>
        </div>
      </header>

      <!-- 畫布區塊 -->
      <div class="canvas-wrapper">
        <canvas id="rpg-canvas" width="384" height="384"></canvas>
      </div>

      <!-- 底部 Footer 導航列與向上展開的手帳手札抽屜 -->
      <footer class="rpg-footer-nav" id="rpg-footer">
        <!-- 向上展開的手札指南面板 -->
        <div id="guide-drawer" class="guide-drawer-content" style="display: none;">
          <div class="drawer-header">
            <span>📖 客舍手札 · 物件與空間指南</span>
            <button id="drawer-close-btn" class="rpg-btn-sm" style="padding:3px 8px;">✕ 收起</button>
          </div>
          
          <div id="shopkeeper-drawer-tools" class="shopkeeper-tools-bar" style="display: none; justify-content: space-between; align-items: center;">
            <div style="display:flex; gap:6px;">
              <button class="tool-btn active" data-tool="move">🚶 散步模式</button>
              <button class="tool-btn" data-tool="delete" style="color:var(--danger-color); border-color:var(--danger-color);">🗑️ 移除模式</button>
            </div>
            <button id="open-cf-modal-btn" class="rpg-btn-sm" style="background:var(--accent-hover); color:#fff;">➕ 新增物件/NPC</button>
          </div>

          <div id="guide-content-box" class="guide-list-box"></div>
        </div>

        <!-- 底部導覽列 -->
        <div style="display:flex; justify-content:center; width:100%; padding:10px 14px; box-sizing:border-box;">
          <div style="display:flex; align-items:center; background:var(--bg-card); border:1px solid var(--border-color); border-radius:16px; width:100%; max-width:600px; box-shadow:0 4px 12px rgba(44,36,29,0.04);">
            <div class="footer-tabs-bar" style="flex:1; border-top:none; display:flex; justify-content:space-around; padding:6px 8px; box-sizing:border-box; background:transparent;">
              
              <!-- 手札 -->
              <button id="btn-tab-guide" class="footer-tab-link" style="background:transparent; border:none; cursor:pointer; display:flex; flex-direction:column; align-items:center; color:var(--text-muted); font-size:11px; gap:2px; padding:6px 10px; border-radius:12px; transition:all 0.2s;">
                <span style="font-size:16px;">📖</span>
                <span>手札</span>
              </button>

              <!-- 聊天 -->
              <a href="/chatroom" style="display:flex; flex-direction:column; align-items:center; text-decoration:none; color:var(--text-muted); font-size:11px; gap:2px; padding:6px 10px; border-radius:12px;">
                <span style="font-size:16px;">💬</span>
                <span>聊天</span>
              </a>

              <!-- 書櫃 (高亮) -->
              <a href="/record" style="display:flex; flex-direction:column; align-items:center; text-decoration:none; color:var(--accent-hover); font-weight:600; font-size:11px; gap:2px; padding:6px 10px; border-radius:12px; background:var(--bg-input);">
                <span style="font-size:16px;">📚</span>
                <span>書櫃</span>
              </a>

              <!-- 共讀 -->
              <a href="/co-read" style="display:flex; flex-direction:column; align-items:center; text-decoration:none; color:var(--text-muted); font-size:11px; gap:2px; padding:6px 10px; border-radius:12px;">
                <span style="font-size:16px;">📖</span>
                <span>共讀</span>
              </a>

              <!-- 萬事屋 -->
              <a href="/skillsupermarket" style="display:flex; flex-direction:column; align-items:center; text-decoration:none; color:var(--text-muted); font-size:11px; gap:2px; padding:6px 10px; border-radius:12px;">
                <span style="font-size:16px;">🏠</span>
                <span>萬事屋</span>
              </a>

            </div>
          </div>
          <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background:var(--danger-color); color:#fff; font-weight:bold; margin-left:8px; padding:6px 12px; border-radius:12px; align-self:center;">🚶 起立</button>
        </div>
      </footer>
    </main>
  </div>

  <style is:global>

    .dnd-focus-mode {
      filter: brightness(0.92) contrast(1.04);
    }
    .dnd-focus-mode .rpg-hud, .dnd-focus-mode .rpg-footer-nav {
      opacity: 0.5;
      transition: opacity 0.5s ease;
    }
    .dnd-focus-mode .rpg-hud:hover, .dnd-focus-mode .rpg-footer-nav:hover {
      opacity: 1;
    }

    .rpg-modal-overlay { position: fixed; inset: 0; background: rgba(44, 36, 29, 0.45); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .rpg-window { background: var(--bg-card); backdrop-filter: blur(20px); border: 1px solid var(--border-color); border-radius: 24px; width: 90%; max-width: 360px; box-shadow: 0 20px 40px rgba(44, 36, 29, 0.12); }
    
    .embed-window { max-width: 390px; height: 82vh; display: flex; flex-direction: column; overflow: hidden; border-radius: 24px; }
    .embed-frame-wrapper { flex: 1; width: 100%; background: #ffffff; }
    .embed-iframe { width: 100%; height: 100%; border: none; }

    .rpg-footer-nav {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      border-top: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      z-index: 50;
      transition: opacity 0.4s ease;
    }

    .guide-drawer-content {
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-color);
      max-height: 46vh;
      min-height: 190px;
      display: flex;
      flex-direction: column;
      padding: 14px 18px;
      border-top-left-radius: 24px;
      border-top-right-radius: 24px;
      animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes slideUp {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    .drawer-header {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 13px; font-weight: 700; color: var(--accent-hover); margin-bottom: 10px; flex-shrink: 0;
    }

    .shopkeeper-tools-bar {
      display: flex; gap: 6px; margin-bottom: 8px; flex-shrink: 0;
      background: var(--bg-input); padding: 8px; border-radius: 14px; border: 1px solid var(--border-color); align-items: center;
    }

    .guide-list-box { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; min-height: 0; }

    .rpg-title-bar { background: var(--bg-input); color: var(--accent-hover); padding: 14px 18px; font-size: 13px; font-weight: 700; border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom: 1px solid var(--border-color); }
    .rpg-content { padding: 20px; }
    .rpg-text { font-size: 13px; color: var(--text-muted); margin-bottom: 14px; line-height: 1.6; }
    
    .rpg-window input[type="text"], .rpg-window input[type="number"], .rpg-window input[type="email"], .rpg-window input[type="password"], .rpg-window textarea, .rpg-window select {
      width: 100%; background: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-color); padding: 10px 12px; font-size: 13px; box-sizing: border-box; margin-bottom: 10px; outline: none; border-radius: 14px; transition: border-color 0.2s;
    }
    .rpg-window input:focus, .rpg-window textarea:focus, .rpg-window select:focus { border-color: var(--accent-hover); }

    .rpg-btn { background: var(--accent-hover); color: #fff; border: none; padding: 10px; font-size: 13px; cursor: pointer; width: 100%; font-weight: 700; border-radius: 14px; transition: all 0.2s; }
    .rpg-btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .rpg-btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid var(--border-color); padding: 10px; font-size: 13px; cursor: pointer; width: 100%; border-radius: 14px; }
    .rpg-btn-group { display: flex; gap: 8px; }

    .rpg-hud {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      padding: 12px 16px; font-size: 12px; flex-shrink: 0;
    }
    .hud-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .hud-brand { font-weight: 700; color: var(--accent-hover); letter-spacing: 0.8px; }
    .hud-right { display: flex; align-items: center; gap: 6px; }
    .online-indicator { color: var(--success-color); font-weight: 600; }
    .user-tag { background: var(--bg-input); border: 1px solid var(--border-color); padding: 2px 8px; border-radius: 10px; font-size: 10px; color: var(--accent-hover); font-weight: 600; }
    
    .hud-mid-row { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .theme-select-dropdown { background: var(--bg-input); color: var(--text-color); border: 1px solid var(--border-color); padding: 4px 8px; font-size: 11px; border-radius: 12px; outline: none; cursor: pointer; font-weight: 500; }
    .rpg-btn-sm { background: var(--bg-input); color: var(--text-color); border: 1px solid var(--border-color); padding: 5px 10px; font-size: 11px; cursor: pointer; border-radius: 10px; font-weight: 600; }
    
    .canvas-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; background: var(--bg-main); padding: 8px; overflow: hidden; min-height: 0; }
    #rpg-canvas { border: 1px solid var(--border-color); background: var(--bg-card); cursor: pointer; image-rendering: pixelated; border-radius: 20px; width: 100%; max-width: 384px; height: 100%; max-height: 384px; object-fit: contain; }

    .tool-btn { background: var(--bg-input); color: var(--text-muted); border: 1px solid var(--border-color); padding: 5px 10px; font-size: 11px; cursor: pointer; border-radius: 10px; }
    .tool-btn.active { background: var(--accent-hover); color: #fff; border-color: var(--accent-hover); font-weight: 700; }
  </style>

  <script>
    import { supabase } from '../lib/supabase';

    const TABLE_NAME = 'slowpace_members';
    const ITEMS_TABLE = 'slowplace_items';
    const ROOMS_TABLE = 'slowplace_rooms';
    const LOGS_TABLE = 'reading_record';

    let userId: string | null = null;
    let playerName = '冒險者';
    let playerRole = '☁️ 讀者';
    let playerAvatar = '/assets/player1.png';
    let playerTier = '鄰里人';
    let isAdmin = false;
    let isGuest = false;
    let playerGx = 2;
    let playerGy = 2;
    let currentTool = 'move';
    let currentRoom = 'study';
    let isDND = false;
    let currentTask = '';

    let moveQueue: { gx: number; gy: number }[] = [];
    let moveTimer = 0;
    let onlinePlayers: Record<string, any> = {};
    let roomItems: any[] = [];
    let activeSeatData: any = null;
    let activeTableData: any = null;
    let activePlayerCardData: any = null;
    let userReadingRecords: any[] = [];
    let currentReadingRecordId: string | null = null;
    let syncInterval: any = null;

    let customRooms: { room_key: string; room_name: string; bg_img: string; grid_size: number }[] = [];
    let currentGridSize = 12;
    let currentBgImg = '';

    let hoveredItem: any = null;
    let glowCounter = 0;

    let activeDmTargetId: string | null = null;
    let activeDmTargetName: string = '';
    let dmPollInterval: any = null;

    function updateCurrentRoomConfig() {
      const r = customRooms.find(rc => rc.room_key === currentRoom);
      if (r) {
        currentGridSize = r.grid_size || 12;
        currentBgImg = r.bg_img || '';
      } else {
        currentGridSize = 12;
        currentBgImg = '';
      }
    }

    const modal = document.getElementById('rpg-modal');
    const logoutBtn = document.getElementById('logout-btn');
    const hudName = document.getElementById('hud-name');
    const hudTierTag = document.getElementById('hud-tier-tag');
    const rpgContainer = document.getElementById('rpg-container');

    async function initAuthCheck() {
      const guestId = sessionStorage.getItem('space_guest_id');

      if (guestId) {
        userId = guestId;
        isGuest = true;
        playerName = sessionStorage.getItem('space_guest_name') || '訪客';
        playerAvatar = sessionStorage.getItem('space_guest_avatar') || '/assets/player1.png';
        isAdmin = false;
        if (modal) modal.style.display = 'none';
        if (hudName) hudName.textContent = playerName;
        if (hudTierTag) hudTierTag.textContent = '🌱 訪客';
        await startAppSession();
      } else {
        const { data: { session } } = await supabase.auth.getSession();
        if (session && session.user) {
          userId = session.user.id;
          isGuest = false;
          if (modal) modal.style.display = 'none';
          await loadUserProfile(userId);
          await startAppSession();
        } else {
          if (modal) modal.style.display = 'flex';
        }
      }
    }

    window.addEventListener('message', async (event) => {
      if (event.data && event.data.type === 'GUEST_LOGIN_SUCCESS') {
        userId = event.data.guestId;
        isGuest = true;
        playerName = event.data.name;
        playerAvatar = event.data.avatar;
        isAdmin = false;
        if (modal) modal.style.display = 'none';
        if (hudName) hudName.textContent = playerName;
        if (hudTierTag) hudTierTag.textContent = '🌱 訪客';
        await startAppSession();
      }
      
      if (event.data && event.data.type === 'LOGIN_SUCCESS') {
        if (modal) modal.style.display = 'none';
        const { data: { session } } = await supabase.auth.getSession();
        if (session && session.user) {
          userId = session.user.id;
          isGuest = false;
          await loadUserProfile(userId);
          await startAppSession();
        }
      }
    });

    supabase.auth.onAuthStateChange(async (event, session) => {
      if ((event === 'SIGNED_IN' || event === 'USER_UPDATED') && session?.user) {
        userId = session.user.id;
        isGuest = false;
        if (modal) modal.style.display = 'none';
        await loadUserProfile(userId);
        await startAppSession();
      }
    });

    async function loadUserProfile(uId: string) {
      const { data } = await supabase.from(TABLE_NAME).select('*').eq('user_id', uId).maybeSingle();
      if (data) {
        playerName = data.name || data.username || '冒險者';
        playerRole = data.role || '☁️ 讀者';
        playerAvatar = data.avatar || '/assets/player1.png';
        playerTier = data.tier || '鄰里人';
        isAdmin = Boolean(data.is_admin);
        
        if (hudName) hudName.textContent = playerName;
        if (hudTierTag) hudTierTag.textContent = isAdmin ? '👑 店主' : '🌱 鄰里人';
        
        if (isAdmin) {
          document.querySelectorAll('.shopkeeper-only-btn').forEach(b => (b as HTMLElement).style.display = 'inline-block');
        }
      }
    }

    async function handleLeaveAndCleanup() {
      const currentGuestId = sessionStorage.getItem('space_guest_id');
      if (currentGuestId) {
        await supabase.from(TABLE_NAME).delete().eq('user_id', currentGuestId);
        sessionStorage.clear();
      }
      await supabase.auth.signOut();
      localStorage.clear();
      window.location.reload();
    }

    logoutBtn?.addEventListener('click', async () => {
      await handleLeaveAndCleanup();
    });

    window.addEventListener('beforeunload', () => {
      const currentGuestId = sessionStorage.getItem('space_guest_id');
      if (currentGuestId) {
        supabase.from(TABLE_NAME).delete().eq('user_id', currentGuestId);
      }
    });

    const onlineCountSpan = document.getElementById('online-count');

    async function startAppSession() {
      await fetchRooms();
      await syncMyStateToDB();
      await fetchOnlinePlayers();
      await fetchRoomItems();
      await fetchUserReadingRecords();
      initDatabaseRealtime();
      gameLoop();
    }

    async function fetchUserReadingRecords() {
      if (!userId || isGuest) return;
      const { data } = await supabase
        .from(LOGS_TABLE)
        .select('*')
        .eq('user_id', userId)
        .order('created_at', { ascending: false });

      userReadingRecords = data || [];
      updateSeatRecordDropdown();
    }

    function updateSeatRecordDropdown() {
      const selectEl = document.getElementById('seat-record-select') as HTMLSelectElement;
      if (!selectEl) return;
      let html = '<option value="">-- 手動輸入新書 --</option>';
      userReadingRecords.forEach(rec => {
        const title = rec.book_title || '無題';
        const author = rec.author || '佚名';
        const cur = rec.current_page || 0;
        const tot = rec.total_pages || 100;
        const pct = tot > 0 ? Math.round((cur / tot) * 100) : 0;
        html += `<option value="${rec.id}">${title} - ${author} (${cur}/${tot} 頁, ${pct}%)</option>`;
      });
      selectEl.innerHTML = html;
    }

    async function syncMyStateToDB() {
      if (!userId) return;
      await supabase.from(TABLE_NAME).upsert({
        user_id: userId,
        name: playerName,
        role: playerRole,
        tier: playerTier,
        is_admin: isAdmin,
        avatar: playerAvatar,
        room: currentRoom,
        gx: playerGx,
        gy: playerGy,
        is_dnd: isDND,
        task: currentTask,
        updated_at: new Date()
      }, { onConflict: 'user_id' });
    }

    async function fetchOnlinePlayers() {
      const thirtySecondsAgo = new Date(Date.now() - 30000).toISOString();
      const { data } = await supabase
        .from(TABLE_NAME)
        .select('*')
        .eq('room', currentRoom)
        .gte('updated_at', thirtySecondsAgo);

      if (data) {
        onlinePlayers = {};
        let count = 0;
        data.forEach((p: any) => {
          if (p.user_id !== userId) {
            onlinePlayers[p.user_id] = p;
          }
          count++;
        });
        if (onlineCountSpan) onlineCountSpan.textContent = String(count);
      } else {
        onlinePlayers = {};
        if (onlineCountSpan) onlineCountSpan.textContent = "1";
      }
    }

    async function fetchRoomItems() {
      const { data } = await supabase.from(ITEMS_TABLE).select('*').eq('room', currentRoom);
      roomItems = data || [];
    }

    function initDatabaseRealtime() {
      supabase.channel('db-changes').on('postgres_changes', { event: '*', schema: 'public', table: TABLE_NAME }, () => {
        fetchOnlinePlayers();
      }).subscribe();

      supabase.channel('item-changes').on('postgres_changes', { event: '*', schema: 'public', table: ITEMS_TABLE }, () => {
        fetchRoomItems();
      }).subscribe();

      supabase.channel('room-changes').on('postgres_changes', { event: '*', schema: 'public', table: ROOMS_TABLE }, () => {
        fetchRooms();
      }).subscribe();

      syncInterval = setInterval(() => { 
        syncMyStateToDB();
        fetchOnlinePlayers(); 
        fetchRoomItems(); 
      }, 5000);
    }

    async function fetchRooms() {
      const { data } = await supabase
        .from(ROOMS_TABLE)
        .select('*')
        .not('room_key', 'is', null)
        .not('room_name', 'is', null);

      if (data && data.length > 0) {
        customRooms = data
          .filter((r: any) => r.room_key && r.room_name)
          .map((r: any) => ({
            room_key: r.room_key,
            room_name: r.room_name,
            bg_img: r.bg_img || '',
            grid_size: r.grid_size || 12
          }));
      } else {
        const defaults = [
          { room_key: 'study', room_name: '📖 自修室', bg_img: '', grid_size: 12 },
          { room_key: 'chat', room_name: '☕ 書話間', bg_img: '', grid_size: 12 },
          { room_key: 'salon', room_name: '🏛️ 沙龍', bg_img: '', grid_size: 12 }
        ];
        for (const dr of defaults) {
          await supabase.from(ROOMS_TABLE).upsert(dr, { onConflict: 'room_key' });
        }
        customRooms = defaults;
      }
      renderRoomDropdown();
      updateCurrentRoomConfig();
    }

    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');

    const imageCache: Record<string, HTMLImageElement> = {};
    const imageFailed: Record<string, boolean> = {};

    function getLoadedImage(src: string): HTMLImageElement | null {
      if (!src || src.trim() === '') return null;
      if (imageFailed[src]) return null;
      if (!imageCache[src]) {
        const img = new Image();
        img.onerror = () => { imageFailed[src] = true; };
        img.src = src;
        imageCache[src] = img;
      }
      return imageFailed[src] ? null : imageCache[src];
    }

    function getPlayerAtCell(gx: number, gy: number) {
      return Object.values(onlinePlayers).find((p: any) => p.gx === gx && p.gy === gy);
    }

    function isCellSolidBlocked(gx: number, gy: number): boolean {
      if (gx < 0 || gx >= currentGridSize || gy < 0 || gy >= currentGridSize) return true;
      for (const item of roomItems) {
        const iw = item.w || 1;
        const ih = item.h || 1;
        if (gx >= item.gx && gx < item.gx + iw && gy >= item.gy && gy < item.gy + ih) return true;
      }
      return false;
    }

    function drawSpeechBubble(c: CanvasRenderingContext2D, text: string, x: number, y: number, isDndActive = false) {
      c.font = '10px -apple-system, sans-serif';
      const textWidth = c.measureText(text).width;
      const bubbleW = textWidth + 16;
      const bubbleH = 20;
      const bx = x - bubbleW / 2;
      const by = y - 36;

      c.save();
      c.fillStyle = isDndActive ? 'rgba(129, 178, 154, 0.95)' : 'rgba(255, 255, 255, 0.92)';
      c.strokeStyle = isDndActive ? '#52796f' : '#e6dcc8';
      c.lineWidth = 1;

      c.beginPath();
      c.roundRect(bx, by, bubbleW, bubbleH, 8);
      c.fill();
      c.stroke();

      c.beginPath();
      c.moveTo(x - 4, by + bubbleH);
      c.lineTo(x + 4, by + bubbleH);
      c.lineTo(x, by + bubbleH + 4);
      c.closePath();
      c.fill();
      c.stroke();

      c.fillStyle = '#2c241d';
      c.textAlign = 'center';
      c.fillText(text, x, by + 14);
      c.restore();
    }

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      const tileSize = canvas.width / currentGridSize;
      glowCounter += 0.05;

      const bgImgObj = getLoadedImage(currentBgImg);
      if (bgImgObj && bgImgObj.complete && bgImgObj.naturalWidth !== 0) {
        ctx.drawImage(bgImgObj, 0, 0, canvas.width, canvas.height);
      } else {
        ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--bg-main').trim() || '#faf6ee';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }

      ctx.strokeStyle = 'rgba(230, 220, 200, 0.4)';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += tileSize) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
      for (let y = 0; y < canvas.height; y += tileSize) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }

      if (!isDND) {
        moveTimer++;
        if (moveQueue.length > 0 && moveTimer % 8 === 0) {
          const nextStep = moveQueue.shift()!;
          if (!isCellSolidBlocked(nextStep.gx, nextStep.gy)) {
            playerGx = nextStep.gx;
            playerGy = nextStep.gy;
            syncMyStateToDB();
          } else { moveQueue = []; }
        }
      }

      roomItems.forEach(item => {
        const px = item.gx * tileSize;
        const py = item.gy * tileSize;
        const iw = (item.w || 1) * tileSize;
        const ih = (item.h || 1) * tileSize;

        const isHovered = hoveredItem && hoveredItem.id === item.id;
        if (isHovered) {
          ctx.save();
          ctx.shadowColor = '#84a98c';
          ctx.shadowBlur = 12;
          ctx.fillStyle = '#84a98c';
          ctx.fillRect(px - 1, py - 1, iw + 2, ih + 2);
          ctx.restore();
        }

        const img = getLoadedImage(item.img_src);
        if (img && img.complete && img.naturalWidth !== 0) {
          ctx.drawImage(img, px, py, iw, ih);
        } else {
          ctx.fillStyle = item.type === 'table' ? '#dda15e' : '#bc6c25';
          ctx.fillRect(px + 2, py + 2, iw - 4, ih - 4);
        }

        if (item.type === 'seat' && item.host_id) {
          ctx.fillStyle = 'rgba(129, 178, 154, 0.9)';
          ctx.fillRect(px + 4, py + ih - 14, iw - 8, 11);
          ctx.fillStyle = '#2c241d';
          ctx.font = 'bold 9px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(`📖 ${item.book_title || '閱讀中'}`, px + iw / 2, py + ih - 5);
          ctx.textAlign = 'left';
        }

        if (item.type === 'table' && item.book_title) {
          ctx.fillStyle = 'rgba(221, 161, 94, 0.9)';
          ctx.fillRect(px + 4, py + ih - 16, iw - 8, 13);
          ctx.fillStyle = '#2c241d';
          ctx.font = 'bold 9px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(`📖 ${item.book_title}`, px + iw / 2, py + ih - 6);
          ctx.textAlign = 'left';
        }
      });

      Object.values(onlinePlayers).forEach((op: any) => {
        const px = op.gx * tileSize + tileSize / 2;
        const py = op.gy * tileSize + tileSize / 2;
        const opImg = getLoadedImage(op.avatar || '/assets/player2.png');
        if (opImg && opImg.complete && opImg.naturalWidth !== 0) {
          ctx.drawImage(opImg, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#84a98c';
          ctx.fillRect(px - 12, py - 12, 24, 24);
        }
        
        const opStatusText = op.is_dnd ? '📖 閱讀中' : op.name;
        drawSpeechBubble(ctx, opStatusText, px, py - 18, Boolean(op.is_dnd));
      });

      const pScreenX = playerGx * tileSize + tileSize / 2;
      const pScreenY = playerGy * tileSize + tileSize / 2;
      const playerImg = getLoadedImage(playerAvatar);
      if (playerImg && playerImg.complete && playerImg.naturalWidth !== 0) {
        ctx.drawImage(playerImg, pScreenX - 16, pScreenY - 16, 32, 32);
      } else {
        ctx.fillStyle = isDND ? '#81b29a' : '#84a98c';
        ctx.fillRect(pScreenX - 12, pScreenY - 12, 24, 24);
      }

      const myStatusText = isDND ? '📖 專注閱讀' : playerName;
      drawSpeechBubble(ctx, myStatusText, pScreenX, pScreenY - 18, isDND);
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    canvas?.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const x = (e.clientX - rect.left) * scaleX;
      const y = (e.clientY - rect.top) * scaleY;
      const tileSize = canvas.width / currentGridSize;
      const gx = Math.floor(x / tileSize);
      const gy = Math.floor(y / tileSize);

      hoveredItem = roomItems.find(item => gx >= item.gx && gx < item.gx + (item.w || 1) && gy >= item.gy && gy < item.gy + (item.h || 1));
      const hitPlayer = getPlayerAtCell(gx, gy);

      canvas.style.cursor = (hoveredItem || hitPlayer) ? 'pointer' : 'default';
    });

    canvas?.addEventListener('mouseleave', () => {
      hoveredItem = null;
      canvas.style.cursor = 'default';
    });

    const roomSelectDropdown = document.getElementById('room-select-dropdown') as HTMLSelectElement;
    const openRoomModalBtn = document.getElementById('open-room-modal-btn');
    const deleteRoomBtn = document.getElementById('delete-room-btn') as HTMLButtonElement;
    const roomSettingsModal = document.getElementById('room-settings-modal');
    const rsCancelBtn = document.getElementById('rs-cancel-btn');
    const rsConfirmBtn = document.getElementById('rs-confirm-btn');
    const rsRoomKey = document.getElementById('rs-room-key') as HTMLInputElement;
    const rsRoomName = document.getElementById('rs-room-name') as HTMLInputElement;
    const rsBgImg = document.getElementById('rs-bg-img') as HTMLInputElement;
    const rsGridSize = document.getElementById('rs-grid-size') as HTMLInputElement;

    const libraryModal = document.getElementById('library-modal');
    const libraryCloseBtn = document.getElementById('library-close-btn');

    const btnTabGuide = document.getElementById('btn-tab-guide');
    const guideDrawer = document.getElementById('guide-drawer');
    const drawerCloseBtn = document.getElementById('drawer-close-btn');
    const guideContentBox = document.getElementById('guide-content-box');
    const shopkeeperDrawerTools = document.getElementById('shopkeeper-drawer-tools');

    const playerCardModal = document.getElementById('player-card-modal');
    const pcCloseBtn = document.getElementById('pc-close-btn');
    const pcAvatar = document.getElementById('pc-avatar') as HTMLImageElement;
    const pcName = document.getElementById('pc-name');
    const pcTier = document.getElementById('pc-tier');
    const pcCurrentBook = document.getElementById('pc-current-book');
    const pcTableBook = document.getElementById('pc-table-book');
    const pcViewRecordsBtn = document.getElementById('pc-view-records-btn');
    const pcDmBtn = document.getElementById('pc-dm-btn');

    const otherRecordsModal = document.getElementById('other-records-modal');
