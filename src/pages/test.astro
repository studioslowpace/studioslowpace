---
// src/pages/test.astro
import Layout from '../layouts/Layout.astro';
import LoginModal from '../components/LoginModal.astro';
---

<Layout title="空間客舍 · 自由佈置空間">

  <!-- 1. 登入 / 訪客 Modal -->
  <div id="rpg-modal" class="rpg-modal-overlay">
    <div class="rpg-window embed-window" style="max-width: 420px; height: 520px;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>◆ 空間客舍 · 身分認證 ◆</span>
      </div>
      <div class="embed-frame-wrapper" style="flex:1;">
        <LoginModal />
      </div>
    </div>
  </div>

  <!-- 2. 圖書館藏 Modal -->
  <div id="library-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span>📚 客舍館藏書單 (Library)</span>
        <button id="library-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe src="/library" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- 3. 共讀桌活動 Modal -->
  <div id="table-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span id="table-modal-title">📖 共讀桌活動</span></div>
      <div class="rpg-content">
        <div id="table-form-view" style="display:none;">
          <p class="rpg-text">此桌目前為空桌，由你來發起一場新的共讀活動：</p>
          <input type="text" id="table-book" placeholder="共讀書名" style="margin-bottom:6px;" />
          <input type="text" id="table-author" placeholder="作者" style="margin-bottom:6px;" />
          <div style="font-size:11px; color:#94a3b8; margin-bottom:4px;">限制參加人數：</div>
          <input type="number" id="table-max" value="3" min="1" max="10" style="margin-bottom:6px;" />
          <div style="font-size:11px; color:#94a3b8; margin-bottom:4px;">預定完讀日期：</div>
          <input type="date" id="table-date" style="width:100%; background:var(--bg-main); border:1px solid var(--border-color); color:#fff; padding:8px; border-radius:8px; margin-bottom:12px;" />
          <div class="rpg-btn-group">
            <button id="table-cancel-btn" class="rpg-btn-ghost">取消</button>
            <button id="table-create-btn" class="rpg-btn">✨ 發起共讀</button>
          </div>
        </div>

        <div id="table-info-view">
          <div id="table-details" style="font-size:12px; line-height:1.6; color:#f8fafc; margin-bottom:12px;"></div>
          <div class="rpg-btn-group" style="flex-direction:column; gap:6px;">
            <button id="table-join-btn" class="rpg-btn" style="background:#10b981;">🤝 加入共讀</button>
            <button id="table-end-btn" class="rpg-btn" style="background:#ef4444; display:none;">🛑 結束共讀</button>
            <button id="table-info-close" class="rpg-btn-ghost">關閉</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3.5 木椅坐下閱讀 Modal -->
  <div id="seat-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>🪑 木椅閱讀角</span></div>
      <div class="rpg-content">
        <!-- 空位：坐下輸入書本 -->
        <div id="seat-form-view" style="display:none;">
          <p class="rpg-text">這張木椅目前空著，請輸入你想在此沉浸閱讀的書名：</p>
          <div style="display:flex; gap:6px; margin-bottom:6px;">
            <input type="text" id="seat-book-input" placeholder="輸入書名（例：少女核）" style="flex:1; margin-bottom:0;" />
            <button id="pick-from-record-btn" class="rpg-btn-sm" style="background:var(--accent-hover); color:#fff; white-space:nowrap;">📚 從書櫃選</button>
          </div>
          <div class="rpg-btn-group" style="margin-top:12px;">
            <button id="seat-cancel-btn" class="rpg-btn-ghost">取消</button>
            <button id="seat-sit-btn" class="rpg-btn" style="background:#10b981;">✨ 坐下閱讀</button>
          </div>
        </div>

        <!-- 已有人坐：查看讀者與書名 -->
        <div id="seat-info-view" style="display:none;">
          <div id="seat-details" style="font-size:12px; line-height:1.6; color:#f8fafc; margin-bottom:14px;"></div>
          <button id="seat-info-close" class="rpg-btn-ghost">關閉</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 彈出網頁視窗 (Modal 預覽用) -->
  <div id="custom-modal-frame" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="custom-modal-title">📄 內容預覽</span>
        <button id="custom-modal-close" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe id="custom-modal-iframe" src="" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- 5. 新增自訂物件 Modal (店主專用) -->
  <div id="custom-furniture-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>🛠️ 新增空間物件/NPC/傳送門</span></div>
      <div class="rpg-content">
        <p class="rpg-text">設定物件名稱、圖片、說明及點擊後的連結行為：</p>
        <input type="text" id="cf-name" placeholder="名稱（例：屋主 Mi / 綠意書櫃）" maxlength="15" style="margin-bottom:6px;" />
        <input type="text" id="cf-img" placeholder="圖片路徑（例：/assets/npc_mi.png）" style="margin-bottom:6px;" />
        <input type="text" id="cf-link" placeholder="連結網址（例：/ 或外部網址，無則留空）" style="margin-bottom:6px;" />
        
        <div style="font-size:11px; color:#94a3b8; margin-bottom:4px;">連結開啟方式：</div>
        <select id="cf-open-type" style="width:100%; background:var(--bg-main); color:#f8fafc; border:1px solid var(--border-color); padding:8px; border-radius:6px; margin-bottom:6px;">
          <option value="current">🌐 在當前頁面跳轉 (預設)</option>
          <option value="blank">📑 在新分頁開啟 (_blank)</option>
          <option value="modal">🪟 以彈出視窗 (Modal) 顯示</option>
        </select>

        <textarea id="cf-desc" placeholder="物件圖示說明文字..." style="width:100%; height:50px; background:var(--bg-main); color:#f8fafc; border:1px solid var(--border-color); border-radius:6px; padding:6px; font-size:11px; resize:none; outline:none; box-sizing:border-box; margin-bottom:6px;"></textarea>
        <div style="display:flex; gap:6px; margin-bottom:8px;">
          <input type="number" id="cf-w" placeholder="寬度 (格)" value="1" min="1" max="4" style="flex:1; margin-bottom:0;" />
          <input type="number" id="cf-h" placeholder="高度 (格)" value="1" min="1" max="4" style="flex:1; margin-bottom:0;" />
        </div>
        <div class="rpg-btn-group" style="margin-top:10px;">
          <button id="cf-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="cf-confirm-btn" class="rpg-btn">✨ 新增至清單</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. 店主新增房間/設定背景 Modal -->
  <div id="room-settings-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window">
      <div class="rpg-title-bar"><span>🏠 房間與背景設定 (店主專用)</span></div>
      <div class="rpg-content">
        <p class="rpg-text">新增房間代碼、房間名稱、背景圖網址及格子數量：</p>
        <input type="text" id="rs-room-key" placeholder="房間代碼（例：reading_room）" style="margin-bottom:6px;" />
        <input type="text" id="rs-room-name" placeholder="房間顯示名稱（例：📖 靜心閱覽室）" style="margin-bottom:6px;" />
        <input type="text" id="rs-bg-img" placeholder="背景圖片網址（留空則使用純色背景）" style="margin-bottom:6px;" />
        <div style="font-size:11px; color:#94a3b8; margin-bottom:4px;">格子大小 (預設 12x12)：</div>
        <input type="number" id="rs-grid-size" placeholder="格子數 (預設 12)" value="12" min="6" max="30" style="margin-bottom:12px;" />
        <div class="rpg-btn-group">
          <button id="rs-cancel-btn" class="rpg-btn-ghost">取消</button>
          <button id="rs-confirm-btn" class="rpg-btn">✨ 建立並儲存房間</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 7. 玩家互動選單 Modal -->
  <div id="player-action-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 280px; text-align: center;">
      <div class="rpg-title-bar"><span id="pam-title">👤 玩家選單</span></div>
      <div class="rpg-content" style="display: flex; flex-direction: column; gap: 8px;">
        <button id="pam-dm-btn" class="rpg-btn" style="background: var(--accent-hover);">💬 進入聊天室</button>
        <button id="pam-logs-btn" class="rpg-btn" style="background: #10b981;">📚 查看閱讀記錄</button>
        <button id="pam-cancel-btn" class="rpg-btn-ghost">取消</button>
      </div>
    </div>
  </div>

  <!-- 8. 查看其他玩家閱讀記錄 Modal -->
  <div id="peer-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window" style="max-width: 360px; max-height: 80vh; display: flex; flex-direction: column;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="peer-modal-title">👤 書友的閱讀記錄</span>
        <button id="peer-close-btn" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="rpg-content" id="peer-content-box" style="overflow-y: auto; flex: 1; font-size: 12px;"></div>
    </div>
  </div>

  <!-- 主介面 -->
  <div class="app-viewport">
    <main class="rpg-container">
      <header class="rpg-hud">
        <div class="hud-top-row">
          <span class="hud-brand">☁️ 空間客舍</span>
          <div class="hud-right">
            <span class="online-indicator">🟢 在線: <strong id="online-count">1</strong></span>
            <span class="user-tag" id="hud-tier-tag">🌱 鄰里人</span>
            <strong id="hud-name" style="color: var(--accent-light, #e0f2fe);">旅人</strong>
            <button id="logout-btn" class="rpg-btn-sm" style="background:#ef4444; color:#fff; border:none;">🚪 登出</button>
          </div>
        </div>

        <div class="hud-mid-row">
          <div class="room-selector-wrapper">
            <select id="room-select-dropdown" class="theme-select-dropdown" style="padding:4px 8px; font-weight:bold;">
              <option value="study">📖 自修室</option>
            </select>
          </div>

          <div style="display:flex; gap:4px; align-items:center;">
            <button id="open-room-modal-btn" class="shopkeeper-only-btn rpg-btn-sm" style="display:none; background:var(--accent-hover); color:#fff; font-size:10px;">➕ 新房間</button>
            <button id="delete-room-btn" class="shopkeeper-only-btn rpg-btn-sm" style="display:none; background:#ef4444; color:#fff; font-size:10px;">🗑️ 刪除</button>
            <select id="theme-select" class="theme-select-dropdown">
              <option value="blue">☁️ 晴空藍</option>
              <option value="green">🍃 森林綠</option>
              <option value="purple">🔮 暮光紫</option>
            </select>
          </div>
        </div>
      </header>

      <!-- 畫布區塊 -->
      <div class="canvas-wrapper">
        <canvas id="rpg-canvas" width="384" height="384"></canvas>
      </div>

      <!-- 底部 Footer 導航列與向上展開的指南抽屜 -->
      <footer class="rpg-footer-nav">
        <!-- 向上展開的指南面板 -->
        <div id="guide-drawer" class="guide-drawer-content" style="display: none;">
          <div class="drawer-header">
            <span>📖 空間物件與放置指南</span>
            <button id="drawer-close-btn" class="rpg-btn-sm" style="padding:2px 6px;">✕ 收起</button>
          </div>
          
          <!-- 店主專屬操作：移動模式與新增物件按鈕放入指南內 -->
          <div id="shopkeeper-drawer-tools" class="shopkeeper-tools-bar" style="display: none;">
            <button class="tool-btn active" data-tool="move">🚶 移動模式</button>
            <button id="open-cf-modal-btn" class="rpg-btn-sm" style="background:var(--accent-hover); color:#fff; font-size:11px;">➕ 新增物件/NPC</button>
          </div>

          <div id="guide-content-box" class="guide-list-box"></div>
        </div>

        <!-- 底部主導航列與起立按鈕 -->
        <div style="display:flex; align-items:center; background:var(--bg-main);">
          <div class="footer-tabs-bar" style="flex:1; border-top:none;">
            <button class="footer-tab-btn" data-target="chat">💬 聊天</button>
            <button class="footer-tab-btn" data-target="record">📚 書櫃</button>
            <button class="footer-tab-btn" data-target="guide">📖 指南</button>
          </div>
          <button id="btn-leave-seat" class="rpg-btn-sm" style="display:none; background:#ef4444; color:#fff; font-weight:bold; margin-right:8px; padding:6px 12px;">🚶 起立</button>
        </div>
      </footer>
    </main>
  </div>

  <!-- 聊天與書櫃共用 Modal (同一頁開分頁) -->
  <div id="app-drawer-modal" class="rpg-modal-overlay" style="display: none;">
    <div class="rpg-window embed-window" style="height: 85vh;">
      <div class="rpg-title-bar" style="display:flex; justify-content:space-between; align-items:center;">
        <div style="display:flex; gap:10px;">
          <button id="modal-tab-chat" class="rpg-btn-sm active" style="background:var(--accent-hover); color:#fff;">💬 聊天</button>
          <button id="modal-tab-record" class="rpg-btn-sm">📚 書櫃</button>
        </div>
        <button id="app-drawer-close" class="rpg-btn-sm" style="padding:2px 8px;">✕ 關閉</button>
      </div>
      <div class="embed-frame-wrapper">
        <iframe id="app-drawer-iframe" src="/chatroom" class="embed-iframe"></iframe>
      </div>
    </div>
  </div>

  <style is:global>
    :root {
      --bg-main: #0f172a;
      --bg-card: #1e293b;
      --border-color: #334155;
      --accent-color: #38bdf8;
      --accent-hover: #0284c7;
      --accent-light: #e0f2fe;
    }

    [data-theme="green"] {
      --bg-main: #064e3b;
      --bg-card: #065f46;
      --border-color: #047857;
      --accent-color: #34d399;
      --accent-hover: #059669;
      --accent-light: #d1fae5;
    }

    [data-theme="purple"] {
      --bg-main: #3b0764;
      --bg-card: #581c87;
      --border-color: #7e22ce;
      --accent-color: #c084fc;
      --accent-hover: #9333ea;
      --accent-light: #f3e8ff;
    }

    * { -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; user-select: none; }

    html, body {
      background-color: #020617;
      color: #cbd5e1;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0; padding: 0; width: 100vw; height: 100vh; height: 100dvh; overflow: hidden; touch-action: manipulation;
    }

    .app-viewport { width: 100vw; height: 100vh; height: 100dvh; display: flex; justify-content: center; align-items: center; background: #020617; }
    .rpg-container {
      width: 100vw; max-width: 414px; height: 100vh; height: 100dvh;
      display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; box-sizing: border-box;
      background-color: var(--bg-main); border-left: 1px solid var(--border-color); border-right: 1px solid var(--border-color);
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.8); transition: background-color 0.3s ease;
    }

    .rpg-modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .rpg-window { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; width: 90%; max-width: 360px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
    
    .embed-window { max-width: 390px; height: 80vh; display: flex; flex-direction: column; overflow: hidden; }
    .embed-frame-wrapper { flex: 1; width: 100%; background: #ffffff; }
    .embed-iframe { width: 100%; height: 100%; border: none; }

    /* 底部 Footer 導航與向上展開指南抽屜 */
    .rpg-footer-nav {
      background: var(--bg-card);
      border-top: 2px solid var(--accent-hover);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      z-index: 50;
    }

    .guide-drawer-content {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      max-height: 45vh;
      min-height: 180px;
      display: flex;
      flex-direction: column;
      padding: 8px 12px;
      box-sizing: border-box;
      animation: slideUp 0.25s ease-out;
    }

    @keyframes slideUp {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    .drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      font-weight: bold;
      color: var(--accent-color);
      margin-bottom: 6px;
      flex-shrink: 0;
    }

    .shopkeeper-tools-bar {
      display: flex;
      gap: 6px;
      margin-bottom: 8px;
      flex-shrink: 0;
      background: var(--bg-main);
      padding: 6px;
      border-radius: 6px;
      border: 1px solid var(--border-color);
    }

    .guide-list-box {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-height: 0;
    }

    .footer-tabs-bar {
      display: flex;
      background: var(--bg-main);
      border-top: 1px solid var(--border-color);
    }

    .footer-tab-btn {
      flex: 1;
      background: transparent;
      border: none;
      color: #94a3b8;
      padding: 10px;
      font-size: 12px;
      cursor: pointer;
      font-weight: 500;
      text-align: center;
    }

    .footer-tab-btn.active {
      color: var(--accent-color);
      background: var(--bg-card);
      font-weight: bold;
    }

    .rpg-title-bar { background: var(--bg-main); color: var(--accent-color); padding: 12px 16px; font-size: 13px; font-weight: 500; border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom: 1px solid var(--border-color); }
    .rpg-content { padding: 18px; }
    .rpg-text { font-size: 13px; color: #94a3b8; margin-bottom: 14px; line-height: 1.5; }
    
    .rpg-window input[type="text"], .rpg-window input[type="number"], .rpg-window input[type="email"], .rpg-window input[type="password"] { width: 100%; background: var(--bg-main); border: 1px solid var(--border-color); color: #f8fafc; padding: 10px; font-size: 13px; box-sizing: border-box; margin-bottom: 12px; outline: none; border-radius: 8px; }
    .rpg-btn { background: var(--accent-hover); color: #f8fafc; border: none; padding: 10px; font-size: 13px; cursor: pointer; width: 100%; font-weight: 500; border-radius: 8px; }
    .rpg-btn-ghost { background: transparent; color: #94a3b8; border: 1px solid var(--border-color); padding: 10px; font-size: 13px; cursor: pointer; width: 100%; border-radius: 8px; }
    .rpg-btn-group { display: flex; gap: 8px; }

    .rpg-hud { background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 6px 10px; font-size: 12px; flex-shrink: 0; }
    .hud-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
    .hud-brand { font-weight: 600; color: var(--accent-color); }
    .hud-right { display: flex; align-items: center; gap: 6px; }
    .online-indicator { color: #34d399; }
    .user-tag { background: var(--bg-main); border: 1px solid var(--border-color); padding: 2px 6px; border-radius: 8px; font-size: 10px; color: var(--accent-color); }
    
    .hud-mid-row { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .theme-select-dropdown { background: var(--bg-main); color: var(--accent-color); border: 1px solid var(--border-color); padding: 3px 6px; font-size: 11px; border-radius: 8px; outline: none; cursor: pointer; }
    .rpg-btn-sm { background: var(--bg-main); color: #cbd5e1; border: 1px solid var(--border-color); padding: 4px 8px; font-size: 11px; cursor: pointer; border-radius: 6px; }
    
    .canvas-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; background: #020617; padding: 2px; overflow: hidden; min-height: 0; }
    #rpg-canvas { border: 1px solid var(--border-color); background: var(--bg-main); cursor: pointer; image-rendering: pixelated; border-radius: 8px; width: 100%; max-width: 384px; height: 100%; max-height: 384px; object-fit: contain; }

    .tool-btn { background: var(--bg-main); color: #94a3b8; border: 1px solid var(--border-color); padding: 5px 10px; font-size: 11px; cursor: pointer; border-radius: 6px; }
    .tool-btn.active { background: var(--accent-hover); color: #f8fafc; border-color: var(--accent-hover); font-weight: 500; }
  </style>

  <script>
    import { supabase } from '../lib/supabase';

    const TABLE_NAME = 'slowspace_members';
    const ITEMS_TABLE = 'slowplace_items';
    const ROOMS_TABLE = 'slowplace_rooms';

    let userId: string | null = null;
    let playerName = '冒險者';
    let playerRole = '☁️ 讀者';
    let playerAvatar = '/assets/player1.png';
    let playerTier = '鄰里人';
    let isAdmin = false;
    let playerGx = 2;
    let playerGy = 2;
    let currentTool = 'move';
    let currentRoom = 'study';
    let isDND = false;
    let currentTask = '';

    let moveQueue: { gx: number; gy: number }[] = [];
    let moveTimer = 0;
    let onlinePlayers: Record<string, any> = {};
    let roomItems: any[] = [];
    let activeTableData: any = null;
    let activeSeatData: any = null;

    let customRooms: { room_key: string; room_name: string; bg_img: string; grid_size: number }[] = [];

    let currentGridSize = 12;
    let currentBgImg = '';

    function updateCurrentRoomConfig() {
      const r = customRooms.find(rc => rc.room_key === currentRoom);
      if (r) {
        currentGridSize = r.grid_size || 12;
        currentBgImg = r.bg_img || '';
      } else {
        currentGridSize = 12;
        currentBgImg = '';
      }
    }

    let customFurnitureTypes: { type: string; label: string; w: number; h: number; imgSrc: string; description: string; link: string; openType: string }[] = JSON.parse(localStorage.getItem('rpg_custom_furnitures') || '[]');

    // ==========================================
    // 區塊一：身分驗證與初始化
    // ==========================================
    const modal = document.getElementById('rpg-modal');
    const logoutBtn = document.getElementById('logout-btn');
    const hudName = document.getElementById('hud-name');
    const hudTierTag = document.getElementById('hud-tier-tag');

    async function initAuthCheck() {
      const guestId = sessionStorage.getItem('space_guest_id');

      if (guestId) {
        userId = guestId;
        playerName = sessionStorage.getItem('space_guest_name') || '訪客';
        playerAvatar = sessionStorage.getItem('space_guest_avatar') || '/assets/player1.png';
        isAdmin = false;
        if (modal) modal.style.display = 'none';
        if (hudName) hudName.textContent = playerName;
        if (hudTierTag) hudTierTag.textContent = '🌱 訪客';
        await startAppSession();
      } else {
        const { data: { session } } = await supabase.auth.getSession();
        if (session && session.user) {
          userId = session.user.id;
          if (modal) modal.style.display = 'none';
          await loadUserProfile(userId);
          await startAppSession();
        } else {
          if (modal) modal.style.display = 'flex';
        }
      }
    }

    window.addEventListener('message', async (event) => {
      if (event.data && event.data.type === 'GUEST_LOGIN_SUCCESS') {
        userId = event.data.guestId;
        playerName = event.data.name;
        playerAvatar = event.data.avatar;
        isAdmin = false;
        if (modal) modal.style.display = 'none';
        if (hudName) hudName.textContent = playerName;
        if (hudTierTag) hudTierTag.textContent = '🌱 訪客';
        await startAppSession();
      }
      
      if (event.data && event.data.type === 'LOGIN_SUCCESS') {
        if (modal) modal.style.display = 'none';
        const { data: { session } } = await supabase.auth.getSession();
        if (session && session.user) {
          userId = session.user.id;
          await loadUserProfile(userId);
          await startAppSession();
        }
      }
    });

    supabase.auth.onAuthStateChange(async (event, session) => {
      if ((event === 'SIGNED_IN' || event === 'USER_UPDATED') && session?.user) {
        userId = session.user.id;
        if (modal) modal.style.display = 'none';
        await loadUserProfile(userId);
        await startAppSession();
      }
    });

    async function loadUserProfile(uId: string) {
      const { data } = await supabase.from(TABLE_NAME).select('*').eq('user_id', uId).single();
      if (data) {
        playerName = data.name || '冒險者';
        playerRole = data.role || '☁️ 讀者';
        playerAvatar = data.avatar || '/assets/player1.png';
        playerTier = data.tier || '鄰里人';
        isAdmin = Boolean(data.is_admin);
        
        if (hudName) hudName.textContent = playerName;
        if (hudTierTag) hudTierTag.textContent = isAdmin ? '👑 店主' : '🌱 鄰里人';
        
        if (isAdmin) {
          document.querySelectorAll('.shopkeeper-only-btn').forEach(b => (b as HTMLElement).style.display = 'inline-block');
        }
      }
    }

    async function handleLeaveAndCleanup() {
      const currentGuestId = sessionStorage.getItem('space_guest_id');
      if (currentGuestId) {
        await supabase.from(TABLE_NAME).delete().eq('user_id', currentGuestId);
        sessionStorage.clear();
      }
      await supabase.auth.signOut();
      localStorage.clear();
      window.location.reload();
    }

    logoutBtn?.addEventListener('click', async () => {
      await handleLeaveAndCleanup();
    });

    window.addEventListener('beforeunload', () => {
      const currentGuestId = sessionStorage.getItem('space_guest_id');
      if (currentGuestId) {
        supabase.from(TABLE_NAME).delete().eq('user_id', currentGuestId);
      }
    });

    // ==========================================
    // 區塊二：雲端同步與遊戲迴圈
    // ==========================================
    const onlineCountSpan = document.getElementById('online-count');

    async function startAppSession() {
      await fetchRooms();
      await syncMyStateToDB();
      await fetchOnlinePlayers();
      await fetchRoomItems();
      initDatabaseRealtime();
      gameLoop();
    }

    async function syncMyStateToDB() {
      if (!userId) return;
      await supabase.from(TABLE_NAME).upsert({
        user_id: userId,
        name: playerName,
        role: playerRole,
        tier: playerTier,
        is_admin: isAdmin,
        avatar: playerAvatar,
        room: currentRoom,
        gx: playerGx,
        gy: playerGy,
        is_dnd: isDND,
        task: currentTask,
        updated_at: new Date()
      }, { onConflict: 'user_id' });
    }

    async function fetchOnlinePlayers() {
      const fifteenSecondsAgo = new Date(Date.now() - 15000).toISOString();
      const { data } = await supabase
        .from(TABLE_NAME)
        .select('*')
        .eq('room', currentRoom)
        .gte('updated_at', fifteenSecondsAgo);

      if (data) {
        onlinePlayers = {};
        let count = 0;
        data.forEach((p: any) => {
          if (p.user_id !== userId) onlinePlayers[p.user_id] = p;
          count++;
        });
        if (onlineCountSpan) onlineCountSpan.textContent = String(count);
      } else {
        onlinePlayers = {};
        if (onlineCountSpan) onlineCountSpan.textContent = "1";
      }
    }

    async function fetchRoomItems() {
      const { data } = await supabase.from(ITEMS_TABLE).select('*').eq('room', currentRoom);
      roomItems = data || [];
    }

    function initDatabaseRealtime() {
      supabase.channel('db-changes').on('postgres_changes', { event: '*', schema: 'public', table: TABLE_NAME }, () => {
        fetchOnlinePlayers();
      }).subscribe();

      supabase.channel('item-changes').on('postgres_changes', { event: '*', schema: 'public', table: ITEMS_TABLE }, () => {
        fetchRoomItems();
      }).subscribe();

      supabase.channel('room-changes').on('postgres_changes', { event: '*', schema: 'public', table: ROOMS_TABLE }, () => {
        fetchRooms();
      }).subscribe();

      setInterval(() => { syncMyStateToDB(); fetchOnlinePlayers(); fetchRoomItems(); }, 5000);
    }

    // ==========================================
    // 區塊三：獨立讀取 slowspace_rooms 並過濾 NULL 與繪製
    // ==========================================
    async function fetchRooms() {
      const { data } = await supabase
        .from(ROOMS_TABLE)
        .select('*')
        .not('room_key', 'is', null)
        .not('room_name', 'is', null);

      if (data && data.length > 0) {
        customRooms = data
          .filter((r: any) => r.room_key && r.room_name)
          .map((r: any) => ({
            room_key: r.room_key,
            room_name: r.room_name,
            bg_img: r.bg_img || '',
            grid_size: r.grid_size || 12
          }));
      } else {
        const defaults = [
          { room_key: 'study', room_name: '📖 自修室', bg_img: '', grid_size: 12 },
          { room_key: 'chat', room_name: '☕ 書話間', bg_img: '', grid_size: 12 },
          { room_key: 'salon', room_name: '🏛️ 沙龍', bg_img: '', grid_size: 12 }
        ];
        for (const dr of defaults) {
          await supabase.from(ROOMS_TABLE).upsert(dr, { onConflict: 'room_key' });
        }
        customRooms = defaults;
      }
      renderRoomDropdown();
      updateCurrentRoomConfig();
    }

    const canvas = document.getElementById('rpg-canvas') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');
    const leaveSeatBtn = document.getElementById('btn-leave-seat');

    const imageCache: Record<string, HTMLImageElement> = {};
    const imageFailed: Record<string, boolean> = {};

    function getLoadedImage(src: string): HTMLImageElement | null {
      if (!src || src.trim() === '') return null;
      if (imageFailed[src]) return null;
      if (!imageCache[src]) {
        const img = new Image();
        img.onerror = () => { imageFailed[src] = true; };
        img.src = src;
        imageCache[src] = img;
      }
      return imageFailed[src] ? null : imageCache[src];
    }

    function getPlayerAtCell(gx: number, gy: number) {
      return Object.values(onlinePlayers).find((p: any) => p.gx === gx && p.gy === gy);
    }

    function isCellSolidBlocked(gx: number, gy: number): boolean {
      if (gx < 0 || gx >= currentGridSize || gy < 0 || gy >= currentGridSize) return true;
      for (const item of roomItems) {
        const iw = item.w || 1;
        const ih = item.h || 1;
        if (gx >= item.gx && gx < item.gx + iw && gy >= item.gy && gy < item.gy + ih) return true;
      }
      return false;
    }

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      const tileSize = canvas.width / currentGridSize;

      const bgImgObj = getLoadedImage(currentBgImg);
      if (bgImgObj && bgImgObj.complete && bgImgObj.naturalWidth !== 0) {
        ctx.drawImage(bgImgObj, 0, 0, canvas.width, canvas.height);
      } else {
        const theme = document.documentElement.getAttribute('data-theme') || 'blue';
        const bgMap: Record<string, string> = { blue: '#0f172a', green: '#064e3b', purple: '#3b0764' };
        ctx.fillStyle = bgMap[theme] || '#0f172a';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += tileSize) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
      for (let y = 0; y < canvas.height; y += tileSize) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }

      moveTimer++;
      if (moveQueue.length > 0 && moveTimer % 8 === 0) {
        const nextStep = moveQueue.shift()!;
        if (!isCellSolidBlocked(nextStep.gx, nextStep.gy)) {
          playerGx = nextStep.gx;
          playerGy = nextStep.gy;
          syncMyStateToDB();
        } else { moveQueue = []; }
      }

      roomItems.forEach(item => {
        const px = item.gx * tileSize;
        const py = item.gy * tileSize;
        const iw = (item.w || 1) * tileSize;
        const ih = (item.h || 1) * tileSize;

        const img = getLoadedImage(item.img_src);
        if (img && img.complete && img.naturalWidth !== 0) {
          ctx.drawImage(img, px, py, iw, ih);
        } else {
          ctx.fillStyle = item.type === 'table' ? '#b45309' : '#334155';
          ctx.fillRect(px + 2, py + 2, iw - 4, ih - 4);
        }

        // 若木椅有人坐，標示閱讀狀態
        if (item.type === 'seat' && item.host_id) {
          ctx.fillStyle = 'rgba(16, 185, 129, 0.8)';
          ctx.fillRect(px + 4, py + ih - 14, iw - 8, 11);
          ctx.fillStyle = '#fff';
          ctx.font = '9px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(`📖 ${item.book_title || '閱讀中'}`, px + iw / 2, py + ih - 5);
          ctx.textAlign = 'left';
        }
      });

      Object.values(onlinePlayers).forEach((op: any) => {
        const px = op.gx * tileSize + tileSize / 2;
        const py = op.gy * tileSize + tileSize / 2;
        const opImg = getLoadedImage(op.avatar || '/assets/player2.png');
        if (opImg && opImg.complete && opImg.naturalWidth !== 0) {
          ctx.drawImage(opImg, px - 16, py - 16, 32, 32);
        } else {
          ctx.fillStyle = '#10b981';
          ctx.fillRect(px - 12, py - 12, 24, 24);
        }
        ctx.fillStyle = '#34d399';
        ctx.font = '10px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(op.name, px, py + 26);
        ctx.textAlign = 'left';
      });

      const pScreenX = playerGx * tileSize + tileSize / 2;
      const pScreenY = playerGy * tileSize + tileSize / 2;
      const playerImg = getLoadedImage(playerAvatar);
      if (playerImg && playerImg.complete && playerImg.naturalWidth !== 0) {
        ctx.drawImage(playerImg, pScreenX - 16, pScreenY - 16, 32, 32);
      } else {
        ctx.fillStyle = isDND ? '#10b981' : '#38bdf8';
        ctx.fillRect(pScreenX - 12, pScreenY - 12, 24, 24);
      }
      ctx.fillStyle = '#f8fafc';
      ctx.font = '10px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(playerName, pScreenX, pScreenY + 26);
      ctx.textAlign = 'left';
    }

    function gameLoop() {
      draw();
      requestAnimationFrame(gameLoop);
    }

    // ==========================================
    // 區塊四：UI 互動與 Modal 彈窗
    // ==========================================
    const roomSelectDropdown = document.getElementById('room-select-dropdown') as HTMLSelectElement;
    const openRoomModalBtn = document.getElementById('open-room-modal-btn');
    const deleteRoomBtn = document.getElementById('delete-room-btn') as HTMLButtonElement;
    const roomSettingsModal = document.getElementById('room-settings-modal');
    const rsCancelBtn = document.getElementById('rs-cancel-btn');
    const rsConfirmBtn = document.getElementById('rs-confirm-btn');
    const rsRoomKey = document.getElementById('rs-room-key') as HTMLInputElement;
    const rsRoomName = document.getElementById('rs-room-name') as HTMLInputElement;
    const rsBgImg = document.getElementById('rs-bg-img') as HTMLInputElement;
    const rsGridSize = document.getElementById('rs-grid-size') as HTMLInputElement;

    const libraryModal = document.getElementById('library-modal');
    const libraryCloseBtn = document.getElementById('library-close-btn');

    const playerActionModal = document.getElementById('player-action-modal');
    const pamTitle = document.getElementById('pam-title');
    const pamLogsBtn = document.getElementById('pam-logs-btn');
    const pamDmBtn = document.getElementById('pam-dm-btn');
    const pamCancelBtn = document.getElementById('pam-cancel-btn');
    let selectedPeer: any = null;

    const customModalFrame = document.getElementById('custom-modal-frame');
    const customModalClose = document.getElementById('custom-modal-close');
    const customModalIframe = document.getElementById('custom-modal-iframe') as HTMLIFrameElement;
    const customModalTitle = document.getElementById('custom-modal-title');

    const footerTabBtns = document.querySelectorAll('.footer-tab-btn');
    const guideDrawer = document.getElementById('guide-drawer');
    const drawerCloseBtn = document.getElementById('drawer-close-btn');
    const guideContentBox = document.getElementById('guide-content-box');
    const shopkeeperDrawerTools = document.getElementById('shopkeeper-drawer-tools');

    const appDrawerModal = document.getElementById('app-drawer-modal');
    const appDrawerClose = document.getElementById('app-drawer-close');
    const appDrawerIframe = document.getElementById('app-drawer-iframe') as HTMLIFrameElement;
    const modalTabChat = document.getElementById('modal-tab-chat');
    const modalTabRecord = document.getElementById('modal-tab-record');

    footerTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        footerTabBtns.forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        const targetType = target.dataset.target;

        if (targetType === 'guide') {
          if (guideDrawer) guideDrawer.style.display = 'flex';
          renderGuideContent();
        } else {
          if (guideDrawer) guideDrawer.style.display = 'none';
          if (targetType === 'chat') {
            if (modalTabChat) modalTabChat.click();
          } else if (targetType === 'record') {
            if (modalTabRecord) modalTabRecord.click();
          }
          if (appDrawerModal) appDrawerModal.style.display = 'flex';
        }
      });
    });

    drawerCloseBtn?.addEventListener('click', () => {
      if (guideDrawer) guideDrawer.style.display = 'none';
      footerTabBtns.forEach(b => b.classList.remove('active'));
    });

    appDrawerClose?.addEventListener('click', () => {
      if (appDrawerModal) appDrawerModal.style.display = 'none';
      footerTabBtns.forEach(b => b.classList.remove('active'));
    });

    modalTabChat?.addEventListener('click', () => {
      modalTabChat.classList.add('active');
      modalTabChat.style.background = 'var(--accent-hover)';
      modalTabRecord?.classList.remove('active');
      if (modalTabRecord) modalTabRecord.style.background = 'var(--bg-main)';
      if (appDrawerIframe) appDrawerIframe.src = '/chatroom';
    });

    modalTabRecord?.addEventListener('click', () => {
      modalTabRecord.classList.add('active');
      modalTabRecord.style.background = 'var(--accent-hover)';
      modalTabChat?.classList.remove('active');
      if (modalTabChat) modalTabChat.style.background = 'var(--bg-main)';
      if (appDrawerIframe) appDrawerIframe.src = '/record';
    });

    // 支援指南與刪除 item 功能、快速放置
    function renderGuideContent() {
      if (!guideContentBox) return;
      
      if (isAdmin && shopkeeperDrawerTools) {
        shopkeeperDrawerTools.style.display = 'flex';
      }

      const baseStandardItems = [
        { type: 'seat', label: '木椅', imgSrc: '/assets/seat.png', description: '供旅人安坐專心的木椅', w: 1, h: 1 },
        { type: 'shelf', label: '書架', imgSrc: '/assets/shelf.png', description: '收藏客舍館藏書單的書架', w: 1, h: 1 },
        { type: 'table', label: '共讀桌', imgSrc: '/assets/table.png', description: '供多人共讀交流的共讀桌', w: 2, h: 2 }
      ];

      const allItemsMap = new Map();
      baseStandardItems.forEach(item => allItemsMap.set(item.label, item));
      customFurnitureTypes.forEach(cf => allItemsMap.set(cf.label, { type: cf.type, label: cf.label, imgSrc: cf.imgSrc, description: cf.description, w: cf.w, h: cf.h }));
      roomItems.forEach(item => {
        if (!allItemsMap.has(item.label)) {
          allItemsMap.set(item.label, item);
        }
      });

      let html = '';
      allItemsMap.forEach((item, label) => {
        const isTable = item.type === 'table';
        const foundInRoom = roomItems.find(ri => ri.label === label);
        const itemId = foundInRoom ? foundInRoom.id : null;

        html += `
          <div style="display:flex; gap:10px; align-items:center; background:var(--bg-main); border:1px solid var(--border-color); padding:8px; border-radius:6px; margin-bottom:6px;">
            <img src="${item.img_src}" style="width:36px; height:36px; object-fit:contain; background:var(--bg-card); border-radius:4px; padding:2px;" onerror="this.style.display='none'" />
            <div style="flex:1;">
              <div style="font-weight:bold; color:var(--accent-color);">${label} ${isTable ? '(🪵共讀桌)' : ''}</div>
              <div style="font-size:11px; color:#cbd5e1; margin-top:2px;">說明：${item.description || '無'}</div>
            </div>
            <div style="display:flex; gap:4px;">
              ${isAdmin ? `<button class="guide-add-btn rpg-btn-sm" data-type="${item.type}" data-label="${label}" style="background:var(--accent-hover); color:#fff; font-weight:bold; padding:4px 8px;" title="快速放置">＋</button>` : ''}
              ${isAdmin && itemId ? `<button class="guide-del-btn rpg-btn-sm" data-id="${itemId}" style="background:#ef4444; color:#fff; font-weight:bold; padding:4px 8px;" title="從房間刪除此物件">🗑️</button>` : ''}
            </div>
          </div>
        `;
      });
      guideContentBox.innerHTML = html;

      // 綁定放置按鈕
      document.querySelectorAll('.guide-add-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetBtn = e.currentTarget as HTMLElement;
          currentTool = targetBtn.dataset.type || 'move';
          
          document.querySelectorAll('.tool-btn').forEach(tb => {
            if ((tb as HTMLElement).dataset.tool === currentTool) {
              tb.classList.add('active');
            } else {
              tb.classList.remove('active');
            }
          });

          if (guideDrawer) guideDrawer.style.display = 'none';
          alert(`已選擇「${targetBtn.dataset.label}」，請點擊畫布空白處放置！`);
        });
      });

      // 綁定刪除物件按鈕 (delete item)
      document.querySelectorAll('.guide-del-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const targetBtn = e.currentTarget as HTMLElement;
          const itemId = targetBtn.dataset.id;
          if (itemId && confirm('確定要在房間中刪除此物件嗎？')) {
            await supabase.from(ITEMS_TABLE).delete().eq('id', itemId);
            await fetchRoomItems();
            renderGuideContent();
          }
        });
      });
    }

    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentTool = target.dataset.tool!;
      });
    });

    const peerModal = document.getElementById('peer-modal');
    const peerCloseBtn = document.getElementById('peer-close-btn');

    const tableModal = document.getElementById('table-modal');
    const tableModalTitle = document.getElementById('table-modal-title');
    const tableFormView = document.getElementById('table-form-view');
    const tableInfoView = document.getElementById('table-info-view');
    const tableBook = document.getElementById('table-book') as HTMLInputElement;
    const tableAuthor = document.getElementById('table-author') as HTMLInputElement;
    const tableMax = document.getElementById('table-max') as HTMLInputElement;
    const tableDate = document.getElementById('table-date') as HTMLInputElement;
    const tableCreateBtn = document.getElementById('table-create-btn');
    const tableJoinBtn = document.getElementById('table-join-btn');
    const tableEndBtn = document.getElementById('table-end-btn') as HTMLButtonElement;
    const tableCancelBtn = document.getElementById('table-cancel-btn');
    const tableInfoClose = document.getElementById('table-info-close');
    const tableDetails = document.getElementById('table-details');

    // 木椅閱讀相關 Modal 元素
    const seatModal = document.getElementById('seat-modal');
    const seatFormView = document.getElementById('seat-form-view');
    const seatInfoView = document.getElementById('seat-info-view');
    const seatBookInput = document.getElementById('seat-book-input') as HTMLInputElement;
    const seatSitBtn = document.getElementById('seat-sit-btn');
    const seatCancelBtn = document.getElementById('seat-cancel-btn');
    const seatInfoClose = document.getElementById('seat-info-close');
    const seatDetails = document.getElementById('seat-details');
    const pickFromRecordBtn = document.getElementById('pick-from-record-btn');

    const cfModal = document.getElementById('custom-furniture-modal');
    const openCfModalBtn = document.getElementById('open-cf-modal-btn');
    const cfCancelBtn = document.getElementById('cf-cancel-btn');
    const cfConfirmBtn = document.getElementById('cf-confirm-btn');
    const cfNameInput = document.getElementById('cf-name') as HTMLInputElement;
    const cfImgInput = document.getElementById('cf-img') as HTMLInputElement;
    const cfLinkInput = document.getElementById('cf-link') as HTMLInputElement;
    const cfOpenTypeSelect = document.getElementById('cf-open-type') as HTMLSelectElement;
    const cfDescInput = document.getElementById('cf-desc') as HTMLTextAreaElement;
    const cfWInput = document.getElementById('cf-w') as HTMLInputElement;
    const cfHInput = document.getElementById('cf-h') as HTMLInputElement;
    const themeSelect = document.getElementById('theme-select') as HTMLSelectElement;

    let pendingTableItem: any = null;

    function renderRoomDropdown() {
      if (!roomSelectDropdown) return;
      let html = '';
      customRooms.forEach(rc => {
        const selected = rc.room_key === currentRoom ? 'selected' : '';
        html += `<option value="${rc.room_key}" ${selected}>${rc.room_name}</option>`;
      });
      roomSelectDropdown.innerHTML = html;

      if (isAdmin && !['study', 'chat', 'salon'].includes(currentRoom)) {
        if (deleteRoomBtn) deleteRoomBtn.style.display = 'inline-block';
      } else {
        if (deleteRoomBtn) deleteRoomBtn.style.display = 'none';
      }
    }

    roomSelectDropdown?.addEventListener('change', async (e) => {
      const target = e.target as HTMLSelectElement;
      currentRoom = target.value;
      updateCurrentRoomConfig();
      isDND = false;
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      playerGx = 1; playerGy = 1;
      moveQueue = [];
      renderRoomDropdown();
      await syncMyStateToDB();
      await fetchOnlinePlayers();
      await fetchRoomItems();
    });

    openRoomModalBtn?.addEventListener('click', () => { if (roomSettingsModal) roomSettingsModal.style.display = 'flex'; });
    rsCancelBtn?.addEventListener('click', () => { if (roomSettingsModal) roomSettingsModal.style.display = 'none'; });

    rsConfirmBtn?.addEventListener('click', async () => {
      const key = rsRoomKey?.value.trim();
      const name = rsRoomName?.value.trim();
      const bgImg = rsBgImg?.value.trim() || '';
      const gridSize = parseInt(rsGridSize?.value) || 12;

      if (!key || !name) { alert('請填寫房間代碼與顯示名稱'); return; }

      await supabase.from(ROOMS_TABLE).upsert({
        room_key: key, room_name: name, bg_img: bgImg, grid_size: gridSize
      }, { onConflict: 'room_key' });

      await fetchRooms();
      if (roomSettingsModal) roomSettingsModal.style.display = 'none';
      rsRoomKey.value = ''; rsRoomName.value = ''; rsBgImg.value = '';

      currentRoom = key;
      updateCurrentRoomConfig();
      playerGx = 1; playerGy = 1;
      renderRoomDropdown();
      await syncMyStateToDB();
      await fetchOnlinePlayers();
      await fetchRoomItems();
      alert(`成功建立並切換至「${name}」！`);
    });

    deleteRoomBtn?.addEventListener('click', async () => {
      if (['study', 'chat', 'salon'].includes(currentRoom)) {
        alert('預設房間無法刪除！');
        return;
      }

      if (confirm('確定要刪除當前房間嗎？')) {
        await supabase.from(ROOMS_TABLE).delete().eq('room_key', currentRoom);
        await supabase.from(ITEMS_TABLE).delete().eq('room', currentRoom);

        currentRoom = 'study';
        updateCurrentRoomConfig();
        playerGx = 1; playerGy = 1;
        await fetchRooms();
        await fetchOnlinePlayers();
        await fetchRoomItems();
      }
    });

    openCfModalBtn?.addEventListener('click', () => { if (cfModal) cfModal.style.display = 'flex'; });
    cfCancelBtn?.addEventListener('click', () => { if (cfModal) cfModal.style.display = 'none'; });

    cfConfirmBtn?.addEventListener('click', () => {
      const name = cfNameInput?.value.trim();
      const img = cfImgInput?.value.trim();
      const link = cfLinkInput?.value.trim() || '';
      const openType = cfOpenTypeSelect?.value || 'current';
      const description = cfDescInput?.value.trim() || '無詳細說明';
      const w = parseInt(cfWInput?.value) || 1;
      const h = parseInt(cfHInput?.value) || 1;

      if (!name || !img) { alert('請填寫物件名稱與圖片路徑'); return; }

      const typeKey = 'cf_' + Math.random().toString(36).substring(2, 8);
      customFurnitureTypes.push({ type: typeKey, label: name, w, h, imgSrc: img, description, link, openType });
      localStorage.setItem('rpg_custom_furnitures', JSON.stringify(customFurnitureTypes));

      if (cfModal) cfModal.style.display = 'none';
      cfNameInput.value = ''; cfImgInput.value = ''; cfLinkInput.value = ''; cfDescInput.value = ''; cfWInput.value = '1'; cfHInput.value = '1';
      renderGuideContent();
    });

    peerCloseBtn?.addEventListener('click', () => { if (peerModal) peerModal.style.display = 'none'; });
    customModalClose?.addEventListener('click', () => { if (customModalFrame) customModalFrame.style.display = 'none'; });
    pamCancelBtn?.addEventListener('click', () => { if (playerActionModal) playerActionModal.style.display = 'none'; });

    pamLogsBtn?.addEventListener('click', () => {
      if (selectedPeer) {
        if (playerActionModal) playerActionModal.style.display = 'none';
        window.location.href = `/record?user_id=${selectedPeer.user_id}`;
      }
    });

    pamDmBtn?.addEventListener('click', () => {
      if (selectedPeer) {
        if (playerActionModal) playerActionModal.style.display = 'none';
        window.location.href = `/chatroom?dm=${selectedPeer.user_id}&name=${encodeURIComponent(selectedPeer.name)}`;
      }
    });

    themeSelect?.addEventListener('change', (e) => {
      const selected = (e.target as HTMLSelectElement).value;
      document.documentElement.setAttribute('data-theme', selected);
      localStorage.setItem('rpg_theme', selected);
    });

    libraryCloseBtn?.addEventListener('click', () => { if (libraryModal) libraryModal.style.display = 'none'; });

    // 從個人閱讀記錄選擇書本彈出視窗（支援跳轉或讀取）
    pickFromRecordBtn?.addEventListener('click', () => {
      if (seatModal) seatModal.style.display = 'none';
      // 在同頁分頁開啟書櫃供選擇
      modalTabRecord?.click();
      if (appDrawerModal) appDrawerModal.style.display = 'flex';
    });

    canvas?.addEventListener('click', async (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const clickX = (e.clientX - rect.left) * scaleX;
      const clickY = (e.clientY - rect.top) * scaleY;

      const tileSize = canvas.width / currentGridSize;
      const targetGx = Math.floor(clickX / tileSize);
      const targetGy = Math.floor(clickY / tileSize);

      if (currentTool !== 'move') {
        if (!isAdmin) {
          alert('只有店主（具備管理員權限）才能進行空間佈置！');
          return;
        }

        if (isCellSolidBlocked(targetGx, targetGy)) {
          alert('該位置已有物件或無法放置！');
          return;
        }

        let itemType = currentTool;
        let itemLabel = currentTool;
        let imgSrc = '';
        let link = '';
        let openType = 'current';
        let description = '';
        let w = 1;
        let h = 1;

        if (currentTool === 'seat') {
          itemLabel = '木椅';
          imgSrc = '/assets/seat.png';
          description = '供旅人安坐專心的木椅';
        } else if (currentTool === 'shelf') {
          itemLabel = '書架';
          imgSrc = '/assets/shelf.png';
          description = '收藏客舍館藏書單的書架';
          link = '/library';
          openType = 'modal';
        } else if (currentTool === 'table') {
          itemLabel = '共讀桌';
          imgSrc = '/assets/table.png';
          description = '供多人共讀交流的共讀桌';
          w = 2; h = 2;
        } else {
          const customObj = customFurnitureTypes.find(cf => cf.type === currentTool);
          if (customObj) {
            itemLabel = customObj.label;
            imgSrc = customObj.imgSrc;
            link = customObj.link;
            openType = customObj.openType;
            description = customObj.description;
            w = customObj.w;
            h = customObj.h;
          }
        }

        const { error } = await supabase.from(ITEMS_TABLE).insert([{
          room: currentRoom,
          type: itemType,
          label: itemLabel,
          img_src: imgSrc,
          link: link,
          open_type: openType,
          description: description,
          gx: targetGx,
          gy: targetGy,
          w: w,
          h: h,
          book_title: itemType === 'table' || itemType === 'seat' ? '' : null,
          author: '',
          max_members: 3,
          members: []
        }]);

        if (error) {
          console.error('放置物件失敗:', error);
          alert('放置物件失敗，請稍後再試');
        } else {
          await fetchRoomItems();
        }
        return;
      }

      if (currentTool === 'move') {
        const hitItem = roomItems.find(item => targetGx >= item.gx && targetGx < item.gx + (item.w || 1) && targetGy >= item.gy && targetGy < item.gy + (item.h || 1));
        
        if (hitItem) {
          // 木椅互動邏輯 (seat 坐下閱讀功能)
          if (hitItem.type === 'seat') {
            activeSeatData = hitItem;
            if (!hitItem.host_id || hitItem.host_id === '') {
              // 空椅：可坐下輸入書本
              if (seatBookInput) seatBookInput.value = '';
              if (seatFormView) seatFormView.style.display = 'block';
              if (seatInfoView) seatInfoView.style.display = 'none';
              if (seatModal) seatModal.style.display = 'flex';
              return;
            } else {
              // 已有人坐：顯示閱讀者人名與書名
              if (seatFormView) seatFormView.style.display = 'none';
              if (seatInfoView) seatInfoView.style.display = 'block';
              if (seatDetails) {
                seatDetails.innerHTML = `
                  <p><strong>坐下讀者：</strong>${hitItem.host_name || '某位旅人'}</p>
                  <p><strong>正在閱讀：</strong>《${hitItem.book_title || '沈思中'}》</p>
                `;
              }
              if (seatModal) seatModal.style.display = 'flex';
              return;
            }
          }

          if (hitItem.type === 'table') {
            activeTableData = hitItem;
            pendingTableItem = hitItem;
            if (!hitItem.book_title || hitItem.book_title === '') {
              if (tableModalTitle) tableModalTitle.textContent = '✨ 發起共讀活動';
              if (tableFormView) tableFormView.style.display = 'block';
              if (tableInfoView) tableInfoView.style.display = 'none';
              if (tableModal) tableModal.style.display = 'flex';
              return;
            }
            if (tableModalTitle) tableModalTitle.textContent = `📖 共讀桌活動：《${hitItem.book_title}》`;
            if (tableFormView) tableFormView.style.display = 'none';
            if (tableInfoView) tableInfoView.style.display = 'block';
            
            if (tableDetails) {
              let membersList = (hitItem.members || []).map((m: any) => m.name).join('、');
              tableDetails.innerHTML = `
                <p><strong>書名：</strong>《${hitItem.book_title}》</p>
                <p><strong>作者：</strong>${hitItem.author || '佚名'}</p>
                <p><strong>發起人：</strong>${hitItem.host_name || '未知'}</p>
                <p><strong>預定完讀：</strong>${hitItem.finish_date || '未設定'}</p>
                <p><strong>成員 (${(hitItem.members || []).length}/${hitItem.max_members})：</strong>${membersList}</p>
              `;
              if (hitItem.host_id === userId || isAdmin) {
                if (tableEndBtn) tableEndBtn.style.display = 'block';
              } else {
                if (tableEndBtn) tableEndBtn.style.display = 'none';
              }
            }
            if (tableModal) tableModal.style.display = 'flex';
            return;
          }

          if (hitItem.type === 'shelf') {
            if (libraryModal) libraryModal.style.display = 'flex';
            return;
          }

          if (hitItem.link && hitItem.link.trim() !== '') {
            const oType = hitItem.open_type || 'current';
            if (oType === 'blank') {
              window.open(hitItem.link, '_blank');
            } else if (oType === 'modal') {
              if (customModalTitle) customModalTitle.textContent = `📄 ${hitItem.label || '內容預覽'}`;
              if (customModalIframe) customModalIframe.src = hitItem.link;
              if (customModalFrame) customModalFrame.style.display = 'flex';
            } else {
              window.location.href = hitItem.link;
            }
            return;
          }
        }

        const hitPlayer = getPlayerAtCell(targetGx, targetGy);
        if (hitPlayer) {
          selectedPeer = hitPlayer;
          if (pamTitle) pamTitle.textContent = `👤 ${hitPlayer.name} (${hitPlayer.role})`;
          if (playerActionModal) playerActionModal.style.display = 'flex';
          return;
        }

        if (!isCellSolidBlocked(targetGx, targetGy)) {
          moveQueue = [];
          let currX = playerGx; let currY = playerGy;
          while (currX !== targetGx) { currX += currX < targetGx ? 1 : -1; moveQueue.push({ gx: currX, gy: currY }); }
          while (currY !== targetGy) { currY += currY < targetGy ? 1 : -1; moveQueue.push({ gx: currX, gy: currY }); }
          if (isDND) { isDND = false; if (leaveSeatBtn) leaveSeatBtn.style.display = 'none'; }
        }
      }
    });

    // 坐下閱讀確認
    seatSitBtn?.addEventListener('click', async () => {
      const bookTitle = seatBookInput?.value.trim();
      if (!bookTitle) { alert('請輸入你想閱讀的書名！'); return; }
      if (activeSeatData) {
        isDND = true;
        if (leaveSeatBtn) leaveSeatBtn.style.display = 'inline-block';
        await supabase.from(ITEMS_TABLE).update({
          host_id: userId,
          host_name: playerName,
          book_title: bookTitle
        }).eq('id', activeSeatData.id);
      }
      if (seatModal) seatModal.style.display = 'none';
      await syncMyStateToDB();
      await fetchRoomItems();
    });

    seatCancelBtn?.addEventListener('click', () => { if (seatModal) seatModal.style.display = 'none'; });
    seatInfoClose?.addEventListener('click', () => { if (seatModal) seatModal.style.display = 'none'; });

    // 起立離開木椅
    leaveSeatBtn?.addEventListener('click', async () => {
      isDND = false;
      if (leaveSeatBtn) leaveSeatBtn.style.display = 'none';
      
      // 清除當前用戶坐著的木椅狀態
      const seatedSeat = roomItems.find(item => item.type === 'seat' && item.host_id === userId);
      if (seatedSeat) {
        await supabase.from(ITEMS_TABLE).update({
          host_id: '',
          host_name: '',
          book_title: ''
        }).eq('id', seatedSeat.id);
      }

      if (playerGy + 1 < currentGridSize && !isCellSolidBlocked(playerGx, playerGy + 1)) playerGy += 1;
      await syncMyStateToDB();
      await fetchRoomItems();
    });

    tableCreateBtn?.addEventListener('click', async () => {
      const book = tableBook?.value.trim();
      const author = tableAuthor?.value.trim();
      const maxM = parseInt(tableMax?.value) || 3;
      const date = tableDate?.value;
      if (!book || !date) { alert('請完整填寫書名與完讀日期'); return; }
      if (pendingTableItem) {
        await supabase.from(ITEMS_TABLE).update({ book_title: book, author: author || '佚名', finish_date: date, max_members: maxM, host_id: userId, host_name: playerName, members: [{ id: userId, name: playerName }] }).eq('id', pendingTableItem.id);
      }
      if (tableModal) tableModal.style.display = 'none';
      fetchRoomItems();
    });

    tableJoinBtn?.addEventListener('click', async () => {
      if (!activeTableData) return;
      const members = activeTableData.members || [];
      if (!members.some((m: any) => m.id === userId)) {
        members.push({ id: userId, name: playerName });
        await supabase.from(ITEMS_TABLE).update({ members }).eq('id', activeTableData.id);
      }
      if (tableModal) tableModal.style.display = 'none';
      fetchRoomItems();
    });

    tableEndBtn?.addEventListener('click', async () => {
      if (!activeTableData) return;
      await supabase.from(ITEMS_TABLE).update({ book_title: '', author: '', finish_date: '', max_members: 3, host_id: '', host_name: '', members: [] }).eq('id', activeTableData.id);
      if (tableModal) tableModal.style.display = 'none';
      fetchRoomItems();
    });

    tableCancelBtn?.addEventListener('click', () => { if (tableModal) tableModal.style.display = 'none'; });
    tableInfoClose?.addEventListener('click', () => { if (tableModal) tableModal.style.display = 'none'; });

    initAuthCheck();
  </script>
</Layout>