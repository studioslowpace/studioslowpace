    drawerCloseBtn?.addEventListener('click', () => {
      if (guideDrawer) guideDrawer.style.display = 'none';
    });

    function renderGuideContent() {
      if (!guideContentBox) return;
      if (isAdmin && shopkeeperDrawerTools) { shopkeeperDrawerTools.style.display = 'flex'; }

      const baseStandardItems = [
        { id: 'std_seat', type: 'seat', label: '木椅', imgSrc: '/assets/seat.png', description: '供旅人安坐專心的木椅', w: 1, h: 1, isSystem: true },
        { id: 'std_shelf', type: 'shelf', label: '書架', imgSrc: '/assets/shelf.png', description: '收藏客舍館藏書單的書架', w: 1, h: 1, isSystem: true },
        { id: 'std_table', type: 'table', label: '共讀桌', imgSrc: '/assets/table.png', description: '供多人共讀交流的共讀桌', w: 2, h: 2, isSystem: true }
      ];

      const uniqueItemsMap = new Map();
      baseStandardItems.forEach(item => uniqueItemsMap.set(item.label, item));

      roomItems.forEach(item => {
        if (!uniqueItemsMap.has(item.label)) {
          uniqueItemsMap.set(item.label, {
            id: item.id,
            type: item.type,
            label: item.label,
            imgSrc: item.img_src || '',
            description: item.description || '',
            w: item.w || 1,
            h: item.h || 1,
            link: item.link || '',
            openType: item.open_type || 'current',
            isSystem: false
          });
        }
      });

      let html = '';
      uniqueItemsMap.forEach((item, label) => {
        const isTable = item.type === 'table';
        html += `
          <div style="display:flex; gap:10px; align-items:center; background:var(--bg-main); border:1px solid var(--border-color); padding:8px; border-radius:6px; margin-bottom:6px;">
            <img src="${item.imgSrc || item.img_src}" style="width:36px; height:36px; object-fit:contain; background:var(--bg-card); border-radius:4px; padding:2px;" onerror="this.style.display='none'" />
            <div style="flex:1;">
              <div style="font-weight:bold; color:var(--accent-color);">${label} ${isTable ? '(🪵共讀桌)' : ''}</div>
              <div style="font-size:11px; color:#cbd5e1; margin-top:2px;">說明：${item.description || '無'}</div>
            </div>
            <div style="display:flex; gap:4px;">
              ${isAdmin && !item.isSystem ? `<button class="guide-edit-btn rpg-btn-sm" data-id="${item.id}" style="background:var(--bg-card); color:#38bdf8; font-weight:bold; padding:4px 8px;" title="修改物件">✏️</button>` : ''}
              ${isAdmin ? `<button class="guide-add-btn rpg-btn-sm" data-type="${item.type}" data-label="${label}" style="background:var(--accent-hover); color:#fff; font-weight:bold; padding:4px 8px;" title="放置至畫布">＋</button>` : ''}
            </div>
          </div>
        `;
      });
      guideContentBox.innerHTML = html;

      document.querySelectorAll('.guide-add-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetBtn = e.currentTarget as HTMLElement;
          currentTool = targetBtn.dataset.type || 'move';
          document.querySelectorAll('.shopkeeper-tools-bar .tool-btn').forEach(tb => tb.classList.remove('active'));
          if (guideDrawer) guideDrawer.style.display = 'none';
          alert(`已選擇「${targetBtn.dataset.label}」，請點擊畫布空白處放置！`);
        });
      });

      document.querySelectorAll('.guide-edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetBtn = e.currentTarget as HTMLElement;
          const itemId = targetBtn.dataset.id;
          const targetItem = roomItems.find(ri => ri.id == itemId);
          if (targetItem) {
            const cfModal = document.getElementById('custom-furniture-modal');
            const cfModalTitle = document.getElementById('cf-modal-title');
            const cfEditId = document.getElementById('cf-edit-id') as HTMLInputElement;
            const cfName = document.getElementById('cf-name') as HTMLInputElement;
            const cfImg = document.getElementById('cf-img') as HTMLInputElement;
            const cfLink = document.getElementById('cf-link') as HTMLInputElement;
            const cfOpenType = document.getElementById('cf-open-type') as HTMLSelectElement;
            const cfDesc = document.getElementById('cf-desc') as HTMLTextAreaElement;
            const cfW = document.getElementById('cf-w') as HTMLInputElement;
            const cfH = document.getElementById('cf-h') as HTMLInputElement;

            if (cfModalTitle) cfModalTitle.textContent = '✏️ 修改空間物件';
            if (cfEditId) cfEditId.value = targetItem.id;
            if (cfName) cfName.value = targetItem.label;
            if (cfImg) cfImg.value = targetItem.img_src || '';
            if (cfLink) cfLink.value = targetItem.link || '';
            if (cfOpenType) cfOpenType.value = targetItem.open_type || 'current';
            if (cfDesc) cfDesc.value = targetItem.description || '';
            if (cfW) cfW.value = String(targetItem.w || 1);
            if (cfH) cfH.value = String(targetItem.h || 1);
            if (cfModal) cfModal.style.display = 'flex';
          }
        });
      });
    }

    document.querySelectorAll('.shopkeeper-tools-bar .tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.shopkeeper-tools-bar .tool-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
